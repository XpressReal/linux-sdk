/ {
	#address-cells = <1>;
	#size-cells = <1>;

	binman: binman {
		nand_128k {
			filename = "rtd1625_snand_128k_bind.bin";
			section@1 {
				size = <0x20000>;
				pad-byte = <0xff>;
				blob@1 {
					filename = "scs_certificate/SCS_Certificate.bin";
					//size = <0x400>;
					align-size = <0x1000>;
				};
				blob@2 {
					filename = "scs_param/0000/SCS_Params_Area.dev.bin";
					//size = <0x200>;
					align-size = <0x1000>;
				};
				blob@3 {
					filename = "extrom_dice_lib/Extrom_Dice_Lib_Area.bin";
					//size = <0x14200>;
					align-size = <0x1000>;
				};
			};
			section@2 {
				size = <0x40000>;
				blob@4 {
					filename = "auxcode/Auxcode_Area.aiot.bin";
					//size = <0x26800>;
					align-size = <0x1000>;
				};
			};
		};

		nand_256k {
			filename = "rtd1625_snand_256k_bind.bin";
			section@1 {
				size = <0x40000>;
				pad-byte = <0xff>;
				blob@1 {
					filename = "scs_certificate/SCS_Certificate.bin";
					//size = <0x400>;
					align-size = <0x1000>;
				};
				blob@2 {
					filename = "scs_param/0000/SCS_Params_Area.dev.bin";
					//size = <0x200>;
					align-size = <0x1000>;
				};
				blob@3 {
					filename = "extrom_dice_lib/Extrom_Dice_Lib_Area.bin";
					//size = <0x14200>;
					align-size = <0x1000>;
				};
			};
			section@2 {
				size = <0x40000>;
				blob@4 {
					filename = "auxcode/Auxcode_Area.aiot.bin";
					//size = <0x26800>;
					align-size = <0x1000>;
				};
			};
		};

		trust_fw {
			filename = "rtd1625_snand_trustfw_bind.bin";
			allow-repack;
			size = <0x80000>; // 0x76000, 256KB aligned
			pad-byte = <0xff>;
			align-size = <0x1000>;
			fit {
				description = "TrustFW fitImage for Kent";
				fit,external-offset = <0x1000>;
				fit,align = <0x1000>;

				images {
					atf_cert {
						description = "atf certificate image";
						type = "firmware";
						arch = "arm64";
						compression = "none";

						blob {
							size = <0x400>;
							filename = "atf_certificate/ATF_Certificate.bin";
						};
					};
					rtk_param {
						description = "rtk param image";
						type = "firmware";
						arch = "arm64";
						compression = "none";

						blob {
							size = <0x800>;
							filename = "rtk_param/RTK_Params_Area.bin";
						};
					};
					dram_init {
						description = "dram init image";
						type = "standalone";
						arch = "arm64";
						compression = "none";

						blob {
							size = <0x40000>;
							filename = "dram_init/DRAM_Init_Area.bin";
						};
					};
					bl31 {
						description = "bl31 image";
						type = "standalone";
						arch = "arm64";
						compression = "none";

						blob {
							size = <0x32000>;
							filename = "bl31/BL31_Area.bin";
						};
					};
					dte_cert {
						description = "Certificate for DTE FW";
						type = "firmware";
						arch = "arm64";
						compression = "none";

						blob {
							filename = "dte_fw_certificate/DTE_FW_Certificate.bin";
						};
					};
				};
			};
			fdtmap {
			};
			image-header {
				location = "end";
			};
		};

		spl {
			filename = "rtd1625_snand_spl_bind.bin";
			size = <0x40000>; // 256KB aligned
			pad-byte = <0xff>;
			blob@1 {
				filename = "u-boot-spl.bin_pad";
				size = <0x2B000>; // 172k
				align-size = <0x1000>;
			};
			spl_sig: blob-ext@1 {
				filename = "u-boot-spl.sig";
				//size = <0x200>; /* 256 */
				align-size = <0x1000>;
				optional;
			};
		};

		bootcode {
			filename = "rtd1625_snand_bootcode_bind.bin";
			size = <0xC0000>; // 256KB aligned
			pad-byte = <0xff>;
			blob@1 {
				filename = "u-boot.img";
				align-size = <0x1000>;
			};
		};
	};
};
