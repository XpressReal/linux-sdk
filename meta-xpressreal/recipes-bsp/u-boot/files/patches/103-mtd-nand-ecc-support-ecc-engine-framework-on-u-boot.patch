From d64f0b381b79febcb53d941d2ff875276d5e0136 Mon Sep 17 00:00:00 2001
From: Ken Tseng <ken.tseng@realtek.com>
Date: Tue, 14 Apr 2026 13:36:17 +0800
Subject: [PATCH] mtd: nand: ecc: support ecc engine framework on u-boot

- SPI_RTK_NAND: Set bitflip_threshold to 1/3 ECC strength
---
 drivers/mtd/nand/core.c  |  2 ++
 drivers/mtd/nand/ecc.c   | 67 +++++++++++++++++++++++++++++++++++++---
 include/linux/mtd/nand.h |  4 +++
 3 files changed, 68 insertions(+), 5 deletions(-)

diff --git a/drivers/mtd/nand/core.c b/drivers/mtd/nand/core.c
index 2366383997..145662d2d2 100644
--- a/drivers/mtd/nand/core.c
+++ b/drivers/mtd/nand/core.c
@@ -262,9 +262,11 @@ static int nanddev_find_ecc_configuration(struct nand_device *nand)
 	if (ret)
 		return ret;
 
+#ifndef __UBOOT__
 	if (!nand_ecc_is_strong_enough(nand))
 		pr_warn("WARNING: %s: the ECC used on your system is too weak compared to the one required by the NAND chip\n",
 			nand->mtd->name);
+#endif
 
 	return 0;
 }
diff --git a/drivers/mtd/nand/ecc.c b/drivers/mtd/nand/ecc.c
index e64b1f793c..b43976f51d 100644
--- a/drivers/mtd/nand/ecc.c
+++ b/drivers/mtd/nand/ecc.c
@@ -93,12 +93,17 @@
  *   - ondie + finish  + ecc + write: do nothing
  */
 
-//#include <linux/module.h>
+#ifndef __UBOOT__
+#include <linux/module.h>
 #include <linux/mtd/nand.h>
-//#include <linux/slab.h>
-//#include <linux/of.h>
-//#include <linux/of_device.h>
-//#include <linux/of_platform.h>
+#include <linux/slab.h>
+#include <linux/of.h>
+#include <linux/of_device.h>
+#include <linux/of_platform.h>
+#else
+#include <ubi_uboot.h>
+#include <linux/mtd/nand.h>
+#endif
 
 static LIST_HEAD(on_host_hw_engines);
 static DEFINE_MUTEX(on_host_hw_engines_mutex);
@@ -159,6 +164,7 @@ int nand_ecc_finish_io_req(struct nand_device *nand,
 }
 EXPORT_SYMBOL(nand_ecc_finish_io_req);
 
+#ifndef __UBOOT__
 /* Define default OOB placement schemes for large and small page devices */
 static int nand_ooblayout_ecc_sp(struct mtd_info *mtd, int section,
 				 struct mtd_oob_region *oobregion)
@@ -590,6 +596,37 @@ void nand_ecc_restore_req(struct nand_ecc_req_tweak_ctx *ctx,
 	*req = *orig;
 }
 EXPORT_SYMBOL_GPL(nand_ecc_restore_req);
+#else
+static enum nand_ecc_engine_type
+of_get_nand_ecc_engine_type(struct udevice *dev)
+{
+	struct udevice *eng_dev = NULL;
+	struct ofnode_phandle_args args;
+	int ret;
+
+	ret = dev_read_phandle_with_args(dev, "nand-ecc-engine", NULL, 0, 0,
+					 &args);
+	if (!ret)
+		ret = uclass_get_device_by_ofnode(UCLASS_SPI, args.node, &eng_dev);
+
+	if (eng_dev) {
+		if (eng_dev == dev)
+			return NAND_ECC_ENGINE_TYPE_ON_DIE;
+		else
+			return NAND_ECC_ENGINE_TYPE_ON_HOST;
+	}
+
+	return NAND_ECC_ENGINE_TYPE_INVALID;
+}
+void of_get_nand_ecc_user_config(struct nand_device *nand)
+{
+	struct udevice *dev = nand->mtd->dev;
+
+	nand->ecc.user_conf.engine_type = of_get_nand_ecc_engine_type(dev);
+
+}
+EXPORT_SYMBOL(of_get_nand_ecc_user_config);
+#endif /* __UBOOT__ */
 
 struct nand_ecc_engine *nand_ecc_get_on_die_hw_engine(struct nand_device *nand)
 {
@@ -630,7 +667,11 @@ int nand_ecc_unregister_on_host_hw_engine(struct nand_ecc_engine *engine)
 }
 EXPORT_SYMBOL(nand_ecc_unregister_on_host_hw_engine);
 
+#ifndef __UBOOT__
 static struct nand_ecc_engine *nand_ecc_match_on_host_hw_engine(struct device *dev)
+#else
+static struct nand_ecc_engine *nand_ecc_match_on_host_hw_engine(struct udevice *dev)
+#endif
 {
 	struct nand_ecc_engine *item;
 
@@ -644,14 +685,22 @@ static struct nand_ecc_engine *nand_ecc_match_on_host_hw_engine(struct device *d
 struct nand_ecc_engine *nand_ecc_get_on_host_hw_engine(struct nand_device *nand)
 {
 	struct nand_ecc_engine *engine = NULL;
+#ifndef __UBOOT__
 	struct device *dev = &nand->mtd->dev;
 	struct platform_device *pdev;
+#else
+	struct udevice *dev = nand->mtd->dev;
+	struct udevice *pdev;
+	struct ofnode_phandle_args args;
+	int ret;
+#endif
 	struct device_node *np;
 
 	if (list_empty(&on_host_hw_engines))
 		return NULL;
 
 	/* Check for an explicit nand-ecc-engine property */
+#ifndef __UBOOT__
 	np = of_parse_phandle(dev->of_node, "nand-ecc-engine", 0);
 	if (np) {
 		pdev = of_find_device_by_node(np);
@@ -665,6 +714,14 @@ struct nand_ecc_engine *nand_ecc_get_on_host_hw_engine(struct nand_device *nand)
 		if (!engine)
 			return ERR_PTR(-EPROBE_DEFER);
 	}
+#else
+	ret = dev_read_phandle_with_args(dev, "nand-ecc-engine", NULL, 0, 0,
+					 &args);
+	if (!ret)
+		ret = uclass_get_device_by_ofnode(UCLASS_SPI, args.node, &pdev);
+	if (!ret)
+		engine = nand_ecc_match_on_host_hw_engine(pdev);
+#endif
 
 	if (engine)
 		get_device(engine->dev);
diff --git a/drivers/mtd/nand/spi/core.c b/drivers/mtd/nand/spi/core.c
index 3c95748d93..8061682220 100644
--- a/drivers/mtd/nand/spi/core.c
+++ b/drivers/mtd/nand/spi/core.c
@@ -1658,7 +1658,11 @@ static int spinand_init(struct spinand_device *spinand)
 	/* Propagate ECC information to mtd_info */
 	mtd->ecc_strength = nanddev_get_ecc_conf(nand)->strength;
 	mtd->ecc_step_size = nanddev_get_ecc_conf(nand)->step_size;
+#if CONFIG_IS_ENABLED(SPI_RTK_NAND)
+	mtd->bitflip_threshold = DIV_ROUND_UP(mtd->ecc_strength * 1, 3);
+#else
 	mtd->bitflip_threshold = DIV_ROUND_UP(mtd->ecc_strength * 3, 4);
+#endif
 
 	ret = spinand_create_dirmaps(spinand);
 	if (ret) {
diff --git a/include/linux/mtd/nand.h b/include/linux/mtd/nand.h
index 1004ac8a91..8d77e29702 100644
--- a/include/linux/mtd/nand.h
+++ b/include/linux/mtd/nand.h
@@ -276,7 +276,11 @@ enum nand_ecc_engine_integration {
  * @priv: Private data
  */
 struct nand_ecc_engine {
+#ifndef __UBOOT__
 	struct device *dev;
+#else
+	struct udevice *dev;
+#endif
 	struct list_head node;
 	struct nand_ecc_engine_ops *ops;
 	enum nand_ecc_engine_integration integration;
-- 
2.47.0

