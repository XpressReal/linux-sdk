bootargs=earlycon=uart8250,mmio32,0x98007800 console=ttyS0,460800 uio_pdrv_genirq.of_id=generic-uio rootfstype=ext4,squashfs rootwait pd_ignore_unused clk_ignore_unused restrict_cma_redirect loglevel=4
boot_yocto=run setup_bootargs; run setup_mmc; fatload mmc ${mmcidx}:1 ${script_addr} boot.scr && source ${script_addr}:script; fatload mmc ${mmcidx}:1 ${bootmaddr} yocto.itb; bootm ${bootmaddr}${bootcfg}
altbootcmd=setenv bootcfg "#rescue"; run boot_yocto
board=stark
serial#=88816198
bootdelay=2
initrd_high=0xffffffffffffffff
fdt_high=0xffffffffffffffff
loadaddr=0x03000000
bootmaddr=0x20000000
baudrate=460800
ethact=r8168#0
ethaddr=00:10:20:30:40:50
gatewayip=192.168.100.254
ipaddr=192.168.100.1
netmask=255.255.255.0
serverip=192.168.100.2
vconsole=video=HDMI-A-1:1920x1080@30 console=tty1
firmware_path=/lib/firmware/realtek/rtd1619b/
setup_bootargs=setenv bootargs "${bootargs} ${vconsole} firmware_class.path=${firmware_path}"
setup_mmc=setenv mmcidx 0; mmc dev 1 && setenv mmcidx 1; setenv bootargs "${bootargs} root=/dev/mmcblk${mmcidx}p2"
bootcmd=run try_usb_boot || run try_boot_android || run boot_chromium_os || run boot_yocto

try_usb_boot=if env exists boot_usb; then usb reset; fatload usb 0:1 ${bootmaddr} yocto.itb && run setup_bootargs && setenv bootargs "${bootargs} root=/dev/sda2" && bootm ${bootmaddr}${bootcfg}; fi

# For Chromium OS on USB/SDMMC/eMMC
script_img=/boot/boot.scr.uimg
script_addr=0x7000000
distro_bootpart=c
devnum=0
setup_devtype=setenv devtype; if env exists boot_usb; then usb reset; setenv devtype usb; else run setup_mmc; setenv devtype mmc; setenv devnum ${mmcidx}; fi
load_uimg=run setup_devtype; test -e ${devtype} ${devnum}:${distro_bootpart} ${script_img} && load ${devtype} ${devnum}:${distro_bootpart} ${script_addr} ${script_img}
boot_chromium_os=run load_uimg && source ${script_addr}

# For AOSP
gpt_parts=name=uboot,start=4MiB,size=32MiB;name=boot,size=64MiB;name=vendor_boot,size=32MiB;name=dtbo,size=8MiB;name=recovery,size=64MiB;name=misc,size=4MiB;name=vbmeta,size=64KiB;name=super,size=3GiB;name=cache,size=256MiB;name=metadata,size=16MiB;name=userdata,size=-
boot_android=if bcb load $devtype $devnum misc; then run boot_android_bootloader || run test_bcb; run setup_android_arg; run setup_bootargs; run do_avb_verify; run boot_android_img; fi
do_avb_verify=echo "Starting AVB verification..."; avb init $devnum; if avb verify; then echo "AVB OK"; setenv bootargs "${bootargs} ${avb_bootargs}"; elif test "${fastboot_unlocked}" = "yes"; then echo "AVB failed, device unlocked - booting orange"; setenv bootargs "${bootargs} androidboot.verifiedbootstate=orange"; else echo "AVB FAILED!"; fastboot usb 1; fi
load_vendor_boot=part start $devtype $devnum vendor_boot vb_start && part size $devtype $devnum vendor_boot vb_size && $devtype read $vendor_bootmaddr $vb_start $vb_size
load_dtbo=part start $devtype $devnum dtbo dtbo_start && part size $devtype $devnum dtbo dtbo_size && $devtype read $dtbo_addr_r $dtbo_start $dtbo_size
boot_android_img=part start $devtype $devnum $bootpart_name part_start; part size $devtype $devnum $bootpart_name part_size; $devtype read $bootmaddr $part_start $part_size; setenv fdt_high; setenv kernel_addr_r 0x01000000; setenv ramdisk_addr_r 0x06000000; setenv fdt_addr_r 0x03800000; setenv vendor_bootmaddr 0x18000000; setenv dtbo_addr_r 0x1a000000; run load_dtbo; run load_vendor_boot && abootimg addr $bootmaddr $vendor_bootmaddr; bootm $bootmaddr
boot_android_bootloader=if bcb test command = bootonce-bootloader; then bcb clear command; bcb store; echo "booting android bootloader"; fastboot usb 1; fi
# only backinblack with adtb_idx=1 has dtbo
setup_android_arg=if test -z "$adtbo_idx"; then setenv adtbo_idx 0; fi; if test $adtb_idx -ne 1; then setenv adtbo_idx; fi; if test -n "$adtbo_idx"; then setenv bootargs androidboot.dtbo_idx=$adtbo_idx; else setenv bootargs; fi; setenv vconsole; setenv firmware_path /vendor/firmware/,/vendor/firmware/realtek/rtd1619b/;

test_bcb=if bcb test command = boot-fastboot; then echo "booting fastbootd (userspace fastboot)"; setenv bootpart_name recovery; elif bcb test command = boot-recovery; then echo "booting android recovery"; setenv bootpart_name recovery; else echo "booting android ..."; setenv bootpart_name boot; fi
try_boot_android=setenv devtype mmc; for num in 1 0; do setenv devnum $num; run boot_android; done
