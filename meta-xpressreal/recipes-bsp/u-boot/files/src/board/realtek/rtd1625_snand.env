bootargs=earlycon=uart8250,mmio32,0x98007800 console=ttyS0,460800 8250.nr_uarts=10 rootwait pd_ignore_unused clk_ignore_unused restrict_cma_redirect loglevel=4
boot_yocto=run setup_bootargs; run setup_ubi; ubi read $bootmaddr linux; bootm ${bootmaddr}${bootcfg}
altbootcmd=setenv bootcfg "#rescue"; run boot_yocto
bootdelay=2
initrd_high=0xffffffffffffffff
fdt_high=0xffffffffffffffff
loadaddr=0x03000000
bootmaddr=0x20000000
baudrate=460800
ethact=r8168#0
ethaddr=00:10:20:30:40:50
gatewayip=192.168.100.254
ipaddr=192.168.100.1
netmask=255.255.255.0
serverip=192.168.100.2
vconsole=video=HDMI-A-1:1920x1080@30 console=tty1
firmware_path=/lib/firmware/realtek/rtd1625/
setup_bootargs=setenv bootargs "${bootargs} ${vconsole} firmware_class.path=${firmware_path}"
setup_ubi=ubi part ubi; setenv bootargs "${bootargs} ${mtdparts} root=ubi0:rootfs ubi.mtd=rootfs rootfstype=ubifs pstore_blkdev=pstore"
bootcmd=run try_usb_boot || run boot_yocto

try_usb_boot=if env exists boot_usb; then usb reset; fatload usb 0:1 ${bootmaddr} yocto.itb && run setup_bootargs && setenv bootargs "${bootargs} root=/dev/sda2" && bootm ${bootmaddr}${bootcfg}; fi

