   };
diff --git a/media/gpu/v4l2/v4l2_vda_helpers.cc b/media/gpu/v4l2/v4l2_vda_helpers.cc
index 631af02102..2056a17172 100644
--- a/media/gpu/v4l2/v4l2_vda_helpers.cc
+++ b/media/gpu/v4l2/v4l2_vda_helpers.cc
@@ -20,8 +20,13 @@
 #include "media/gpu/macros.h"
 #include "media/gpu/v4l2/v4l2_device.h"
 #include "media/gpu/v4l2/v4l2_image_processor_backend.h"
+#include "media/media_buildflags.h"
 #include "media/parsers/h264_parser.h"
 
+#if BUILDFLAG(ENABLE_HEVC_PARSER_AND_HW_DECODER)
+#include "media/parsers/h265_parser.h"
+#endif  // BUILDFLAG(ENABLE_HEVC_PARSER_AND_HW_DECODER)
+
 namespace media {
 namespace v4l2_vda_helpers {
 
@@ -156,6 +161,11 @@ InputBufferFragmentSplitter::CreateFromProfile(
     case VideoCodec::kH264:
       return std::make_unique<
           v4l2_vda_helpers::H264InputBufferFragmentSplitter>();
+#if BUILDFLAG(ENABLE_HEVC_PARSER_AND_HW_DECODER)
+    case VideoCodec::kHEVC:
+      return std::make_unique<
+          v4l2_vda_helpers::H265InputBufferFragmentSplitter>();
+#endif  // BUILDFLAG(ENABLE_HEVC_PARSER_AND_HW_DECODER)
     case VideoCodec::kVP8:
     case VideoCodec::kVP9:
       // VP8/VP9 don't need any frame splitting, use the default implementation.
@@ -280,5 +290,121 @@ bool H264InputBufferFragmentSplitter::IsPartialFramePending() const {
   return partial_frame_pending_;
 }
 
+#if BUILDFLAG(ENABLE_HEVC_PARSER_AND_HW_DECODER)
+H265InputBufferFragmentSplitter::H265InputBufferFragmentSplitter()
+    : h265_parser_(new H265Parser()) {}
+
+H265InputBufferFragmentSplitter::~H265InputBufferFragmentSplitter() = default;
+
+bool H265InputBufferFragmentSplitter::AdvanceFrameFragment(const uint8_t* data,
+                                                           size_t size,
+                                                           size_t* endpos) {
+  DCHECK(h265_parser_);
+
+  // For H265, we need to feed HW one frame at a time. This requires parsing
+  // our input stream to find access unit (frame) boundaries.
+  h265_parser_->SetStream(data, size);
+  H265NALU nalu;
+  H265Parser::Result result;
+  bool has_frame_data = false;
+  *endpos = 0;
+
+  // Keep on peeking the next NALs while they don't indicate a frame boundary.
+  while (true) {
+    bool end_of_frame = false;
+    result = h265_parser_->AdvanceToNextNALU(&nalu);
+    if (result == H265Parser::kInvalidStream ||
+        result == H265Parser::kUnsupportedStream) {
+      return false;
+    }
+    if (result == H265Parser::kEOStream) {
+      // We've reached the end of the buffer before finding a frame boundary.
+      if (has_frame_data)
+        partial_frame_pending_ = true;
+      *endpos = size;
+      return true;
+    }
+    // NALU types in [0, RSV_VCL31] are VCL NALUs, i.e. coded slice segments.
+    if (nalu.nal_unit_type <= H265NALU::RSV_VCL31) {
+      // The 2-byte NAL unit header plus at least one byte of slice segment
+      // header are required to inspect first_slice_segment_in_pic_flag.
+      if (nalu.size < 3)
+        return false;
+
+      has_frame_data = true;
+
+      // A coded slice segment begins a new picture (frame) when
+      // first_slice_segment_in_pic_flag is 1. That flag is the very first bit
+      // of the slice_segment_header() RBSP, which follows the two-byte NAL unit
+      // header (i.e. the MSB of |nalu.data[2]|). Being the first bit, it cannot
+      // be affected by emulation prevention, so a direct test against 0x80 is
+      // safe. See H.265 7.3.6.1 and 7.4.2.4.4.
+      //
+      // But only treat it as a frame boundary if the access unit being
+      // accumulated already holds a slice. Otherwise (e.g. it directly follows
+      // the VPS/SPS/PPS we've been buffering) keep it together with those
+      // parameter sets so the whole access unit is submitted in one OUTPUT
+      // buffer, which stateful HEVC drivers require to decode the IDR.
+      const bool first_slice_segment_in_pic = (nalu.data[2] >= 0x80);
+      if (first_slice_segment_in_pic && current_au_has_vcl_) {
+        end_of_frame = true;
+      }
+      current_au_has_vcl_ = true;
+    } else {
+      switch (nalu.nal_unit_type) {
+        case H265NALU::AUD_NUT:
+        case H265NALU::VPS_NUT:
+        case H265NALU::SPS_NUT:
+        case H265NALU::PPS_NUT:
+        case H265NALU::PREFIX_SEI_NUT:
+        case H265NALU::FD_NUT:
+          // Access unit delimiter, parameter sets, prefix SEI and filler data
+          // all lead the next picture. They only mark a frame boundary if a
+          // complete picture (with slices) has already been accumulated;
+          // otherwise keep buffering them for the upcoming slice.
+          if (current_au_has_vcl_) {
+            end_of_frame = true;
+            current_au_has_vcl_ = false;
+          }
+          break;
+        case H265NALU::SUFFIX_SEI_NUT:
+          // Trails the preceding picture: keep it attached, no boundary.
+          break;
+        default:
+          // EOS/EOB and anything else closes off any pending picture.
+          end_of_frame = true;
+          current_au_has_vcl_ = false;
+          break;
+      }
+    }
+    if (end_of_frame) {
+      if (!partial_frame_pending_ && *endpos == 0) {
+        // The frame was previously restarted, and we haven't filled the
+        // current frame with any contents yet. Start the new frame here and
+        // continue parsing NALs.
+      } else {
+        // The frame wasn't previously restarted and/or we have contents for
+        // the current frame; signal the start of a new frame here: we don't
+        // have a partial frame anymore.
+        partial_frame_pending_ = false;
+        return true;
+      }
+    }
+    *endpos = (nalu.data + base::checked_cast<size_t>(nalu.size)) - data;
+  }
+  NOTREACHED();
+}
+
+void H265InputBufferFragmentSplitter::Reset() {
+  partial_frame_pending_ = false;
+  current_au_has_vcl_ = false;
+  h265_parser_.reset(new H265Parser());
+}
+
+bool H265InputBufferFragmentSplitter::IsPartialFramePending() const {
+  return partial_frame_pending_;
+}
+#endif  // BUILDFLAG(ENABLE_HEVC_PARSER_AND_HW_DECODER)
+
 }  // namespace v4l2_vda_helpers
 }  // namespace media
diff --git a/media/gpu/v4l2/v4l2_vda_helpers.h b/media/gpu/v4l2/v4l2_vda_helpers.h
index 12e06c1001..ce8848abce 100644
--- a/media/gpu/v4l2/v4l2_vda_helpers.h
+++ b/media/gpu/v4l2/v4l2_vda_helpers.h
@@ -13,12 +13,16 @@
 #include "media/base/video_codecs.h"
 #include "media/gpu/chromeos/fourcc.h"
 #include "media/gpu/chromeos/image_processor.h"
+#include "media/media_buildflags.h"
 #include "ui/gfx/geometry/size.h"
 
 namespace media {
 
 class V4L2Device;
 class H264Parser;
+#if BUILDFLAG(ENABLE_HEVC_PARSER_AND_HW_DECODER)
+class H265Parser;
+#endif  // BUILDFLAG(ENABLE_HEVC_PARSER_AND_HW_DECODER)
 
 // Helper static methods to be shared between V4L2VideoDecodeAccelerator and
 // V4L2SliceVideoDecodeAccelerator. This avoids some code duplication between
@@ -116,6 +120,36 @@ class H264InputBufferFragmentSplitter : public InputBufferFragmentSplitter {
   bool partial_frame_pending_ = false;
 };
 
+#if BUILDFLAG(ENABLE_HEVC_PARSER_AND_HW_DECODER)
+// Splitter for H.265, making sure to properly report when a partial frame
+// may be pending. Analogous to H264InputBufferFragmentSplitter.
+class H265InputBufferFragmentSplitter : public InputBufferFragmentSplitter {
+ public:
+  explicit H265InputBufferFragmentSplitter();
+  ~H265InputBufferFragmentSplitter() override;
+
+  bool AdvanceFrameFragment(const uint8_t* data,
+                            size_t size,
+                            size_t* endpos) override;
+  void Reset() override;
+  bool IsPartialFramePending() const override;
+
+ private:
+  // For H265 decode, hardware requires that we send it frame-sized chunks.
+  // We'll need to parse the stream.
+  std::unique_ptr<H265Parser> h265_parser_;
+  // Set if we have a pending incomplete frame in the input buffer.
+  bool partial_frame_pending_ = false;
+  // Whether the access unit currently being accumulated already contains a VCL
+  // (coded slice) NALU. Unlike H.264, stateful HEVC drivers require the
+  // parameter sets (VPS/SPS/PPS) to be submitted in the same OUTPUT buffer as
+  // the first slice of the picture they apply to. This flag lets us keep
+  // leading parameter sets attached to the upcoming slice instead of splitting
+  // them into their own (undecodable) frame chunks.
+  bool current_au_has_vcl_ = false;
+};
+#endif  // BUILDFLAG(ENABLE_HEVC_PARSER_AND_HW_DECODER)
+
 }  // namespace v4l2_vda_helpers
 }  // namespace media
 
