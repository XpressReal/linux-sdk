@@ -0,0 +1,314 @@
+// WifiSettingsView.qml
+
+import QtQuick 2.15
+import QtQuick.Controls 2.15
+import QtQuick.Layouts 1.15
+
+import QtQuick.VirtualKeyboard 2.15
+import QtQuick.VirtualKeyboard.Settings 2.15
+
+Page {
+    id: wifiPage
+    property bool isScanning: false
+    property bool isConnecting: false
+    property string connectionDetails: ""
+
+    ColumnLayout {
+        anchors.fill: parent
+        anchors.margins: 20
+
+        RowLayout {
+            spacing: 20
+
+            Label {
+                text: "Current Network: " + (wifiManager.currentSSID || "None")
+                font.bold: true
+                font.pixelSize: 18
+            }
+
+            Button {
+                text: "Info"
+                visible: wifiManager.currentSSID !== ""
+                onClicked: {
+                    wifiPage.connectionDetails = wifiManager.getConnectionDetails()
+                    connectionInfoDialog.open()
+                }
+            }
+        }
+
+        Button {
+            text: "Scan Networks"
+            enabled: !wifiPage.isScanning
+            onClicked: {
+                wifiPage.isScanning = true
+                wifiManager.scanNetworks()
+            }
+        }
+
+        ListView {
+            id: networkList
+            Layout.fillWidth: true
+            Layout.fillHeight: true
+            clip: true
+            model: wifiManager ? wifiManager.networks : []
+
+            delegate: ItemDelegate {
+                width: networkList.width
+                height: 30
+
+                background: Rectangle {
+                    color: {
+                        if (mouseArea.containsPress) return "#444444";
+                        if (mouseArea.containsMouse) return "#555555";
+                        // background colors switch
+                        if (index % 2 === 0) return "#252525";
+                        else return "#404040";
+                    }
+                    radius: 10
+                }
+
+                property int signalLevel: {
+                    var text = modelData.toString();
+                    var match = text.match(/Signal: ([-\d]+) dBm/);
+                    if (match) {
+                        var s = parseInt(match[1]);
+                        if (s >= -50) return 4;
+                        if (s >= -70) return 3;
+                        if (s >= -80) return 2;
+                        if (s >= -90) return 1;
+                    }
+                    return 0;
+                }
+
+                MouseArea {
+                    id: mouseArea
+                    anchors.fill: parent
+                    hoverEnabled: true
+                    onClicked: {
+                        var ssid = modelData.toString().split(" (Signal:")[0].trim()
+                        passwordDialog.ssid = ssid
+                        passwordDialog.open()
+                    }
+                }
+
+                RowLayout {
+                    anchors.fill: parent
+                    anchors.leftMargin: 20
+                    anchors.rightMargin: 20
+                    spacing: 20
+
+                    // icon for signal strength
+                    Row {
+                        Layout.alignment: Qt.AlignVCenter
+                        spacing: 6
+
+                        Repeater {
+                            model: 4
+
+                            Rectangle {
+                                width: 12
+                                height: 28
+                                radius: 4
+
+                                color: {
+                                    if (index >= signalLevel) {
+                                        return "#444444";
+                                    }
+
+                                    // Some colors for different signal levels
+                                    if (signalLevel === 4) return "#4CAF50";     // high
+                                    if (signalLevel === 3) return "#CDDC39";     // normal
+                                    if (signalLevel === 2) return "#FFC107";     // medium
+                                    return "#F44336";                            // low
+                                }
+
+                                opacity: index < signalLevel ? 1.0 : 0.3
+                                border.color: "#666666"
+                                border.width: index < signalLevel ? 1 : 0
+                            }
+                        }
+                    }
+
+                    Text {
+                        Layout.fillWidth: true
+                        Layout.alignment: Qt.AlignVCenter
+                        text: modelData
+                        font.family: "Courier New, Monospace"
+                        font.pixelSize: 18
+                        font.weight: Font.Medium
+                        color: "#ffffff"
+                        elide: Text.ElideRight
+                        leftPadding: 10
+                        verticalAlignment: Text.AlignVCenter
+                    }
+                }
+
+                onClicked: {
+                    var ssid = modelData.split(" (Signal:")[0].trim()
+                    passwordDialog.ssid = ssid
+                    passwordDialog.open()
+                }
+            }
+
+            ScrollIndicator.vertical: ScrollIndicator { }
+        }
+    }
+
+    Rectangle {
+        id: loadingOverlay
+        anchors.fill: parent
+        color: "#80000000"
+        visible: wifiPage.isScanning || wifiPage.isConnecting
+        z: 10
+
+        Column {
+            anchors.centerIn: parent
+            spacing: 20
+
+            BusyIndicator {
+                width: 80
+                height: 80
+                running: true
+                anchors.horizontalCenter: parent.horizontalCenter
+            }
+
+            Text {
+                text: wifiPage.isScanning ? "Scanning Wi-Fi networks..."
+                                        : "Connecting to Wi-Fi..."
+                color: "white"
+                font.pixelSize: 18
+                anchors.horizontalCenter: parent.horizontalCenter
+            }
+        }
+    }
+
+    // password dialog
+    Dialog {
+        id: passwordDialog
+        property string ssid: ""
+        title: "Connect to " + ssid
+        closePolicy: Popup.NoAutoClose
+        standardButtons: Dialog.Ok | Dialog.Cancel
+        height: parent.height * 0.4
+
+        ColumnLayout {
+            Layout.fillWidth: true
+            spacing: 10
+
+            Label { text: "Enter password for " + passwordDialog.ssid }
+
+            RowLayout {
+                spacing: 10
+
+                TextField {
+                    id: pwdField
+                    placeholderText: "Password (leave blank for open network)"
+                    echoMode: TextInput.Password
+                    inputMethodHints: Qt.ImhNoAutoUppercase | Qt.ImhSensitiveData | Qt.ImhNoPredictiveText
+                    focus: true
+                }
+
+                ToolButton {
+                    id: showPasswordButton
+                    icon.source: pwdField.echoMode === TextInput.Password
+                        ? "qrc:/res/visibility.svg"
+                        : "qrc:/res/visibility-off.svg"
+                    icon.name: pwdField.echoMode === TextInput.Password ? "visibility" : "visibility-off"
+                    icon.color: "#ffffff"
+                    icon.width: 24
+                    icon.height: 24
+                    flat: true
+                    hoverEnabled: true
+
+                    onClicked: {
+                        pwdField.echoMode = (pwdField.echoMode === TextInput.Password)
+                                            ? TextInput.Normal
+                                            : TextInput.Password
+                    }
+
+                    ToolTip {
+                        visible: showPasswordButton.hovered
+                        text: pwdField.echoMode === TextInput.Password ? "show" : "hide"
+                        delay: 500
+                    }
+                }
+            }
+        }
+
+        onOpened: {
+            pwdField.forceActiveFocus()
+        }
+
+        onAccepted: {
+            wifiPage.isConnecting = true
+            wifiManager.connectToNetwork(passwordDialog.ssid, pwdField.text)
+        }
+    }
+
+    Dialog {
+        id: connectionInfoDialog
+        title: "Connection Info - " + wifiManager.currentSSID
+        width: parent.width * 0.7
+        height: parent.height * 0.6
+        standardButtons: Dialog.Close
+
+        ScrollView {
+            anchors.fill: parent
+            TextArea {
+                readOnly: true
+                text: wifiPage.connectionDetails
+                font.pixelSize: 18
+                font.family: "Courier New, Monospace"
+                wrapMode: TextArea.Wrap
+                background: Rectangle { color: "#1e1e1e" }
+            }
+        }
+    }
+
+    Timer {
+        id: connectDelayTimer
+        interval: 8000
+        repeat: false
+        running: false
+
+        onTriggered: {
+            wifiPage.isConnecting = false
+            console.log("Loading timer")
+        }
+    }
+
+    Connections {
+        target: wifiManager
+
+        function onNetworksChanged() {
+            console.log("onNetworksChanged")
+            wifiPage.isScanning = false
+        }
+
+        function onConnectionChanged() {
+            console.log("onConnectionChanged")
+            connectDelayTimer.start()
+            //wifiPage.isConnecting = false
+        }
+
+        function onErrorOccurred(msg) {
+            console.log("onErrorOccurred")
+            wifiPage.isScanning = false
+            wifiPage.isConnecting = false
+        }
+    }
+
+    InputPanel {
+        id: inputPanel
+        z: 999999
+        anchors.left: parent.left
+        anchors.right: parent.right
+        anchors.bottom: parent.bottom
+        visible: active
+        height: Math.min(parent.height * 0.35, 300)
+
+        Behavior on y {
+            NumberAnimation { duration: 200; easing.type: Easing.OutQuad }
+        }
+    }
+}
