+++ b/app/backend/WifiManager.h
@@ -0,0 +1,44 @@
+// WifiManager.h
+
+#ifndef WIFIMANAGER_H
+#define WIFIMANAGER_H
+
+#include <QObject>
+#include <QStringList>
+#include <QProcess>
+#include <QTimer>
+#include <QRegularExpression>
+
+class WifiManager : public QObject
+{
+    Q_OBJECT
+    Q_PROPERTY(QStringList networks READ networks NOTIFY networksChanged)
+    Q_PROPERTY(QString currentSSID READ currentSSID NOTIFY connectionChanged)
+
+public:
+    explicit WifiManager(QObject *parent = nullptr);
+
+    QStringList networks() const { return m_networks; }
+    QString currentSSID() const { return m_currentSSID; }
+
+    Q_INVOKABLE void scanNetworks();
+    Q_INVOKABLE void connectToNetwork(const QString &ssid, const QString &password = QString());
+    Q_INVOKABLE QString getConnectionDetails();
+
+signals:
+    void networksChanged();
+    void connectionChanged();
+    void errorOccurred(const QString &msg);
+
+private slots:
+    void scanProcessFinished(int exitCode, QProcess::ExitStatus exitStatus);
+    void connectProcessFinished(int exitCode, QProcess::ExitStatus exitStatus);
+
+private:
+    void refreshCurrentSSID();
+
+    QStringList m_networks;      // Formatted strings: SSID (Signal: xx dBm, Security, Freq: xxxx MHz (x GHz))
+    QString m_currentSSID;
+};
+
+#endif // WIFIMANAGER_H
