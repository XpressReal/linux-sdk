+++ b/app/backend/WifiManager.cpp
@@ -0,0 +1,258 @@
+// WifiManager.cpp
+
+#include "WifiManager.h"
+#include <QDebug>
+#include <QProcess>
+#include <QTimer>
+#include <algorithm>
+
+WifiManager::WifiManager(QObject *parent) : QObject(parent)
+{
+    // Fetch current connected SSID on startup
+    refreshCurrentSSID();
+
+    // Optional: periodically refresh current SSID (e.g., every 10 seconds)
+    // QTimer *timer = new QTimer(this);
+    // connect(timer, &QTimer::timeout, this, &WifiManager::refreshCurrentSSID);
+    // timer->start(10000);
+}
+
+void WifiManager::refreshCurrentSSID()
+{
+    QProcess *process = new QProcess(this);
+    connect(process, QOverload<int, QProcess::ExitStatus>::of(&QProcess::finished),
+            this, [this, process](int exitCode, QProcess::ExitStatus) {
+        Q_UNUSED(exitCode);
+        QString output = process->readAllStandardOutput();
+        QString newSSID;
+
+        // Parse line like "ssid=MyNetwork"
+        QStringList lines = output.split('\n');
+        for (const QString &line : lines) {
+            if (line.startsWith("ssid=")) {
+                newSSID = line.mid(5).trimmed();  // get value from ssid=
+                break;
+            }
+        }
+
+        if (m_currentSSID != newSSID) {
+            m_currentSSID = newSSID;
+            emit connectionChanged();
+            qDebug() << "Current SSID updated to:" << m_currentSSID;
+        }
+
+        process->deleteLater();
+    });
+
+    process->start("wpa_cli", QStringList() << "-i" << "wlan0" << "status");
+}
+
+void WifiManager::scanNetworks()
+{
+    qDebug() << "Starting Wi-Fi scan using wpa_cli (interface: wlan0)...";
+
+    QProcess *process = new QProcess(this);
+    connect(process, QOverload<int, QProcess::ExitStatus>::of(&QProcess::finished),
+            this, &WifiManager::scanProcessFinished);
+
+    // Trigger scan first, then get results after a short delay
+    // Using pipeline: scan + sleep + scan_results
+    process->start("sh", QStringList() << "-c"
+                   << "wpa_cli -i wlan0 scan && sleep 3 && wpa_cli -i wlan0 scan_results");
+
+    // If root privileges are required, prepend "sudo " to the commands above
+    if (!process->waitForStarted()) {
+        emit errorOccurred("Failed to start wpa_cli scan");
+    }
+}
+
+void WifiManager::scanProcessFinished(int exitCode, QProcess::ExitStatus exitStatus)
+{
+    Q_UNUSED(exitStatus);
+
+    QProcess *process = qobject_cast<QProcess*>(sender());
+    if (!process) return;
+
+    qDebug() << "wpa_cli scan finished, exit code:" << exitCode;
+
+    QString output = process->readAllStandardOutput();
+    QString err = process->readAllStandardError();
+
+    if (!err.isEmpty()) {
+        qWarning() << "wpa_cli error:" << err;
+        emit errorOccurred("Scan error: " + err.simplified());
+        process->deleteLater();
+        return;
+    }
+
+    qDebug() << "wpa_cli raw output:\n" << output;
+
+    // Use temporary list for sorting by signal strength
+    QList<QPair<int, QString>> networksWithSignal;
+
+    QStringList lines = output.split('\n');
+    bool foundHeader = false;
+
+    for (const QString &line : lines) {
+        if (line.simplified().isEmpty()) continue;
+
+        if (line.contains("Selected interface") || line.contains("OK") || line.contains(">")) {
+            continue;
+        }
+
+        if (line.startsWith("bssid") || line.startsWith("BSSID")) {
+            foundHeader = true;
+            continue;
+        }
+
+        if (foundHeader) {
+            QString trimmed = line.trimmed();
+            if (trimmed.isEmpty()) continue;
+
+            QStringList fields = trimmed.split('\t');
+            if (fields.size() >= 5) {
+                QString bssid = fields[0];
+                QString freqStr = fields[1];      // Frequency in MHz
+                QString signalStr = fields[2];
+                QString flags = fields[3];
+                QString ssid = fields.size() > 4 ? fields[4] : "<Hidden SSID>";
+
+                if (ssid.isEmpty()) ssid = "<Hidden SSID>";
+
+                QString security = "Open";
+                if (flags.contains("WPA2") || flags.contains("WPA")) {
+                    security = flags.contains("PSK") ? "WPA2-PSK" : "WPA2-Enterprise";
+                } else if (flags.contains("WEP")) {
+                    security = "WEP";
+                }
+
+                // Convert frequency to human-readable band
+                int freq = freqStr.toInt();
+                QString band = (freq >= 5000) ? "5 GHz" : "2.4 GHz";
+
+                // Format display string with frequency
+                QString display = QString("%1 (Signal: %2 dBm, %3, Freq: %4 MHz (%5))")
+                                      .arg(ssid, signalStr, security, freqStr, band);
+
+                bool ok;
+                int signal = signalStr.toInt(&ok);
+                if (!ok) {
+                    signal = -100;  // Fallback for invalid values
+                    qWarning() << "Failed to parse signal strength:" << signalStr;
+                }
+
+                networksWithSignal.append(qMakePair(signal, display));
+            }
+        }
+    }
+
+    if (networksWithSignal.isEmpty()) {
+        emit errorOccurred("No Wi-Fi networks found (may need to be closer to hotspots)");
+    } else {
+        // Sort by signal strength descending (strongest first)
+        std::sort(networksWithSignal.begin(), networksWithSignal.end(),
+                  [](const QPair<int, QString> &a, const QPair<int, QString> &b) {
+                      return a.first > b.first;
+                  });
+
+        m_networks.clear();
+        for (const auto &pair : networksWithSignal) {
+            m_networks << pair.second;
+        }
+
+        emit networksChanged();
+        qDebug() << "Parsed and sorted" << m_networks.size() << "networks with frequency info";
+    }
+
+    process->deleteLater();
+}
+
+void WifiManager::connectToNetwork(const QString &ssid, const QString &password)
+{
+    qDebug() << "Attempting to connect to SSID:" << ssid;
+
+    QProcess *process = new QProcess(this);
+    connect(process, QOverload<int, QProcess::ExitStatus>::of(&QProcess::finished),
+            this, &WifiManager::connectProcessFinished);
+
+    QString cmd;
+    if (password.isEmpty()) {
+        // Open network
+        cmd = QString(//"wpa_cli -i wlan0 add_network && "
+                      "wpa_cli -i wlan0 set_network 0 ssid \\\"%1\\\" && "
+                      "wpa_cli -i wlan0 set_network 0 key_mgmt NONE && "
+                      "wpa_cli -i wlan0 disable_network 0 || true && "
+                      "wpa_cli -i wlan0 enable_network 0 && "
+                      "wpa_cli -i wlan0 save_config && "
+                      "wpa_cli -i wlan0 reassociate").arg(ssid);
+    } else {
+        // WPA-PSK
+        cmd = QString(//"wpa_cli -i wlan0 add_network && "
+                      "wpa_cli -i wlan0 set_network 0 ssid \\\"%1\\\" && "
+                      "wpa_cli -i wlan0 set_network 0 psk \\\"%2\\\" && "
+                      "wpa_cli -i wlan0 set_network 0 key_mgmt WPA-PSK && "
+                      "wpa_cli -i wlan0 disable_network 0 || true && "
+                      "wpa_cli -i wlan0 enable_network 0 && "
+                      "wpa_cli -i wlan0 save_config && "
+                      "wpa_cli -i wlan0 reassociate").arg(ssid, password);
+    }
+
+    process->start("sh", QStringList() << "-c" << cmd);
+}
+
+void WifiManager::connectProcessFinished(int exitCode, QProcess::ExitStatus exitStatus)
+{
+    Q_UNUSED(exitStatus);
+
+    QProcess *process = qobject_cast<QProcess*>(sender());
+    if (!process) return;
+
+    QString output = process->readAllStandardOutput();
+    QString err = process->readAllStandardError();
+
+    qDebug() << "Connection command output:" << output << "Error:" << err;
+
+    if (output.contains("OK") && exitCode == 0) {
+        // Refresh current SSID after a short delay to allow connection to establish
+        QTimer::singleShot(5000, this, &WifiManager::refreshCurrentSSID);
+
+        emit connectionChanged();
+        // Clear any previous error
+        //emit errorOccurred("");
+    } else {
+        emit errorOccurred("Connection failed, please check password or signal");
+    }
+
+    process->deleteLater();
+}
+
+QString WifiManager::getConnectionDetails()
+{
+    QString details;
+
+    // 1. get wpa_cli status
+    QProcess wpaProcess;
+    wpaProcess.start("wpa_cli", QStringList() << "-i" << "wlan0" << "status");
+    wpaProcess.waitForFinished();
+    QString wpaOutput = wpaProcess.readAllStandardOutput().trimmed();
+
+    details += "=== WPA Status ===\n" + wpaOutput + "\n\n";
+
+    // 2. get IP address
+    QProcess ipProcess;
+    ipProcess.start("ip", QStringList() << "addr" << "show" << "wlan0");
+    ipProcess.waitForFinished();
+    QString ipOutput = ipProcess.readAllStandardOutput().trimmed();
+
+    details += "=== IP & Interface Info ===\n" + ipOutput + "\n\n";
+
+    // 3. get iw dev wlan0 link (more details)
+    QProcess iwProcess;
+    iwProcess.start("iw", QStringList() << "dev" << "wlan0" << "link");
+    iwProcess.waitForFinished();
+    QString iwOutput = iwProcess.readAllStandardOutput().trimmed();
+
+    details += "=== Link Info ===\n" + iwOutput;
+
+    return details;
+}
