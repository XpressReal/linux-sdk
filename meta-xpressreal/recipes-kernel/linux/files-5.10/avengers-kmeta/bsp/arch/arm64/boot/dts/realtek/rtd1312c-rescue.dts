/dts-v1/;

#include "rtd13xx-rescue.dtsi"

/ {
	model = "Realtek RTD1312C Rescue";
	compatible = "realtek,rescue", "realtek,rtd1312c";

	memory@40000 {
		device_type = "memory";
		reg = <0x00040000 0x3ffc0000>; /* 1 GiB */
	};

	chosen {
		bootargs = "earlycon=uart8250,mmio32,0x98007800 console=ttyS0,460800 init=/init NO_RESERVE";
	};
};

&emmc {
	compatible = "rtd1312c-dw-cqe-emmc";
};

&efuse {
	otp_usb_port0_dc_dis: usb-port0-dc-dis@4fe,0 {
		reg = <0x4fe 0x1>;
		bits = <0 4>;
	};
	otp_usb_port1_dc_dis: usb-port1-dc-dis@4fe,4 {
		reg = <0x4fe 0x1>;
		bits = <4 4>;
	};
	otp_usb_port2_dc_dis: usb-port2-dc-dis@4ff,0 {
		reg = <0x4ff 0x1>;
		bits = <0 4>;
	};
};

&usb_manager {
	status = "okay";

	gpio0: gpio0 {
		realtek,power-gpio = <&gpio 48 GPIO_ACTIVE_HIGH>;
		power_low_active;
	};

	gpio1: gpio1 {
		realtek,power-gpio = <&gpio 49 GPIO_ACTIVE_HIGH>;
		power_low_active;
	};

	port0 {
		usb = <&dwc3_u2drd>;
		usb_gpio = <&gpio0>;
	};

	port1 {
		usb = <&dwc3_u2host>;
		usb_gpio = <&gpio1>;
	};

	port2 {
		usb = <&dwc3_u3drd>;
		usb_gpio = <&gpio1>;
	};

	rtk_usb {
		type_c {
			realtek,connector_switch-gpio = <&gpio 30 GPIO_ACTIVE_HIGH>;
		};
	};
};

&dwc3_u2drd_usb2phy {
	compatible = "realtek,rtd1312c-usb2phy";
	nvmem-cells = <&otp_usb_port0_dc_cal>, <&otp_usb_port0_dc_dis>;
	nvmem-cell-names = "usb-dc-cal", "usb-dc-dis";
	status = "okay";
};

&dwc3_u2drd {
	status = "okay";

	boot_check_time = <30000>; /* ms (At boot Device switch Host time) */

	dwc3_u2drd@98020000 {
		dr_mode = "peripheral"; /*host, peripheral*/
		status = "okay";
	};
};

&dwc3_u2host_usb2phy {
	compatible = "realtek,rtd1312c-usb2phy";
	nvmem-cells = <&otp_usb_port1_dc_cal>, <&otp_usb_port1_dc_dis>;
	nvmem-cell-names = "usb-dc-cal", "usb-dc-dis";
	status = "okay";
};

&dwc3_u2host {
	status = "okay";
};

&dwc3_u3drd_usb2phy {
	compatible = "realtek,rtd1312c-usb2phy";
	nvmem-cells = <&otp_usb_port2_dc_cal>, <&otp_usb_port2_dc_dis>;
	nvmem-cell-names = "usb-dc-cal", "usb-dc-dis";
	status = "okay";
};

&dwc3_u3drd_usb3phy {
	status = "disable";
};

&dwc3_u3drd {
	status = "okay";

	dwc3_u3drd@981f0000 {
		dr_mode = "host"; /*host, peripheral*/
		usb-phy = <&dwc3_u3drd_usb2phy>;
		phys = <&dwc3_u3drd_usb2phy>;
		phy-names = "usb2-phy";
		status = "okay";
	};

};

&rtk_type_c {
	status = "okay";

	realtek,usb_port = <&dwc3_u2drd>;

	realtek,default_revision = <0xA00>;
	A00 {
		realtek,cc_dfp_mode = "dfp_3_0"; /*dfp_3_0, dfp_1_5, dfp_usb*/
		realtek,cc1_rp_4p7k_code = <0xE>;
		realtek,cc1_rp_36k_code = <0xC>;
		realtek,cc1_rp_12k_code = <0xC>;
		realtek,cc1_rd_code = <0xA>;
		realtek,cc1_ra_code = <0x3>;
		realtek,cc1_vref_ufp = /bits/ 8
			<0x7 0x7 0x4>; /*<1p23v,0p66v,0p2v>*/
		realtek,cc1_vref_dfp_usb = /bits/ 8
			<0x7 0x4 0x0>; /*<0_1p6v,0p2v,unused>*/
		realtek,cc1_vref_dfp_1_5 = /bits/ 8
			<0x7 0x4 0x4>; /*<1_1p6v,0p4v,0p2v>*/
		realtek,cc1_vref_dfp_3_0 = /bits/ 8
			<0xa 0x7 0x4>; /*<2p6v,0p8v,0p2v>*/
		realtek,cc2_rp_4p7k_code = <0xE>;
		realtek,cc2_rp_36k_code = <0xC>;
		realtek,cc2_rp_12k_code = <0xC>;
		realtek,cc2_rd_code = <0xA>;
		realtek,cc2_ra_code = <0x3>;
		realtek,cc2_vref_ufp = /bits/ 8
			<0x7 0x7 0x4>; /*<1p23v,0p66v,0p2v>*/
		realtek,cc2_vref_dfp_usb = /bits/ 8
			<0x7 0x4 0x0>; /*<0_1p6v,0p2v,unused>*/
		realtek,cc2_vref_dfp_1_5 = /bits/ 8
			<0x7 0x4 0x4>; /*<1_1p6v,0p4v,0p2v>*/
		realtek,cc2_vref_dfp_3_0 = /bits/ 8
			<0xa 0x7 0x4>; /*<2p6v,0p8v,0p2v>*/
	};
};

/delete-node/ &nic;
/delete-node/ &sd;
/delete-node/ &pcie_trans;
/delete-node/ &pcie;
/delete-node/ &pcie1;
/delete-node/ &pcie2;
/delete-node/ &pcie0_phy;
/delete-node/ &pcie1_phy;
/delete-node/ &pcie2_phy;
