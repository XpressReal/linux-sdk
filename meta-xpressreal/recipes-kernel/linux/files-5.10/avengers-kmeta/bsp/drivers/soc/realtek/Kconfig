menu "Realtek SoC drivers"

config RTK_RESERVE_MEMORY
	bool "RTK Reserve Memory for Video/Image Codec"
	default n

config RTK_PUWRAP
	tristate
	select RTK_RESERVE_MEMORY

config RTK_IMAGE_CODEC
	tristate "RTK Image Codec"
	select RTK_PUWRAP
	default y

menuconfig RTD13XX_RTK_CODEC
	tristate "Realtek RTD13XX Codec"
	select RTK_RESERVE_MEMORY
	default n
	help
	  Realtek RTD13XX codec support.

	  If unsure, say N.

config RTD13XX_VE1_CODEC
	tristate "RTK Video Engine 1 Codec"
	depends on RTD13XX_RTK_CODEC
	select RTK_PUWRAP
	default n

menuconfig RTD13XXD_RTK_CODEC
	tristate "Realtek RTD13XXD Codec"
	select RTK_RESERVE_MEMORY
	default n
	help
	  Realtek RTD13XXD codec support.

	  If unsure, say N.

config RTD13XXD_VE1_CODEC
	tristate "RTK Video Engine 1 Codec"
	depends on RTD13XXD_RTK_CODEC
	select RTK_PUWRAP
	default n

menuconfig RTD13XXE_RTK_CODEC
        tristate "Realtek RTD13XXE Codec"
        select RTK_RESERVE_MEMORY
        default n
        help
          Realtek RTD13XXE codec support.

          If unsure, say N.

config RTD13XXE_VE1_CODEC
        tristate "RTK Video Engine 1 Codec"
        depends on RTD13XXE_RTK_CODEC
        select RTK_PUWRAP
        default n

menuconfig RTD16XXB_RTK_CODEC
	tristate "Realtek RTD16XXB Codec"
	select RTK_RESERVE_MEMORY
	default n
	help
	  Realtek RTD16XXB codec support.

	  If unsure, say N.

config RTD16XXB_VE1_CODEC
	tristate "RTK Video Engine 1 Codec"
	depends on RTD16XXB_RTK_CODEC
	select RTK_PUWRAP
	default n

config REALTEK_SOC
	bool
	depends on ARCH_REALTEK
	default y
	help
	  Realtek SoC drivers.

	  If unsure, say N.

menuconfig RTK_CODEC
	tristate "Realtek Codec"
	default n
	help
	  Realtek codec support.

	  If unsure, say N.

config RTK_VE1
	tristate "RTK Video Engine 1 Codec"
	depends on RTK_CODEC
	default n

config RTK_VE1_V4L2_BEHAVIOR
	bool "RTK VE1 V4L2 stateful behavior"
	depends on RTK_VE1
	default n
	help
	  Enable V4L2 stateful decoder behavior for RTK Video Engine 1.

source "drivers/soc/realtek/common/Kconfig"
source "drivers/soc/realtek/cpudvfs/Kconfig"
source "drivers/soc/realtek/cpuhp/Kconfig"
source "drivers/soc/realtek/gpu/Kconfig"
source "drivers/soc/realtek/tee_mem/Kconfig"
source "drivers/soc/realtek/runtime_device/Kconfig"

endmenu
