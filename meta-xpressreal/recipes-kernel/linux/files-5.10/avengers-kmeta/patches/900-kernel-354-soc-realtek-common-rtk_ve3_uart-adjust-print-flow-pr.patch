From d36c66421443eac8bcd23f7a31bd3bdd69a2b307 Mon Sep 17 00:00:00 2001
From: TY Chang <tychang@realtek.com>
Date: Fri, 19 Aug 2022 19:25:36 +0800
Subject: [PATCH] soc: realtek: common/rtk_ve3_uart: adjust print flow & print
 loglevel

Change-Id: Ie8df59c03811842b24d262452557b233ef93adcf
---
 drivers/soc/realtek/common/rtk_ve3_uart.c | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/drivers/soc/realtek/common/rtk_ve3_uart.c b/drivers/soc/realtek/common/rtk_ve3_uart.c
index 30ae84573ca2..c1b737292936 100644
--- a/drivers/soc/realtek/common/rtk_ve3_uart.c
+++ b/drivers/soc/realtek/common/rtk_ve3_uart.c
@@ -50,11 +50,15 @@ static int ve3_uart_thread(void * p)
 		while (ve3_uart_enable) {
 			status = readl(hevc_reg + UFIFO_STATUS);
 			cnt = (status >> 16) & 0x1f;
+			if (cnt == 0) {
+				msleep(10);
+				continue;
+			}
 			while (cnt > 0) {
 				tx_char = readl(hevc_reg + UFIFO_RD);
 				if (tx_char == '\n' || tx_num == 1023) {
 					uart_tx[tx_num] = tx_char;
-					pr_err("[VE3 LOG] %s \n", uart_tx);
+					pr_info("[VE3 LOG] %s \n", uart_tx);
 					memset(uart_tx, 0, 1024);
 					tx_num = 0;
 				} else {
@@ -63,7 +67,6 @@ static int ve3_uart_thread(void * p)
 				}
 				cnt--;
 			}
-			msleep(10);
 		}
 	}
 	return 0;
-- 
2.17.1

