From f0dfd7c41ba7c9ed2c1168e1aac56fc8059dd347 Mon Sep 17 00:00:00 2001
From: TY Chang <tychang@realtek.com>
Date: Wed, 28 May 2025 10:23:09 +0800
Subject: [PATCH 15/18] remoteproc: realtek: Add remoteproc driver support

Change-Id: I53c9758df85dfa4a2f633163c8cea21e6b5e3c74
---
 drivers/remoteproc/Kconfig             |    6 +
 drivers/remoteproc/Makefile            |    1 +
 drivers/remoteproc/rtk_fw_remoteproc.c | 1711 ++++++++++++++++++++++++
 3 files changed, 1718 insertions(+)
 create mode 100644 drivers/remoteproc/rtk_fw_remoteproc.c

diff --git a/drivers/remoteproc/Kconfig b/drivers/remoteproc/Kconfig
index d99548fb5ddef..1639b21fd4f1c 100644
--- a/drivers/remoteproc/Kconfig
+++ b/drivers/remoteproc/Kconfig
@@ -234,6 +234,12 @@ config QCOM_WCNSS_PIL
 	  Say y here to support the Peripheral Image Loader for the Qualcomm
 	  Wireless Connectivity Subsystem.
 
+config RTK_FW_REMOTEPROC
+	tristate "Realtek DHC remoteproc support"
+	depends on ARCH_REALTEK
+	help
+	  Say y here to support remote processors on Realtek DHC SoCs.
+
 config ST_REMOTEPROC
 	tristate "ST remoteproc support"
 	depends on ARCH_STI
diff --git a/drivers/remoteproc/Makefile b/drivers/remoteproc/Makefile
index da2ace4ec86cb..bc3c056dde8f2 100644
--- a/drivers/remoteproc/Makefile
+++ b/drivers/remoteproc/Makefile
@@ -34,3 +34,4 @@ obj-$(CONFIG_ST_SLIM_REMOTEPROC)	+= st_slim_rproc.o
 obj-$(CONFIG_STM32_RPROC)		+= stm32_rproc.o
 obj-$(CONFIG_TI_K3_DSP_REMOTEPROC)	+= ti_k3_dsp_remoteproc.o
 obj-$(CONFIG_TI_K3_R5_REMOTEPROC)	+= ti_k3_r5_remoteproc.o
+obj-$(CONFIG_RTK_FW_REMOTEPROC)	+= rtk_fw_remoteproc.o
-- 
2.47.0

