From 1f9b1c115f257bf778ad14aa3ff7a6b32bd0e14e Mon Sep 17 00:00:00 2001
From: Stanley Chang <stanley_chang@realtek.com>
Date: Thu, 21 Dec 2023 19:41:58 +0800
Subject: [PATCH] [FEATURE] arm64: dts: realtek: stark: move the properties of
 switch gpio to type c node

Change-Id: I776cf74645b8aa84d078c8331d158f3f9409b067
Signed-off-by: Stanley Chang <stanley_chang@realtek.com>
---
 arch/arm64/boot/dts/realtek/rtd1315c-arcreactor.dtsi |  3 +--
 arch/arm64/boot/dts/realtek/rtd1315c-morgan.dtsi     | 12 ++----------
 arch/arm64/boot/dts/realtek/rtd1315c-repulsor.dtsi   |  3 +--
 .../arm64/boot/dts/realtek/rtd1619b-backinblack.dtsi |  7 ++-----
 .../boot/dts/realtek/rtd1619b-bleedingedge.dtsi      |  7 +------
 arch/arm64/boot/dts/realtek/rtd16xxb-rescue.dtsi     |  7 +------
 arch/arm64/boot/dts/realtek/rtd16xxb-usb.dtsi        | 11 +++++------
 7 files changed, 13 insertions(+), 37 deletions(-)

diff --git a/arch/arm64/boot/dts/realtek/rtd1315c-arcreactor.dtsi b/arch/arm64/boot/dts/realtek/rtd1315c-arcreactor.dtsi
index 06b80b81fc677..9a44d233e6858 100644
--- a/arch/arm64/boot/dts/realtek/rtd1315c-arcreactor.dtsi
+++ b/arch/arm64/boot/dts/realtek/rtd1315c-arcreactor.dtsi
@@ -447,9 +447,8 @@ dwc3@50000 {
 };
 
 &type_c {
-	status = "disabled";
-
 	realtek,usb-port = <&usb_port0>;
+	status = "disabled";
 };
 
 /* debug console (J1) */
diff --git a/arch/arm64/boot/dts/realtek/rtd1315c-morgan.dtsi b/arch/arm64/boot/dts/realtek/rtd1315c-morgan.dtsi
index 2fa5dc3c3db3c..2e3a01934a374 100644
--- a/arch/arm64/boot/dts/realtek/rtd1315c-morgan.dtsi
+++ b/arch/arm64/boot/dts/realtek/rtd1315c-morgan.dtsi
@@ -445,9 +445,9 @@ dwc3@50000 {
 };
 
 &type_c {
-	status = "okay";
-
 	realtek,usb-port = <&usb_port2>;
+	realtek,connector-switch-gpio = <&gpio 49 GPIO_ACTIVE_HIGH>;
+	status = "disabled";
 };
 
 /* debug console (J1) */
@@ -466,14 +466,6 @@ &uart2 {
 
 &usb_manager {
 	status = "okay";
-	realetk,auto-switch-role-time = <30>; /* second */
-
-	rtk_usb {
-		type_c {
-			realtek,connector_switch-gpio = <&gpio 49 GPIO_ACTIVE_HIGH>;
-		};
-	};
-
 };
 
 &vcpu {
diff --git a/arch/arm64/boot/dts/realtek/rtd1315c-repulsor.dtsi b/arch/arm64/boot/dts/realtek/rtd1315c-repulsor.dtsi
index 2805bed43d1e4..ad14cb88a264d 100644
--- a/arch/arm64/boot/dts/realtek/rtd1315c-repulsor.dtsi
+++ b/arch/arm64/boot/dts/realtek/rtd1315c-repulsor.dtsi
@@ -415,9 +415,8 @@ dwc3@50000 {
 };
 
 &type_c {
-	status = "okay";
-
 	realtek,usb-port = <&usb_port2>;
+	status = "disabled";
 };
 
 /* debug console (J1) */
diff --git a/arch/arm64/boot/dts/realtek/rtd1619b-backinblack.dtsi b/arch/arm64/boot/dts/realtek/rtd1619b-backinblack.dtsi
index 9fa353d5fb9f0..7e2ec52a1516d 100644
--- a/arch/arm64/boot/dts/realtek/rtd1619b-backinblack.dtsi
+++ b/arch/arm64/boot/dts/realtek/rtd1619b-backinblack.dtsi
@@ -405,6 +405,7 @@ &usb_port0_usb2phy {
 };
 
 &usb_port0 {
+	realtek,power-gpio = <&gpio 48 GPIO_ACTIVE_LOW>;
 	status = "okay";
 };
 
@@ -413,6 +414,7 @@ &usb_port1_usb2phy {
 };
 
 &usb_port1 {
+	realtek,power-gpio = <&gpio 48 GPIO_ACTIVE_LOW>;
 	status = "okay";
 };
 
@@ -444,11 +446,6 @@ &uart2 {
 
 &usb_manager {
 	status = "okay";
-
-	gpio0 {
-		realtek,power-gpio = <&gpio 48 GPIO_ACTIVE_HIGH>;
-		power_low_active;
-	};
 };
 
 &vcpu {
diff --git a/arch/arm64/boot/dts/realtek/rtd1619b-bleedingedge.dtsi b/arch/arm64/boot/dts/realtek/rtd1619b-bleedingedge.dtsi
index f986f82a1f5af..574afd1c1575e 100644
--- a/arch/arm64/boot/dts/realtek/rtd1619b-bleedingedge.dtsi
+++ b/arch/arm64/boot/dts/realtek/rtd1619b-bleedingedge.dtsi
@@ -541,6 +541,7 @@ &usb_port2 {
 };
 
 &type_c {
+	realtek,plug-side-switch-gpio = <&gpio 53 GPIO_ACTIVE_HIGH>;
 	status = "okay";
 };
 
@@ -560,12 +561,6 @@ &uart2 {
 
 &usb_manager {
 	status = "okay";
-
-	rtk_usb {
-		type_c {
-			realtek,plug_side_switch-gpio = <&gpio 53 GPIO_ACTIVE_HIGH>;
-		};
-	};
 };
 
 &vcpu {
diff --git a/arch/arm64/boot/dts/realtek/rtd16xxb-rescue.dtsi b/arch/arm64/boot/dts/realtek/rtd16xxb-rescue.dtsi
index 58afc2d831467..aaf3996243b5d 100644
--- a/arch/arm64/boot/dts/realtek/rtd16xxb-rescue.dtsi
+++ b/arch/arm64/boot/dts/realtek/rtd16xxb-rescue.dtsi
@@ -36,12 +36,6 @@ &gpio {
 
 &usb_manager {
 	status = "okay";
-
-	rtk_usb {
-		type_c {
-			realtek,plug_side_switch-gpio = <&gpio 53 GPIO_ACTIVE_HIGH>;
-		};
-	};
 };
 
 &usb_port0_usb2phy {
@@ -76,6 +70,7 @@ &usb_port2 {
 };
 
 &type_c {
+	realtek,plug-side-switch-gpio = <&gpio 53 GPIO_ACTIVE_HIGH>;
 	status = "okay";
 };
 
diff --git a/arch/arm64/boot/dts/realtek/rtd16xxb-usb.dtsi b/arch/arm64/boot/dts/realtek/rtd16xxb-usb.dtsi
index 0b662c4eaa2fe..929a02a7d612b 100644
--- a/arch/arm64/boot/dts/realtek/rtd16xxb-usb.dtsi
+++ b/arch/arm64/boot/dts/realtek/rtd16xxb-usb.dtsi
@@ -20,12 +20,6 @@ &usb_manager {
 	rtk_usb {
 		TP1CK_MEM_TEST1_register = <0x9804ef14>;
 
-		type_c {
-			/* For 1315C, u3drd */
-			//realtek,connector_switch-gpio = <&gpio 49 GPIO_ACTIVE_HIGH>;
-			/* For 1619B, u3drd */
-			//realtek,plug_side_switch-gpio = <&gpio 53 GPIO_ACTIVE_HIGH>;
-		};
 	};
 };
 
@@ -196,6 +190,11 @@ type_c: type-c@7220 {
 		resets = <&ic RTD1619B_ISO_RSTN_TYPE_C>; /* rstn_type_c */
 		reset-names = "type-c"; /* rstn_type_c */
 
+		/* For 1315C, u3drd */
+		//realtek,connector-switch-gpio = <&gpio 49 GPIO_ACTIVE_HIGH>;
+		/* For 1619B, u3drd */
+		//realtek,plug-side-switch-gpio = <&gpio 53 GPIO_ACTIVE_HIGH>;
+
 		status = "disabled";
 
 		connector {
-- 
