-	};
-
-	port0 {
-		usb = <&usb_port0>;
-		usb_gpio = <&gpio0>;
-	};
-
-	port1 {
-		usb = <&usb_port1>;
-		usb_gpio = <&gpio0>;
-	};
-
-	port2 {
-		usb = <&usb_port2>;
-		usb_gpio = <&gpio1>;
-	};
-
 	rtk_usb {
 		TP1CK_MEM_TEST1_register = <0x9804ef14>;
 
