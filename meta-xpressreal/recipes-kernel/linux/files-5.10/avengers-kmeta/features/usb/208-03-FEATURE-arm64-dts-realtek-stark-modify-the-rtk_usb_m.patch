@@ -415,6 +415,7 @@ &usb_port0_usb2phy {
 };
 
 &usb_port0 {
+	realtek,power-gpio = <&gpio 48 GPIO_ACTIVE_LOW>;
 	status = "okay";
 };
 
@@ -467,15 +468,6 @@ &uart2 {
 
 &usb_manager {
 	status = "okay";
-
-	gpio0 {
-		realtek,power-gpio = <&gpio 48 GPIO_ACTIVE_HIGH>;
-		power_low_active;
-	};
-	port2 {
-		disable_usb3;
-	};
-
 };
 
 &vcpu {
