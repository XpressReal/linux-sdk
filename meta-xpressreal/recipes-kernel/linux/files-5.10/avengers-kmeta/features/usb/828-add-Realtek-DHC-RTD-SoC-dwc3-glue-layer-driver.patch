From f52fa355d7f5bbe2eb9204f6eaeb7191506e504e Mon Sep 17 00:00:00 2001
From: James Tai <james.tai@realtek.com>
Date: Tue, 21 Jul 2020 23:37:38 +0800
Subject: [PATCH] usb: dwc3: Add Realtek specific glue layer [REVIEWER] Stanley
 Chang

Change-Id: I9094141314b5c62ea1752020fd00bbfe9005b9f4
Signed-off-by: James Tai <james.tai@realtek.com>
Signed-off-by: Stanley Chang <stanley_chang@realtek.com>
---
 drivers/usb/dwc3/Kconfig            |   15 +
 drivers/usb/dwc3/Makefile           |    3 +

diff --git a/drivers/usb/dwc3/Kconfig b/drivers/usb/dwc3/Kconfig
index 7a2304565a73..d8553cc18304 100644
--- a/drivers/usb/dwc3/Kconfig
+++ b/drivers/usb/dwc3/Kconfig
@@ -53,6 +53,21 @@ endchoice
 
 comment "Platform Glue Driver Support"
 
+config USB_DWC3_RTK
+	tristate "Realtek DWC3 Platform Driver"
+	default USB_DWC3
+	help
+	  RTK SoCs with DesignWare Core USB3 IP inside,
+	  say 'Y' or 'M' if you have such device.
+
+config USB_DWC3_RTK_DUAL_ROLE
+	bool "Realtek DWC3 Platform Dual Role Driver"
+	depends on USB_DWC3_DUAL_ROLE
+	help
+	  RTK SoCs with DesignWare Core USB3 IP to suport drd mode,
+	  Support Realtek dwc3 drd mode to dynamical host/device switch.
+	  say 'Y' if you have such device.
+
 config USB_DWC3_OMAP
 	tristate "Texas Instruments OMAP5 and similar Platforms"
 	depends on ARCH_OMAP2PLUS || COMPILE_TEST
diff --git a/drivers/usb/dwc3/Makefile b/drivers/usb/dwc3/Makefile
index ae86da0dc5bd..f2f73f078f1e 100644
--- a/drivers/usb/dwc3/Makefile
+++ b/drivers/usb/dwc3/Makefile
@@ -51,3 +51,6 @@ obj-$(CONFIG_USB_DWC3_MESON_G12A)	+= dwc3-meson-g12a.o
 obj-$(CONFIG_USB_DWC3_OF_SIMPLE)	+= dwc3-of-simple.o
 obj-$(CONFIG_USB_DWC3_ST)		+= dwc3-st.o
 obj-$(CONFIG_USB_DWC3_QCOM)		+= dwc3-qcom.o
+obj-$(CONFIG_USB_DWC3_RTK)		+= dwc3-rtk.o
+obj-$(CONFIG_USB_DWC3_RTK)		+= dwc3-rtk-debugfs.o
+obj-$(CONFIG_USB_DWC3_RTK_DUAL_ROLE)	+= dwc3-rtk-drd.o
\ No newline at end of file
-- 
2.47.0

