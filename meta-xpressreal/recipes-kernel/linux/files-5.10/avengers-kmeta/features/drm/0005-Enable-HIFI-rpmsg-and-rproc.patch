From d7368a665b827eb55fea67a14df633345e5ced42 Mon Sep 17 00:00:00 2001
From: "joshua.yang" <joshua.yang@realtek.com>
Date: Thu, 30 Apr 2026 20:50:14 +0800
Subject: [PATCH 1/1] Enable HIFI rpmsg and rproc

---
 arch/arm64/boot/dts/realtek/rtd1501s-phantom-8gb.dts | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/arch/arm64/boot/dts/realtek/rtd1501s-phantom-8gb.dts b/arch/arm64/boot/dts/realtek/rtd1501s-phantom-8gb.dts
index 7b47747b0154..2f8b6f172133 100644
--- a/arch/arm64/boot/dts/realtek/rtd1501s-phantom-8gb.dts
+++ b/arch/arm64/boot/dts/realtek/rtd1501s-phantom-8gb.dts
@@ -52,15 +52,17 @@ &dlsr_rproc {
 };
 
 &hifi_rproc {
-	is-booted;
-	need-ext-fw;
-	status = "disabled";
+	status = "okay";
 };
 
 &kr4_rproc {
 	status = "disabled";
 };
 
+&hifi_rpmsg {
+	status = "okay";
+};
+
 &kr4_rpmsg {
 	status = "disabled";
 };
