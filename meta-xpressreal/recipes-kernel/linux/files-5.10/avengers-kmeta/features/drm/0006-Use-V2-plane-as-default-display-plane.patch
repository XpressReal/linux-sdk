From dafc4959f35e452427784c71d2511e6b555147fd Mon Sep 17 00:00:00 2001
From: "joshua.yang" <joshua.yang@realtek.com>
Date: Thu, 7 May 2026 09:49:06 +0800
Subject: [PATCH 1/1] Use V2 plane as default display plane

---
 drivers/gpu/drm/realtek/Kconfig        | 4 ++++
 drivers/gpu/drm/realtek/rtk_drm_crtc.c | 4 +++-
 2 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/realtek/Kconfig b/drivers/gpu/drm/realtek/Kconfig
index 24303863207c..377ce17c7ad9 100644
--- a/drivers/gpu/drm/realtek/Kconfig
+++ b/drivers/gpu/drm/realtek/Kconfig
@@ -27,4 +27,8 @@ config RTK_DRM_CACHEABLE_HEADER
         bool "Realtek DRM Cacheable Header"
         default n
 
+config YOCTO_PLATFORMS
+        bool "Realtek Yocto platform heap alloc"
+        default n
+
 endif
diff --git a/drivers/gpu/drm/realtek/rtk_drm_crtc.c b/drivers/gpu/drm/realtek/rtk_drm_crtc.c
index 96c61ea82288..b473dbfb6e73 100644
--- a/drivers/gpu/drm/realtek/rtk_drm_crtc.c
+++ b/drivers/gpu/drm/realtek/rtk_drm_crtc.c
@@ -628,8 +628,10 @@ static const struct crtc_plane_data rtd_crtc_plane_all[] = {
 	  .type = DRM_PLANE_TYPE_PRIMARY },
 	{ .layer_nr = VO_VIDEO_PLANE_SUB1,
 	  .type = DRM_PLANE_TYPE_CURSOR },
+#ifndef CONFIG_YOCTO_PLATFORMS
 	{ .layer_nr = VO_VIDEO_PLANE_V1,
-	  .type = DRM_PLANE_TYPE_OVERLAY },
+	 .type = DRM_PLANE_TYPE_OVERLAY },
+#endif
 	{ .layer_nr = VO_VIDEO_PLANE_V2,
 	  .type = DRM_PLANE_TYPE_OVERLAY },
 };
-- 
2.34.1

