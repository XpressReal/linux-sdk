+static void rtk_dsi_config_param(struct rtk_dsi *dsi, int panel, struct hvsync_param *param)
+{
+	struct interface_info *if_info;
+	struct videomode *videomode;
+
+	if_info   = &dsi->if_info;
+	videomode = &if_info->videomode;
+
+	if (panel == DSI_PANEL_SEL_VGA) {
+		DRM_DEBUG_DRIVER("panel %d no need param\n", panel);
+	} else if (panel == DSI_PANEL_SEL_AUO ||
+			   panel == DSI_PANEL_SEL_TECHWIN ||
+			   panel == DSI_PANEL_SEL_TECHWIN_SINGLE) {
+
+		DRM_DEBUG_DRIVER("rtk_dsi_config_param :\n");
+		DRM_DEBUG_DRIVER("pixelclock   = %lu\n", videomode->pixelclock);
+		DRM_DEBUG_DRIVER("hactive      = %d\n", videomode->hactive);
+		DRM_DEBUG_DRIVER("hfront_porch = %d\n", videomode->hfront_porch);
+		DRM_DEBUG_DRIVER("hback_porch  = %d\n", videomode->hback_porch);
+		DRM_DEBUG_DRIVER("hsync_len    = %d\n", videomode->hsync_len);
+		DRM_DEBUG_DRIVER("vactive      = %d\n", videomode->vactive);
+		DRM_DEBUG_DRIVER("vfront_porch = %d\n", videomode->vfront_porch);
+		DRM_DEBUG_DRIVER("vback_porch  = %d\n", videomode->vback_porch);
+		DRM_DEBUG_DRIVER("vsync_len    = %d\n", videomode->vsync_len);
+
+		param->h_valid    = videomode->hactive;
+		param->hs_width   = videomode->hsync_len;
+		param->hs_bp      = videomode->hback_porch;
+		param->hs_fp      = videomode->hfront_porch;
+		param->v_valid    = videomode->vactive;
+		param->vs_width   = videomode->vsync_len;
+		param->vs_bp      = videomode->vback_porch;
+		param->vs_fp      = videomode->vfront_porch;
+		param->frame_rate = if_info->frame_rate;
+
+		DRM_DEBUG_DRIVER("panel %d config param done\n", panel);
+	} else {
+		DRM_DEBUG_DRIVER("panel %d need to config param\n", panel);
+	}
+}
