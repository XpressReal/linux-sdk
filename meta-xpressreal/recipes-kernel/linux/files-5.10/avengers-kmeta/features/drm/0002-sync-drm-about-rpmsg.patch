+
+static int rtk_dsi_conn_get_modes(struct drm_connector *connector)
+{
+	struct rtk_dsi *dsi = to_rtk_dsi(connector);
+	struct drm_display_mode *mode;
+	struct interface_info *if_info;
+
+	DRM_INFO("[rtk_dsi_conn_get_modes]\n");
+
+	if_info = &dsi->if_info;
+
+	if_info->display_interface = DISPLAY_INTERFACE_MIPI;
+
+	dsi->dsi_data->get_modes(dsi, if_info);
+
+	if (if_info->panel_rotated) {
+		mode = drm_mode_duplicate(connector->dev, &rotate_modes[if_info->timing_id]);
+	} else {
+		mode = drm_mode_duplicate(connector->dev, &if_info->disp_mode);
+		drm_mode_set_name(mode);
+	}
+
+	if (!mode) {
+		DRM_ERROR("bad mode or failed to add mode\n");
+		return -EINVAL;
+	}
+
+	mode->type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED;
+
+	connector->display_info.width_mm = if_info->disp_mode.width_mm;
+	connector->display_info.height_mm = if_info->disp_mode.height_mm;
+
+	drm_mode_probed_add(connector, mode);
+
+	return 1;
+}
+
+static enum drm_mode_status rtk_dsi_conn_mode_valid(
+	struct drm_connector *connector, struct drm_display_mode *mode)
+{
+	DRM_DEBUG_KMS("%s\n", __func__);
+
+	return MODE_OK;
+}
