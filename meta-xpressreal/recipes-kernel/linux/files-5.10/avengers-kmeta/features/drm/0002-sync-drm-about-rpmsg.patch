+static void dsi_command_GM8775C(struct rtk_dsi *dsi, int panel, struct hvsync_param *param)
+{
+	// printk(KERN_ALERT"[fn_name]:[\x1b[33m%s\033[0m], [line]: \x1b[33m%d\033[0m\n", __func__, __LINE__);
+	//GM8775C setting use MIPI TX LP command
+	regmap_write(dsi->reg, TO1, 0x0000ffff); //LPTX timer
+	regmap_write(dsi->reg, TO2, 0x0000ffff); //LPRX timer
+
+	regmap_write(dsi->reg, CTRL_REG, 0x07010000); //disable HS mode, enable TX crc
+
+	//Generic_Short_Write_2P(0x27,0xAA)
+	regmap_write(dsi->reg, CMD0, 0x00AA2723); //Packet content
+	_go_and_wait(dsi);
+
+	//Generic_Short_Write_2P(0x48,0x02)
+	regmap_write(dsi->reg, CMD0, 0x00024823); //Packet content
+	_go_and_wait(dsi);
+
+	//Generic_Short_Write_2P(0xB6,0x20)
+	regmap_write(dsi->reg, CMD0, 0x0020B623); //Packet content
+	_go_and_wait(dsi);
+
+	// printk(KERN_ALERT"h_valid %llx => %d\n",0x00000123 | getLowByte(param->h_valid), param->h_valid);
+	//Generic_Short_Write_2P(0x01,0x80)
+	regmap_write(dsi->reg, CMD0, 0x00000123 | getLowByte(param->h_valid)); //Packet content
+	_go_and_wait(dsi);
+
+	// printk(KERN_ALERT"v_valid => %llx => %d\n",0x00000223 | getLowByte(param->v_valid), param->v_valid);
+	//Generic_Short_Write_2P(0x02,0xD0)
+	regmap_write(dsi->reg, CMD0, 0x00000223 | getLowByte(param->v_valid)); //Packet content
+	_go_and_wait(dsi);
+
+	// printk(KERN_ALERT"h_valid / v_valid high => %llx \n",0x00000323 | get2HighNiBBle(param->h_valid, param->v_valid));
+	//Generic_Short_Write_2P(0x03,0x27)
+	regmap_write(dsi->reg, CMD0, 0x00000323 | get2HighNiBBle(param->h_valid, param->v_valid)); //Packet content
+	_go_and_wait(dsi);
+
+	// printk(KERN_ALERT"hs_fp => %llx => %d\n",0x00000423 | getLowByte(param->hs_fp), param->hs_fp);
+	//Generic_Short_Write_2P(0x04,0x1c)
+	regmap_write(dsi->reg, CMD0, 0x00000423 | getLowByte(param->hs_fp)); //Packet content
+	_go_and_wait(dsi);
+
+	// printk(KERN_ALERT"hs_width => %llx => %d\n",0x00000523 | getLowByte(param->hs_width), param->hs_width);
+	//Generic_Short_Write_2P(0x05,0x14)
+	regmap_write(dsi->reg, CMD0, 0x00000523 | getLowByte(param->hs_width)); //Packet content
+	_go_and_wait(dsi);
+
+	// printk(KERN_ALERT"hs_bp => %llx => %d\n",0x00000623 | getLowByte(param->hs_bp), param->hs_bp);
+	//Generic_Short_Write_2P(0x06,0x18)
+	regmap_write(dsi->reg, CMD0, 0x00000623 | getLowByte(param->hs_bp)); //Packet content
+	_go_and_wait(dsi);
+
+	//Generic_Short_Write_2P(0x07,0x00)
+	regmap_write(dsi->reg, CMD0, 0x00000723); //Packet content
+	_go_and_wait(dsi);
+
+	regmap_write(dsi->reg, TC0, (long long)(param->hs_width<<16)|(param->h_valid)*3); //set HSA/HACT 1920*3(RGB888*3, RGB565*2, RGB666*2.25, RGB666loosely*3)
+	regmap_write(dsi->reg, TC1, (long long)(param->hs_bp<<16)|(param->hs_fp)); //set HBP/HFP
+	regmap_write(dsi->reg, TC2, (long long)(param->vs_width<<16)|(param->v_valid)); //set VSA/VACT 720
+	regmap_write(dsi->reg, TC3, (long long)(param->vs_bp<<16)|(param->vs_fp)); //set VBP/VFP
+
+	// printk(KERN_ALERT"vs_fp => %llx => %d\n",0x00000823 | getLowByte(param->vs_fp), param->vs_fp);
+	//Generic_Short_Write_2P(0x08,0x08)
+	regmap_write(dsi->reg, CMD0, 0x00000823 | getLowByte(param->vs_fp)); //Packet content
+	_go_and_wait(dsi);
+
+	// printk(KERN_ALERT"vs_width => %llx => %d\n",0x00000923 | getLowByte(param->vs_width), param->vs_width);
+	//Generic_Short_Write_2P(0x09,0x0A)
+	regmap_write(dsi->reg, CMD0, 0x00000923 | getLowByte(param->vs_width)); //Packet content
+	_go_and_wait(dsi);
+
+	// printk(KERN_ALERT"vs_bp => %llx => %d\n",0x00000A23 | getLowByte(param->vs_bp), param->vs_bp);
+	//Generic_Short_Write_2P(0x0A,0x08)
+	regmap_write(dsi->reg, CMD0, 0x00000A23 | getLowByte(param->vs_bp)); //Packet content
+	_go_and_wait(dsi);
+
+	if (panel ==1 || panel==3) { // TechWin
+		//ref 26M crystal
+		//Generic_Short_Write_2P(0x0B,0x02)
+		regmap_write(dsi->reg, CMD0, 0x00020B23); //Packet content
+		_go_and_wait(dsi);
+
+		//Generic_Short_Write_2P(0x0C,0x1a)//LVDS CLK 22.5MHz,30P
+		regmap_write(dsi->reg, CMD0, 0x001a0C23); //Packet content
+		_go_and_wait(dsi);
+
+	} else { //AUO
+
+		if(PANEL_CLOCK_SRC==CLOCK_SRC_MIPI) {
+			//from MIPI
+			//Generic_Short_Write_2P(0x0B,0x82)
+			regmap_write(dsi->reg, CMD0, 0x00820B23); //Packet content
+			_go_and_wait(dsi);
+
+			//Generic_Short_Write_2P(0x0C,0x07)
+			regmap_write(dsi->reg, CMD0, 0x00070C23); //Packet content
+			_go_and_wait(dsi);
+
+		} else {
+			//ref 26M crystal
+			//Generic_Short_Write_2P(0x0B,0x02)
+			regmap_write(dsi->reg, CMD0, 0x00020B23); //Packet content
+			_go_and_wait(dsi);
+
+			if(param->frame_rate==30){
+				//Generic_Short_Write_2P(0x0C,0x1B)//LVDS CLK 23MHz,30P
+				regmap_write(dsi->reg, CMD0, 0x001B0C23); //Packet content
+				_go_and_wait(dsi);
+			} else {
+				//Generic_Short_Write_2P(0x0C,0x33) //LVDS CLK 45MHz,60P
+				regmap_write(dsi->reg, CMD0, 0x00330C23); //Packet content
+				_go_and_wait(dsi);
+			}
+		}
+	}
+
+
+	//Generic_Short_Write_2P(0x0D,0x01)
+	regmap_write(dsi->reg, CMD0, 0x00010D23); //Packet content
+	_go_and_wait(dsi);
+
+	//Generic_Short_Write_2P(0x0E,0x80)
+	regmap_write(dsi->reg, CMD0, 0x00800E23); //Packet content
+	_go_and_wait(dsi);
+
+
+	//Generic_Short_Write_2P(0x0F,0x20)
+	regmap_write(dsi->reg, CMD0, 0x00200F23); //Packet content
+	_go_and_wait(dsi);
+
+	//Generic_Short_Write_2P(0x10,0x20)
+	regmap_write(dsi->reg, CMD0, 0x00201023); //Packet content
+	_go_and_wait(dsi);
+
+	//Generic_Short_Write_2P(0x11,0x03)//MIPI 4lane
+	regmap_write(dsi->reg, CMD0, 0x00031123); //Packet content
+	_go_and_wait(dsi);
+
+	//Generic_Short_Write_2P(0x12,0x1B)
+	regmap_write(dsi->reg, CMD0, 0x001B1223); //Packet content
+	_go_and_wait(dsi);
+
+	if(panel==3){ //Techwim single
+		//Generic_Short_Write_2P(0x13,0x5F)//JEIDA
+		// printk(KERN_ALERT"LVDS JEIDA =>5F\n");
+		regmap_write(dsi->reg, CMD0, 0x005F1323); //Packet content
+		_go_and_wait(dsi);
+	} else {
+		//Generic_Short_Write_2P(0x13,0x6F)//JEIDA , even odd
+		// printk(KERN_ALERT"LVDS even odd change & JEIDA =>6F\n");
+		regmap_write(dsi->reg, CMD0, 0x006F1323); //Packet content
+		_go_and_wait(dsi);
+	}
+
+
+	//Generic_Short_Write_2P(0x14,0x01)
+	regmap_write(dsi->reg, CMD0, 0x00011423); //Packet content
+	_go_and_wait(dsi);
+
+	//Generic_Short_Write_2P(0x15,0x23)
+	regmap_write(dsi->reg, CMD0, 0x00231523); //Packet content
+	_go_and_wait(dsi);
+
+	//Generic_Short_Write_2P(0x16,0x40)
+	regmap_write(dsi->reg, CMD0, 0x00401623); //Packet content
+	_go_and_wait(dsi);
+
+	//Generic_Short_Write_2P(0x17,0x00)
+	regmap_write(dsi->reg, CMD0, 0x00001723); //Packet content
+	_go_and_wait(dsi);
+
+	//Generic_Short_Write_2P(0x18,0x01)
+	regmap_write(dsi->reg, CMD0, 0x00011823); //Packet content
+	_go_and_wait(dsi);
+
+	//Generic_Short_Write_2P(0x19,0x23)
+	regmap_write(dsi->reg, CMD0, 0x00231923); //Packet content
+	_go_and_wait(dsi);
+
+	//Generic_Short_Write_2P(0x1A,0x40)
+	regmap_write(dsi->reg, CMD0, 0x00401A23); //Packet content
+	_go_and_wait(dsi);
+
+	//Generic_Short_Write_2P(0x1B,0x00)
+	regmap_write(dsi->reg, CMD0, 0x00001B23); //Packet content
+	_go_and_wait(dsi);
+
+	//Generic_Short_Write_2P(0x1E,0x46)
+	regmap_write(dsi->reg, CMD0, 0x00461E23); //Packet content
+	_go_and_wait(dsi);
+
+	//Generic_Short_Write_2P(0x51,0x30)
+	regmap_write(dsi->reg, CMD0, 0x00305123); //Packet content
+	_go_and_wait(dsi);
+
+	//Generic_Short_Write_2P(0x1F,0x10)
+	regmap_write(dsi->reg, CMD0, 0x00101F23); //Packet content
+	_go_and_wait(dsi);
+
+	//// GM8775C Test mode off, signal from MIPI
+	//Generic_Short_Write_2P(0x2A,0x01)
+	regmap_write(dsi->reg, CMD0, 0x00012A23); //off
+	//writel(0x002D2A23, DSI_BASE + CMD0); //border line
+	//writel(0x003D2A23, DSI_BASE + CMD0); //Checkerboard
+	//writel(0x004D2A23, DSI_BASE + CMD0); //Color Bar
+	_go_and_wait(dsi);
+}
