+static int rtk_do_ovt_modes(struct drm_connector *connector, u8 *db, u8 len)
+{
+	struct drm_display_mode *display_mode;
+	int rid = 0;
+	char frame_rate = 0;
+	char frame_rate_factor = 0;
+	int i = 0;
+	int modes = 0;
