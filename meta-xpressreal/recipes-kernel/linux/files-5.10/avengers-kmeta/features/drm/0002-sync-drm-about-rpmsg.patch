+static int rtk_1619_dsi_enable(struct rtk_dsi *dsi, struct interface_info *if_info)
+{
+	struct rtk_rpc_info *rpc_info = dsi->rpc_info;
+	struct rpc_set_display_out_interface interface;
+	int ret;
+
+	DRM_INFO("rtk_1619_dsi_enable\n");
+
+	if (dsi->lk_initialized == 1) {
+		printk("lk initialized\n");
+		dsi->lk_initialized = 0;
+		return 0;
+	}
+
+	ret = clk_prepare_enable(dsi->clk);
+	if (ret) {
+		DRM_ERROR("Failed to enable clk: %d\n", ret);
+	}
+
+	reset_control_deassert(dsi->rstc);
+
+	rtk_dsi_harware_init(dsi, if_info->panel_id, if_info->timing_id);
+
+	regmap_write(dsi->reg, PAT_GEN, 0x9000000);
+
+	DRM_INFO("if_info->width : %d, if_info->height : %d\n", if_info->width, if_info->height);
+
+	interface.display_interface       = DISPLAY_INTERFACE_MIPI;
+	interface.width                   = if_info->width;
+	interface.height                  = if_info->height;
+	interface.frame_rate              = if_info->frame_rate;
+	interface.display_interface_mixer = if_info->mixer;
+
+	DRM_INFO("enable %s on %s (%dx%d@%d)\n",
+		interface_names[interface.display_interface], mixer_names[interface.display_interface_mixer],
+		interface.width, interface.height, interface.frame_rate);
+
+	ret = rpc_set_out_interface(rpc_info, &interface);
+	if (ret) {
+		DRM_ERROR("rpc_set_out_interface rpc fail\n");
+	}
+
+	if (if_info->panel_id == DSI_PANEL_SEL_AUO) {
+		pwm_enable(dsi->pwm_0);
+		pwm_enable(dsi->pwm_1);
+	}
+
+	return 0;
+}
