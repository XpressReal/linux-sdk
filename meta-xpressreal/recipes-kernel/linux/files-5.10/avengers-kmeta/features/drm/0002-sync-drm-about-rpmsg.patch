+static void rtk_1619_dsi_get_modes(struct rtk_dsi *dsi, struct interface_info *if_info)
+{
+	struct rpc_set_display_out_interface interface;
+	struct rtk_rpc_info *rpc_info = dsi->rpc_info;
+
+	DRM_INFO("[rtk_1619_dsi_get_modes]\n");
+
+	interface.display_interface = DISPLAY_INTERFACE_MIPI;
+
+	rpc_query_out_interface(rpc_info, &interface);
+
+	if (interface.display_interface_mixer != DISPLAY_INTERFACE_MIXER_NONE) {
+		DRM_INFO("interface %s [%dx%d %d fps] is on %s\n",
+			interface_names[if_info->display_interface], interface.width, interface.height,
+			interface.frame_rate, mixer_names[interface.display_interface_mixer]);
+
+		if_info->mixer      = interface.display_interface_mixer;
+		if_info->width      = interface.width;
+		if_info->height     = interface.height;
+		if_info->frame_rate = interface.frame_rate;
+	} else {
+
+		if_info->mixer = DISPLAY_INTERFACE_MIXER2;
+		if_info->width      = if_info->disp_mode.hdisplay;
+		if_info->height     = if_info->disp_mode.vdisplay;
+
+		DRM_INFO("interface %d not on any mixer yet\n",
+			if_info->display_interface);
+	}
+}
