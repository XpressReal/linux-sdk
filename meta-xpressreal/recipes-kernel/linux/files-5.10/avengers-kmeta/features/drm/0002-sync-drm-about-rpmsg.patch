+int rtk_dsi_parse_dts_timing(struct device_node *np, struct rtk_dsi *dsi)
+{
+	struct interface_info *if_info;
+	struct drm_display_mode *disp_mode;
+	struct videomode *videomode;
+	unsigned int panel_id, timing_id, panel_rotated;
+	int ret;
+
+	if_info   = &dsi->if_info;
+	disp_mode = &if_info->disp_mode;
+	videomode = &if_info->videomode;
+
+	of_property_read_u32(np, "panel-id", &panel_id);
+	of_property_read_u32(np, "timing-id", &timing_id);
+	of_property_read_u32(np, "panel-rotated", &panel_rotated);
+
+	DRM_INFO("panel_id = %d, timing_id = %d, panel_rotated = %d\n",
+		panel_id, timing_id, panel_rotated);
+
+	ret = of_get_drm_display_mode(np, disp_mode, NULL, OF_USE_NATIVE_MODE);
+	if (ret) {
+		DRM_ERROR("of_get_drm_display_mode fail %d\n", ret);
+		return -EINVAL;
+	}
+
+	disp_mode->width_mm  = disp_mode->hdisplay / 10;
+	disp_mode->height_mm = disp_mode->vdisplay / 10;
+
+	DRM_INFO("dsi drm display mode:\n");
+	DRM_INFO("clock       = %d\n", disp_mode->clock);
+	DRM_INFO("hdisplay    = %d\n", disp_mode->hdisplay);
+	DRM_INFO("hsync_start = %d\n", disp_mode->hsync_start);
+	DRM_INFO("hsync_end   = %d\n", disp_mode->hsync_end);
+	DRM_INFO("htotal      = %d\n", disp_mode->htotal);
+	DRM_INFO("vdisplay    = %d\n", disp_mode->vdisplay);
+	DRM_INFO("vsync_start = %d\n", disp_mode->vsync_start);
+	DRM_INFO("vsync_end   = %d\n", disp_mode->vsync_end);
+	DRM_INFO("vtotal      = %d\n", disp_mode->vtotal);
+	DRM_INFO("width_mm    = %d\n", disp_mode->width_mm);
+	DRM_INFO("height_mm   = %d\n", disp_mode->height_mm);
+	DRM_INFO("frame rate = %d\n", disp_mode->clock * 1000 / (disp_mode->htotal * disp_mode->vtotal));
+
+	if_info->panel_id  = panel_id;
+	if_info->timing_id = timing_id;
+	if_info->panel_rotated = panel_rotated;
+
+	drm_display_mode_to_videomode(disp_mode, videomode);
+
+	DRM_INFO("dsi video mode:\n");
+	DRM_INFO("pixelclock   = %lu\n", videomode->pixelclock);
+	DRM_INFO("hactive      = %d\n", videomode->hactive);
+	DRM_INFO("hfront_porch = %d\n", videomode->hfront_porch);
+	DRM_INFO("hback_porch  = %d\n", videomode->hback_porch);
+	DRM_INFO("hsync_len    = %d\n", videomode->hsync_len);
+	DRM_INFO("vactive      = %d\n", videomode->vactive);
+	DRM_INFO("vfront_porch = %d\n", videomode->vfront_porch);
+	DRM_INFO("vback_porch  = %d\n", videomode->vback_porch);
+	DRM_INFO("vsync_len    = %d\n", videomode->vsync_len);
+
+	if (panel_id == DSI_FMT_1920_720P_30 ||
+		panel_id == DSI_FMT_600_1024P_30 ) {
+		if_info->frame_rate = 30;
+	} else {
+		if_info->frame_rate = 60;
+	}
+
+	DRM_INFO("panel_id   = %d\n", if_info->panel_id);
+	DRM_INFO("timing_id  = %d\n", if_info->timing_id);
+	DRM_INFO("frame_rate = %d\n", if_info->frame_rate);
+
+	return 0;
+}
+
+static int rtk_1619_dsi_query_timings(struct device_node *np, struct rtk_dsi *dsi)
+{
+	int ret = 0;
+
+	ret = rtk_dsi_parse_dts_timing(np, dsi);
+	if (ret) {
+		DRM_ERROR("Failed to parse dts timing : %d\n", ret);
+	}
+
+	return ret;
+}
+
+static int rtk_1861_dsi_query_timings(struct device_node *np, struct rtk_dsi *dsi)
+{
+	struct rtk_rpc_info *rpc_info = dsi->rpc_info;
+	struct interface_info *if_info;
+	struct drm_display_mode *disp_mode;
+	struct videomode *videomode;
+	struct rpc_query_display_out_interface_timing interface_timing;
+	int ret = 0;
+
+	if_info = &dsi->if_info;
+
+	interface_timing.display_interface = DISPLAY_INTERFACE_MIPI;
+
+	disp_mode = &if_info->disp_mode;
+	videomode = &if_info->videomode;
+
+	// TODO: 1861 DSI quert timing rpc
+	rpc_query_out_interface_timing(rpc_info, &interface_timing);
+	disp_mode->clock       = interface_timing.clock;
+	disp_mode->hdisplay    = interface_timing.hdisplay;
+	disp_mode->hsync_start = interface_timing.hsync_start;
+	disp_mode->hsync_end   = interface_timing.hsync_end;
+	disp_mode->htotal      = interface_timing.htotal;
+	disp_mode->vdisplay    = interface_timing.vdisplay;
+	disp_mode->vsync_start = interface_timing.vsync_start;
+	disp_mode->vsync_end   = interface_timing.vsync_end;
+	disp_mode->vtotal      = interface_timing.vtotal;
+	disp_mode->flags       = 0;
+
+	DRM_INFO("[dsi][rpc_query_out_interface_timing] (%dx%d)\n",
+		disp_mode->hdisplay, disp_mode->vdisplay);
+
+	drm_display_mode_to_videomode(disp_mode, videomode);
+
+	// *disp_mode = n080jce_g41_mode;
+
+	return ret;
+}
