+static void rtk_dsi_harware_init(struct rtk_dsi *dsi, enum dsi_panel_sel panel, enum dsi_fmt fmt)
+{
+	struct hvsync_param param;
+	unsigned int val;
+
+	regmap_write(dsi->reg, PAT_GEN, 0xf000000);
+	regmap_write(dsi->reg, CLOCK_GEN, 0x3f4000);
+
+	regmap_write(dsi->reg, WATCHDOG, 0x1632);
+	regmap_write(dsi->reg, CTRL_REG, 0x7000000);
+	regmap_write(dsi->reg, DF, 0x1927c20);
+
+	if (fmt == DSI_FMT_1920_720P_30 ||
+		fmt == DSI_FMT_1920_720P_60 ||
+		fmt == DSI_FMT_600_1024P_60) {
+		regmap_write(dsi->reg, SSC2, 0x0);
+		regmap_write(dsi->reg, SSC3, 0x281111);
+	} else { //DSI_FORMAT_1080P_60
+		regmap_write(dsi->reg, SSC2, 0x4c05ed);
+		regmap_write(dsi->reg, SSC3, 0x282219);
+	}
+
+	regmap_write(dsi->reg, MPLL, 0x403592b); //PLL setting
+
+	if (fmt == DSI_FMT_1920_720P_30 ||
+		fmt == DSI_FMT_1920_720P_60) {
+		if (panel == 1 || panel == 2) { //1:techwin 2:AUO
+			regmap_write(dsi->reg, TX_DATA1, 0x10d0100);
+			regmap_write(dsi->reg, TX_DATA2, 0x81d010f);
+			regmap_write(dsi->reg, TX_DATA3, 0x5091401);
+		} else { //panel==3 techwin single
+			regmap_write(dsi->reg, TX_DATA1, 0x50d0100);
+			regmap_write(dsi->reg, TX_DATA2, 0x81d050f);
+			regmap_write(dsi->reg, TX_DATA3, 0x5091405);
+		}
+
+		regmap_write(dsi->reg, CLOCK_GEN, 0x3F47f0); //enable DPHY four lanes
+		regmap_write(dsi->reg, TX_SWAP, 0x13042); //TX: D2 swap to D0, CLK swap to D1
+		regmap_write(dsi->reg, RX_SWAP, 0x13042); //RX: D2 swap to D0, CLK swap to D1
+
+		if (fmt == DSI_FMT_1920_720P_30)
+			regmap_write(dsi->reg, DF, 0x1927c3d); //PLL divider setting div2=1, clock bit rate 270Mbps
+		else if (fmt == DSI_FMT_1920_720P_60)
+			regmap_write(dsi->reg, DF, 0x1927c3c); //PLL divider setting div2=0, clock bit rate 540Mbps
+
+	} else if (fmt == DSI_FMT_600_1024P_60) {
+		regmap_write(dsi->reg, TX_DATA1, 0x30d0100);
+		regmap_write(dsi->reg, TX_DATA2, 0x81d030f);
+		regmap_write(dsi->reg, TX_DATA3, 0x5091403);
+		regmap_write(dsi->reg, CLOCK_GEN, 0x3F47f0); //enable DPHY four lanes
+
+		if (panel == 4) {//arcadyan
+			// Arcadyan_panel_reset();
+		}
+
+		regmap_write(dsi->reg, DF, 0x1927c3d); //PLL divider setting div2=1, clock bit rate 270Mbps
+	} else { //DSI_FORMAT_1080P_60
+		regmap_write(dsi->reg, TX_DATA1, 0x70d0100);
+		regmap_write(dsi->reg, TX_DATA2, 0x81d090f);
+		regmap_write(dsi->reg, TX_DATA3, 0x5091408);
+
+		regmap_read(dsi->reg, CLOCK_GEN, &val);
+		val |= 0x7f0;
+		regmap_write(dsi->reg, CLOCK_GEN, val);
+
+		regmap_write(dsi->reg, DF, 0x1927c3c);
+	}
+
+	regmap_write(dsi->reg, WATCHDOG, 0x161a);
+
+	if (fmt == DSI_FMT_1920_720P_30 ||
+		fmt == DSI_FMT_1920_720P_60) {
+		regmap_write(dsi->reg, CLK_CONTINUE, 0x80);
+	} else if (fmt == DSI_FMT_600_1024P_60) {
+		regmap_write(dsi->reg, CLK_CONTINUE, 0x0);
+	}
+
+	// DSI COMMAND
+	if (fmt == DSI_FMT_1920_720P_30 ||
+		fmt == DSI_FMT_1920_720P_60 ||
+		fmt == DSI_FMT_600_1024P_60) {
+
+		rtk_dsi_config_param(dsi, panel, &param);
+
+		regmap_write(dsi->reg, TC0, (long long)(param.hs_width<<16)|(param.h_valid)*3); //set HSA/HACT 1920*3(RGB888*3, RGB565*2, RGB666*2.25, RGB666loosely*3)
+		regmap_write(dsi->reg, TC1, (long long)(param.hs_bp<<16)|(param.hs_fp)); //set HBP/HFP
+		regmap_write(dsi->reg, TC2, (long long)(param.vs_width<<16)|(param.v_valid)); //set VSA/VACT 720
+		regmap_write(dsi->reg, TC3, (long long)(param.vs_bp<<16)|(param.vs_fp)); //set VBP/VFP
+
+		if (fmt == DSI_FMT_600_1024P_60) {
+			//4lane
+			regmap_write(dsi->reg, TC5, 0x2580212); //set pixel number 600 and line time
+			regmap_write(dsi->reg, TC4, 0x2410109); //set video mode and clock req timing
+			regmap_write(dsi->reg, PAT_GEN, 0x8808080);
+		} else{
+			//4lane
+			regmap_write(dsi->reg, TC5, 0x78005e5); //set pixel number 1920 and line time
+			regmap_write(dsi->reg, TC4, 0x24102f2); //set video mode and clock req timing
+		}
+
+	} else { //DSI_FORMAT_1080P_60
+		regmap_write(dsi->reg, TC0, 0x2c1680);
+		regmap_write(dsi->reg, TC2, 0x50438);
+		regmap_write(dsi->reg, TC5, 0x780073c);
+		regmap_write(dsi->reg, TC1, 0x940058);
+		regmap_write(dsi->reg, TC3, 0x240004);
+		regmap_write(dsi->reg, TC4, 0x241032b);
+	}
+
+	//dsi command
+	if (panel == 0) {
+		//RTK test panel
+		DRM_DEBUG_DRIVER("dsi_command_fl7703\n");
+		// dsi_command_fl7703(res);
+	} else if (panel==1||panel==2||panel==3) {
+		//TechWin & AUO
+		DRM_DEBUG_DRIVER("dsi_command_GM8775C\n");
+		dsi_command_GM8775C(dsi, panel, &param);
+	} else if (panel==4) {
+		// arcadyan
+		DRM_DEBUG_DRIVER("dsi_command_Arcadyan\n");
+		// dsi_command_Arcadyan();
+	} else {
+		DRM_DEBUG_DRIVER("Panel not define\n");
+	}
+
+	//dsi_output_colorbar();
+	regmap_write(dsi->reg, CTRL_REG, 0x7610031);
+}
