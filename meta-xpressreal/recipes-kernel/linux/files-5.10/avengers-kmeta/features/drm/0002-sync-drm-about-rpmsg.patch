+static void rtk_1861_dsi_get_modes(struct rtk_dsi *dsi, struct interface_info *if_info)
+{
+	struct drm_display_mode *disp_mode;
+
+	DRM_INFO("[rtk_1619_dsi_get_modes]\n");
+
+	disp_mode = &if_info->disp_mode;
+	if_info   = &dsi->if_info;
+
+	if_info->width      = disp_mode->hdisplay;
+	if_info->height     = disp_mode->vdisplay;
+	if_info->frame_rate = drm_mode_vrefresh(disp_mode);
+}
