From ff2e98ab5756de6bbf061229a170f84636d513f0 Mon Sep 17 00:00:00 2001
From: edwardwu <edwardwu@realtek.com>
Date: Tue, 10 Mar 2026 08:06:42 +0800
Subject: [PATCH 2/2] arm64: dts: realtek: rename cma_2 to vo5 for cmaheap
 purpose

Change-Id: Ief5e03495e88807928cc5941081f727c9f389386
---
 arch/arm64/boot/dts/realtek/rtd1501.dtsi                      | 2 +-
 arch/arm64/boot/dts/realtek/rtd1501s-phantom-chromium-8gb.dts | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/realtek/rtd1501.dtsi b/arch/arm64/boot/dts/realtek/rtd1501.dtsi
index 1bf4425a1c3e..be0ae0e9f444 100644
--- a/arch/arm64/boot/dts/realtek/rtd1501.dtsi
+++ b/arch/arm64/boot/dts/realtek/rtd1501.dtsi
@@ -254,7 +254,7 @@ cma_reserved_1:linux,cma_1 {
 		reusable;
 	};
 
-	cma_reserved_2:linux,cma_2 {
+	cma_reserved_2:vo5 {
 		compatible = "shared-dma-pool";
 		alignment = <0x0 0x00400000>;
 		/* Avoid crossing A/VCPU PA2VA per 512M boundary */
diff --git a/arch/arm64/boot/dts/realtek/rtd1501s-phantom-chromium-8gb.dts b/arch/arm64/boot/dts/realtek/rtd1501s-phantom-chromium-8gb.dts
index 8e5c476243c2..1fe4f90c83da 100644
--- a/arch/arm64/boot/dts/realtek/rtd1501s-phantom-chromium-8gb.dts
+++ b/arch/arm64/boot/dts/realtek/rtd1501s-phantom-chromium-8gb.dts
@@ -153,7 +153,7 @@ linux,cma {
 		alloc-ranges=<0x0 0x20000000 0x0 0x20000000>;
 	};
 
-	linux,cma_2 {
+	vo5 {
 		size = <0x0 0x50000000>; /* 1280M */
 	};
 
-- 
2.43.0

