From 5b798a2f8d0c16d782fe8379b3bdac4482cb3b8c Mon Sep 17 00:00:00 2001
From: "yao.tsai" <yao.tsai@realtek.com>
Date: Mon, 27 Oct 2025 16:58:27 +0800
Subject: [PATCH] gpu: drm: realtek: Add startup/shutdown callback for kent
 chrome platform

Jira: CHROME-586

Change-Id: Ibfdbd1898ba6114728ab93aff1c15c576a4d2dab
---
 arch/arm64/boot/dts/realtek/kent-audio.dtsi |  1 +
 drivers/gpu/drm/realtek/rtk_hdmi.c          | 50 ++++++++++++++++++---
 drivers/gpu/drm/realtek/rtk_hdmi.h          |  3 ++
 3 files changed, 47 insertions(+), 7 deletions(-)

diff --git a/arch/arm64/boot/dts/realtek/kent-audio.dtsi b/arch/arm64/boot/dts/realtek/kent-audio.dtsi
index a373586b883ca..a80b0b7706c9c 100644
--- a/arch/arm64/boot/dts/realtek/kent-audio.dtsi
+++ b/arch/arm64/boot/dts/realtek/kent-audio.dtsi
@@ -110,6 +110,7 @@ rtk_vad: rtk-vad {
 	rtk_sof: rtk_sof {
 		compatible = "realtek,rtd1920s-hifi";
 		realtek,krpc-agent = <&hifi_kernel_agent>;
+		remote-cpu = <1>; /* 0: AFW 1: HIFI */
 		status = "disabled";
 	};
 
diff --git a/drivers/gpu/drm/realtek/rtk_hdmi.c b/drivers/gpu/drm/realtek/rtk_hdmi.c
index 0fc2afb783cf1..4b8b2762d83f4 100644
--- a/drivers/gpu/drm/realtek/rtk_hdmi.c
+++ b/drivers/gpu/drm/realtek/rtk_hdmi.c
@@ -45,6 +45,8 @@
 	{ .compatible = "realtek,audio-out", },
 	{ .compatible = "realtek,rtd1619b-hifi-afe",},
 	{ .compatible = "realtek,rtd1920s-hifi-afe", },
+	{ .compatible = "realtek,rtd1501s-hifi", },
+	{ .compatible = "realtek,rtd1619b-hifi", },
 	{ /*sentinel*/ }
 };
 
@@ -1259,6 +1266,14 @@ static int rtk_hdmi_audio_output_ctrl(struct rtk_hdmi *hdmi,
 	int ret;
 	struct rpc_audio_hdmi_freq audio_arg;
 	struct rpc_audio_ctrl_data rpc_data;
+	struct rtk_rpc_info *rpc_info_ao;
+
+	rpc_info_ao = hdmi->rpc_info_ao;
+
+	if (rpc_info_ao->ao_in_hifi != NULL &&
+		*rpc_info_ao->ao_in_hifi &&
+		!hdmi->hifi_ready)
+		return 0;
 
 	memset(&audio_arg, 0, sizeof(audio_arg));
 	memset(&rpc_data, 0, sizeof(rpc_data));
@@ -1270,9 +1285,14 @@ static int rtk_hdmi_audio_output_ctrl(struct rtk_hdmi *hdmi,
 	}
 
 	rpc_data.version = AUDIO_CTRL_VERSION;
-	rpc_data.hdmi_en_state = enable ? 1:0;
 
-	dev_info(hdmi->dev, "set audio output %s",  enable ? "on":"off");
+	if (IS_ENABLED(CONFIG_CHROME_PLATFORMS) &&
+		soc_device_match(rtk_soc_kent))
+		rpc_data.hdmi_en_state = enable&hdmi->audio_startup ? 1:0;
+	else
+		rpc_data.hdmi_en_state = enable ? 1:0;
+
+	dev_info(hdmi->dev, "set audio output %s",  rpc_data.hdmi_en_state ? "on":"off");
 
 	ret = rpc_set_hdmi_audio_onoff(hdmi->rpc_info_ao, &rpc_data);
 
@@ -2514,8 +2534,8 @@ static void rtk_hdmi_update_sink_info(struct rtk_hdmi *hdmi)
 		rpc_send_edid_raw_data(rpc_info, (u8 *)hdmi->edid_cache,
 				(hdmi->edid_cache->extensions + 1) * EDID_LENGTH);
 
-		if (rpc_info_ao->ao_in_hifi != NULL) {
-			if (*rpc_info_ao->ao_in_hifi && (rpc_info->krpc_vo_opt != rpc_info_ao->krpc_vo_opt))
+		if (rpc_info_ao->ao_in_hifi != NULL && *rpc_info_ao->ao_in_hifi) {
+			if (hdmi->hifi_ready && (rpc_info->krpc_vo_opt != rpc_info_ao->krpc_vo_opt))
 				rpc_send_edid_raw_data(rpc_info_ao, (u8 *)hdmi->edid_cache,
 						(hdmi->edid_cache->extensions + 1) * EDID_LENGTH);
 		}
@@ -3345,6 +3365,20 @@ static void rtk_hdmi_audio_shutdown(struct device *dev, void *data)
 	struct rtk_hdmi *hdmi = dev_get_drvdata(dev);
 
 	dev_info(hdmi->dev, "audio shutdown");
+
+	hdmi->audio_startup = 0;
+}
+
+static int rtk_hdmi_audio_startup(struct device *dev, void *data)
+{
+	struct rtk_hdmi *hdmi = dev_get_drvdata(dev);
+
+	dev_info(hdmi->dev, "audio startup");
+
+	hdmi->hifi_ready = 1;
+	hdmi->audio_startup = 1;
+
+	return 0;
 }
 
 static int rtk_hdmi_audio_hook_plugged_cb(struct device *dev, void *data,
@@ -3373,6 +3407,7 @@ static int rtk_hdmi_audio_hook_plugged_cb(struct device *dev, void *data,
 static const struct hdmi_codec_ops rtk_hdmi_audio_codec_ops = {
 	.hw_params = rtk_hdmi_audio_hw_params,
 	.audio_shutdown = rtk_hdmi_audio_shutdown,
+	.audio_startup = rtk_hdmi_audio_startup,
 	.hook_plugged_cb = rtk_hdmi_audio_hook_plugged_cb,
 };
 
@@ -3562,6 +3597,7 @@ static int rtk_hdmi_bind(struct device *dev, struct device *master,
 			ret = of_property_read_u32(audio_out_np, "remote-cpu", &hdmi->ao_in_hifi);
 			if (ret)
 				hdmi->ao_in_hifi = 0;
+			break;
 		}
 	}
 	dev_info(dev, "ao_in_hifi=%u\n", hdmi->ao_in_hifi);
diff --git a/drivers/gpu/drm/realtek/rtk_hdmi.h b/drivers/gpu/drm/realtek/rtk_hdmi.h
index 871585b3cc407..2eb6a378a3965 100644
--- a/drivers/gpu/drm/realtek/rtk_hdmi.h
+++ b/drivers/gpu/drm/realtek/rtk_hdmi.h
@@ -11,6 +11,7 @@
 #include <drm/drm_crtc_helper.h>
 #include <drm/drm_probe_helper.h>
 
+
 #include <sound/hdmi-codec.h>
 
 #include "rtk_drm_drv.h"
@@ -393,6 +394,8 @@ struct rtk_hdmi {
 	u32 is_new_mac;
 	u32 lr_scramble;
 	u32 ao_in_hifi;
+	u32 hifi_ready;
+	u32 audio_startup;
 	u32 ext_flags;
 	u32 swap_config;
 	u32 max_clock_k;
-- 
2.47.0

