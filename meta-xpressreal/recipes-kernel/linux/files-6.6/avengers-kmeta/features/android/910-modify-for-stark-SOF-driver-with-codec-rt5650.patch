+
+static void rtd1619b_hifi_poweroff(void)
+{
+	void __iomem *map_bit;
+	int timeout = 500;
+	unsigned int val;
+
+	// Disable
+	/* Disable Clock  [15:14] = Disable 0x2 Enable 0x3 */
+	map_bit = ioremap(HIFI_CLK_ENABLE, 0x120);
+	val = readl(map_bit) & 0xFFFF3FFF;
+	val |= (0x2<<14);
+	writel(val, map_bit);
+
+	/* clemp cell on ISO_CTRL1 [21:20] = 0x3 */
+	map_bit = ioremap(ISO_CTRL1, 0x120);
+	writel(readl(map_bit)|(0x3<<20), map_bit);
+
+	/* Set iso_hifi0 bits of ISO_power_ctrl(0x9800_7fD0[13]) register to 1 */
+	map_bit = ioremap(ISO_POWER_CTRL, 0x120);
+	writel(readl(map_bit) | 0x00002000, map_bit);
+
+	/* HIFI HIFI_SRAM reset SYS_SOFT_RESET10_SECURE [15:14]0x3 [9:8]0x3*/
+	map_bit = ioremap(SYS_SOFT_RESET10_SECURE, 0x120);
+	writel(readl(map_bit)|(0x3<<8)|(0x3<<15), map_bit);
+
+	/*HIFI reg reset SYS_SOFT_RESET9[23:22] 0x3 */
+	map_bit = ioremap(SYS_SOFT_RESET9, 0x120);
+	writel(readl(map_bit)|(0x3<<22), map_bit);
+
+	/*HIFI CLK TOGGLE*/
+	map_bit = ioremap(HIFI_CLK_ENABLE, 0x120);
+	writel(readl(map_bit)|(0x3<<14)|(0x3<<22), map_bit);
+	val= readl(map_bit) & 0xFF3F3FFF;
+	val |= (0x202 << 14);
+	writel(val, map_bit);
+
+	/* Set bit 0 and bit1 of ISO_hifi0_sram_pwr4(0x9800_7248[1:0]) register to 1;
+	 * To turn off aucpu power
+	 */
+	map_bit = ioremap(ISO_HIFI0_SRAM_PWR4, 0x120);
+	writel(readl(map_bit) | 0x00000003, map_bit);
+	map_bit = ioremap(ISO_HIFI0_SRAM_PWR5, 0x120);
+	while ((readl(map_bit) & 0x4) != 0x4) {
+		udelay(1000);
+		if (timeout-- < 0) {
+			pr_err("[HIFI] ERROR: failed to power on HiFi: polling sram_pwr5 timeout!\n");
+			break;
+		}
+	}
+	pr_info("HIFI power off");
+	iounmap(map_bit);
+}
+
+static void rtd1619b_hifi_poweron(void)
+{
+	void __iomem *map_bit;
+	int timeout = 500;
+	unsigned int val;
+
+	/* Set bit 0 and bit1 of ISO_hifi0_sram_pwr4(0x9800_7248[1:0]) register to 0;
+	 * To turn on aucpu power
+	 */
+	map_bit = ioremap(ISO_HIFI0_SRAM_PWR4, 0x120);
+	writel(readl(map_bit) & 0xfffffffc, map_bit);
+
+	map_bit = ioremap(ISO_HIFI0_SRAM_PWR5, 0x120);
+	while ((readl(map_bit) & 0x4) != 0x4) {
+		udelay(1000);
+		if (timeout-- < 0) {
+			pr_err("[HIFI] ERROR: failed to power on HiFi: polling sram_pwr5 timeout!\n");
+			break;
+		}
+	}
+
+	/* Set iso_hifi0 bits of ISO_power_ctrl(0x9800_7FD0[13]) register to 0. */
+	map_bit = ioremap(ISO_POWER_CTRL, 0x120);
+	writel(readl(map_bit) & 0xffffdfff, map_bit);
+
+	map_bit = ioremap(ISO_CTRL1, 0x120);
+	val = readl(map_bit)& 0xffcfffff;
+	val |= (0x2 << 20);
+	writel(val, map_bit);
+
+	iounmap(map_bit);
+
+	pr_info("HIFI power on");
+}
