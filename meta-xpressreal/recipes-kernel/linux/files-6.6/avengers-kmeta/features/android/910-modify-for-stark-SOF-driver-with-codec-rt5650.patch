 	priv->sof_ept->priv = priv;
@@ -420,6 +537,7 @@ static int rtk_hifi_shutdown(struct snd_sof_dev *sdev)
 void set_hifi_pll_and_ssc_control(uint32_t freq_setting)
 {
 	void __iomem *map_bit;
+	unsigned int val;
 
 	map_bit = ioremap(SYS_PLL_HIFI2, 0x120);
 	if (readl(map_bit) == 0x3)
@@ -457,6 +575,26 @@ void set_hifi_pll_and_ssc_control(uint32_t freq_setting)
 	map_bit = ioremap(SYS_PLL_HIFI2, 0x120);
 	writel(0x00000003, map_bit);
 
+	/* reset vector 9801AD00 ???*/
+
+	/* tpggle HIFI clock */
+	map_bit = ioremap(HIFI_CLK_ENABLE, 0x120);
+	writel(readl(map_bit)|(0x3<<14)|(0x3<<22), map_bit);
+	val= readl(map_bit) & 0xFF3F3FFF;
+	val |= (0x202 << 14);
+	writel(val, map_bit);
+
+	/* reg rest SYS_SOFT_RESET9[23:22]0x3 */
+	map_bit = ioremap(SYS_SOFT_RESET9, 0x120);
+	writel(readl(map_bit)|(0x3<<22), map_bit);
+
+	/* reset SYS_SOFT_RESET10_SECURE[9:8] 0x3 */
+	map_bit = ioremap(SYS_SOFT_RESET10_SECURE, 0x120);
+	writel(readl(map_bit)|(0x3<<8), map_bit);
+
+	/* Enable HIFI clock */
+	map_bit = ioremap(HIFI_CLK_ENABLE, 0x120);
+	writel(readl(map_bit)|(0x3<<14), map_bit);
 	iounmap(map_bit);
 }
 
