From dda90f9019542cb3de6109e47d91e3d9cce5fc6f Mon Sep 17 00:00:00 2001
From: "yao.tsai" <yao.tsai@realtek.com>
Date: Fri, 7 Nov 2025 10:00:17 +0800
Subject: [PATCH] sound: soc: realtek: refine machine driver without
 codec arm64: dts: realtek: refine dts for 1501

[JIRA]CHROME-778

- change default fw_path and tplg_path to "sof"

Change-Id: Ia708587b174887e17d158bb875c803d4e628a90e
---
 arch/arm64/boot/dts/realtek/kent-audio.dtsi   |  1 -
 .../realtek/rtd1501s-phantom-chromium-8gb.dts |  3 +-
 .../boot/dts/realtek/rtd1920s-smallville.dtsi |  1 +
 sound/soc/realtek/Kconfig                     |  5 --
 sound/soc/realtek/rtk-hifi-machine.c          | 86 +++++++++----------
 sound/soc/sof/realtek/hifi-dsp.c              | 24 ++++++
 6 files changed, 67 insertions(+), 53 deletions(-)

diff --git a/arch/arm64/boot/dts/realtek/kent-audio.dtsi b/arch/arm64/boot/dts/realtek/kent-audio.dtsi
index a80b0b7706c9c..0f985ded091ba 100644
--- a/arch/arm64/boot/dts/realtek/kent-audio.dtsi
+++ b/arch/arm64/boot/dts/realtek/kent-audio.dtsi
@@ -108,5 +108,4 @@ rtk_vad: rtk-vad {
 	};
 
 	rtk_sof: rtk_sof {
-		compatible = "realtek,rtd1920s-hifi";
 		realtek,krpc-agent = <&hifi_kernel_agent>;
diff --git a/arch/arm64/boot/dts/realtek/rtd1501s-phantom-chromium-8gb.dts b/arch/arm64/boot/dts/realtek/rtd1501s-phantom-chromium-8gb.dts
index f0a06fa47c529..58dba061f3e21 100644
--- a/arch/arm64/boot/dts/realtek/rtd1501s-phantom-chromium-8gb.dts
+++ b/arch/arm64/boot/dts/realtek/rtd1501s-phantom-chromium-8gb.dts
@@ -170,6 +170,7 @@ &rtk_pm {
 
 &rtk_sof {
 	status = "okay";
+	compatible = "realtek,rtd1501s-hifi";
 	intr-syscon = <&sb2>;
 	ipc-syscon = <&sb2_pmu>;
 };
@@ -180,7 +181,7 @@ &rtk_asoc_machine {
 	realtek,audio-platform = <&rtk_sof>;
 	realtek,hdmi-audio = <&hdmi>;
 	realtek,dp-audio = <&dp>;
-	realtek,dai-link = "RDAI_I2S","RDAI_I2S1","RDAI_DMIC","RDAI_HDMI","RDAI_DP";
+	realtek,dai-link = "RDAI_HDMI","RDAI_DP","RDAI_DMIC";
 	status = "okay";
 };
 
diff --git a/arch/arm64/boot/dts/realtek/rtd1920s-smallville.dtsi b/arch/arm64/boot/dts/realtek/rtd1920s-smallville.dtsi
index 0ec8099b9715f..b4a714c5e01c9 100644
--- a/arch/arm64/boot/dts/realtek/rtd1920s-smallville.dtsi
+++ b/arch/arm64/boot/dts/realtek/rtd1920s-smallville.dtsi
@@ -237,6 +237,7 @@ rt5650: rt5650@1a {
 
 &rtk_sof {
 	status = "okay";
+	compatible = "realtek,rtd1920s-hifi";
 	intr-syscon = <&sb2>;
 	ipc-syscon = <&sb2_pmu>;
 };
diff --git a/sound/soc/realtek/Kconfig b/sound/soc/realtek/Kconfig
index 2651c6d8e6cbe..e6b78522e69fc 100644
--- a/sound/soc/realtek/Kconfig
+++ b/sound/soc/realtek/Kconfig
@@ -39,11 +39,6 @@ config SND_SOC_REALTEK_FL3236
 
 config SND_SOC_RTK_HIFI_MACHINE
 	tristate "Realtek hifi asoc machine Driver"
-	default n
-
-config SND_SOC_RTK_HIFI_RT5650_MACHINE
-	tristate "Realtek hifi with rt5650 codec asoc machine Driver"
-	select SND_SOC_RT5645
 	select SND_SOC_HDMI_CODEC
 	default n
 
diff --git a/sound/soc/realtek/rtk-hifi-machine.c b/sound/soc/realtek/rtk-hifi-machine.c
index d204f77d55625..790317a438f7e 100644
--- a/sound/soc/realtek/rtk-hifi-machine.c
+++ b/sound/soc/realtek/rtk-hifi-machine.c
@@ -13,20 +13,18 @@
 #include <sound/soc.h>
 
 #include <sound/jack.h>
-#include "../codecs/rt5645.h"
 
 #define DP_CODEC_DAI	"spdif-hifi"
 #define HDMI_CODEC_DAI	"spdif-hifi"
 
 enum {
-	DAI_LINK_DL1_FE = 0,
+	DAI_LINK_AO0_BE = 0,
+	DAI_LINK_DL1_FE,
 	DAI_LINK_DL2_FE,
-	DAI_LINK_DL3_FE,
 	DAI_LINK_UL1_FE,
 	DAI_LINK_UL2_FE,
 	DAI_LINK_I2S,
 	DAI_LINK_I2S_LOOPBACK,
-	DAI_LINK_AO0_BE,
 	DAI_LINK_DMIC_BE,
 	DAI_LINK_DP_AUDIO_BE,
 	DAI_LINK_HDMI_AUDIO_BE,
@@ -48,11 +46,6 @@ SND_SOC_DAILINK_DEFS(DL2_FE,
 		     DAILINK_COMP_ARRAY(COMP_DUMMY()),
 		     DAILINK_COMP_ARRAY(COMP_EMPTY()));
 
-SND_SOC_DAILINK_DEFS(DL3_FE,
-		     DAILINK_COMP_ARRAY(COMP_CPU("DL3")),
-		     DAILINK_COMP_ARRAY(COMP_DUMMY()),
-		     DAILINK_COMP_ARRAY(COMP_EMPTY()));
-
 SND_SOC_DAILINK_DEFS(UL1_FE,
 		     DAILINK_COMP_ARRAY(COMP_CPU("UL1")),
 		     DAILINK_COMP_ARRAY(COMP_DUMMY()),
@@ -64,11 +57,13 @@ SND_SOC_DAILINK_DEFS(UL2_FE,
 		     DAILINK_COMP_ARRAY(COMP_EMPTY()));
 
 SND_SOC_DAILINK_DEFS(HDMI_AO, DAILINK_COMP_ARRAY(COMP_CPU("SOF_HDMI")),
-		     DAILINK_COMP_ARRAY(COMP_DUMMY()),
+		     DAILINK_COMP_ARRAY(COMP_CODEC(NULL,
+						HDMI_CODEC_DAI)),
                      DAILINK_COMP_ARRAY(COMP_EMPTY()));
 
 SND_SOC_DAILINK_DEFS(DP_AO, DAILINK_COMP_ARRAY(COMP_CPU("SOF_DP")),
-                     DAILINK_COMP_ARRAY(COMP_DUMMY()),
+                     DAILINK_COMP_ARRAY(COMP_CODEC(NULL,
+						HDMI_CODEC_DAI)),
 		     DAILINK_COMP_ARRAY(COMP_EMPTY()));
 /* BE */
 SND_SOC_DAILINK_DEFS(I2S0,
@@ -101,6 +96,6 @@ static struct snd_soc_jack rtk_hdmi_jack;
 static int rtk_hdmi_codec_init(struct snd_soc_pcm_runtime *rtd)
 {
 	struct snd_soc_jack *jack = &rtk_hdmi_jack;
-	struct snd_soc_component *cmpnt_codec =	asoc_rtd_to_codec(rtd,0)->component;
+	struct snd_soc_component *cmpnt_codec =	snd_soc_rtd_to_codec(rtd,0)->component;
 	int ret = 0;
 
@@ -128,6 +123,6 @@ static struct snd_soc_jack rtk_dp_jack;
 static int rtk_dp_codec_init(struct snd_soc_pcm_runtime *rtd)
 {
         struct snd_soc_jack *jack = &rtk_dp_jack;
-        struct snd_soc_component *cmpnt_codec = asoc_rtd_to_codec(rtd,0)->component;
+        struct snd_soc_component *cmpnt_codec = snd_soc_rtd_to_codec(rtd,0)->component;
         int ret = 0;
 
@@ -167,24 +162,30 @@ static struct snd_soc_dai_link rtk_hifi_dai_links[] = {
 		.name = "RDAI_HDMI",
 		.no_pcm = 1,
 		.dpcm_playback = 1,
+		.init = rtk_hdmi_codec_init,
 		SND_SOC_DAILINK_REG(HDMI_AO),
 	},
 	[DAI_LINK_DP_AUDIO_BE] = {
 		.name = "RDAI_DP",
 		.no_pcm = 1,
 		.dpcm_playback = 1,
+		.init = rtk_dp_codec_init,
 		SND_SOC_DAILINK_REG(DP_AO),
 	},
 	[DAI_LINK_AO0_BE] = {
 		.name = "RDAI_SOC_AO0",
 		.no_pcm = 1,
 		.dpcm_playback = 1,
+		.dai_fmt = SND_SOC_DAIFMT_I2S | SND_SOC_DAIFMT_NB_NF |
+			SND_SOC_DAIFMT_CBS_CFS,
 		SND_SOC_DAILINK_REG(AUDIO_OUT0),
 	},
 	[DAI_LINK_I2S] = {
 		.name = "RDAI_SOC_I2S",
 		.no_pcm = 1,
 		.dpcm_capture = 1,
+		.dai_fmt = SND_SOC_DAIFMT_I2S | SND_SOC_DAIFMT_NB_NF |
+			SND_SOC_DAIFMT_CBS_CFS,
 		SND_SOC_DAILINK_REG(I2S0),
 	},
 	[DAI_LINK_I2S_LOOPBACK] = {
@@ -195,7 +196,7 @@ static struct snd_soc_dai_link rtk_hifi_dai_links[] = {
 	},
 	[DAI_LINK_DL1_FE] = {
 		.name = "RDAI_DL1_FE",
-		.stream_name = "DL1 Playback",
+		.stream_name = "DL1 Playback - AO0",
 		.trigger = {
 			SND_SOC_DPCM_TRIGGER_POST,
 			SND_SOC_DPCM_TRIGGER_POST,
@@ -215,20 +216,9 @@ static struct snd_soc_dai_link rtk_hifi_dai_links[] = {
 		.dpcm_playback = 1,
 		SND_SOC_DAILINK_REG(DL2_FE),
 	},
-	[DAI_LINK_DL3_FE] = {
-		.name = "RDAI_DL3_FE",
-		.stream_name = "DL3 Playback",
-		.trigger = {
-			SND_SOC_DPCM_TRIGGER_POST,
-			SND_SOC_DPCM_TRIGGER_POST,
-		},
-		.dynamic = 1,
-		.dpcm_playback = 1,
-		SND_SOC_DAILINK_REG(DL3_FE),
-	},
 	[DAI_LINK_UL1_FE] = {
 		.name = "RDAI_UL1_FE",
-		.stream_name = "UL1 Capture",
+		.stream_name = "I2S0 Capture",
 		.trigger = {
 			SND_SOC_DPCM_TRIGGER_POST,
 			SND_SOC_DPCM_TRIGGER_POST,
@@ -239,7 +229,7 @@ static struct snd_soc_dai_link rtk_hifi_dai_links[] = {
 	},
 	[DAI_LINK_UL2_FE] = {
 		.name = "RDAI_UL2_FE",
-		.stream_name = "UL2 Capture",
+		.stream_name = "I2S0 Loopback Capture",
 		.trigger = {
 			SND_SOC_DPCM_TRIGGER_POST,
 			SND_SOC_DPCM_TRIGGER_POST,
@@ -396,34 +386,38 @@ static int rtk_hifi_dev_probe(struct platform_device *pdev)
 	/* assign the node of sof driver to platforms in dai_link */
 	for_each_card_prelinks(card, i, dai_link) {
 		dai_link->platforms->of_node = platform_node;
-		if (strcmp(dai_link->name, "RDAI_I2S") == 0 ||
-			   strcmp(dai_link->name, "RDAI_I2S1") == 0) {
+		if (strcmp(dai_link->name,"RDAI_HDMI") == 0){
 			card->dapm_routes = NULL;
 			card->num_dapm_routes = 0;//ARRAY_SIZE(rtk_hifi_routes),
-			dai_link->codecs->of_node = of_parse_phandle(dev->of_node, "realtek,audio-codec", 0);
-		} else if (strcmp(dai_link->name,"RDAI_HDMI") == 0){
 			codec_node = of_parse_phandle(dev->of_node, "realtek,hdmi-audio", 0);
 
-			if(of_device_is_available(codec_node)) {
-				dai_link->codecs->name = NULL;
-				dai_link->codecs->dai_name = HDMI_CODEC_DAI;
-				dai_link->codecs->of_node = codec_node;
-				dai_link->init = rtk_hdmi_codec_init;
-			} else
-				pr_info("Cant find CODEC,RDAI_HDMI use DUMMY CODEC");
+			if (!codec_node) {
+				pr_err("Can NOT find node realtek,hdmi-audio");
+				ret = -EINVAL;
+				goto put_exist_node;
+			}
+
+			dai_link->codecs->of_node = codec_node;
 		} else if (strcmp(dai_link->name, "RDAI_DP") == 0) {
                         codec_node = of_parse_phandle(dev->of_node, "realtek,dp-audio", 0);
 
-                        if(of_device_is_available(codec_node)) {
-				dai_link->codecs->name = NULL;
-				dai_link->codecs->dai_name = DP_CODEC_DAI;
-				dai_link->codecs->of_node = codec_node;
-				dai_link->init = rtk_dp_codec_init;
-                        } else
-				pr_info("Cant find CODEC,RDAI_DP use DUMMY CODEC");
-		} else if (strcmp(dai_link->name, "RDAI_SOC_AO0") == 0) {
+			if (!codec_node) {
+				pr_err("Can NOT find node realtek,dp-audio");
+				ret = -EINVAL;
+				goto put_exist_node;
+			}
+
+			dai_link->codecs->of_node = codec_node;
+		} else if (strcmp(dai_link->name, "RDAI_SOC_AO0") == 0 || strcmp(dai_link->name, "RDAI_SOC_I2S") == 0) {
 			card->dapm_routes = NULL;
 			card->num_dapm_routes = 0;//ARRAY_SIZE(rtk_hifi_routes),
+
+			codec_node = of_parse_phandle(dev->of_node, "realtek,audio-codec", 0);
+			if(!codec_node) {
+				pr_err("Cant find codec node for %s",dai_link->name);
+				return -EINVAL;
+			}
+			dai_link->codecs->of_node = codec_node;
 		}
 	}
 
diff --git a/sound/soc/sof/realtek/hifi-dsp.c b/sound/soc/sof/realtek/hifi-dsp.c
index 4a1cb313c272c..3b38944903c7b 100644
--- a/sound/soc/sof/realtek/hifi-dsp.c
+++ b/sound/soc/sof/realtek/hifi-dsp.c
@@ -867,6 +867,11 @@ static struct snd_soc_acpi_mach sof_rtk_machs[] = {
 		.drv_name = "rtk-hifi",
 		.sof_tplg_filename = "sof-adsp-rtd1920s.tplg",
 	},
+	{
+		.board = "realtek,rtd1501s",
+		.drv_name = "rtk-hifi",
+		.sof_tplg_filename = "sof-adsp-rtd1501s.tplg",
+	},
 	{},
 };
 
@@ -887,9 +892,28 @@ static struct sof_dev_desc snd_sof_rtd1920s_desc = {
 	.ops = &sof_hifi_ops,
 };
 
+static struct sof_dev_desc snd_sof_rtd1501s_desc = {
+        .machines = sof_rtk_machs,
+        .ipc_supported_mask     = BIT(SOF_IPC_TYPE_3),
+        .ipc_default            = SOF_IPC_TYPE_3,
+        .default_fw_path = {
+                [SOF_IPC_TYPE_3] = "sof",
+        },
+        .default_tplg_path = {
+                [SOF_IPC_TYPE_3] = "sof",
+        },
+        .default_fw_filename = {
+                [SOF_IPC_TYPE_3] = "sof-adsp-rtd1501s.ri",
+        },
+        .nocodec_tplg_filename = "",
+        .ops = &sof_hifi_ops,
+};
+
 static const struct of_device_id sof_of_rtk_ids[] = {
 	{ .compatible = "realtek,rtd1920s-hifi",
 	  .data = &snd_sof_rtd1920s_desc },
+	{ .compatible = "realtek,rtd1501s-hifi",
+	  .data = &snd_sof_rtd1501s_desc },
 	{},
 };
 MODULE_DEVICE_TABLE(of, sof_of_rtk_ids);
-- 
