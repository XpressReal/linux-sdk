 #define MAX_INST_HANDLE_SIZE (32*1024)
-#define MAX_NUM_INSTANCE 4
+#define MAX_NUM_INSTANCE 8
 #define MAX_NUM_VPU_CORE 1
 #define MAX_NUM_VCORE 1
 
