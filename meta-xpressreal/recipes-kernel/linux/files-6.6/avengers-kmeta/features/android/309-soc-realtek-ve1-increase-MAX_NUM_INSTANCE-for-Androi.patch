 #define PRODUCT_CODE_NOT_W_SERIES(x) (x == BODA950_CODE || x == CODA960_CODE || x == CODA980_CODE)
 #define MAX_INST_HANDLE_SIZE (32*1024)
-#define MAX_NUM_INSTANCE 4
