From d40abf5e5ff24ec2411fbb607f866b93e9a652aa Mon Sep 17 00:00:00 2001
From: edwardwu <edwardwu@realtek.com>
Date: Tue, 24 Mar 2026 16:03:05 +0800
Subject: [PATCH] soc: realtek: ve1: increase MAX_NUM_INSTANCE for Android CTS
 testGetMaxSupportedInstances

atest android.media.codec.cts.MediaCodecInstancesTest#testGetMaxSupportedInstances
---
 drivers/soc/realtek/kent/rtk_ve/ve1/ve1config.h     | 2 +-
 drivers/soc/realtek/rtd16xxb/rtk_ve/ve1/ve1config.h | 2 +-
 drivers/soc/realtek/rtk_ve/ve1/ve1config.h          | 2 +-
 3 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/drivers/soc/realtek/kent/rtk_ve/ve1/ve1config.h b/drivers/soc/realtek/kent/rtk_ve/ve1/ve1config.h
index 67c3d5956378d..a0173bfd187c1 100644
--- a/drivers/soc/realtek/kent/rtk_ve/ve1/ve1config.h
+++ b/drivers/soc/realtek/kent/rtk_ve/ve1/ve1config.h
@@ -36,7 +36,7 @@
 #define PRODUCT_CODE_W_SERIES(x) (x == WAVE420L_CODE || x == WAVE510_CODE || x == WAVE512_CODE || x == WAVE520_CODE)
 #define PRODUCT_CODE_NOT_W_SERIES(x) (x == BODA950_CODE || x == CODA960_CODE || x == CODA980_CODE)
 #define MAX_INST_HANDLE_SIZE (32*1024)
-#define MAX_NUM_INSTANCE 4
+#define MAX_NUM_INSTANCE 8
 #define MAX_NUM_VPU_CORE 1
 #define MAX_NUM_VCORE 1
 
diff --git a/drivers/soc/realtek/rtd16xxb/rtk_ve/ve1/ve1config.h b/drivers/soc/realtek/rtd16xxb/rtk_ve/ve1/ve1config.h
