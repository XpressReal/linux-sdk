 10 files changed, 98 insertions(+), 10 deletions(-)

diff --git a/arch/arm64/boot/dts/realtek/kent.dtsi b/arch/arm64/boot/dts/realtek/kent.dtsi
index e4da3fec27a7..5d5c193d4106 100644
--- a/arch/arm64/boot/dts/realtek/kent.dtsi
+++ b/arch/arm64/boot/dts/realtek/kent.dtsi
@@ -404,6 +404,21 @@ vcpu: vcpu {
 		status = "disabled";
 	};
 
+	vpu_legacy: vpu_legacy {
+		compatible = "realtek,kent-vpu-legacy";
+		interrupt-parent = <&gic>;
+		interrupts = <GIC_SPI 92 IRQ_TYPE_LEVEL_HIGH>;
+		realtek,krpc-agent = <&vcpu_kernel_agent>;
+		memory-region = <&cma_reserved_0>;
+		status = "disabled";
+	};
+
+	vpu_ve4: vcpu_ve4 {
+		compatible = "realtek,kent-vpu-ve4";
+		memory-region=<&cma_reserved_0>;
+		status = "disabled";
+	};
+
 	avcert_rproc: avcert-rproc {
 		compatible = "realtek,rtd-rproc-avcert";
 		firmware-name = "AFW_Certificate.bin";
diff --git a/arch/arm64/boot/dts/realtek/prince.dtsi b/arch/arm64/boot/dts/realtek/prince.dtsi
index 4382a7fdf8d6..326021fa2419 100644
