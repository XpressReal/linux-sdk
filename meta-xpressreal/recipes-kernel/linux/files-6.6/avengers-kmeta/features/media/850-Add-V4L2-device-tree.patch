 arch/arm64/boot/dts/realtek/kent.dtsi         | 15 +++++++++++
 arch/arm64/boot/dts/realtek/prince.dtsi       | 14 +++++++++++
 .../dts/realtek/rtd1315c-badassium-2gb.dts    |  6 +++++
 .../boot/dts/realtek/rtd1501s-phantom-8gb.dts |  8 ++++++
