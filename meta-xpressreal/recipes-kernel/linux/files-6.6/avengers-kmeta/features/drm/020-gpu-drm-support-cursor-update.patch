From ac2ca896bc5f742aa4b17cbd85e238d3e82595e3 Mon Sep 17 00:00:00 2001
From: "yichen.wang" <yichen.wang@realtek.com>
Date: Mon, 29 Jun 2026 16:50:43 +0800
Subject: [PATCH] gpu: drm: support cursor update

Signed-off-by: yichen.wang <yichen.wang@realtek.com>
---
 drivers/gpu/drm/realtek/rtk_drm_plane.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/drivers/gpu/drm/realtek/rtk_drm_plane.c b/drivers/gpu/drm/realtek/rtk_drm_plane.c
index d137ae64eff5e..41d22f762bdfa 100644
--- a/drivers/gpu/drm/realtek/rtk_drm_plane.c
+++ b/drivers/gpu/drm/realtek/rtk_drm_plane.c
@@ -74,6 +74,7 @@ static const unsigned int video_formats[] = {
 static const unsigned int other_formats[] = {
 	DRM_FORMAT_XRGB8888,
 	DRM_FORMAT_ARGB8888,
+	DRM_FORMAT_ABGR8888,
 	DRM_FORMAT_RGB565,
 };
 
@@ -1319,6 +1320,8 @@ static void rtk_plane_atomic_update(struct drm_plane *plane,
 		rtk_plane_update_video_obj(plane);
 	else if (plane->type == DRM_PLANE_TYPE_PRIMARY)
 		rtk_plane_update_graphic_obj(plane);
+	else if (plane->type == DRM_PLANE_TYPE_CURSOR)
+		rtk_plane_update_cursor(plane);
 	else {
 		DRM_DEBUG_DRIVER("Please consider putting %s on OVERLAY/PRIMARY\n",
 			plane_names[rtk_plane->layer_nr]);
-- 
2.50.1

