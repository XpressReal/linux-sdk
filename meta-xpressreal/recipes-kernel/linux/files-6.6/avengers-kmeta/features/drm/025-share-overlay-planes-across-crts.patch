diff --git a/drivers/gpu/drm/realtek/rtk_drm_crtc.h b/drivers/gpu/drm/realtek/rtk_drm_crtc.h
index 7ba5faf1498ee..575c6f6506abc 100644
--- a/drivers/gpu/drm/realtek/rtk_drm_crtc.h
+++ b/drivers/gpu/drm/realtek/rtk_drm_crtc.h
@@ -14,7 +14,25 @@
 #define OVERLAY_PLANE_MAX	2
 #define BUFLOCK_MAX		10
 
+/* z-order value that marks a mixer layer as unused/not present. */
+#define MIXER_LAYER_UNUSED 10
+/* default z-order for a present video layer (matches shared overlay plane_order). */
+#define MIXER_LAYER_DEFAULT_ORDER 0
+/* Maximum number of planes each mixer's hardware compositor can blend. */
+#define MIXER1_MAX_PLANES 8
+#define MIXER2_MAX_PLANES 6
+#define MIXER3_MAX_PLANES 4
+#define MIXER1_MAX_PLANE_ORDER (MIXER1_MAX_PLANES - 1)
+#define MIXER2_MAX_PLANE_ORDER (MIXER2_MAX_PLANES - 1)
+#define MIXER3_MAX_PLANE_ORDER (MIXER3_MAX_PLANES - 1)
+
+/* Upper bound of the mutable zpos property (largest per-mixer order).
+ * The core normalizes zpos per-CRTC and atomic_check caps plane count to
+ * the mixer capacity, so the value sent to hardware stays in range. */
+#define RTK_PLANE_MAX_ZPOS MIXER1_MAX_PLANE_ORDER
+
 #define to_rtk_crtc(s) container_of(s, struct rtk_drm_crtc, crtc)
+#define to_rtk_plane(s) container_of(s, struct rtk_drm_plane, plane)
