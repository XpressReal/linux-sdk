-			rtk_drm_fence_update(&rtk_crtc->nplanes[i]);
+	/* Service the out-fence of every plane routed to this mixer (shared
+	 * overlays live on crtc->dev, not this CRTC). rtk_fence is only set for
+	 * PRIMARY/OVERLAY. */
+	drm_for_each_plane(plane, crtc->dev) {
+		struct rtk_drm_plane *rtk_plane = to_rtk_plane(plane);
+
+		if (rtk_plane->rtk_fence && rtk_plane->mixer == rtk_crtc->mixer)
+			rtk_drm_fence_update(rtk_plane);
+	}
 
 	rtk_drm_vowb_isr(rtk_crtc->crtc.dev);
 
@@ -544,6 +635,98 @@ static void rtk_crtc_stats_init(struct rtk_drm_crtc *rtk_crtc)
 	stats->last_pageflip_count = 0;
 }
 
+#if defined(CONFIG_CHROME_PLATFORMS)
+static const struct soc_device_attribute rtk_soc_kent[] = {
+	{ .family = "Realtek Kent", },
+	{ /* sentinel */ }
+};
+
+/* Shared video overlay planes, assigned to a CRTC at commit time. Kent has 4
+ * (V1-V4), Stark 2 (V1-V2). */
+static const struct crtc_plane_data rtk_shared_overlay_kent[] = {
+	{ .layer_nr = VO_VIDEO_PLANE_V1,
+	  .type = DRM_PLANE_TYPE_OVERLAY,
+	  .plane_order = MIXER_LAYER_DEFAULT_ORDER },
+	{ .layer_nr = VO_VIDEO_PLANE_V2,
+	  .type = DRM_PLANE_TYPE_OVERLAY,
+	  .plane_order = MIXER_LAYER_DEFAULT_ORDER },
+	{ .layer_nr = VO_VIDEO_PLANE_V3,
+	  .type = DRM_PLANE_TYPE_OVERLAY,
+	  .plane_order = MIXER_LAYER_DEFAULT_ORDER },
+	{ .layer_nr = VO_VIDEO_PLANE_V4,
+	  .type = DRM_PLANE_TYPE_OVERLAY,
+	  .plane_order = MIXER_LAYER_DEFAULT_ORDER },
+};
+
+static const struct crtc_plane_data rtk_shared_overlay_stark[] = {
+	// If stark need shared video plane, uncomment this
+	// { .layer_nr = VO_VIDEO_PLANE_V1,
+	//   .type = DRM_PLANE_TYPE_OVERLAY,
+	//   .plane_order = MIXER_LAYER_DEFAULT_ORDER },
+	// { .layer_nr = VO_VIDEO_PLANE_V2,
+	//   .type = DRM_PLANE_TYPE_OVERLAY,
+	//   .plane_order = MIXER_LAYER_DEFAULT_ORDER },
+};
+
+/*
+ * Create the shared video overlay planes (usable by any CRTC), after all
+ * components are bound. They start on mixer 0 and inherit its panel usage
+ * until reassigned at commit time. Returns 0 on success, negative errno on
+ * failure.
+ */
+int rtk_crtc_create_additional_planes(struct drm_device *drm)
+{
+	struct rtk_drm_private *priv = drm->dev_private;
+	struct rtk_rpc_info *rpc_info = &priv->rpc_info[RTK_RPC_MAIN];
+	const struct crtc_plane_data *shared;
+	enum display_panel_usage usage = CHROME;
+	struct drm_crtc *crtc;
+	unsigned int num_shared;
+	int i;
+
+	drm_for_each_crtc(crtc, drm) {
+		struct rtk_drm_crtc *rtk_crtc = to_rtk_crtc(crtc);
+
+		if (rtk_crtc->mixer == 0) {
+			usage = rtk_crtc->display_panel_usage;
+			break;
+		}
+	}
+
+	if (soc_device_match(rtk_soc_kent)) {
+		shared = rtk_shared_overlay_kent;
+		num_shared = ARRAY_SIZE(rtk_shared_overlay_kent);
+	} else {
+		/* Default (Stark and others): 2 video overlay planes */
+		shared = rtk_shared_overlay_stark;
+		num_shared = ARRAY_SIZE(rtk_shared_overlay_stark);
+	}
+
+	for (i = 0; i < num_shared; i++) {
+		struct rtk_drm_plane *rtk_plane;
+
+		rtk_plane = kzalloc(sizeof(*rtk_plane), GFP_KERNEL);
+		if (!rtk_plane)
+			return -ENOMEM;
+
+		rtk_plane->mixer = DISPLAY_INTERFACE_MIXER_NONE;
+		rtk_plane->plane_order = shared[i].plane_order;
+		rtk_plane->display_panel_usage = usage;
+
+		if (rtk_plane_init(drm, rtk_plane,
+				   GENMASK(drm->mode_config.num_crtc - 1, 0),
+				   shared[i].type, shared[i].layer_nr,
+				   rpc_info)) {
+			DRM_ERROR("shared overlay plane %d init fail\n", i);
+			kfree(rtk_plane);
+			return -1;
+		}
+	}
+
+	return 0;
+}
