+	if (!new_state->crtc ||
+	    (old_state && new_state->crtc == old_state->crtc))
+		return 0;
+
+	/* CRTC has not released the plane in DRM yet */
+	if (old_state && old_state->crtc) {
+		DRM_INFO("%s: still owned by CRTC %d, not moving to CRTC %d\n",
+			  plane_names[rtk_plane->layer_nr],
