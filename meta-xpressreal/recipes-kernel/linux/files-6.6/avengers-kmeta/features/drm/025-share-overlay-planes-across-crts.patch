 #define to_rtk_crtc_state(s) container_of(s, struct rtk_crtc_state, base)
 
+/* Number of planes the given mixer's hardware compositor can blend. */
+static unsigned int rtk_mixer_max_planes(unsigned int mixer)
+{
+	switch (mixer) {
+	case DISPLAY_INTERFACE_MIXER1: return MIXER1_MAX_PLANES;
+	case DISPLAY_INTERFACE_MIXER2: return MIXER2_MAX_PLANES;
+	case DISPLAY_INTERFACE_MIXER3: return MIXER3_MAX_PLANES;
+	default:                       return MIXER1_MAX_PLANES;
+	}
+}
+
 #if defined(CONFIG_CHROME_PLATFORMS) || defined(CONFIG_YOCTO_PLATFORMS)
 static int rtk_crtc_set_mixer_order(struct rtk_rpc_info *rpc_info,
                struct rpc_disp_mixer_order *mixer_order)
@@ -49,10 +62,63 @@ static int rtk_crtc_set_mixer_order(struct rtk_rpc_info *rpc_info,
    if(!rpc_info)
        return -1;
 
+   DRM_INFO("%s: mixer=%u v1=%u v2=%u v3=%u v4=%u osd1=%u sub1=%u osd3=%u osd4=%u\n",
+       __func__, mixer_order->MixerNum,
+       mixer_order->v1, mixer_order->v2, mixer_order->v3, mixer_order->v4,
+       mixer_order->osd1, mixer_order->sub1, mixer_order->osd3, mixer_order->osd4);
+
    ret = rpc_set_mixer_order(rpc_info, mixer_order);
 
    return ret;
 }
+
+/* Store @order for @layer_nr in the mixer's per-layer z-order table. */
+static void rtk_mixer_order_set_layer(struct rpc_disp_mixer_order *order,
+				      enum VO_VIDEO_PLANE layer_nr,
+				      unsigned char value)
+{
+	switch (layer_nr) {
+	case VO_VIDEO_PLANE_V1:   order->v1 = value;   break;
+	case VO_VIDEO_PLANE_V2:   order->v2 = value;   break;
+	case VO_VIDEO_PLANE_V3:   order->v3 = value;   break;
+	case VO_VIDEO_PLANE_V4:   order->v4 = value;   break;
+	case VO_VIDEO_PLANE_SUB1: order->sub1 = value; break;
+	case VO_VIDEO_PLANE_SUB2: order->sub2 = value; break;
+	case VO_VIDEO_PLANE_OSD1: order->osd1 = value; break;
+	case VO_VIDEO_PLANE_OSD2: order->osd2 = value; break;
+	case VO_VIDEO_PLANE_OSD3: order->osd3 = value; break;
+	case VO_VIDEO_PLANE_OSD4: order->osd4 = value; break;
+	case VO_VIDEO_PLANE_CSR:  order->csr = value;  break;
+	default: break;
+	}
+}
+
+/* Rebuild @crtc's mixer z-order from the normalized zpos of the planes on it
+ * and resend it if it changed. Called from atomic_flush, once the planes'
+ * windows have been (re)configured. */
+static void rtk_crtc_program_mixer_order(struct drm_crtc *crtc)
+{
+	struct rtk_drm_crtc *rtk_crtc = to_rtk_crtc(crtc);
+	struct rpc_disp_mixer_order order;
+	struct drm_plane *plane;
+
+	memset(&order, MIXER_LAYER_UNUSED, sizeof(struct rpc_disp_mixer_order));
+	order.MixerNum = rtk_crtc->mixer;
+
+	drm_atomic_crtc_for_each_plane(plane, crtc) {
+		struct rtk_drm_plane *rtk_plane = to_rtk_plane(plane);
+
+		rtk_mixer_order_set_layer(&order, rtk_plane->layer_nr,
+					  plane->state->normalized_zpos);
+	}
+
+	if (!memcmp(&order, &rtk_crtc->mixer_order, sizeof(order)))
+		return;
+
+	rtk_crtc->mixer_order = order;
+	if (rtk_crtc_set_mixer_order(rtk_crtc->rpc_info, &order))
+		DRM_ERROR("rtk crtc set mixer order fail\n");
+}
 #endif
 
