From 6fd1f253609332f79a9c4b4f580650a4d2786680 Mon Sep 17 00:00:00 2001
From: yaozenhu <yaozenhu@realtek.com>
Date: Tue, 16 Jun 2026 21:16:04 -0400
Subject: [PATCH] gpu: drm: provide XB24 to primary plane

License: GPLv2
Source: Realtek
---
 drivers/gpu/drm/realtek/rtk_drm_plane.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/drivers/gpu/drm/realtek/rtk_drm_plane.c b/drivers/gpu/drm/realtek/rtk_drm_plane.c
index 3831e9f46d958..d137ae64eff5e 100644
--- a/drivers/gpu/drm/realtek/rtk_drm_plane.c
+++ b/drivers/gpu/drm/realtek/rtk_drm_plane.c
@@ -48,6 +48,7 @@ static const unsigned int osd_formats[] = {
 	DRM_FORMAT_ARGB8888,
 	DRM_FORMAT_BGRA8888,
 	DRM_FORMAT_ABGR8888,
+	DRM_FORMAT_XBGR8888,
 	DRM_FORMAT_RGBA8888,
 	DRM_FORMAT_RGB565,
 	DRM_FORMAT_ARGB4444,
@@ -694,6 +695,11 @@ static int rtk_plane_update_graphic_obj(struct drm_plane *plane)
 		case DRM_FORMAT_RGBA8888:
 			obj->format = INBAND_CMD_GRAPHIC_FORMAT_RGBA8888_LITTLE;
 			break;
+		case DRM_FORMAT_XBGR8888:
+			flags |= eBuffer_USE_GLOBAL_ALPHA;
+			obj->alpha = 0x3ff;
+			obj->format = INBAND_CMD_GRAPHIC_FORMAT_RGBA8888;
+			break;
 		case DRM_FORMAT_ABGR8888:
 			obj->format = INBAND_CMD_GRAPHIC_FORMAT_RGBA8888;
 			break;
-- 
2.34.1

