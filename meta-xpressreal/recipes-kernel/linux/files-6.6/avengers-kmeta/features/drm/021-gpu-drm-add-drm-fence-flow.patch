+/**
+ * rtk_crtc_commit_count - Increment commit counter
+ * @rtk_crtc: rtk_drm_crtc
+ *
+ * Called in rtk_crtc_atomic_flush()
+ */
+static inline void rtk_crtc_commit_count(struct rtk_drm_crtc *rtk_crtc)
+{
+    atomic64_inc(&rtk_crtc->stats.commit_count);
+}
+
+/**
+ * rtk_crtc_pageflip_count - Increment pageflip counter
+ * @rtk_crtc: rtk_drm_crtc
+ *
+ * Called in rtk_crtc_finish_page_flip()
+ */
+static inline void rtk_crtc_pageflip_count(struct rtk_drm_crtc *rtk_crtc)
+{
+    atomic64_inc(&rtk_crtc->stats.pageflip_count);
+}
+
 void rtk_crtc_finish_page_flip(struct drm_crtc *crtc)
+{
+    struct rtk_drm_crtc *rtk_crtc = to_rtk_crtc(crtc);
+
+    if (rtk_crtc->event) {
+        rtk_crtc_pageflip_count(rtk_crtc);
+        drm_crtc_send_vblank_event(crtc, rtk_crtc->event);
+        drm_crtc_vblank_put(crtc);
+        rtk_crtc->event = NULL;
+    } else {
+        trace_rtk_drm_func_event(TRACE_NO_PENDING_EVENT);
+    }
+}
