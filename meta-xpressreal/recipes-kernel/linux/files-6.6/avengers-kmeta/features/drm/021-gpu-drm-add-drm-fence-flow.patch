-static void fence_signal_worker(struct drm_flip_work *work, void *val)
+/*
+ * Returns true if context a is strictly before b in the CONTEXT_SIZE circular
+ * sequence, using a half-window to handle wrap-around.  Covers skipped-frame
+ * cases where (b - a) > 1, which the original strict a+1==b check missed.
+ */
+static bool fence_idx_before(unsigned int a, unsigned int b)
 {
-	struct rtk_dma_fence *fence = val;
+	unsigned int diff = (b - a) & (CONTEXT_SIZE - 1);
 
-	DRM_DEBUG_DRIVER("signal out-fence[%d] : (%p) (%p)\n", fence->idx, fence , fence->fence);
+	return diff > 0 && diff < (CONTEXT_SIZE / 2);
+}
+
+static bool video_fence_idx_before(unsigned int a, unsigned int b)
+{
+	unsigned int diff = (b - a) % PLOCK_BUFFER_SET_SIZE;
 
+	return diff > 0 && diff < (PLOCK_BUFFER_SET_SIZE / 2);
+}
+
+static void fence_signal_free(struct rtk_dma_fence *fence)
+{
+	list_del(&fence->node);
 	dma_fence_signal(fence->fence);
 	dma_fence_put(fence->fence);
-
 	kfree(fence);
 }
 
