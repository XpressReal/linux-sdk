+static void rtk_crtc_stats_init(struct rtk_drm_crtc *rtk_crtc)
+{
+	struct rtk_crtc_stats *stats = &rtk_crtc->stats;
+
+	atomic64_set(&stats->commit_count, 0);
+	atomic64_set(&stats->pageflip_count, 0);
+	stats->start_time = ktime_get();
+	stats->last_read_time = 0;
+	stats->last_commit_count = 0;
+	stats->last_pageflip_count = 0;
+}
