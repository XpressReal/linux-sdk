From 8aabbaefb0c9a2333000c062ed43b4b2299e5e23 Mon Sep 17 00:00:00 2001
From: yaozenhu <yaozenhu@realtek.com>
Date: Tue, 26 Aug 2025 03:48:17 -0400
Subject: [PATCH] dts: hdmi only mode for gamepad on backinblack

---
 arch/arm64/boot/dts/realtek/rtd1619b-backinblack-2gb.dts | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/arch/arm64/boot/dts/realtek/rtd1619b-backinblack-2gb.dts b/arch/arm64/boot/dts/realtek/rtd1619b-backinblack-2gb.dts
index a9ff6cf5a646..507b366648f1 100644
--- a/arch/arm64/boot/dts/realtek/rtd1619b-backinblack-2gb.dts
+++ b/arch/arm64/boot/dts/realtek/rtd1619b-backinblack-2gb.dts
@@ -39,7 +39,7 @@ bootlogo {
 };
 
 &display_subsystem {
-	ports = <&voext_out>, <&vo_out>;
+	ports =  <&vo_out>;
 	status = "okay";
 };
 
@@ -49,11 +49,11 @@ &vowb {
 
 &vo {
 	status = "okay";
-	compatible = "realtek,rtd-crtc-main";
+	compatible = "realtek,rtd-crtc-main-all";
 };
 
 &voext {
-	status = "okay";
+	status = "disabled";
 	compatible = "realtek,rtd-crtc-ext";
 	voext_out: port {
 		voext_out_dsi: endpoint {
@@ -63,7 +63,7 @@ voext_out_dsi: endpoint {
 };
 
 &dsi {
-	status = "okay";
+	status = "disabled";
 
 	ports {
 		dsi_in: port@0 {
-- 
2.34.1

