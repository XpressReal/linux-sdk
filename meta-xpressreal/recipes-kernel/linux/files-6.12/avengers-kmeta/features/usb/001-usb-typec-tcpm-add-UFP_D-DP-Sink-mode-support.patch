Subject: [PATCH] usb: typec: tcpm: add UFP_D (DP Sink) mode support

---
 drivers/usb/typec/tcpm/tcpm.c | 398 +++++++++++++++++++++++++++++++++-
 1 file changed, 387 insertions(+), 11 deletions(-)

diff --git a/drivers/usb/typec/tcpm/tcpm.c b/drivers/usb/typec/tcpm/tcpm.c
index e8cda34eedba..7197021036ff 100644
--- a/drivers/usb/typec/tcpm/tcpm.c
+++ b/drivers/usb/typec/tcpm/tcpm.c
@@ -28,6 +28,7 @@
 #include <linux/usb/pd_bdo.h>
 #include <linux/usb/pd_ext_sdb.h>
 #include <linux/usb/pd_vdo.h>
+#include <linux/usb/typec_dp.h>
 #include <linux/usb/role.h>
 #include <linux/usb/tcpm.h>
 #include <linux/usb/typec_altmode.h>
@@ -587,6 +588,11 @@ struct tcpm_port {
 	int logbuffer_tail;
 	u8 *logbuffer[LOG_BUFFER_ENTRIES];
 #endif
+
+	/* Hybrid DR_Swap support for passive cables and alt mode */
+	struct hrtimer dr_swap_wait_timer;
+	struct kthread_work dr_swap_wait_work;
+	bool waiting_for_partner_dr_swap;
 };
 
 struct pd_rx_event {
@@ -1888,6 +1894,101 @@ static void tcpm_register_plug_altmodes(struct tcpm_port *port)
 	}
