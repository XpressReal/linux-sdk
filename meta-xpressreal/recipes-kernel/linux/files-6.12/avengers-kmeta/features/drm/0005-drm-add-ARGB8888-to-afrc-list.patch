From fcaafe34222b4daa44b5d2ff094e580509c272ef Mon Sep 17 00:00:00 2001
From: yaozenhu <yaozenhu@realtek.com>
Date: Sun, 17 May 2026 20:56:21 -0400
Subject: [PATCH] drm: add ARGB8888 to afrc list

License: GPLv2
Source: Realtek
---
 drivers/gpu/drm/realtek/rtk_drm_fb.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/drivers/gpu/drm/realtek/rtk_drm_fb.c b/drivers/gpu/drm/realtek/rtk_drm_fb.c
index fbbd1445b750..83de74000182 100644
--- a/drivers/gpu/drm/realtek/rtk_drm_fb.c
+++ b/drivers/gpu/drm/realtek/rtk_drm_fb.c
@@ -33,6 +33,8 @@ struct rtk_drm_fb {
 static const struct drm_format_info rtk_afrc_mod_format[] = {
 	{ .format = DRM_FORMAT_ABGR8888, .depth = 32, .num_planes = 1,
 	  .char_per_block = { 1, 0, 0 }, .hsub = 1, .vsub = 1, .has_alpha = true },
+	{ .format = DRM_FORMAT_ARGB8888, .depth = 32, .num_planes = 1,
+	  .char_per_block = { 1, 0, 0 }, .hsub = 1, .vsub = 1, .has_alpha = true },
 };
 
 struct drm_gem_object *rtk_fb_get_gem_obj(struct drm_framebuffer *fb,
-- 
2.34.1

