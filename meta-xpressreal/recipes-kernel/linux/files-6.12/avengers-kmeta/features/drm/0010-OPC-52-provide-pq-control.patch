 };
 
 enum VO_HDMI_OFF_MODE {
@@ -807,6 +829,11 @@ enum ENUM_VIDEO_KEEP_CUR_SVP_TYPE {
 	ENUM_VIDEO_KEEP_CUR_SVP_TYPE_GET_FW_MALLOC_SVP_BUFFER = 2
 };
 
+struct rtk_pqstatus {
+	uint32_t type;
+	uint32_t value;
+};
+
 struct inband_cmd_pkg_header {
 	enum INBAND_CMD_TYPE type;
 	unsigned int size;
@@ -2125,5 +2152,6 @@ int rpc_query_mixer_by_plane(struct rtk_rpc_info *rpc_info,
 				struct rpc_query_mixer_by_plane_in *argp_in,
 				struct rpc_query_mixer_by_plane_out *argp_out);
 
-int rpc_set_dlsr_enable(struct rtk_rpc_info *rpc_info, unsigned int enable);
+int rpc_set_pq_status(struct rtk_rpc_info *rpc_info, struct rtk_pqstatus *pqstatus);
+int rpc_get_pq_status(struct rtk_rpc_info *rpc_info, struct rtk_pqstatus *pqstatus);
 #endif
