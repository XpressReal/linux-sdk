From a1e98554c3be223d1c4fb05e10de09dc47c93856 Mon Sep 17 00:00:00 2001
From: yaozenhu <yaozenhu@realtek.com>
Date: Wed, 1 Apr 2026 05:25:00 -0400
Subject: [PATCH] kernel: dma_heap: adjust memory layout for AIOT project

---
 .../dts/realtek/rtd1761b-rose-8gb-hdmi.dts    | 29 +++++++++++++++----
 drivers/dma-buf/heaps/rtk_media_heap.c        |  8 ++---
 include/soc/realtek/memory.h                  |  6 ++++
 3 files changed, 34 insertions(+), 9 deletions(-)

diff --git a/drivers/dma-buf/heaps/rtk_media_heap.c b/drivers/dma-buf/heaps/rtk_media_heap.c
index ee8f6652ffeb..097a425ec7d4 100644
--- a/drivers/dma-buf/heaps/rtk_media_heap.c
+++ b/drivers/dma-buf/heaps/rtk_media_heap.c
@@ -215,7 +215,7 @@ RTK_DEVNAME_DEF(HIFI,
 		);
 
 RTK_DEVNAME_DEF(HEAP_B1P5,
-		COMP_ARRAY(COMP_DEV("heap-high",
+		COMP_ARRAY(COMP_DEV("vo_non-ve2",
 					 0),
 				)
 		);
@@ -314,7 +314,7 @@ static struct rtk_heap_data rheap_data[] = {
 		.flags = (RTK_FLAG_SCPUACC |
 			RTK_FLAG_HWIPACC | RTK_FLAG_CMA | RTK_FLAG_VCPU_FWACC |
 			RTK_FLAG_ACPUACC | RTK_FLAG_PROTECTED_DYNAMIC |
-			RTK_FLAG_PROTECTED_V2_VO_POOL |
+			RTK_FLAG_PROTECTED_V2_VO_POOL | RTK_FLAG_VO_U_POOL |
 			RTK_FLAG_SUPPORT_NONCACHED |
 			RTK_FLAG_SKIP_ZERO),
 		.penalty = 3000,
@@ -483,9 +483,9 @@ static struct rtk_heap_data rheap_data[] = {
 		.name = "heap_b1p5",
 		.flags = (RTK_FLAG_SCPUACC |
 			RTK_FLAG_HWIPACC | RTK_FLAG_CMA |
-			RTK_FLAG_SUPPORT_NONCACHED |
+			RTK_FLAG_SUPPORT_NONCACHED | RTK_FLAG_VO_POOL |
 			RTK_FLAG_SKIP_ZERO),
-		.penalty = ULONG_MAX,
+		.penalty = 1500,
 		RTK_DEVNAME_REG(HEAP_B1P5),
 	},
 
diff --git a/include/soc/realtek/memory.h b/include/soc/realtek/memory.h
index c4562e7707e7..74f5abe6293b 100644
--- a/include/soc/realtek/memory.h
+++ b/include/soc/realtek/memory.h
@@ -38,6 +38,8 @@
 	 RTK_FLAG_PROTECTED_EXT_BIT2)
 
 #define RTK_FLAG_HIFIACC	(1U << 15)
+#define RTK_FLAG_VO_U_POOL (1U << 18)
+#define RTK_FLAG_VO_POOL (1U << 19)
 
 #define RTK_FLAG_TOC_MASK						       \
 	(RTK_FLAG_HIFIACC)
@@ -149,6 +151,8 @@
 	RTK_FLAG_VCPU_FWACC | \
 	RTK_FLAG_HIFIACC | \
 	RTK_FLAG_CMA | \
+	RTK_FLAG_VO_POOL | \
+	RTK_FLAG_VO_U_POOL | \
 	RTK_FLAG_SKIP_ZERO)
 
 
@@ -185,6 +189,8 @@ static struct rtk_heap_table rtk_heap_flags[] = {
 	DUMP_FLAG(RTK_FLAG_NONCACHED),
 	DUMP_FLAG(RTK_FLAG_HIFIACC),
 	DUMP_FLAG(RTK_FLAG_SKIP_ZERO),
+	DUMP_FLAG(RTK_FLAG_VO_POOL),
+	DUMP_FLAG(RTK_FLAG_VO_U_POOL),
 };
 
 #define MAX_WORD 60
-- 
2.34.1

