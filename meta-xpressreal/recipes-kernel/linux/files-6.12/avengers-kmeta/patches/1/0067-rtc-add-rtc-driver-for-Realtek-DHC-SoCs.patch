From e61cf2d7ed43217c04b91af01776c6e8c723a58f Mon Sep 17 00:00:00 2001
From: James Tai <james.tai@realtek.com>
Date: Mon, 17 Mar 2025 14:51:17 +0800
Subject: [PATCH 67/73] rtc: add rtc driver for Realtek DHC SoCs

Change-Id: I4b81430778b1e04a65e8b5faa9207ffc38bff513
---
 drivers/rtc/Kconfig  | 6 ++++++
 drivers/rtc/Makefile | 1 +
 2 files changed, 7 insertions(+)

diff --git a/drivers/rtc/Kconfig b/drivers/rtc/Kconfig
index 66eb1122248b6..1987cbdb7a467 100644
--- a/drivers/rtc/Kconfig
+++ b/drivers/rtc/Kconfig
@@ -1372,6 +1372,12 @@ config RTC_DRV_NTXEC
 	  embedded controller found in certain e-book readers designed by the
 	  original design manufacturer Netronix.
 
+config RTC_DRV_RTK
+	tristate "Realtek RTC"
+	depends on ARCH_REALTEK
+	select MFD_SYSCON
+	help
+	  Realtek RTC support.
 comment "on-CPU RTC drivers"
 
 config RTC_DRV_ASM9260
diff --git a/drivers/rtc/Makefile b/drivers/rtc/Makefile
index f62340ecc5348..d1a6d8ed6b1ee 100644
--- a/drivers/rtc/Makefile
+++ b/drivers/rtc/Makefile
@@ -191,3 +191,4 @@ obj-$(CONFIG_RTC_DRV_WM8350)	+= rtc-wm8350.o
 obj-$(CONFIG_RTC_DRV_X1205)	+= rtc-x1205.o
 obj-$(CONFIG_RTC_DRV_XGENE)	+= rtc-xgene.o
 obj-$(CONFIG_RTC_DRV_ZYNQMP)	+= rtc-zynqmp.o
+obj-$(CONFIG_RTC_DRV_RTK)	+= rtc-rtk.o
-- 
2.47.0

