From 8237e99beddc3ab6d5f228f11ef248c71d51e1b7 Mon Sep 17 00:00:00 2001
From: James Tai <james.tai@realtek.com>
Date: Sun, 16 Mar 2025 22:48:35 +0800
Subject: [PATCH 41/73] media: rc: add irda driver for Realtek DHC SoCs

Change-Id: Ie693b2dbacfbfab87af78da3e44489c685d2db43
---
 drivers/media/rc/Kconfig          | 1 +
 drivers/media/rc/Makefile         | 1 +
 drivers/media/rc/keymaps/Makefile | 1 +
 3 files changed, 3 insertions(+)

diff --git a/drivers/media/rc/Kconfig b/drivers/media/rc/Kconfig
index 74d69ce22a33e..369d8901ee362 100644
--- a/drivers/media/rc/Kconfig
+++ b/drivers/media/rc/Kconfig
@@ -472,6 +472,7 @@ config RC_XBOX_DVD
 	   called xbox_remote.
 
 source "drivers/media/rc/img-ir/Kconfig"
+source "drivers/media/rc/rtk-ir/Kconfig"
 
 endif #RC_DEVICES
 
diff --git a/drivers/media/rc/Makefile b/drivers/media/rc/Makefile
index 2bca6f7f07bc9..e47664c5da21d 100644
--- a/drivers/media/rc/Makefile
+++ b/drivers/media/rc/Makefile
@@ -54,3 +54,4 @@ obj-$(CONFIG_RC_ATI_REMOTE) += ati_remote.o
 obj-$(CONFIG_RC_LOOPBACK) += rc-loopback.o
 obj-$(CONFIG_RC_ST) += st_rc.o
 obj-$(CONFIG_RC_XBOX_DVD) += xbox_remote.o
+obj-$(CONFIG_IR_RTK) += rtk-ir/
diff --git a/drivers/media/rc/keymaps/Makefile b/drivers/media/rc/keymaps/Makefile
index 7fdf0d9edbfd3..2c80f6445570f 100644
--- a/drivers/media/rc/keymaps/Makefile
+++ b/drivers/media/rc/keymaps/Makefile
@@ -105,6 +105,7 @@ obj-$(CONFIG_RC_MAP) += \
 			rc-pv951.o \
 			rc-rc6-mce.o \
 			rc-real-audio-220-32-keys.o \
+			rc-realtek-dhc.o \
 			rc-reddo.o \
 			rc-snapstream-firefly.o \
 			rc-streamzap.o \
