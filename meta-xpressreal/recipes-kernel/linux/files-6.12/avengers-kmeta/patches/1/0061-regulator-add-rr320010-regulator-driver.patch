From d453e24879240f48ecd312863080f328d866cdd7 Mon Sep 17 00:00:00 2001
From: James Tai <james.tai@realtek.com>
Date: Mon, 17 Mar 2025 14:29:56 +0800
Subject: [PATCH 61/73] regulator: add rr320010-regulator driver

Change-Id: Ib5b92c75a01962eb5c4f4beb15c295393ae74c79
---
 drivers/regulator/Kconfig  | 7 +++++++
 drivers/regulator/Makefile | 1 +
 2 files changed, 8 insertions(+)

diff --git a/drivers/regulator/Kconfig b/drivers/regulator/Kconfig
index cabbcddbda38e..9f1a7839dc3e6 100644
--- a/drivers/regulator/Kconfig
+++ b/drivers/regulator/Kconfig
@@ -1739,4 +1739,11 @@ config REGULATOR_APW8886
 	help
 	  This driver provides support for the voltage regulators on the
 	  Anpec APW8886.
+
+config REGULATOR_RR320010
+	tristate "Renesas RR320010 Power regulators"
+	depends on MFD_RR320010_I2C
+	help
+	  This driver provides support for the voltage regulators on the
+	  Renesas RR320010 PMIC.
 endif
diff --git a/drivers/regulator/Makefile b/drivers/regulator/Makefile
index 261b6c70b610f..f4188ceabfd30 100644
--- a/drivers/regulator/Makefile
+++ b/drivers/regulator/Makefile
@@ -204,5 +204,6 @@ obj-$(CONFIG_REGULATOR_WM8994) += wm8994-regulator.o
 obj-$(CONFIG_REGULATOR_APW888X_CORE) += apw888x-regulator-core.o
 obj-$(CONFIG_REGULATOR_APW8889) += apw8889-regulator.o
 obj-$(CONFIG_REGULATOR_APW8886) += apw8886-regulator.o
+obj-$(CONFIG_REGULATOR_RR320010) += rr320010-regulator.o
 
 ccflags-$(CONFIG_REGULATOR_DEBUG) += -DDEBUG
-- 
2.47.0

