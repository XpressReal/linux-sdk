From 1e8aa8740ac652f6d0ef9a76f4b85941ff35e9f4 Mon Sep 17 00:00:00 2001
From: Edgar Lee <cylee12@realtek.com>
Date: Thu, 29 May 2025 15:51:23 +0800
Subject: [PATCH 14/33] input: misc: Add Realtek LSADC knob driver

Add a new driver, rtk_lsadc_knob, to support rotary knobs connected
to a Realtek LSADC controller.

This driver functions as a consumer of an IIO LSADC channel. It leverages
the ADC's hardware compare-block ("cmpblk") feature to receive callbacks
when the knob's voltage output enters specific "low" and "high" ranges.
These ranges are defined in the devicetree via the "realtek,vscfg"
property.

A workqueue is used to process the sequence and duration of these voltage
states. By analyzing the transitions (e.g., LOW -> HIGH vs. HIGH -> LOW),
the driver decodes the input as clockwise or anti-clockwise rotation.

The driver registers an input device (EV_KEY) and reports two distinct
keycodes, specified in the "linux,keycodes" DT property, to represent
the two rotation directions.

Finally, this adds the necessary Kconfig option (INPUT_REALTEK_LSADC_KNOB),
Makefile entry, and tracepoints for debugging.

Change-Id: I2c39ce928d36b3cfec98d45f7526926a2df7b179
---
 drivers/input/misc/Kconfig  | 22 ++++++++++++++++++++++
 drivers/input/misc/Makefile |  1 +
 2 files changed, 23 insertions(+)

diff --git a/drivers/input/misc/Kconfig b/drivers/input/misc/Kconfig
index 6a852c76331b6..2804f4dc0c849 100644
--- a/drivers/input/misc/Kconfig
+++ b/drivers/input/misc/Kconfig
@@ -956,4 +956,26 @@ config INPUT_STPMIC1_ONKEY
 	  To compile this driver as a module, choose M here: the
 	  module will be called stpmic1_onkey.
 
+config INPUT_REALTEK_LSADC_KNOB
+	tristate "Realtek LSADC knob support"
+	depends on IIO
+	select IIO_BUFFER_CB
+	help
+	  Say Y or M here to enable support for rotary knobs connected to
+	  a Realtek LSADC.
+
+	  This driver operates as an IIO framework consumer. It uses the
+	  LSADC's hardware compare block feature to monitor the analog
+	  voltage levels generated by the knob. By analyzing the sequence
+	  and duration of these voltage states (e.g., low-to-high or
+	  high-to-low), it decodes the knob's rotation into clockwise and
+	  anti-clockwise movements.
+
+	  These rotation events are then reported to the input subsystem
+	  as distinct key presses (e.g., KEY_VOLUMEUP / KEY_VOLUMEDOWN).
+	  The driver requires configuration via a devicetree node.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called rtk_lsadc_knob.
+
 endif
diff --git a/drivers/input/misc/Makefile b/drivers/input/misc/Makefile
index 4f7f736831ba8..518368d54c042 100644
--- a/drivers/input/misc/Makefile
+++ b/drivers/input/misc/Makefile
@@ -92,3 +92,4 @@ obj-$(CONFIG_INPUT_WM831X_ON)		+= wm831x-on.o
 obj-$(CONFIG_INPUT_XEN_KBDDEV_FRONTEND)	+= xen-kbdfront.o
 obj-$(CONFIG_INPUT_YEALINK)		+= yealink.o
 obj-$(CONFIG_INPUT_IDEAPAD_SLIDEBAR)	+= ideapad_slidebar.o
+obj-$(CONFIG_INPUT_REALTEK_LSADC_KNOB)	+= rtk_lsadc_knob.o
-- 
