From e2ea4d674fe0515675a263b220e595d9e52d5485 Mon Sep 17 00:00:00 2001
From: TY Chang <tychang@realtek.com>
Date: Fri, 31 Oct 2025 13:05:49 +0800
Subject: [PATCH 10/33] net: ethernet: realtek: Add r8127 nic support

Change-Id: Id4815591f2ce28169fefaaf3b9a39529eb246328
---
 drivers/net/ethernet/realtek/Kconfig  | 11 +++++++++++
 drivers/net/ethernet/realtek/Makefile |  1 +
 2 files changed, 12 insertions(+)

diff --git a/drivers/net/ethernet/realtek/Kconfig b/drivers/net/ethernet/realtek/Kconfig
index 687bae596a31b..06fcb909690dc 100644
--- a/drivers/net/ethernet/realtek/Kconfig
+++ b/drivers/net/ethernet/realtek/Kconfig
@@ -194,4 +194,15 @@ config R8126
 
 	  To compile this driver as a module, choose M here: the module
 
+config R8127
+	tristate "Realtek 8127 10 gigabit ethernet support"
+	depends on PCI
+	select FW_LOADER
+	select CRC32
+	select MII
+	help
+	  Say Y here if you have a Realtek 8127 PCI 10 Gigabit Ethernet adapter.
+
+	  To compile this driver as a module, choose M here: the module
+
 endif # NET_VENDOR_REALTEK
diff --git a/drivers/net/ethernet/realtek/Makefile b/drivers/net/ethernet/realtek/Makefile
index 2fdf6166bbe5a..c8f78e70cfb1a 100644
--- a/drivers/net/ethernet/realtek/Makefile
+++ b/drivers/net/ethernet/realtek/Makefile
@@ -15,3 +15,4 @@ obj-$(CONFIG_R8169SOC) += r8169soc.o
 obj-$(CONFIG_R8168) += r8168/
 obj-$(CONFIG_R8125) += r8125/
 obj-$(CONFIG_R8126) += r8126/
+obj-$(CONFIG_R8127) += r8127/
-- 
2.47.0

