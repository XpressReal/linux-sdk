#generic kernel configration and patches for DHC avengers SoC

include patches/avengers.scc
include features/usb/usb.scc
include features/rtknic/rtknic.scc
include features/mtd/spi.scc
include features/tee/dts.scc
include features/sdcard/sdcard.scc

kconf non-hardware features/android/namespace.cfg
kconf non-hardware features/blk/blk.cfg
kconf non-hardware features/fs/fs.cfg
kconf hardware features/hw/ata.cfg
kconf hardware features/hw/pcie.cfg
