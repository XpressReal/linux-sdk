	};

	uart1_vsel_1v8_pins: uart1-vsel-1v8_pins {
		pins = "gpio_8", "gpio_9", "gpio_10", "gpio_11";
		power-source = <0>;
		realtek,input_volt = <0>;
	};

	uart1_vsel_3v3_pins: uart1-vsel-3v3_pins {
		pins = "gpio_8", "gpio_9", "gpio_10", "gpio_11";
		power-source = <1>;
		realtek,input_volt = <1>;
	};

	pwm0_loc1_pins: pwm0-loc1-pins {
		pins = "gpio_64";
		function = "pwm0_loc1";
	};

	pwm1_loc1_pins: pwm1-loc1-pins {
