		function = "pcm";
	};

	eio_irq5_pins: eio_irq5-pins {
		pins = "gpio_76";
		function = "eio_irq5";
	};

	sd_pins: sd-pins {
		pins = "gpio_44", "gpio_45", "hif_clk", "hif_data", "hif_en", "hif_rdy";
		function = "sd";
	};

	sd_vsel_3v3_pins: sd-vsel-3v3-pins {
		pins = "gpio_44", "gpio_45", "hif_clk", "hif_data", "hif_en", "hif_rdy";
		power-source = <1>;
	};

	sd_vsel_1v8_pins: sd-vsel-1v8-pins {
		pins = "gpio_44", "gpio_45", "hif_clk", "hif_data", "hif_en", "hif_rdy";
		power-source = <0>;
	};

	sd_3v3_drv_pins: sd-3v3-drv-pins {
		mux {
			pins = "gpio_44", "gpio_45", "hif_clk", "hif_data", "hif_en", "hif_rdy";
			function = "sd";
		};

		conf {
			pins = "gpio_44", "gpio_45", "hif_clk", "hif_data", "hif_en", "hif_rdy";
			realtek,pdrive = <0>;
			realtek,ndrive = <0>;
		};
	};

	sd_1v8_drv_pins: sd-1v8-drv-pins {
		mux {
			pins = "gpio_44", "gpio_45", "hif_clk", "hif_data", "hif_en", "hif_rdy";
			function = "sd";
		};

		conf {
			pins = "gpio_44", "gpio_45", "hif_clk", "hif_data", "hif_en", "hif_rdy";
			realtek,pdrive = <4>;
			realtek,ndrive = <4>;
		};
	};

	sd_pud_cfg_pins: sd-pud-cfg-pins {
		mux {
			pins = "gpio_44", "gpio_45", "hif_clk", "hif_data", "hif_en", "hif_rdy";
			function = "sd";
		};

		conf-pull-disable {
			pins = "gpio_45";
			bias-disable;
		};

		conf-pull-up {
			pins = "hif_en";
			bias-pull-up = <1>;
		};
	};

	nf_pins: nf-pins {
		pins = "emmc_data_0", "emmc_data_1", "emmc_data_2", "emmc_data_3", "emmc_data_4",
		       "emmc_data_5";
		function = "nf";
	};

	emmc_pins: emmc-pins {
