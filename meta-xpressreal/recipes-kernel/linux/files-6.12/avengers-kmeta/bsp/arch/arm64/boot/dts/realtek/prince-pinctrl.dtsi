		       "gpio_32",
		       "gpio_33";
		function = "ts1";
	};

	vi_dtv_pins: vi_dtv-pins {
		pins = "gpio_110", "gpio_111", "gpio_112", "gpio_113", "gpio_114",
		       "gpio_115", "gpio_116", "gpio_117", "gpio_118";
		function = "vi_dtv";
	};

	ao_i2s0_pins: ao-i2s0-pins {
		pins = "gpio_78", "gpio_79", "gpio_80", "gpio_85", "gpio_86",
		       "gpio_87", "gpio_88";
		function = "ao_i2s0";
	};

	ao_i2s0_data_pins: ao-i2s0-data-pins {
		pins = "gpio_85", "gpio_86", "gpio_87", "gpio_88";
		function = "ao_i2s0";
	};

	ai_i2s0_loc0_pins: ai-i2s0-loc0-pins {
		pins = "gpio_78", "gpio_79", "gpio_80", "gpio_81", "gpio_82",
		       "gpio_83", "gpio_84", "ai_i2s0_loc";
		function = "ai_i2s0_loc0";
	};

	ai_i2s1_loc0_pins: ai-i2s1-loc0-pins {
		pins = "ai_i2s1_loc", "gpio_89", "gpio_90", "gpio_91", "gpio_92", "gpio_93";
		function = "ai_i2s1_loc0";
	};

	ai_i2s1_loc1_sel_pins: ai-i2s1-loc1-sel-pins {
		pins = "ai_i2s1_loc";
		function = "ai_i2s1_loc1";
	};

	ai_saibb0_pins: ai-saibb0-pins {
		mux {
			pins = "gpio_81", "gpio_82", "gpio_83", "gpio_84";
			function = "ai_saibb0";
		};
		conf {
			pins = "gpio_82", "gpio_83", "gpio_84";
			input-schmitt-enable;
		};
	};

	ai_saibb1_pins: ai-saibb1-pins {
		mux {
			pins = "gpio_89", "gpio_90", "gpio_91", "gpio_93";
			function = "ai_saibb1";
		};
		conf {
			pins = "gpio_89", "gpio_91", "gpio_93";
			input-schmitt-enable;
		};
	};

	ai_tdm0_pins: ai-tdm0-pins {
		pins = "gpio_89", "gpio_90", "gpio_91", "gpio_92";
		function = "ai_tdm0";
	};

	ao_tdm0_pins: ao-tdm0-pins {
		pins = "gpio_78", "gpio_79", "gpio_80", "gpio_85";
		function = "ao_tdm0";
	};

	ao_tdm1_pins: ao-tdm1-pins {
		pins = "gpio_86", "gpio_87", "gpio_88", "gpio_93";
		function = "ao_tdm1";
	};

	aio_vsel_1v8_pins: aio-vsel-1v8-pins {
		pins = "gpio_78", "gpio_79", "gpio_80", "gpio_81", "gpio_82", "gpio_83",
		       "gpio_84", "gpio_85", "gpio_86", "gpio_87", "gpio_88", "gpio_89",
		       "gpio_90", "gpio_91", "gpio_92", "gpio_93";
		power-source = <0>;
		realtek,input_volt = <0>;
	};

	aio_vsel_3v3_pins: aio-vsel-3v3-pins {
		pins = "gpio_78", "gpio_79", "gpio_80", "gpio_81", "gpio_82", "gpio_83",
		       "gpio_84", "gpio_85", "gpio_86", "gpio_87", "gpio_88", "gpio_89",
		       "gpio_90", "gpio_91", "gpio_92", "gpio_93";
		power-source = <1>;
		realtek,input_volt = <1>;
	};
};

