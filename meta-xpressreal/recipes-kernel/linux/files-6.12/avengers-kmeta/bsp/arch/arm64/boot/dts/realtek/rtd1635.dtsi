&sb2 {
	vcpu_rpmsg: vcpu-rpmsg {
		vcpu-intr-channel {
			memory-region = <&cma_reserved_0>;
		};
	};
};

&scpu_wrapper {
	status = "okay";
};

&sdcard {
	bus-width = <4>;
	cap-sd-highspeed;
	cap-mmc-highspeed;
	sd-uhs-sdr12;
	sd-uhs-sdr25;
	sd-uhs-sdr50;
	sd-uhs-sdr104;
	keep-power-in-suspend;
	non-removable;
	no-sd;
	status = "okay";
	/delete-property/ sd-power-gpios;
	/delete-property/ wp-gpios;
	/delete-property/ cd-gpios;
};

