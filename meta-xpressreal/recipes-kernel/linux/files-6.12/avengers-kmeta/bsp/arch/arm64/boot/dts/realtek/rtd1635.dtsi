#include "prince.dtsi"

&boot_status {
	status = "okay";
};

&cec {
	status = "okay";
};

&display_subsystem {
	status = "okay";
	ports = <&vo1_out>, <&vo0_out>, <&vo2_out>;
	krpc-second = <0>;
};

&dp {
	status = "disabled";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		dp_in: port@0 {
			reg = <0>;
			dp_in_vo2: endpoint {
				remote-endpoint = <&vo2_out_dp>;
			};
		};

		dp_out: port@1 {
			reg = <1>;
		};
	};
};

