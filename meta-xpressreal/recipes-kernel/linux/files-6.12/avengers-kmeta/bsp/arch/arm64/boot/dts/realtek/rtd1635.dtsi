};

&usb_manager {
	status = "okay";
};

&usb_port0 {
	status = "okay";
};

&usb_port1 {
	realtek,power-gpio = <&gpio 62 GPIO_ACTIVE_LOW>;
	status = "okay";
};

&usb_port2 {
	realtek,power-gpio = <&gpio 62 GPIO_ACTIVE_LOW>;
	status = "okay";
};

&type_c {
	realtek,usb-port = <&usb_port0>;
	realtek,vbus-ctrl-gpio = <&gpio 126 GPIO_ACTIVE_LOW>;
	realtek,vconn1-en-gpio = <&gpio 133 GPIO_ACTIVE_HIGH>;
	realtek,vconn2-en-gpio = <&gpio 134 GPIO_ACTIVE_HIGH>;

	status = "disabled";
};

&usb_tcpc {
	vbus-en-gpio = <&gpio 126 GPIO_ACTIVE_LOW>;
	vconn1-en-gpio = <&gpio 133 GPIO_ACTIVE_HIGH>;
	vconn2-en-gpio = <&gpio 134 GPIO_ACTIVE_HIGH>;

	status = "okay";
};

