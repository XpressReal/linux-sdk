				status = "disabled";
			};

			isom_pinctrl: pinctrl@146200 {
				compatible = "realtek,rtd1635-isom-pinctrl", "syscon";
				reg = <0x146200 0x34>;
				ranges = <0x0 0x146200 0x34>;
				reg-io-width = <4>;
				#address-cells = <1>;
				#gpio-range-cells = <3>;
				#size-cells = <1>;
			};

			iso_m_system: syscon@146000 {
				compatible = "syscon", "simple-mfd";
				reg = <0x146000 0x1000>;
				ranges = <0x0 0x146000 0x1000>;
				reg-io-width = <4>;

				#address-cells = <1>;
				#size-cells = <1>;
			};

			ve3_pinctrl: pinctrl@148d00 {
				compatible = "realtek,rtd1635-ve3-pinctrl", "syscon";
				reg = <0x148d00 0x1c>;
				ranges = <0x0 0x148d00 0x1c>;
				reg-io-width = <4>;
				#address-cells = <1>;
				#gpio-range-cells = <3>;
				#size-cells = <1>;
			};

			nor_flash: spi@14b000 {
				compatible = "realtek,rtd1635-sfc";
				reg = <0x14b000 0x00050>;
				pinctrl-names = "default";
				pinctrl-0 = <&spi_pins>;
				clock-names = "nor";
				clocks = <&cc RTD1635_CRT_CLK_EN_MD>;
				#address-cells = <1>;
				#size-cells = <0>;
				status = "disabled";
				flash@0 {
					compatible = "jedec,spi-nor";
					spi-rx-bus-width = <2>;
					spi-tx-bus-width = <2>;
					reg = <0>;
					spi-max-frequency = <40000000>;
				};
			};

			emmc: emmc@14c000 {
				compatible = "realtek,rtd-dw-cqe-emmc";
				reg = <0x0014c000 0x00600>,
				      <0x0014d000 0x00060>;
				reg-names = "emmc","cqhci";
				realtek,m2tmx = <&m2tmx>;
				clock-freq-min-max = <300000 400000000>;
				clock-frequency = <400000>;
				vmmc-supply = <&regulator_vcc1v8>;
				clock-names = "biu", "ciu", "vp0", "vp1";
				clocks = <&cc RTD1635_CRT_CLK_EN_EMMC>,
					 <&cc RTD1635_CRT_CLK_EN_EMMC_IP>,
					 <&cc RTD1635_CRT_PLL_EMMC_VP0>,
					 <&cc RTD1635_CRT_PLL_EMMC_VP1>;
				interrupts = <GIC_SPI 42 IRQ_TYPE_LEVEL_HIGH>;
				pinctrl-0 = <&emmc_sdr50_pins>;
				pinctrl-1 = <&emmc_sdr50_pins>;
				pinctrl-2 = <&emmc_ddr50_pins>;
				pinctrl-3 = <&emmc_hs200_pins>;
				pinctrl-4 = <&emmc_hs400_pins>;
				pinctrl-5 = <&emmc_tune0_pins>;
				pinctrl-6 = <&emmc_tune1_pins>;
				pinctrl-7 = <&emmc_tune2_pins>;
				pinctrl-8 = <&emmc_tune3_pins>;
				pinctrl-9 = <&emmc_tune4_pins>;
				pinctrl-names = "default", "sdr50", "ddr50",
						"hs200", "hs400", "tune0",
						"tune1", "tune2", "tune3",
						"tune4";
				reset-names = "reset";
				resets = <&cc RTD1635_CRT_RSTN_EMMC>;
				speed-step = <4>;
				dma_64bit = <1>;
				cqe = <1>;
				rdq-ctrl = <0>;
				status = "disabled";
			};

			dptx14_aphy: syscon@14f000 {
				compatible = "syscon", "simple-mfd";
				reg = <0x14f000 0x1000>;
