				reg-io-width = <4>;
				#address-cells = <1>;
				#size-cells = <1>;
				ranges = <0x0 0x4b000 0x100>;
			};

			iso_pinctrl: pinctrl@4e000 {
				compatible = "realtek,rtd1635-iso-pinctrl", "syscon";
				reg = <0x4e000 0x1b0>;
