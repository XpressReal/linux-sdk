				reg = <0x166000 0xFFF>;
				reg-io-width = <4>;
				#address-cells = <1>;
				#size-cells = <1>;
				ranges = <0x0 0x166000 0xFFF>;
				status = "disabled";
			};

			mipi_dsi2: syscon@167000 {
				compatible = "syscon", "simple-mfd";
				reg = <0x167000 0x1000>;
				reg-io-width = <4>;
				#address-cells = <1>;
				#size-cells = <1>;
