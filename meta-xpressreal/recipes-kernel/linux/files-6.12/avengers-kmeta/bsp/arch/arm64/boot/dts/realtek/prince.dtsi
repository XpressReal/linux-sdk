			};

			sds_ana: syscon@1ca000 {
				compatible = "syscon", "simple-mfd";
				reg = <0x1ca000 0x100>;
				reg-io-width = <4>;
				#address-cells = <1>;
				#size-cells = <1>;
				ranges = <0x0 0x1ca000 0x100>;
			};

			gpu_wrap: gpu-wrap@200000 {
				compatible = "realtek,rtd1625-gpu-wrap";
				reg = <0x200000 0x4f000>,
				      <0x6f0000 0x2000>,
				      <0x6f2000 0x2000>,
				      <0x6f4000 0x2000>;
				reg-names = "ip", "wrap", "top", "bist";
				ranges = <0x0 0x200000 0x500000>;
				power-domains = <&pwr_gpu>;
				clock-names = "gpu", "ts_src";
				clocks = <&cc RTD1635_CRT_CLK_EN_GPU>, <&cc RTD1635_CRT_CLK_EN_GPU_TS_SRC>;
				reset-names = "core", "bist";
				resets = <&cc RTD1635_CRT_RSTN_GPU>, <&cc RTD1635_CRT_RSTN_GPU_BIST>;
				#address-cells = <1>;
				#size-cells = <1>;
				status = "disabled";

				assigned-clocks = <&cc RTD1635_CRT_CLK_GPU>;
				assigned-clock-parents = <&cc RTD1635_CRT_PLL_GPU>;
				assigned-clock-rates = <405000000>;

				gpu: gpu@0 {
					compatible = "arm,mali-midgard";
					reg = <0x0 0x480000>;
					clock-name = "clk_mali";
					clocks = <&cc RTD1635_CRT_CLK_EN_GPU>;
					interrupt-names = "JOB", "MMU", "GPU";
					interrupts = <GIC_SPI 76 IRQ_TYPE_LEVEL_HIGH>,
						     <GIC_SPI 77 IRQ_TYPE_LEVEL_HIGH>,
						     <GIC_SPI 75 IRQ_TYPE_LEVEL_HIGH>;
					dynamic-power-coefficient = <2268>;
					#cooling-cells = <2>;

					power_model-0 {
						compatible = "arm,mali-simple-power-model";
						static-coefficient = <186463>;
						dynamic-coefficient = <2268>;
						ts = <(-2980400) 125310 (-1699) 9>;
						thermal-zone = "cpu-thermal";
					};

					power_model-1 {
						compatible = "arm,mali-tvax-power-model";
						scale = <4>;
					};
				};

				gpu_cache: gpu-cache@4f0000 {
					reg = <0x4f0000 0x1000>;
					compatible = "realtek,rtd1625-gpu-cache";
					status = "disabled";
				};
			};

			npu_pp: npu-pp@161000 {
				compatible = "realtek,npu-pp";
				reg = <0x161000 0x1000>;
				interrupts = <GIC_SPI 103 IRQ_TYPE_LEVEL_HIGH>;
				realtek,krpc-agent = <&hifi_kernel_agent>;
				enable-capture = <1>;
				status = "disabled";
			};

			npu: npu-wrapper@85000 {
				compatible = "realtek,npu-wrapper";
				reg = <0x85000 0x2000>;
				interrupts = <GIC_SPI 102 IRQ_TYPE_LEVEL_HIGH>;
				power-domains = <&pwr_npu>;
				clock-names = "npu";
				clocks = <&cc RTD1635_CRT_CLK_NPU>;
				resets = <&pwr_npu>;
				contiguousSize = <0x0 0x1000000>;
				ipc-syscon = <&sb2_pmu>;
				intr-syscon = <&sb2>;
				memory-region = <&npu_cma>;
				status = "disabled";
			};
		};

		gic: interrupt-controller@ff100000 {
			compatible = "arm,gic-v3";
			reg = <0xff100000 0x10000>,
			      <0xff140000 0x80000>;
			interrupt-controller;
			interrupts = <GIC_PPI 9 IRQ_TYPE_LEVEL_HIGH>;
			#address-cells = <1>;
			#interrupt-cells = <3>;
			#size-cells = <1>;
		};
	};

	thermal-zones {
		cpu_thermal: cpu-thermal {
			polling-delay-passive = <100>;
			polling-delay = <1000>;
			thermal-sensors = <&cpu_tm>;
			sustainable-power = <2500>;

			trips {
				cpu_switch_on: switch-on {
					temperature = <70000>;
					hysteresis = <0>;
					type = "passive";
				};

				cpu_desired: desired {
					temperature = <85000>;
					hysteresis = <0>;
					type = "passive";
				};
			};

			cooling-maps {
				cpu {
					trip = <&cpu_desired>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
					contribution = <1024>;
				};
				cpu3 {
					trip = <&cpu_desired>;
					cooling-device = <&cpu3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
					contribution = <1024>;
				};
				gpu {
					trip = <&cpu_desired>;
					cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
					contribution = <2048>;
				};
			};
		};
	};

	pwr_isomis_dma: pwr-isomis-dma {
		#power-domain-cells = <0>;
		compatible = "realtek,simple-pd";
		clocks = <&cc RTD1635_CRT_CLK_EN_ISOMIS_DMA>;
		resets = <&cc RTD1635_CRT_RSTN_ISOMIS_DMA>;
		label = "isomis-dma";
	};

	pwr_iso_phy: pwr-iso-phy {
		#power-domain-cells = <0>;
		compatible = "realtek,simple-pd";
		pwr-cfg = <&iso_sys 0x300 0x200000 0 0x200000>;
		label = "iso-phy";
	};

	pwr_ur_top: pwr-ur-top {
		#power-domain-cells = <0>;
		compatible = "realtek,simple-pd";
		clocks = <&cc RTD1635_CRT_CLK_EN_UR_TOP>;
		resets = <&cc RTD1635_CRT_RSTN_UR_TOP>;
		label = "ur-top";
	};

	rtk_pcpu_devopt: rtk-pcpu-devopt {
		compatible = "realtek,kent-pcpu-devopt";
		ipc-syscon = <&sb2_pmu>;
		intr-syscon = <&sb2>;
		status = "disabled";
	};

	rtk_ddr_dfs: rtk-ddr-dfs {
		compatible = "realtek,kent-ddr-dfs";
		time-window = <250>;
		low-bw = <0x40000000>;
		low-debounce = <20>;
		high-bw = <0x60000000>;
		high-debounce = <1>;
		auto-enable = <0>;
		status = "disabled";
	};

	rtk_ddr_dynif: rtk-ddr-dynif {
		compatible = "realtek,rtk-ddr-dynif";
		dpi-enable = <0>;
		dpi-interval = <2000>;
		dpi-step = <10000>;
		dpi-bind = <0x7>;
		dpi-tm = <&cpu_tm>;
		refresh-enable = <0>;
		refresh-interval = <150>;
		refresh-bind = <0x18>;
		status = "disabled";
	};

	rtk_nsb2_trash: rtk-nsb2-trash {
		compatible = "realtek,prince-nsb2-trash";
		status = "disabled";
	};
};

&crt {
	cc: clock-controller@0 {
		compatible = "realtek,rtd1635-crt-clk";
		reg = <0 0x1000>;
		#clock-cells = <1>;
		#reset-cells = <1>;
	};
};

&iso {
	iso_irq_dispatcher: iso-irq-dispatcher {
		compatible = "realtek,rtd1625-iso-irq-dispatcher";
		interrupt-controller;
		interrupts-extended = <&gic GIC_SPI 41 IRQ_TYPE_LEVEL_HIGH>;
		#address-cells = <0>;
		#interrupt-cells = <1>;
		iso = <&iso>;
		isom = <&iso_m_mis>;
	};

	iso_irq_mux: iso-irq-mux {
		compatible = "realtek,rtd1635-iso-irq-mux";
		interrupt-controller;
		interrupts-extended = <&iso_irq_dispatcher 0>,
				      <&gic GIC_SPI 57 IRQ_TYPE_LEVEL_HIGH>,
				       <&gic GIC_SPI 39 IRQ_TYPE_LEVEL_HIGH>;
		syscon = <&iso>;
		#address-cells = <0>;
		#interrupt-cells = <1>;
	};

	rtk_pm: rtk-pm {
		compatible = "realtek,rtk_pm_v3";
		syscon = <&iso>;
		system-power-controller;
		pm-dbg = <0>;
		status = "disabled";
	};

	rtc: rtc@440 {
		compatible = "realtek,rtd1319d-rtc";
		reg = <0x440 0x34>;
		rtc-base-year = <2020>;
		interrupts-extended = <&iso_irq_mux 16>;
		interrupt-names = "alarm";
		status = "disabled";
	};

	rfkill: rfkill-gpio {
		compatible = "realtek,rfkill";
		rfkill-gpios = <&gpio 67 GPIO_ACTIVE_HIGH>;
		realtek,iso = <&iso>;
		realtek,pinctrl = <&iso_pinctrl>;
		status = "disabled";
	};

	ic: clock-controller@0 {
		compatible = "realtek,rtd1635-iso-clk";
		reg = <0 0x1000>;
		#clock-cells = <1>;
		#reset-cells = <1>;
	};

	uart9: serial@500 {
		compatible = "snps,dw-apb-uart";
		reg = <0x500 0x100>;
		clock-names = "baudclk", "apb_pclk";
		clocks = <&cc RTD1635_CRT_PLL_DDSA>, <&cc RTD1635_CRT_CLK_EN_UR9>;
		interrupts-extended = <&iso_irq_mux 3>;
		pinctrl-names = "default";
		pinctrl-0 = <&uart9_loc0_pins>, <&uart9_loc0_sel_pins>;
		reg-io-width = <4>;
		reg-shift = <2>;
		resets = <&cc RTD1635_CRT_RSTN_UR9>;
		status = "disabled";
	};

	reboot_mode: reboot-mode@640 {
		compatible = "realtek,reboot-mode";
		reg = <0x640 0x4>;
		status = "disabled";
	};

	uart0: serial@800 {
		compatible = "snps,dw-apb-uart";
		reg = <0x800 0x100>;
		clock-frequency = <432000000>;
		interrupts = <GIC_SPI 68 IRQ_TYPE_LEVEL_HIGH>;
		reg-io-width = <4>;
		reg-shift = <2>;
		status = "disabled";
	};

	watchdog: watchdog@a20 {
		compatible = "realtek,watchdog";
		reg = <0xa20 0x10>,
		      <0xa30 0x8>;
		interrupts = <GIC_SPI 113 IRQ_TYPE_LEVEL_HIGH>;
		timeout-sec = <20>;
		realtek,ov-rstb-oe-init = <0>;
		realtek,ov-rstb-oe = <0>;
		status = "disabled";
	};

	i2c_0: i2c-0@d00 {
		compatible = "realtek,highspeed-i2c";
		reg = <0xd00 0x100>,
		      <0x000 0x100>;
		clocks = <&ic RTD1635_ISO_CLK_EN_I2C0>;
		interrupt-parent = <&iso_irq_mux>;
		interrupts = <8>;
		pinctrl-0 = <&i2c0_pins>;
		pinctrl-names = "default";
		resets = <&ic RTD1635_ISO_RSTN_I2C_0>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "disabled";
	};

	i2c_1: i2c-1@c00 {
		compatible = "realtek,i2c";
		reg = <0xc00 0x100>,
		      <0x000 0x100>;
		clock-frequency = <50000>;
		clocks = <&ic RTD1635_ISO_CLK_EN_I2C1>;
		interrupt-parent = <&iso_irq_mux>;
		interrupts = <11>;
		pinctrl-0 = <&i2c1_pins>;
		pinctrl-1 = <&i2c1_gpio_pins>;
		pinctrl-names = "default", "gpio_mode";
		resets = <&ic RTD1635_ISO_RSTN_I2C_1>;
		#address-cells = <1>;
		#size-cells = <0>;
		scl-gpios = <&gpio 21 GPIO_ACTIVE_HIGH>;
		sda-gpios = <&gpio 20 GPIO_PULL_UP>;
		status = "disabled";
	};
};

&dc_sys {
	dbus_pmu: rtk-dbus-pmu@0 {
		compatible = "realtek,rtk-1635-dbus-pmu";
		reg = <0x0000 0x0d00>;
		interrupts = <GIC_SPI 35 IRQ_TYPE_LEVEL_HIGH>;
	};
};

&dprx {
	rtk_dprx: rtk-dprx {
		compatible = "realtek,rtk-dprx";
		clock-names = "clk_en_dprx";
		clocks = <&cc RTD1635_CRT_CLK_EN_DPRX>;
		reset-names = "rstn_dprx";
		resets = <&cc RTD1635_CRT_RSTN_DPRX>;
		phys = <&usb0_u3phy PHY_TYPE_DP>;
		phy-names = "dprx-phy";
		interrupts = <GIC_SPI 25 IRQ_TYPE_LEVEL_HIGH>;
		syscon = <&dprx>, <&dprx_ip>;
		extcon = <&usb0_u3phy>;
		status = "disabled";
	};
};

&sb2_pmu {
	rbus_pmu: rtk-rbus-pmu@0 {
		compatible = "realtek,rtk-1625-rbus-pmu";
		reg = <0x0000 0x1000>;
		interrupts = <GIC_SPI 36 IRQ_TYPE_LEVEL_HIGH>;
	};
};

&iso_mis {
	pwm: pwm@1e0 {
		compatible = "realtek,rtk-pwm-v3";
		reg = <0x1e0 0x18>;
		#pwm-cells = <2>;
		realtek,iso = <&iso>;
		status = "disabled";

		pwm-0 {
			clkout_div = <0xff>; /* default OCD: from 0x0 to 0xff */
			clksrc_div = <0x1>; /* default OSD: from 0x0 to 0xf */
			duty_rate = <50>; /* default duty_rate 0 ~ 100 */
			enable = <0>;
		};

		pwm-1 {
			clkout_div = <0xff>; /* default OCD: from 0x0 to 0xff */
			clksrc_div = <0x1>; /* default OSD: from 0x0 to 0xf */
			duty_rate = <50>; /* default duty_rate 0 ~ 100 */
			enable = <0>;
		};

		pwm-2 {
			clkout_div = <0xff>; /* default OCD: from 0x0 to 0xff */
			clksrc_div = <0x1>; /* default OSD: from 0x0 to 0xf */
			duty_rate = <50>; /* default duty_rate 0 ~ 100 */
			enable = <0>;
		};

		pwm-3 {
			clkout_div = <0xff>; /* default OCD: from 0x0 to 0xff */
			clksrc_div = <0x1>; /* default OSD: from 0x0 to 0xf */
			duty_rate = <50>; /* default duty_rate 0 ~ 100 */
			enable = <0>;
		};

		pwm-4 {
			clkout_div = <0xff>; /* default OCD: from 0x0 to 0xff */
			clksrc_div = <0x1>; /* default OSD: from 0x0 to 0xf */
			duty_rate = <50>; /* default duty_rate 0 ~ 100 */
			enable = <0>;
		};

		pwm-5 {
			clkout_div = <0xff>; /* default OCD: from 0x0 to 0xff */
			clksrc_div = <0x1>; /* default OSD: from 0x0 to 0xf */
			duty_rate = <50>; /* default duty_rate 0 ~ 100 */
			enable = <0>;
		};

		pwm-6 {
			clkout_div = <0xff>; /* default OCD: from 0x0 to 0xff */
			clksrc_div = <0x1>; /* default OSD: from 0x0 to 0xf */
			duty_rate = <50>; /* default duty_rate 0 ~ 100 */
			enable = <0>;
		};
	};

	spi_0: spi@200 {
		compatible = "realtek,rtd1625-dw-apb-ssi";
		reg = <0x300 0x100>, /* DW SPI */
		      <0x200 0x100>; /* SPI wrapper */
		bus-num = <(-1)>;
		clock-frequency = <256000000>;
		clock-names = "gspi", "spi";
		clocks = <&cc RTD1635_CRT_CLK_EN_GSPI>,
			 <&cc RTD1635_CRT_CLK_EN_SPI0>;
		interrupt-parent = <&iso_irq_mux>;
		interrupts = <4>;
		num-chipselect = <1>;
		pinctrl-0 = <&gspi0_pins>;
		pinctrl-names = "default";
		reset-names = "gspi", "misc", "spi";
		resets = <&cc RTD1635_CRT_RSTN_GSPI>,
			 <&cc RTD1635_CRT_RSTN_MISC>,
			 <&cc RTD1635_CRT_RSTN_SPI0>;
		power-domains = <&pwr_isomis_dma>;
		power-domain-names = "dma";
		#address-cells = <1>;
		#size-cells = <0>;
		status = "disabled";
	};

	spi_1: spi@400 {
		compatible = "realtek,rtd1625-dw-apb-ssi";
		reg = <0x500 0x100>, /* DW SPI */
		      <0x400 0x100>; /* SPI wrapper */
		bus-num = <(-1)>;
		clock-frequency = <256000000>;
		clock-names = "gspi", "spi";
		clocks = <&cc RTD1635_CRT_CLK_EN_GSPI>,
			 <&cc RTD1635_CRT_CLK_EN_SPI1>;
		interrupt-parent = <&iso_irq_mux>;
		interrupts = <5>;
		num-chipselect = <1>;
		pinctrl-0 = <&gspi1_pins>;
		pinctrl-names = "default";
		reset-names = "gspi", "misc", "spi";
		resets = <&cc RTD1635_CRT_RSTN_GSPI>,
			 <&cc RTD1635_CRT_RSTN_MISC>,
			 <&cc RTD1635_CRT_RSTN_SPI1>;
		power-domains = <&pwr_isomis_dma>;
		power-domain-names = "dma";
		#address-cells = <1>;
		#size-cells = <0>;
		status = "disabled";
	};

	spi_2: spi@600 {
		compatible = "realtek,rtd1625-dw-apb-ssi";
		reg = <0x700 0x100>, /* DW SPI */
		      <0x600 0x100>; /* SPI wrapper */
		bus-num = <(-1)>;
		clock-frequency = <256000000>;
		clock-names = "gspi", "spi";
		clocks = <&cc RTD1635_CRT_CLK_EN_GSPI>,
			 <&cc RTD1635_CRT_CLK_EN_SPI2>;
		interrupt-parent = <&iso_irq_mux>;
		interrupts = <6>;
		num-chipselect = <1>;
		pinctrl-0 = <&gspi2_pins>;
		pinctrl-names = "default";
		reset-names = "gspi", "misc", "spi";
		resets = <&cc RTD1635_CRT_RSTN_GSPI>,
			 <&cc RTD1635_CRT_RSTN_MISC>,
			 <&cc RTD1635_CRT_RSTN_SPI2>;
		power-domains = <&pwr_isomis_dma>;
		power-domain-names = "dma";
		#address-cells = <1>;
		#size-cells = <0>;
		status = "disabled";
	};

	lsadc_0: lsadc@800 {
		compatible = "realtek,rtd1635-lsadc0";
		reg = <0x000800 0x200>;
		clocks = <&cc RTD1635_CRT_CLK_EN_LSADC0>;
		resets = <&cc RTD1635_CRT_RSTN_LSADC0>;
		power-domains = <&pwr_iso_phy>, <&pwr_isomis_dma>;
		power-domain-names = "phy", "dma";
		interrupts-extended = <&iso_irq_mux 21>;
		#io-channel-cells = <1>;
		status = "disabled";
	};

	lsadc_1: lsadc@a00 {
		compatible = "realtek,rtd1635-lsadc1";
		reg = <0x000a00 0x200>;
		clocks = <&cc RTD1635_CRT_CLK_EN_LSADC1>;
		resets = <&cc RTD1635_CRT_RSTN_LSADC1>;
		power-domains = <&pwr_iso_phy>, <&pwr_isomis_dma>;
		power-domain-names = "phy", "dma";
		interrupts-extended = <&iso_irq_mux 22>;
		#io-channel-cells = <1>;
		status = "disabled";
	};

	lsadc_2: lsadc@e00 {
		compatible = "realtek,rtd1635-lsadc2";
		reg = <0x000e00 0x200>;
		clocks = <&cc RTD1635_CRT_CLK_EN_LSADC2>;
		resets = <&cc RTD1635_CRT_RSTN_LSADC2>;
		power-domains = <&pwr_iso_phy>, <&pwr_isomis_dma>;
		power-domain-names = "phy", "dma";
		interrupts-extended = <&iso_irq_mux 23>;
		#io-channel-cells = <1>;
		status = "disabled";
	};
};

&iso_mis_io {
	i2c_8: i2c-8@0 {
		compatible = "realtek,i2c";
		reg = <0x0 0x100>,
		      <0x298 0x4>;
		clocks = <&cc RTD1635_CRT_CLK_EN_MISC_I2C_8>;
		interrupt-parent = <&iso_irq_mux>;
		interrupts = <18>;
		pinctrl-0 = <&i2c8_loc0_pins>;
		pinctrl-names = "default";
		resets = <&cc RTD1635_CRT_RSTN_I2C_8>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "disabled";
	};

	egpio: egpio@100 {
		compatible = "realtek,rtd-gpio-expander";
		reg = <0x100 0x164>,
		      <0x700 0x4>;
		adapter = <&i2c_8>;
		gpio-controller;
		interrupt-parent = <&iso_irq_mux>;
		interrupts = <18>;
		interrupt-controller;
		#address-cells = <0>;
		#gpio-cells = <2>;
		#interrupt-cells = <2>;
		pinctrl-0 = <&eio_irq5_pins>;
		pinctrl-names = "default";
		status = "disabled";
		expander-0 {
			group = <5>;
			addr = <0x75>;
			bits = <1>; /*0: 8bits, 1: 16bits*/
			dir = <0>;
		};
	};
};

&iso_m_mis {
	iso_m_irq_mux: iso-m-irq-mux {
		compatible = "realtek,rtd1635-isom-irq-mux";
		interrupt-controller;
		interrupts-extended = <&iso_irq_dispatcher 1>;
		syscon = <&iso_m_mis>;
		#address-cells = <0>;
		#interrupt-cells = <1>;
	};

	iso_m_gpio: isom-gpio@100 {
		compatible = "realtek,rtd1635-isom-gpio";
		reg = <0x120 0x10>,
		      <0x100 0x20>;
		gpio-controller;
		gpio-ranges = <&isom_pinctrl 0 0 4>;
		interrupt-parent = <&iso_m_irq_mux>;
		interrupts = <0>, <1>, <2>;
		interrupt-controller;
		#address-cells = <0>;
		#gpio-cells = <2>;
		#interrupt-cells = <2>;
		status = "disabled";
	};

	uart10: serial@200 {
		compatible = "snps,dw-apb-uart";
		reg = <0x200 0x100>;
		interrupt-parent = <&iso_m_irq_mux>;
		interrupts = <4>;
		pinctrl-0 = <&uart10_pins>;
		pinctrl-names = "default";
		clock-names = "baudclk", "apb_pclk";
		clocks = <&cc RTD1635_CRT_PLL_DDSA>, <&iso_s_cc RTD1635_ISO_S_CLK_EN_UR10>;
		resets = <&iso_s_cc RTD1635_ISO_RSTN_UR10>;
		reg-io-width = <4>;
		reg-shift = <2>;
		status = "disabled";
	};

	irda: irda@300 {
		compatible = "realtek,rtk-ir";
		reg = <0x300 0x100>;
		clock-names = "irda";
		clocks = <&iso_s_cc RTD1635_ISO_S_CLK_EN_IRDA>;
		interrupt-parent = <&iso_m_irq_mux>;
		interrupts = <5>;
		pinctrl-0 = <&ir_rx_loc1_pins>;
		pinctrl-names = "default";
		resets = <&iso_s_cc RTD1635_ISO_RSTN_IRDA>;
		syscon = <&iso>;
		hw,rc-map-name = "rc-realtek-dhc";
		hw1,rc-map-name = "rc-ruwido";
		status = "disabled";
	};
};

&iso_sys {
	pwr_ve1: power-controller@0 {
		compatible = "realtek,rtd1625-gpc";
		#power-domain-cells = <0>;
		#reset-cells = <0>;
		reg = <0x0 0x20>, <0x20 0x4>;
		reg-names = "ctl", "ctl8";
		clocks = <&cc RTD1635_CRT_CLK_EN_VE1>;
		resets = <&cc RTD1635_CRT_RSTN_VE1>,
			 <&cc RTD1635_CRT_RSTN_VE1_BIST>,
			 <&cc RTD1635_CRT_RSTN_VE1_MMU>,
			 <&cc RTD1635_CRT_RSTN_VE1_MMU_FUNC>,
			 <&cc RTD1635_CRT_RSTN_MAIN_BIST>;
		reset-names = "reset", "bist", "mmu", "mmu_func", "bist_common";
		label = "ve1";

		assigned-clocks = <&cc RTD1635_CRT_CLK_VE1>;
		assigned-clock-parents = <&cc RTD1635_CRT_PLL_VE1>;
		assigned-clock-rates = <661500000>;
	};

	pwr_gpu: power-controller@90 {
		compatible = "realtek,rtd1625-gpc";
		reg = <0x90 0x20>,
		      <0xb0 0x4>;
		reg-names = "ctl", "ctl8";
		label = "gpu";
		#power-domain-cells = <0>;
		realtek,l2h_delay_cycle = <0xf>;
		realtek,h2l_delay_cycle = <0xf>;
		realtek,std_delay_cycle = <0x50>;
	};

	pwr_npu: power-controller@260 {
		reg = <0x260 0x20>, <0x280 0x4>;
		reg-names = "ctl", "ctl8";
		compatible = "realtek,rtd1625-gpc";
		#power-domain-cells = <0>;
		#reset-cells = <0>;
		clocks = <&cc RTD1635_CRT_CLK_NPU>,
		         <&cc RTD1635_CRT_CLK_EN_NPU>,
		         <&cc RTD1635_CRT_CLK_EN_NPUPP>;
		resets = <&cc RTD1635_CRT_RSTN_SOFT_NPU>;
		reset-names = "auto";
		label = "npu";

		assigned-clocks = <&cc RTD1635_CRT_CLK_NPU>;
		assigned-clock-parents = <&cc RTD1635_CRT_PLL_NPU>;
		assigned-clock-rates = <810000000>;
	};

	isosys_clk: clock-controller@3f0 {
		compatible = "realtek,rtd1625-isosys-clk";
		reg = <0x3f0 0xc>;
		#clock-cells = <1>;
	};
};

&mipi_csi {
	mipicsi_g: mipicsi-g {
		compatible = "realtek,rtk-mipi-csi-group";
		clock-names = "clk_en_mipi_csi",
				"clk_en_npu_mipi_csi",
				"clk_npu_mipi_csi";
		clocks = <&cc RTD1635_CRT_CLK_EN_MIPI_CSI>,
				<&cc RTD1635_CRT_CLK_EN_MISC_MIPI_CSI>,
				<&cc RTD1635_CRT_CLK_MIPI_CSI>;
		assigned-clocks = <&cc RTD1635_CRT_CLK_MIPI_CSI>;
		assigned-clock-parents = <&cc RTD1635_CRT_CLK_SYSH>;

		interrupts = <GIC_SPI 23 IRQ_TYPE_LEVEL_HIGH>;
		reset-names = "rstn_mipi_csi";
		resets = <&cc RTD1635_CRT_RSTN_MIPI_CSI>;
		syscon = <&mipi_csi>,
			 <&mipi_csi_phy>;
		ch-index = <3>;
		swap-config = <0xE4>;
		status = "disabled";
	};

	mipicsi_0: mipicsi-0 {
		compatible = "realtek,rtk-mipi-csi";
		clock-names = "clk_en_mipi_csi",
				"clk_en_npu_mipi_csi",
				"clk_npu_mipi_csi";
		clocks = <&cc RTD1635_CRT_CLK_EN_MIPI_CSI>,
				<&cc RTD1635_CRT_CLK_EN_MISC_MIPI_CSI>,
				<&cc RTD1635_CRT_CLK_NPU_MIPI_CSI>;
		assigned-clocks = <&cc RTD1635_CRT_CLK_MIPI_CSI>;
		assigned-clock-parents = <&cc RTD1635_CRT_CLK_SYSH>;

		interrupts = <GIC_SPI 23 IRQ_TYPE_LEVEL_HIGH>;
		reset-names = "rstn_mipi_csi";
		resets = <&cc RTD1635_CRT_RSTN_MIPI_CSI>;
		syscon = <&mipi_csi>,
			 <&mipi_csi_phy>;
		ch-index = <0>;
		src-width = <1920>;
		src-height = <1080>;
		skew-mode = <0>;
		swap-config = <0xE4>;
		hl-interval = <10>;
		status = "disabled";
	};

	mipicsi_1: mipicsi-1 {
		compatible = "realtek,rtk-mipi-csi";
		interrupts = <GIC_SPI 23 IRQ_TYPE_LEVEL_HIGH>;
		syscon = <&mipi_csi>,
			 <&mipi_csi_phy>;
		ch-index = <1>;
		src-width = <1920>;
		src-height = <1080>;
		skew-mode = <0>;
		swap-config = <0xE4>;
		hl-interval = <10>;
		status = "disabled";
	};

	mipicsi_2: mipicsi-2 {
		compatible = "realtek,rtk-mipi-csi";
		interrupts = <GIC_SPI 23 IRQ_TYPE_LEVEL_HIGH>;
		syscon = <&mipi_csi>,
			 <&mipi_csi_phy>;
		ch-index = <2>;
		src-width = <1920>;
		src-height = <1080>;
		skew-mode = <0>;
		swap-config = <0xE4>;
		hl-interval = <10>;
		status = "disabled";
	};

	mipicsi_3: mipicsi-3 {
		compatible = "realtek,rtk-mipi-csi";
		interrupts = <GIC_SPI 23 IRQ_TYPE_LEVEL_HIGH>;
		syscon = <&mipi_csi>,
			 <&mipi_csi_phy>;
		ch-index = <3>;
		src-width = <1920>;
		src-height = <1080>;
		skew-mode = <0>;
		swap-config = <0xE4>;
		hl-interval = <10>;
		status = "disabled";
	};
};

&misc {
	misc_irq_mux: misc-irq-mux {
		compatible = "realtek,rtd1635-misc-irq-mux";
		interrupt-controller;
		interrupts-extended = <&gic GIC_SPI 40 IRQ_TYPE_LEVEL_HIGH>;
		syscon = <&misc>;
		#address-cells = <0>;
		#interrupt-cells = <1>;
	};

	misc_irq2_mux: misc-irq2-mux {
		compatible = "realtek,rtd1635-misc-irq2-mux";
		interrupt-controller;
		interrupts-extended = <&gic GIC_SPI 56 IRQ_TYPE_LEVEL_HIGH>,
				      <&gic GIC_SPI 89 IRQ_TYPE_LEVEL_HIGH>,
				      <&gic GIC_SPI 90 IRQ_TYPE_LEVEL_HIGH>;
		syscon = <&misc>;
		#address-cells = <0>;
		#interrupt-cells = <1>;
	};

	refclk: refclk@538 {
		compatible = "realtek,refclk";
		reg = <0x538 0x10>;
	};

	i2c_6: i2c-6@800 {
		compatible = "realtek,i2c";
		reg = <0x800 0x100>,
		      <0x00c 0x100>;
		clocks = <&cc RTD1635_CRT_CLK_EN_MISC_I2C_6>;
		interrupt-parent = <&misc_irq_mux>;
		interrupts = <22>;
		pinctrl-0 = <&i2c6_loc3_pins>, <&i2c6_loc3_sel_pins>;
		pinctrl-names = "default";
		resets = <&cc RTD1635_CRT_RSTN_I2C_6>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "disabled";
	};

	i2c_3: i2c-3@900 {
		compatible = "realtek,i2c";
		reg = <0x900 0x100>,
		      <0x00c 0x100>;
		clocks = <&cc RTD1635_CRT_CLK_EN_MISC_I2C_3>;
		interrupt-parent = <&misc_irq_mux>;
		interrupts = <23>;
		pinctrl-0 = <&i2c3_pins>;
		pinctrl-names = "default";
		resets = <&cc RTD1635_CRT_RSTN_I2C_3>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "disabled";
	};

	i2c_4: i2c-4@a00 {
		compatible = "realtek,i2c";
		reg = <0xa00 0x100>,
		      <0x00c 0x100>;
		clocks = <&cc RTD1635_CRT_CLK_EN_MISC_I2C_4>;
		interrupt-parent = <&misc_irq_mux>;
		interrupts = <15>;
		pinctrl-0 = <&i2c4_loc0_pins>, <&i2c4_loc0_sel_pins>;
		pinctrl-names = "default";
		resets = <&cc RTD1635_CRT_RSTN_I2C_4>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "disabled";
	};

	i2c_5: i2c-5@b00 {
		compatible = "realtek,i2c";
		reg = <0xb00 0x100>,
		      <0x00c 0x100>;
		clocks = <&cc RTD1635_CRT_CLK_EN_MISC_I2C_5>;
		interrupt-parent = <&misc_irq_mux>;
		interrupts = <14>;
		pinctrl-0 = <&i2c5_pins>;
		pinctrl-names = "default";
		resets = <&cc RTD1635_CRT_RSTN_I2C_5>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "disabled";
	};
};

&misc_uart {
	ur1_wrap: ur1_wrap@0 {
		compatible = "realtek,uart-wrapper";
		reg = <0x0 0x100>;
		interrupts-extended = <&misc_irq2_mux 1>;
		clocks = <&cc RTD1635_CRT_CLK_EN_UR1>;
		resets = <&cc RTD1635_CRT_RSTN_UR1>;
		power-domains = <&pwr_ur_top>;
		ranges = <0x0 0x0 0x200>;
		reg-io-width = <4>;
		#address-cells = <1>;
		#size-cells = <1>;

		uart1: serial@100 {
			compatible = "snps,dw-apb-uart";
			reg = <0x100 0x100>;
			clock-names = "baudclk";
			clocks = <&cc RTD1635_CRT_PLL_DDSA>;
			interrupts-extended = <&misc_irq2_mux 1>;
			pinctrl-0 = <&uart1_pins>;
			pinctrl-names = "default";
			reg-io-width = <4>;
			reg-shift = <2>;
			status = "disabled";
		};
	};

	ur2_wrap: ur2_wrap@200 {
		compatible = "realtek,uart-wrapper";
		reg = <0x200 0x100>;
		interrupts-extended = <&misc_irq2_mux 2>;
		clocks = <&cc RTD1635_CRT_CLK_EN_UR2>;
		resets = <&cc RTD1635_CRT_RSTN_UR2>;
		power-domains = <&pwr_ur_top>;
		ranges = <0x0 0x200 0x200>;
		reg-io-width = <4>;
		#address-cells = <1>;
		#size-cells = <1>;

		uart2: serial@100 {
			compatible = "snps,dw-apb-uart";
			reg = <0x100 0x100>;
			clock-names = "baudclk";
			clocks = <&cc RTD1635_CRT_PLL_DDSA>;
			interrupts-extended = <&misc_irq2_mux 2>;
			pinctrl-names = "default";
			pinctrl-0 = <&uart2_pins>;
			reg-io-width = <4>;
			reg-shift = <2>;
			status = "disabled";
		};
	};

	ur3_wrap: ur3_wrap@400 {
		compatible = "realtek,uart-wrapper";
		reg = <0x400 0x100>;
		interrupts-extended = <&misc_irq2_mux 3>;
		clocks = <&cc RTD1635_CRT_CLK_EN_UR3>;
		resets = <&cc RTD1635_CRT_RSTN_UR3>;
		power-domains = <&pwr_ur_top>;
		ranges = <0x0 0x400 0x200>;
		reg-io-width = <4>;
		#address-cells = <1>;
		#size-cells = <1>;

		uart3: serial@100 {
			compatible = "snps,dw-apb-uart";
			reg = <0x100 0x100>;
			clock-names = "baudclk";
			clocks = <&cc RTD1635_CRT_PLL_DDSA>;
			interrupts-extended = <&misc_irq2_mux 3>;
			pinctrl-names = "default";
			pinctrl-0 = <&uart3_pins>;
			reg-io-width = <4>;
			reg-shift = <2>;
			status = "disabled";
		};
	};

	ur4_wrap: ur4_wrap@600 {
		compatible = "realtek,uart-wrapper";
		reg = <0x600 0x100>;
		interrupts-extended = <&misc_irq2_mux 4>;
		clocks = <&cc RTD1635_CRT_CLK_EN_UR4>;
		resets = <&cc RTD1635_CRT_RSTN_UR4>;
		power-domains = <&pwr_ur_top>;
		ranges = <0x0 0x600 0x200>;
		reg-io-width = <4>;
		#address-cells = <1>;
		#size-cells = <1>;

		uart4: serial@100 {
			compatible = "snps,dw-apb-uart";
			reg = <0x100 0x100>;
			clock-names = "baudclk";
			clocks = <&cc RTD1635_CRT_PLL_DDSA>;
			interrupts-extended = <&misc_irq2_mux 4>;
			pinctrl-names = "default";
			pinctrl-0 = <&uart4_loc0_pins>, <&uart4_loc0_sel_pins>;
			reg-io-width = <4>;
			reg-shift = <2>;
			status = "disabled";
		};
	};

	ur5_wrap: ur5_wrap@800 {
		compatible = "realtek,uart-wrapper";
		reg = <0x800 0x100>;
		interrupts-extended = <&misc_irq2_mux 5>;
		clocks = <&cc RTD1635_CRT_CLK_EN_UR5>;
		resets = <&cc RTD1635_CRT_RSTN_UR5>;
		power-domains = <&pwr_ur_top>;
		ranges = <0x0 0x800 0x200>;
		reg-io-width = <4>;
		#address-cells = <1>;
		#size-cells = <1>;

		uart5: serial@100 {
			compatible = "snps,dw-apb-uart";
			reg = <0x100 0x100>;
			clock-names = "baudclk";
			clocks = <&cc RTD1635_CRT_PLL_DDSA>;
			interrupts-extended = <&misc_irq2_mux 5>;
			pinctrl-names = "default";
			pinctrl-0 = <&uart5_pins>;
			reg-io-width = <4>;
			reg-shift = <2>;
			status = "disabled";
		};
	};

	ur6_wrap: ur6_wrap@a00 {
		compatible = "realtek,uart-wrapper";
		reg = <0xa00 0x100>;
		interrupts-extended = <&misc_irq2_mux 6>;
		clocks = <&cc RTD1635_CRT_CLK_EN_UR6>;
		resets = <&cc RTD1635_CRT_RSTN_UR6>;
		power-domains = <&pwr_ur_top>;
		ranges = <0x0 0xa00 0x200>;
		reg-io-width = <4>;
		#address-cells = <1>;
		#size-cells = <1>;

		uart6: serial@100 {
			compatible = "snps,dw-apb-uart";
			reg = <0x100 0x100>;
			clock-names = "baudclk";
			clocks = <&cc RTD1635_CRT_PLL_DDSA>;
			interrupts-extended = <&misc_irq2_mux 6>;
			pinctrl-names = "default";
			pinctrl-0 = <&uart6_pins>;
			reg-io-width = <4>;
			reg-shift = <2>;
			status = "disabled";
		};
	};

	ur7_wrap: ur7_wrap@c00 {
		compatible = "realtek,uart-wrapper";
		reg = <0xc00 0x100>;
		interrupts-extended = <&misc_irq2_mux 7>;
		clocks = <&cc RTD1635_CRT_CLK_EN_UR7>;
		resets = <&cc RTD1635_CRT_RSTN_UR7>;
		power-domains = <&pwr_ur_top>;
		ranges = <0x0 0xc00 0x200>;
		reg-io-width = <4>;
		#address-cells = <1>;
		#size-cells = <1>;

		uart7: serial@100 {
			compatible = "snps,dw-apb-uart";
			reg = <0x100 0x100>;
			clock-names = "baudclk";
			clocks = <&cc RTD1635_CRT_PLL_DDSA>;
			interrupts-extended = <&misc_irq2_mux 7>;
			pinctrl-names = "default";
			pinctrl-0 = <&uart7_pins>;
			reg-io-width = <4>;
