+    // Recording variables
+    var __isRecording = false;
+    var __recordedEvents = [];
+    var __recordingStartTime = 0;
+
+    var _recordingKeyHandler = function(ev) {
+        if (!__isRecording) return;
+        if (ev.code === "F9") { _stopRecording(); return; }
+        var totalMs = Date.now() - __recordingStartTime;
+        __recordedEvents.push({type: "key", key: ev.code, state: ev.type === "keydown", time: totalMs});
+    };
+
+    var _recordingMouseHandler = function(ev) {
+        if (!__isRecording) return;
+        if (ev.button !== 0) return; // Only left click
+        var totalMs = Date.now() - __recordingStartTime;
+        var rect = $("stream-box").getBoundingClientRect();
+        var geo = __getGeometry();
+        var x = Math.round(tools.remap(ev.clientX - rect.left - geo.x, 0, geo.width, 0, geo.real_width));
+        var y = Math.round(tools.remap(ev.clientY - rect.top - geo.y, 0, geo.height, 0, geo.real_height));
+        __recordedEvents.push({type: "click", x: x, y: y, time: totalMs});
+    };
+
+    var _startRecording = function() {
+        __isRecording = true;
+        __recordedEvents = [];
+        __recordingStartTime = Date.now();
+        $("automation-record-btn").style.display = "none";
+        $("automation-record-stop-btn").style.display = "inline";
+        document.addEventListener("keydown", _recordingKeyHandler, true);
+        document.addEventListener("keyup", _recordingKeyHandler, true);
+        document.addEventListener("pointerdown", _recordingMouseHandler, true);
+        // Switch to stream view for direct interaction
+        wm.closeWindow($("automation-window"));
+        wm.showWindow($("stream-window"));
+        _notify("Recording started... Interact with the remote desktop");
+    };
+
+    var _stopRecording = function() {
+        __isRecording = false;
+        document.removeEventListener("keydown", _recordingKeyHandler, true);
+        document.removeEventListener("keyup", _recordingKeyHandler, true);
+        document.removeEventListener("pointerdown", _recordingMouseHandler, true);
+        $("automation-record-btn").style.display = "inline";
+        $("automation-record-stop-btn").style.display = "none";
+        wm.showWindow($("automation-window"));
+
+        if (__recordedEvents.length === 0) {
+            wm.error("No events recorded");
+            return;
+        }
+
+        // Convert to steps (with modifier awareness for shortcuts)
+        var newSteps = [], prevTime = 0;
+        var activeDown = {};
+        var pendingMods = {};
+        for (var ev of __recordedEvents) {
+            var gap = ev.time - prevTime;
+            if (gap > 500 && newSteps.length > 0) {
+                newSteps.push({type: "wait", duration: Math.round(gap / 100) / 10});
+            }
+            prevTime = ev.time;
+            if (ev.type === "click") {
+                activeDown = {}; pendingMods = {};
+                newSteps.push({type: "click", x: ev.x, y: ev.y});
+            } else if (ev.type === "key") {
+                var isMod = /^(Shift|Control|Alt|Meta)/.test(ev.key);
+                if (ev.state) {
+                    activeDown[ev.key] = {mods: Object.assign({}, pendingMods)};
+                    if (isMod) pendingMods[ev.key] = true;
+                } else {
+                    var info = activeDown[ev.key];
+                    delete activeDown[ev.key];
+                    if (isMod) delete pendingMods[ev.key];
+                    if (!info) continue;
+                    var modKeys = Object.keys(info.mods);
+                    if (modKeys.length > 0 && !isMod) {
+                        newSteps.push({type: "keys", keys: modKeys.concat([ev.key])});
+                        for (var mk of modKeys) { delete activeDown[mk]; }
+                    } else if (!isMod) {
+                        newSteps.push({type: "key", key: ev.key});
+                    }
+                }
+            }
+        }
