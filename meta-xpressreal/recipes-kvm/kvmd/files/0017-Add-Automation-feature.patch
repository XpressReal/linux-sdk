+                timeInput.disabled = false;
+                countdownEl.textContent = "Running...";
+            } else if (resp.status === "completed") {
+                _cancelScheduleUI();
+                if (resp.results && resp.results.length > 0) {
+                    _displayBatchResultsFromServer(resp.results);
+                }
+                _notify("Scheduled batch completed");
+            } else if (resp.status === "cancelled" || resp.status === "error") {
+                _cancelScheduleUI();
+                if (resp.error) wm.error("Schedule error: " + resp.error);
+                else _notify("Schedule " + resp.status);
+            }
+        });
+    };
+
+    var _cancelScheduleUI = function() {
+        if (__schedulePollTimer) {
+            clearInterval(__schedulePollTimer);
+            __schedulePollTimer = null;
+        }
+        document.getElementById("automation-schedule-countdown").textContent = "";
+        document.getElementById("automation-schedule-btn").style.display = "inline";
+        document.getElementById("automation-schedule-cancel-btn").style.display = "none";
+        document.getElementById("automation-schedule-time").disabled = false;
+    };
+
+    var _displayBatchResultsFromServer = function(results) {
+        var el = document.getElementById("automation-results");
+        if (!el) return;
+        el.innerHTML = "";
+        el.classList.add("visible");
+        for (var i = 0; i < results.length; i++) {
+            var r = results[i];
+            var sn = (r.sequence_name || "seq" + i);
+            var line = (r.success ? "PASS" : "FAIL") + " " + sn;
+            line += " | Steps " + (r.completed_steps || 0) + "/" + (r.total_steps || 0);
+            if (r.error) line += " - " + r.error;
+            el.innerHTML += '<div style="padding:4px;font-weight:bold;border-bottom:1px solid #36393f">' + _esc(line) + '</div>';
+            if (r.results) {
+                for (var j = 0; j < r.results.length; j++) {
+                    var sr = r.results[j];
+                    var st = (sr.status === "ok" ? "OK" : sr.status === "error" ? "ERR" : "-") + " Step " + (sr.step || "") + ": " + (sr.type || "");
+                    if (sr.error) st += " - " + sr.error;
+                    el.innerHTML += '<div style="padding:2px 12px;font-size:11px;color:#8a8e97">' + _esc(st) + '</div>';
+                }
+            }
+        }
+    };
+
+    tools.el.setOnClick(document.getElementById("automation-schedule-btn"), function() {
+        if (__batchList.length === 0) { wm.error("Batch list is empty"); return; }
+        if (__isRunning) { wm.error("Already running"); return; }
+
+        var timeInput = document.getElementById("automation-schedule-time");
+        var val = timeInput.value;
+        if (!val) { wm.error("Please set a schedule time"); return; }
+
+        // Fetch dev board time to calculate run_at timestamp
+        tools.httpGet("/api/automation/time", null, function(http) {
+            if (http.status !== 200) { wm.error("Cannot get dev board time"); return; }
+            try {
+                var timeResp = _unwrapJson(http);
+            } catch (e) { wm.error("Invalid server time response"); return; }
+
+            var serverNow = timeResp.timestamp;
+            if (!serverNow) { wm.error("Invalid server time"); return; }
+
+            // Convert PC-local picker time to dev board time
+            var browserScheduledMs = new Date(val).getTime();
+            var clockOffset = serverNow - Date.now();
+            var serverScheduledMs = browserScheduledMs + clockOffset;
+
+            if (serverScheduledMs <= serverNow) {
+                wm.error("Schedule time must be in the future (dev board time)");
+                return;
+            }
+            if (serverScheduledMs - serverNow > 86400000) {
+                wm.error("Schedule cannot be more than 24 hours ahead");
+                return;
+            }
+
+            // Send schedule to dev board (it will execute autonomously)
+            _httpPostJson("/api/automation/schedule", {
+                run_at: serverScheduledMs,
+                sequences: __batchList.map(function(n) { return n.replace(/\.json$/, ""); }),
+            }, function(schedHttp) {
+                if (schedHttp.status === 200) {
+                    document.getElementById("automation-schedule-btn").style.display = "none";
+                    document.getElementById("automation-schedule-cancel-btn").style.display = "inline";
+                    timeInput.disabled = true;
+                    _notify("Batch scheduled on dev board");
+                    // Start polling for status updates
+                    _updateScheduleStatus();
+                    __schedulePollTimer = setInterval(_updateScheduleStatus, 2000);
+                } else {
+                    wm.error("Failed to schedule batch");
+                }
+            });
+        });
+    });
+
+    tools.el.setOnClick(document.getElementById("automation-schedule-cancel-btn"), function() {
+        _httpPostJson("/api/automation/schedule/cancel", {}, function(http) {
+            _cancelScheduleUI();
+            _notify("Schedule cancelled");
+        });
+    });
+
+    // Periodically check for pending schedule on page load
+    _updateScheduleStatus();
+    setInterval(_updateScheduleStatus, 10000);
+
+    // Download Log
+    var _appendResultToText = function(text, result, label) {
+        text += "--- " + label + " ---\nStatus: " + (result.success ? "PASS":"FAIL") + "\n";
+        text += "Steps: " + (result.completed_steps||0) + "/" + (result.total_steps||0) + "\n";
+        if (result.error) text += "Error: " + result.error + "\n";
+        if (result.results) {
+            for (var j = 0; j < result.results.length; j++) {
+                var sr = result.results[j];
+                text += "  Step " + (sr.step||"") + " [" + (sr.status||"") + "] " + (sr.type||"");
+                if (sr.error) text += ": " + sr.error;
+                text += "\n";
+            }
+        }
+        text += "\n";
+        return text;
+    };
+
+    tools.el.setOnClick(document.getElementById("automation-download-log-btn"), function() {
+        var text = "=== Test Results ===\nDate: " + new Date().toISOString() + "\n\n";
+        if (__batchResults.length > 0) {
+            for (var i = 0; i < __batchResults.length; i++) {
+                text = _appendResultToText(text, __batchResults[i], __batchList[i] || ("seq"+i));
+            }
+        } else if (__lastResult) {
+            text = _appendResultToText(text, __lastResult, __lastResult.sequence_name || "Single Run");
+        } else {
+            text += "(No results)\n";
+        }
+        var blob = new Blob([text], {type: "text/plain"});
+        var url = URL.createObjectURL(blob);
+        var a = document.createElement("a");
+        a.href = url;
+        var ts = new Date().toISOString().replace(/[:.]/g, "-");
+        a.download = "test_results_" + ts + ".txt";
+        a.click();
+        URL.revokeObjectURL(url);
+    });
+
+    __init__();
+}
