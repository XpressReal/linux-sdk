+# ========================================================================== #
+#                                                                            #
+#    KVMD - Test Automation Engine                                           #
+#                                                                            #
+#    Integrates OpenCV template matching, Gemini OCR, and HID control        #
+#    to create automated test sequences for KVM targets.                     #
+#                                                                            #
+# ========================================================================== #
+
+
+import io
+import os
+import json
+import time
+import base64
+import struct
+import asyncio
+from typing import Any
+
+from PIL import Image
+
+from ...logging import get_logger
+
+
+# =====
+# Configuration - customizable per deployment
+TEMPLATES_DIR = "/etc/kvmd/automation/templates"
+SEQUENCES_DIR = "/etc/kvmd/automation/sequences"
+# Fallback directories if /etc/kvmd/automation is not writable
+TEMPLATES_DIR_FALLBACK = "/var/lib/kvmd/automation/templates"
+SEQUENCES_DIR_FALLBACK = "/var/lib/kvmd/automation/sequences"
+
+# Gemini API keys: supports multiple keys for automatic rotation when quota is exhausted.
+# Source priority:
+#   1. Environment variable GEMINI_API_KEY (comma-separated or newline-separated)
+#   2. File /etc/kvmd/automation/gemini_key.txt (one key per line or comma-separated)
+_GEMINI_KEY_ENV_RAW = os.environ.get("GEMINI_API_KEY", "")
+_GEMINI_KEY_FILE = "/etc/kvmd/automation/gemini_key.txt"
+
+def _parse_api_keys(raw: str) -> list[str]:
+    """Parse a string that may contain one or more API keys (comma, newline, or semicolon separated)."""
+    keys = []
+    for sep in ("\n", ",", ";"):
+        if sep in raw:
+            parts = raw.split(sep)
+            keys = [k.strip() for k in parts if k.strip()]
+            break
+    if not keys:
+        raw_stripped = raw.strip()
+        if raw_stripped:
+            keys = [raw_stripped]
+    # Remove duplicates while preserving order
+    seen = set()
+    unique = []
+    for k in keys:
+        if k not in seen:
+            seen.add(k)
+            unique.append(k)
+    return unique
+
+_GEMINI_API_KEYS: list[str] = []
+if _GEMINI_KEY_ENV_RAW:
+    _GEMINI_API_KEYS = _parse_api_keys(_GEMINI_KEY_ENV_RAW)
+if not _GEMINI_API_KEYS and os.path.exists(_GEMINI_KEY_FILE):
+    try:
+        _GEMINI_API_KEYS = _parse_api_keys(open(_GEMINI_KEY_FILE).read())
+    except Exception:
+        pass
+
+GEMINI_API_KEY = _GEMINI_API_KEYS[0] if _GEMINI_API_KEYS else "YOUR_API_KEY_HERE"
+GEMINI_API_KEYS = _GEMINI_API_KEYS if _GEMINI_API_KEYS else ["YOUR_API_KEY_HERE"]
+GEMINI_MODEL_NAME = "gemini-3.5-flash-lite"
+
+USE_GEMINI = bool(GEMINI_API_KEYS and GEMINI_API_KEYS[0] and GEMINI_API_KEYS[0] != "YOUR_API_KEY_HERE")
+
+# Screen dimensions (from opencv.py)
+SCREEN_W = 1920
+SCREEN_H = 1080
+
+# HID devices
+HID_MOUSE_DEV = "/dev/hidg1"
+HID_KEYBOARD_DEV = "/dev/hidg0"
+
+
+# =====
+class AutomationError(Exception):
+    """Base exception for automation errors."""
+    pass
+
+
+class TemplateNotFoundError(AutomationError):
+    """Raised when a template image is not found."""
+    pass
+
+
+class SequenceNotFoundError(AutomationError):
+    """Raised when a saved sequence is not found."""
+    pass
+
+
+class SequenceStoppedError(AutomationError):
+    """Raised when a running sequence is stopped by user."""
+    pass
+
+
+class StepExecutionError(AutomationError):
+    """Raised when a step fails to execute."""
+    pass
+
+
+# =====
+class AutomationEngine:
+    """
+    Core automation engine that provides:
+    - Template matching (OpenCV)
+    - Gemini OCR
+    - HID control (mouse click/move, keyboard)
+    - Sequence execution
+    """
+
+    def __init__(self, streamer=None, hid=None) -> None:
+        self._streamer = streamer
+        self._hid = hid
+
+        self._logger = get_logger(0)
+
+        # Try to create template and sequence directories with fallback
+        self._templates_dir = TEMPLATES_DIR
+        self._sequences_dir = SEQUENCES_DIR
+        try:
+            os.makedirs(self._templates_dir, exist_ok=True)
+            os.makedirs(self._sequences_dir, exist_ok=True)
+        except (OSError, PermissionError):
+            try:
+                self._templates_dir = TEMPLATES_DIR_FALLBACK
+                self._sequences_dir = SEQUENCES_DIR_FALLBACK
+                os.makedirs(self._templates_dir, exist_ok=True)
+                os.makedirs(self._sequences_dir, exist_ok=True)
+                self._logger.warning("Using fallback automation directories: %s", self._templates_dir)
+            except (OSError, PermissionError) as ex:
+                self._logger.error("Cannot create automation directories: %s", ex)
+                self._templates_dir = "/tmp/kvmd-automation/templates"
+                self._sequences_dir = "/tmp/kvmd-automation/sequences"
+                os.makedirs(self._templates_dir, exist_ok=True)
+                os.makedirs(self._sequences_dir, exist_ok=True)
+                self._logger.warning("Using tmp fallback automation directories: %s", self._templates_dir)
+
+        # Stop/cancel mechanism for running sequences
+        self._stop_event = asyncio.Event()
+
+        # Schedule mechanism for autonomous batch execution
+        self._schedule_stop_event = asyncio.Event()
+        self._schedule_info: dict | None = None
+        self._schedule_task: asyncio.Task | None = None
+
+        # Lazy-loaded Gemini model and multi-key rotation state
+        self._gemini_model = None
+        self._gemini_key_index: int = 0
+        self._gemini_rotated_keys: set[int] = set()  # indices we've already tried in current rotation
+        self._gemini_model_name: str | None = None  # dynamically resolved model name
+
+    def reload_api_keys(self) -> dict:
+        """
+        Reload API keys from the key file without restarting the server.
+        Returns a dict with status information.
+        """
+        total_before = len(GEMINI_API_KEYS)
+        new_keys: list[str] = []
+
+        # Priority: env var first, then file
+        if _GEMINI_KEY_ENV_RAW:
+            new_keys = _parse_api_keys(_GEMINI_KEY_ENV_RAW)
+        if not new_keys and os.path.exists(_GEMINI_KEY_FILE):
+            try:
+                new_keys = _parse_api_keys(open(_GEMINI_KEY_FILE).read())
+            except Exception as ex:
+                self._logger.error("Failed to reload Gemini keys from file: %s", ex)
+                return {"reloaded": False, "error": str(ex), "total_keys": total_before}
+
+        if not new_keys:
+            return {"reloaded": False, "error": "No keys found", "total_keys": total_before}
+
+        # Update the global list
+        GEMINI_API_KEYS.clear()
+        GEMINI_API_KEYS.extend(new_keys)
+        # Keep key index valid
+        if self._gemini_key_index >= len(GEMINI_API_KEYS):
+            self._gemini_key_index = 0
+        # Force re-init on next use
+        self._gemini_model = None
+        self._gemini_model_name = None
+
+        total_now = len(GEMINI_API_KEYS)
+        self._logger.info("Reloaded Gemini API keys: %d -> %d keys", total_before, total_now)
+        return {
+            "reloaded": True,
+            "total_before": total_before,
+            "total_keys": total_now,
+            "active_index": self._gemini_key_index + 1,
+        }
+
+    def get_gemini_status(self) -> dict:
+        """Return current Gemini API key status (masks actual keys for security)."""
+        total = len(GEMINI_API_KEYS)
+        masked = []
+        for i, k in enumerate(GEMINI_API_KEYS):
+            if k and len(k) > 8:
+                masked.append(k[:6] + "..." + k[-4:])
+            elif k:
+                masked.append(k[:4] + "...")
+            else:
+                masked.append("(empty)")
+        configured = bool(GEMINI_API_KEYS and GEMINI_API_KEYS[0] and GEMINI_API_KEYS[0] != "YOUR_API_KEY_HERE")
+        return {
+            "configured": configured,
+            "total_keys": total,
+            "keys": masked,
+            "active_index": self._gemini_key_index + 1 if self._gemini_model is not None else 0,
+            "model": self._gemini_model_name or GEMINI_MODEL_NAME,
+        }
+
+    def stop_sequence(self) -> None:
+        """Request the currently running sequence to stop."""
+        self._stop_event.set()
+
+    def _check_stop(self) -> None:
+        """Check if stop was requested. Call between steps."""
+        if self._stop_event.is_set():
+            self._stop_event.clear()
+            raise SequenceStoppedError("Sequence stopped by user")
+
+    # ======================================================================
+    # Schedule (autonomous batch execution on dev board)
+    # ======================================================================
+
+    async def schedule_batch(self, run_at_ms: int, sequences: list[str]) -> dict:
+        """Schedule a batch run to execute autonomously on the dev board at the given time."""
+        self.cancel_schedule()
+        self._schedule_info = {
+            "run_at": run_at_ms,
+            "sequences": list(sequences),
+            "status": "pending",
+            "message": "Scheduled",
+            "results": [],
+            "error": None,
+        }
+        self._schedule_stop_event.clear()
+        self._schedule_task = asyncio.create_task(
+            self._execute_scheduled_batch(run_at_ms, sequences)
+        )
+        remaining_s = max(0, (run_at_ms - int(time.time() * 1000))) // 1000
+        self._logger.info(
+            "Batch scheduled at %d (in %ds): %s",
+            run_at_ms, remaining_s, sequences,
+        )
+        return {"scheduled": True, "run_at": run_at_ms, "sequence_count": len(sequences)}
+
+    async def _execute_scheduled_batch(self, run_at_ms: int, sequences: list[str]) -> None:
+        """Background task: wait until run_at, then execute each sequence in order."""
+        import time as _time
+        try:
+            now_ms = int(_time.time() * 1000)
+            delay_s = max(0, (run_at_ms - now_ms)) / 1000
+            if delay_s > 0:
+                # Wait with cancellable sleep
+                try:
+                    await asyncio.wait_for(
+                        self._schedule_stop_event.wait(),
+                        timeout=delay_s,
+                    )
+                    # Event was set → cancelled
+                    if self._schedule_info:
+                        self._schedule_info["status"] = "cancelled"
+                        self._schedule_info["message"] = "Cancelled by user"
+                    return
+                except asyncio.TimeoutError:
+                    pass  # Time reached, proceed
+
+            if self._schedule_stop_event.is_set():
+                return
+
+            if self._schedule_info:
+                self._schedule_info["status"] = "running"
+                self._schedule_info["message"] = "Executing..."
+                self._schedule_info["results"] = []
+
+            for seq_name in sequences:
+                if self._schedule_stop_event.is_set():
+                    if self._schedule_info:
+                        self._schedule_info["status"] = "cancelled"
+                        self._schedule_info["message"] = f"Cancelled after {seq_name}"
+                    return
+                result = await self.run_sequence(seq_name)
+                if self._schedule_info:
+                    self._schedule_info["results"].append(result)
+                if self._schedule_stop_event.is_set():
+                    if self._schedule_info:
+                        self._schedule_info["status"] = "cancelled"
+                    return
+
+            if self._schedule_info:
+                success = all(
+                    r.get("status") in ("ok", "fail")
+                    for result in self._schedule_info["results"]
+                    for r in (result.get("results") or [])
+                ) if self._schedule_info["results"] else False
+                self._schedule_info["status"] = "completed"
+                self._schedule_info["message"] = "Completed"
+                self._logger.info("Scheduled batch completed: success=%s", success)
+
+        except Exception as ex:
+            self._logger.error("Scheduled batch error: %s", ex)
+            if self._schedule_info:
+                self._schedule_info["status"] = "error"
+                self._schedule_info["message"] = str(ex)
+                self._schedule_info["error"] = str(ex)
+
+    def get_schedule_status(self) -> dict:
+        """Return the current schedule status."""
+        if not self._schedule_info:
+            return {"status": "none"}
+        return dict(self._schedule_info)
+
+    def cancel_schedule(self) -> dict:
+        """Cancel a pending or running schedule."""
+        had_schedule = self._schedule_info is not None
+        self._schedule_stop_event.set()
+        if self._schedule_info and self._schedule_info.get("status") in ("pending",):
+            self._schedule_info["status"] = "cancelled"
+            self._schedule_info["message"] = "Cancelled by user"
+        self._schedule_info = None
+        self._schedule_task = None
+        self._logger.info("Schedule cancelled")
+        return {"cancelled": had_schedule}
+
+    # ======================================================================
+    # Snapshot helpers
+    # ======================================================================
+
+    async def take_snapshot(self) -> bytes | None:
+        """
+        Take a snapshot and return JPEG bytes.
+        Reads from kvmd-webrtc's tee branch multifilesink.
+        No service interruption, ~33ms delay, writes to tmpfs (RAM).
+        """
+        import os as _os
+
+        TEE_FILE = "/tmp/kvmd_snapshot.jpg"
+        for attempt in range(5):
+            if _os.path.exists(TEE_FILE):
+                age = time.time() - _os.path.getmtime(TEE_FILE)
+                if age < 3:  # Updated 30fps, 3s is very generous
+                    with open(TEE_FILE, "rb") as f:
+                        data = f.read()
+                    if len(data) > 1000:
+                        self._logger.info("Snapshot via tee: %d bytes (age=%.2fs)", len(data), age)
+                        return data
+                    self._logger.warning("Tee file too small: %d bytes", len(data))
+                else:
+                    self._logger.warning("Tee file stale: age=%.1fs", age)
+            await asyncio.sleep(0.2)
+
+        self._logger.error("Tee file unavailable after %d attempts", 5)
+        return None
+
+    async def _capture_with_service_restart(self) -> bytes | None:
+        """
+        Stop all video streaming services, capture a frame with OpenCV,
+        then restart the services.
+        """
+        import subprocess as _sp
+        import os as _os
+
+        all_services = ["kvmd-janus-static", "kvmd-webrtc", "kvmd-ustreamer", "kvmd-extend"]
+        stopped = []
+        SNAP_FILE = "/tmp/automation_snapshot.jpg"
+
+        try:
+            # Step 1: Stop services
+            for svc in all_services:
+                try:
+                    r = await asyncio.to_thread(
+                        _sp.run, ["systemctl", "is-active", svc],
+                        capture_output=True, text=True, timeout=5,
+                    )
+                    if r.returncode == 0 and "active" in r.stdout:
+                        self._logger.info("Stopping %s to capture snapshot...", svc)
+                        await asyncio.to_thread(
+                            _sp.run, ["systemctl", "stop", svc],
+                            capture_output=True, timeout=15,
+                        )
+                        stopped.append(svc)
+                except Exception:
+                    pass
+
+            if stopped:
+                await asyncio.sleep(3.0)
+
+            # Step 2: gst-launch-1.0 pipelines
+            gst_pipelines = [
+                ["gst-launch-1.0", "v4l2src", "device=/dev/video60", "!", "videoconvert",
+                 "!", "jpegenc", "quality=85", "!", "filesink", f"location={SNAP_FILE}"],
+                ["gst-launch-1.0", "v4l2src", "device=/dev/video60",
+                 "!", "video/x-raw,width=1920,height=1080",
+                 "!", "videoconvert", "!", "jpegenc", "quality=85",
+                 "!", "filesink", f"location={SNAP_FILE}"],
+                ["gst-launch-1.0", "v4l2src", "device=/dev/video60", "io-mode=4",
+                 "!", "videoconvert", "!", "jpegenc", "quality=85",
+                 "!", "filesink", f"location={SNAP_FILE}"],
+            ]
+            for gst_cmd in gst_pipelines:
+                try:
+                    r = await asyncio.to_thread(
+                        _sp.run, gst_cmd, capture_output=True, timeout=8,
+                    )
+                    if r.returncode != 0:
+                        err = (r.stderr or b"")[:500]
+                        out = (r.stdout or b"")[:200]
+                        self._logger.warning("gst-launch ret=%d out=%s err=%s", r.returncode, out, err)
+                except _sp.TimeoutExpired:
+                    pass
+                except Exception as ex:
+                    self._logger.warning("gst-launch exception: %s", ex)
+                    continue
+                if _os.path.exists(SNAP_FILE):
+                    raw = open(SNAP_FILE, "rb").read()
+                    _os.remove(SNAP_FILE)
+                    jpeg_start = raw.find(b"\xff\xd8")
+                    jpeg_end = raw.find(b"\xff\xd9", jpeg_start + 2) if jpeg_start >= 0 else -1
+                    if jpeg_start >= 0 and jpeg_end >= 0:
+                        frame = raw[jpeg_start:jpeg_end + 2]
+                        if len(frame) > 1000:
+                            self._logger.info("Snapshot via gst-launch: %d bytes", len(frame))
+                            return frame
+
+            # Step 3: OpenCV with explicit 1920x1080
+            try:
+                import cv2
+                def _ocv_cap():
+                    for pipe in [
+                        "v4l2src device=/dev/video60 ! video/x-raw,width=1920,height=1080 ! "
+                        "tee name=t t.! queue ! fakesink sync=false "
+                        "t.! queue ! videoconvert ! appsink drop=true max-buffers=1",
+                        "v4l2src device=/dev/video60 ! video/x-raw,width=1920,height=1080 ! "
+                        "videoconvert ! appsink drop=true max-buffers=1",
+                    ]:
+                        cap = cv2.VideoCapture(pipe, cv2.CAP_GSTREAMER)
+                        if cap.isOpened():
+                            ret, frame = cap.read()
+                            cap.release()
+                            if ret and frame is not None:
+                                ok, d = cv2.imencode(".jpg", frame, [cv2.IMWRITE_JPEG_QUALITY, 85])
+                                if ok:
+                                    return (True, d.tobytes())
+                    return (False, None)
+                ok, data = await asyncio.to_thread(_ocv_cap)
+                if ok and data:
+                    self._logger.info("Snapshot via OpenCV: %d bytes", len(data))
+                    return data
+            except ImportError:
+                pass
+            except Exception as ex:
+                self._logger.error("OpenCV capture error: %s", ex)
+
+        except Exception as ex:
+            self._logger.error("Service restart capture error: %s", ex)
+        finally:
+            for svc in reversed(stopped):
+                try:
+                    self._logger.info("Restarting %s...", svc)
+                    await asyncio.to_thread(
+                        _sp.run, ["systemctl", "start", svc],
+                        capture_output=True, timeout=15,
+                    )
+                    await asyncio.sleep(1.0)
+                except Exception as ex:
+                    self._logger.error("Failed to restart %s: %s", svc, ex)
+
+        return None
+
+    # ======================================================================
+    # Template (template image) management
+    # ======================================================================
+
+    def save_template_from_snapshot(
+        self,
+        name: str,
+        snapshot_jpg: bytes,
+        left: int, top: int, right: int, bottom: int,
+    ) -> str:
+        """
+        Crop a region from a snapshot and save as a template image.
+
+        Args:
+            name: Template name (without extension).
+            snapshot_jpg: Full snapshot image as JPEG bytes.
+            left, top, right, bottom: Crop coordinates.
+
+        Returns:
+            Path to the saved template file.
+        """
+        from PIL import Image
+        import io as _io
+
+        img = Image.open(_io.BytesIO(snapshot_jpg))
+        cropped = img.crop((left, top, right, bottom))
+        safe_name = "".join(c if c.isalnum() or c in "._- " else "_" for c in name)
+        path = os.path.join(self._templates_dir, f"{safe_name}.jpg")
+        cropped.save(path, "JPEG")
+        self._logger.info("Saved template: %s (size=%dx%d)", path, cropped.width, cropped.height)
+        return path
+
+    def get_template_path(self, name: str) -> str:
+        """Get the full path for a template name."""
+        self._logger.info("get_template_path: templates_dir=%s name=%s", self._templates_dir, name)
+        orig_name = name
+        if not name.endswith(".jpg"):
+            name += ".jpg"
+        path = os.path.join(self._templates_dir, name)
+        self._logger.info("  Looking for template at: %s (exists=%s)", path, os.path.exists(path))
+        if os.path.exists(path):
+            return path
+        # Try listing directory contents
+        try:
+            files = os.listdir(self._templates_dir)
+            self._logger.info("  Files in templates dir: %s", files)
+        except Exception as ex:
+            self._logger.error("  Cannot list templates dir: %s", ex)
+        raise TemplateNotFoundError(f"Template not found: {orig_name}")
+
+    def list_templates(self) -> list[dict]:
+        """List all saved template images."""
+        templates = []
+        if os.path.isdir(self._templates_dir):
+            for fname in sorted(os.listdir(self._templates_dir)):
+                if fname.lower().endswith((".jpg", ".jpeg", ".png")):
+                    fpath = os.path.join(self._templates_dir, fname)
+                    size = os.path.getsize(fpath)
+                    templates.append({
+                        "name": fname,
+                        "path": fpath,
+                        "size": size,
+                    })
+        return templates
+
+    def delete_template(self, name: str) -> bool:
+        """Delete a template image."""
+        try:
+            path = self.get_template_path(name)
+            os.remove(path)
+            self._logger.info("Deleted template: %s", path)
+            return True
+        except (OSError, TemplateNotFoundError) as ex:
+            self._logger.error("Failed to delete template: %s", ex)
+            return False
+
+    # ======================================================================
+    # OpenCV template matching
+    # ======================================================================
+
+    async def match_template(
+        self,
+        template_name: str,
+        snapshot_jpg: bytes | None = None,
+        threshold: float = 0.8,
+    ) -> dict:
+        """
+        Match a saved template against the current snapshot.
+
+        Args:
+            template_name: Name of saved template.
+            snapshot_jpg: Optional snapshot bytes. If None, takes a new snapshot.
+            threshold: Match confidence threshold (0.0 - 1.0).
+
+        Returns:
+            Dict with keys: found, box, center, confidence
+        """
+        if snapshot_jpg is None:
+            snapshot_jpg = await self.take_snapshot()
+            if snapshot_jpg is None:
+                return {"found": False, "error": "No snapshot available"}
+
+        try:
+            import cv2
+            import numpy as np
+        except ImportError:
+            return {"found": False, "error": "OpenCV (cv2) not installed"}
+
+        try:
+            template_path = self.get_template_path(template_name)
+        except TemplateNotFoundError as ex:
+            return {"found": False, "error": str(ex)}
+
+        # Decode images
+        np_snapshot = np.frombuffer(snapshot_jpg, dtype=np.uint8)
+        main_img = cv2.imdecode(np_snapshot, cv2.IMREAD_COLOR)
+        template = cv2.imread(template_path)
+
+        if main_img is None or template is None:
+            return {"found": False, "error": "Failed to decode images"}
+
+        th, tw = template.shape[:2]
+        result = cv2.matchTemplate(main_img, template, cv2.TM_CCOEFF_NORMED)
+        _, max_val, _, max_loc = cv2.minMaxLoc(result)
+
+        if max_val >= threshold:
+            x1, y1 = max_loc[0], max_loc[1]
+            x2, y2 = x1 + tw, y1 + th
+            return {
+                "found": True,
+                "box": (x1, y1, x2, y2),
+                "center": ((x1 + x2) // 2, (y1 + y2) // 2),
+                "confidence": round(float(max_val), 4),
+                "snapshot_width": main_img.shape[1],
+                "snapshot_height": main_img.shape[0],
+            }
+
+        return {"found": False, "confidence": round(float(max_val), 4)}
+
+    # ======================================================================
+    # Gemini OCR
+    # ======================================================================
+
+    def _discover_model(self, api_key: str) -> str | None:
+        """Query the Gemini API to find the best available model for this key.
+
+        Automatically picks the latest flash/lite model — no hardcoded version list.
+        Only falls back to a hardcoded default if the API query itself fails.
+
+        Returns the model name string, or None if no suitable model is found.
+        """
+        import re as _re
+
+        try:
+            import google.generativeai as genai
+            genai.configure(api_key=api_key)
+
+            models = genai.list_models()
+            # Filter to production Gemini models that support generateContent
+            available = [
+                m.name for m in models
+                if "generateContent" in m.supported_generation_methods
+                and m.name.startswith("models/gemini-")
+            ]
+
+            if not available:
+                self._logger.error("No Gemini models with generateContent found for this API key")
+                return None
+
+            # Helper: extract version tuple from "models/gemini-X.Y-*"
+            def _version(name: str) -> tuple:
+                m = _re.search(r"gemini-(\d+)\.(\d+)", name)
+                return (int(m.group(1)), int(m.group(2))) if m else (0, 0)
+
+            # Separate flash/lite models from others
+            flash_models = [n for n in available if "flash" in n.lower()]
+            other_models = [n for n in available if "flash" not in n.lower()]
+
+            # Pick the newest flash/lite model (highest version wins)
+            if flash_models:
+                flash_models.sort(key=_version, reverse=True)
+                chosen = flash_models[0]
+                self._logger.info(
+                    "Gemini model resolved: %s (from %d available, %d flash models)",
+                    chosen, len(available), len(flash_models),
+                )
+                return chosen
+
+            # No flash model available — use highest-version model among the rest
+            other_models.sort(key=_version, reverse=True)
+            chosen = other_models[0]
+            self._logger.warning(
+                "No flash model available, using: %s (from %d models)",
+                chosen, len(available),
+            )
+            return chosen
+
+        except Exception as ex:
+            self._logger.error("Failed to discover Gemini models: %s", ex)
+            # Fall back to the hardcoded default
+            return "gemini-3.5-flash-lite"
+
+    def _ensure_gemini(self):
+        """Lazy-load the Gemini model using the current API key in rotation."""
+        # Runtime check: if keys aren't configured, try auto-reload from file
+        has_keys = bool(GEMINI_API_KEYS and GEMINI_API_KEYS[0] and GEMINI_API_KEYS[0] != "YOUR_API_KEY_HERE")
+        if not has_keys:
+            if os.path.exists(_GEMINI_KEY_FILE) or os.environ.get("GEMINI_API_KEY", ""):
+                self._logger.info("Keys not configured at import time, attempting auto-reload...")
+                result = self.reload_api_keys()
+                if not result.get("reloaded", False):
+                    self._logger.error("Auto-reload failed: %s", result.get("error", "unknown"))
+                    return False
+            else:
+                return False
+        if self._gemini_model is not None:
+            return True
+
+        total_keys = len(GEMINI_API_KEYS)
+        for attempt in range(total_keys):
+            idx = (self._gemini_key_index + attempt) % total_keys
+            key = GEMINI_API_KEYS[idx]
+            if not key or key == "YOUR_API_KEY_HERE":
+                continue
+            try:
+                # Discover the best model for this key first
+                model_name = self._discover_model(key)
+                if model_name is None:
+                    continue
+
+                import google.generativeai as genai
+                genai.configure(api_key=key)
+                self._gemini_model = genai.GenerativeModel(model_name)
+                self._gemini_model_name = model_name
+                self._gemini_key_index = idx
+                self._logger.info("Gemini initialized with key index %d/%d (model=%s)", idx + 1, total_keys, model_name)
+                return True
+            except Exception as ex:
+                self._logger.warning("Failed to init Gemini with key index %d/%d: %s", idx + 1, total_keys, ex)
+                continue
+
+        self._logger.error("All Gemini API keys failed to initialize")
+        return False
+
+    def _rotate_api_key(self) -> bool:
+        """
+        Rotate to the next API key and re-initialize the model.
+        Returns True if successful, False if all keys exhausted.
+        """
+        import google.generativeai as genai
+
+        self._gemini_model = None
+        total_keys = len(GEMINI_API_KEYS)
+
+        for attempt in range(1, total_keys + 1):
+            idx = (self._gemini_key_index + attempt) % total_keys
+            key = GEMINI_API_KEYS[idx]
+            if not key or key == "YOUR_API_KEY_HERE":
+                continue
+            try:
+                # Discover the best model for this key
+                model_name = self._discover_model(key)
+                if model_name is None:
+                    continue
+
+                genai.configure(api_key=key)
+                self._gemini_model = genai.GenerativeModel(model_name)
+                self._gemini_model_name = model_name
+                self._gemini_key_index = idx
+                self._logger.info("Rotated Gemini key to index %d/%d (model=%s)", idx + 1, total_keys, model_name)
+                return True
+            except Exception as ex:
+                self._logger.warning("Failed to init rotated key %d/%d: %s", idx + 1, total_keys, ex)
+                continue
+
+        self._logger.error("Gemini key rotation exhausted — all keys failed")
+        return False
+
+    async def ocr_region(
+        self,
+        snapshot_jpg: bytes,
+        left: int, top: int, right: int, bottom: int,
+        prompt: str | None = None,
+    ) -> dict:
+        """
+        Run OCR on a region of the snapshot using Gemini.
+        Automatically rotates API keys when quota is exhausted.
+
+        Args:
+            snapshot_jpg: Full snapshot as JPEG bytes.
+            left, top, right, bottom: Region coordinates.
+            prompt: Optional custom prompt for Gemini.
+
+        Returns:
+            Dict with keys: text, success, error (if failed)
+        """
+        if not self._ensure_gemini():
+            # Provide a more informative error message
+            if not GEMINI_API_KEYS or not GEMINI_API_KEYS[0] or GEMINI_API_KEYS[0] == "YOUR_API_KEY_HERE":
+                return {"success": False, "error": "Gemini not configured - no API key loaded. Set GEMINI_API_KEY env var or create /etc/kvmd/automation/gemini_key.txt, then restart kvmd service.", "text": ""}
+            try:
+                import google.generativeai as _gga
+            except ImportError:
+                return {"success": False, "error": "Gemini not configured - google.generativeai package not installed. Run: pip install google-generativeai", "text": ""}
+            return {"success": False, "error": "Gemini not configured - all API keys failed to initialize. Check server logs for details.", "text": ""}
+
+        # Crop the region
+        import io as _io
+        img = Image.open(_io.BytesIO(snapshot_jpg))
+        region = img.crop((left, top, right, bottom))
+        # Re-encode as JPEG bytes (avoid PIL→WebP conversion in old lib)
+        _buf = _io.BytesIO()
+        region.save(_buf, format="JPEG", quality=90)
+        jpg_data = _buf.getvalue()
+
+        if prompt is None:
+            prompt = (
+                "This is a cropped region of a screenshot.\n"
+                "Extract and return ONLY the text content visible in the image. "
+                "Do not include any explanation or extra text."
+            )
+
+        max_rotations = max(1, len(GEMINI_API_KEYS))
+        for rotation in range(max_rotations):
+            try:
+                # Use Part with explicit Blob to avoid PIL→WebP conversion
+                import google.generativeai as _genai
+                img_part = _genai.protos.Part(
+                    inline_data=_genai.protos.Blob(mime_type="image/jpeg", data=jpg_data)
+                )
+                response = self._gemini_model.generate_content([prompt, img_part])
+                text = response.text.strip()
+                return {"success": True, "text": text, "error": None}
+            except Exception as ex:
+                err_msg = str(ex)
+                err_lower = str(ex).lower()
+                # Check if this is a quota/rate-limit error
+                is_quota = any(term in err_msg for term in [
+                    "429", "RESOURCE_EXHAUSTED", "resource_exhausted",
+                    "quota", "rate_limit", "rateLimit", "ratelimit",
+                    "TooManyRequests", "too many requests",
+                    "dailyLimitExceeded", "Daily Limit Exceeded",
+                ]) or any(term in err_lower for term in [
+                    "quota", "rate limit", "rate_limit",
+                ])
+
+                if is_quota and rotation < max_rotations - 1 and len(GEMINI_API_KEYS) > 1:
+                    old_idx = self._gemini_key_index
+                    self._logger.warning(
+                        "Gemini quota error on key index %d/%d: %s. Rotating to next key...",
+                        old_idx + 1, len(GEMINI_API_KEYS), err_msg,
+                    )
+                    if self._rotate_api_key():
+                        self._logger.info(
+                            "Retrying OCR with rotated key index %d/%d",
+                            self._gemini_key_index + 1, len(GEMINI_API_KEYS),
+                        )
+                        continue
+                    else:
+                        self._logger.error("No more Gemini keys available after quota error")
+                        break
+                else:
+                    # Non-quota error, or all keys exhausted
+                    if is_quota:
+                        self._logger.error("Gemini OCR quota error — all keys exhausted: %s", err_msg)
+                    else:
+                        self._logger.error("Gemini OCR error: %s", err_msg)
+                    return {"success": False, "error": err_msg, "text": ""}
+
+        return {"success": False, "error": "All Gemini keys exhausted or failed", "text": ""}
+
+    # ======================================================================
+    # HID Control
+    # ======================================================================
+
+    def mouse_move(self, x: int, y: int) -> bool:
+        """Move mouse to absolute coordinates (screen space 0..SCREEN_W, 0..SCREEN_H)."""
+        if self._hid is not None:
+            try:
+                to_x = int((x / SCREEN_W) * 65535 - 32768)
+                to_y = int((y / SCREEN_H) * 65535 - 32768)
+                self._hid.send_mouse_move_event(to_x, to_y)
+                return True
+            except Exception as ex:
+                self._logger.error("HID mouse move error: %s", ex)
+                return False
+
+        # Fallback: direct HID device access
+        try:
+            hid_x = int((x / SCREEN_W) * 32767)
+            hid_y = int((y / SCREEN_H) * 32767)
+            with open(HID_MOUSE_DEV, 'wb') as hid:
+                hid.write(struct.pack('<Bhhbb', 0x00, hid_x, hid_y, 0, 0))
+            return True
+        except Exception as ex:
+            self._logger.error("Direct mouse move error: %s", ex)
+            return False
+
+    def mouse_click(self, x: int, y: int, button: str = "left") -> bool:
+        """Move mouse to coordinates and click."""
+        if self._hid is not None:
+            try:
+                to_x = int((x / SCREEN_W) * 65535 - 32768)
+                to_y = int((y / SCREEN_H) * 65535 - 32768)
+                self._hid.send_mouse_move_event(to_x, to_y)
+                time.sleep(0.05)
+                if button == "left":
+                    from evdev import ecodes
+                    self._hid.send_mouse_button_event(ecodes.BTN_LEFT, True)
+                    time.sleep(0.05)
+                    self._hid.send_mouse_button_event(ecodes.BTN_LEFT, False)
+                return True
+            except Exception as ex:
+                self._logger.error("HID mouse click error: %s", ex)
+                return False
+
+        # Fallback: direct HID device access
+        try:
+            hid_x = int((x / SCREEN_W) * 32767)
+            hid_y = int((y / SCREEN_H) * 32767)
+            with open(HID_MOUSE_DEV, 'wb') as hid:
+                hid.write(struct.pack('<Bhhbb', 0x00, hid_x, hid_y, 0, 0))
+                time.sleep(0.05)
+                hid.write(struct.pack('<Bhhbb', 0x01, hid_x, hid_y, 0, 0))
+                time.sleep(0.05)
+                hid.write(struct.pack('<Bhhbb', 0x00, hid_x, hid_y, 0, 0))
+            return True
+        except Exception as ex:
+            self._logger.error("Direct mouse click error: %s", ex)
+            return False
+
+    def keyboard_press_key(self, key_name: str) -> bool:
+        """Press and release a single key by name (e.g., 'Enter', 'KeyA')."""
+        # Normalize key name: "A" → "KeyA", "Enter" → "Enter"
+        if len(key_name) == 1 and key_name.isalpha():
+            key_name = f"Key{key_name.upper()}"
+        if self._hid is not None:
+            try:
+                from ...keyboard.mappings import WEB_TO_EVDEV
+                key = WEB_TO_EVDEV[key_name]
+                # Press key first (without auto-release)
+                self._hid.send_key_event(key, True, False)
+                time.sleep(0.08)  # Hold long enough for iOS/iPhone to register
+                # Then release
+                self._hid.send_key_event(key, False, False)
+                return True
+            except Exception as ex:
+                self._logger.error("HID key press error: %s", ex)
+                return False
+
+        # Fallback: direct HID device access
+        try:
+            # Simple mapping for common keys
+            key_map = {
+                "Enter": 0x28, "Space": 0x2C, "Tab": 0x2B,
+                "KeyA": 0x04, "KeyB": 0x05, "KeyC": 0x06,
+                "KeyD": 0x07, "KeyE": 0x08, "KeyF": 0x09,
+                "KeyG": 0x0A, "KeyH": 0x0B, "KeyI": 0x0C,
+                "KeyJ": 0x0D, "KeyK": 0x0E, "KeyL": 0x0F,
+                "KeyM": 0x10, "KeyN": 0x11, "KeyO": 0x12,
+                "KeyP": 0x13, "KeyQ": 0x14, "KeyR": 0x15,
+                "KeyS": 0x16, "KeyT": 0x17, "KeyU": 0x18,
+                "KeyV": 0x19, "KeyW": 0x1A, "KeyX": 0x1B,
+                "KeyY": 0x1C, "KeyZ": 0x1D,
+                "Digit1": 0x1E, "Digit2": 0x1F, "Digit3": 0x20,
+                "Digit4": 0x21, "Digit5": 0x22, "Digit6": 0x23,
+                "Digit7": 0x24, "Digit8": 0x25, "Digit9": 0x26,
+                "Digit0": 0x27,
+                "Backspace": 0x2A, "Delete": 0x4C,
+                "ArrowLeft": 0x50, "ArrowRight": 0x4F,
+                "ArrowUp": 0x52, "ArrowDown": 0x51,
+            }
+            hid_code = key_map.get(key_name, 0x00)
+            if hid_code:
+                with open(HID_KEYBOARD_DEV, 'wb') as hid:
+                    hid.write(struct.pack('8B', 0, 0, hid_code, 0, 0, 0, 0, 0))
+                    time.sleep(0.05)
+                    hid.write(struct.pack('8B', 0, 0, 0, 0, 0, 0, 0, 0))
+                return True
+            return False
+        except Exception as ex:
+            self._logger.error("Direct key press error: %s", ex)
+            return False
+
+    def keyboard_shortcut(self, keys: list[str]) -> bool:
+        """Send a keyboard shortcut (list of key names)."""
+        from ...keyboard.mappings import WEB_TO_EVDEV
+        import evdev
+
+        if self._hid is not None:
+            try:
+                # Press all modifier keys in order
+                for key_name in keys:
+                    key = WEB_TO_EVDEV[key_name]
+                    self._hid.send_key_event(key, True, False)
+                    time.sleep(0.02)
+
+                # Hold all keys briefly to ensure iOS registers the press
+                time.sleep(0.08)
+
+                # Release in reverse
+                for key_name in reversed(keys):
+                    key = WEB_TO_EVDEV[key_name]
+                    self._hid.send_key_event(key, False, False)
+                    time.sleep(0.02)
+                return True
+            except Exception as ex:
+                self._logger.error("HID shortcut error: %s", ex)
+                return False
+        return False
+
+    # Character-to-key mapping for the "type" step
+    # char -> (key_name, needs_shift)
+    _CHAR_MAP = {
+        '!': ('Digit1', True),  '@': ('Digit2', True),
+        '#': ('Digit3', True),  '$': ('Digit4', True),
+        '%': ('Digit5', True),  '^': ('Digit6', True),
+        '&': ('Digit7', True),  '*': ('Digit8', True),
+        '(': ('Digit9', True),  ')': ('Digit0', True),
+        '-': ('Minus', False),  '_': ('Minus', True),
+        '=': ('Equal', False),  '+': ('Equal', True),
+        '[': ('BracketLeft', False), '{': ('BracketLeft', True),
+        ']': ('BracketRight', False), '}': ('BracketRight', True),
+        '\\': ('Backslash', False), '|': ('Backslash', True),
+        ';': ('Semicolon', False), ':': ('Semicolon', True),
+        "'": ('Quote', False),   '"': ('Quote', True),
+        ',': ('Comma', False),   '<': ('Comma', True),
+        '.': ('Period', False),  '>': ('Period', True),
+        '/': ('Slash', False),   '?': ('Slash', True),
+        '`': ('Backquote', False), '~': ('Backquote', True),
+    }
+
+    # ======================================================================
+    # Sequence Execution
+    # ======================================================================
+
+    def _save_sequence(self, name: str, steps: list[dict]) -> str:
+        """Save a sequence to disk."""
+        safe_name = "".join(c if c.isalnum() or c in "._- " else "_" for c in name)
+        path = os.path.join(self._sequences_dir, f"{safe_name}.json")
+        data = {"name": name, "steps": steps}
+        with open(path, "w", encoding="utf-8") as f:
+            json.dump(data, f, ensure_ascii=False, indent=2)
+        self._logger.info("Saved sequence: %s", path)
+        return path
+
+    def _load_sequence(self, name: str) -> dict:
+        """Load a sequence from disk."""
+        if not name.endswith(".json"):
+            name += ".json"
+        path = os.path.join(self._sequences_dir, name)
+        if not os.path.exists(path):
+            raise SequenceNotFoundError(f"Sequence not found: {name}")
+        with open(path, "r", encoding="utf-8") as f:
+            return json.load(f)
+
+    def list_sequences(self) -> list[dict]:
+        """List all saved sequences."""
+        sequences = []
+        if os.path.isdir(self._sequences_dir):
+            for fname in sorted(os.listdir(self._sequences_dir)):
+                if fname.endswith(".json"):
+                    fpath = os.path.join(self._sequences_dir, fname)
+                    try:
+                        with open(fpath, "r", encoding="utf-8") as f:
+                            data = json.load(f)
+                        sequences.append({
+                            "name": data.get("name", fname),
+                            "filename": fname,
+                            "step_count": len(data.get("steps", [])),
+                            "size": os.path.getsize(fpath),
+                        })
+                    except Exception:
+                        pass
+        return sequences
+
+    def get_sequence(self, name: str) -> dict:
+        """Load and return a saved sequence by filename (with steps)."""
+        sequence = self._load_sequence(name)
+        return {
+            "name": sequence.get("name", name),
+            "filename": name if name.endswith(".json") else name + ".json",
+            "steps": sequence.get("steps", []),
+            "step_count": len(sequence.get("steps", [])),
+        }
+
+    def delete_sequence(self, name: str) -> bool:
+        """Delete a saved sequence."""
+        try:
+            if not name.endswith(".json"):
+                name += ".json"
+            path = os.path.join(self._sequences_dir, name)
+            if os.path.exists(path):
+                os.remove(path)
+                return True
+            return False
+        except OSError:
+            return False
+
+    async def run_sequence(self, name: str, repeat: int = 1) -> dict:
+        """
+        Execute a saved sequence.
+
+        The sequence is a list of steps, where each step is a dict:
+          - {"type": "detect", "template": "...", "timeout": 10, "click": true}
+          - {"type": "move", "x": 100, "y": 200}
+          - {"type": "click", "x": 100, "y": 200, "button": "left"}
+          - {"type": "ocr", "left": 0, "top": 0, "right": 100, "bottom": 50,
+             "expected": "...", "prompt": "..."}
+          - {"type": "key", "key": "Enter"}  (single key press)
+          - {"type": "keys", "keys": ["ControlLeft", "KeyC"]}  (shortcut)
+          - {"type": "type", "text": "Hello World"}  (type text)
+          - {"type": "wait", "duration": 2}  (seconds)
+          - {"type": "assert_ocr", "left": 0, "top": 0, "right": 100, "bottom": 50,
+             "expected": "...", "prompt": "..."}
+          - {"type": "snapshot"}  (save snapshot with timestamp)
+
+        Returns:
+            Dict with keys: success, results (list of step results), sequence_name
+        """
+        try:
+            sequence = self._load_sequence(name)
+        except SequenceNotFoundError as ex:
+            return {"success": False, "error": str(ex)}
+
+        self._stop_event.clear()
+        steps = sequence.get("steps", [])
+        results = []
+        rep = 0
+        _early_stop = False
+        _stopped = False
+
+        for rep in range(repeat):
+            self._check_stop()
+            if _stopped or _early_stop:
+                break
+            step_index = 0
+            prev_ok = True
+
+            for step in steps:
+                step_index += 1
+                step_type = step.get("type", "unknown")
+                result = {"step": step_index, "type": step_type, "status": "pending"}
+
+            # Skip if "only_if_prev_ok" is set and previous step failed
+                if step.get("only_if_prev_ok", False) and not prev_ok:
+                    result["status"] = "skipped"
+                    result["error"] = "Skipped: previous step failed"
+                    results.append(result)
+                    continue
+
+                try:
+                    # Check stop inside try so SequenceStoppedError is always caught
+                    self._check_stop()
+                    if step_type == "wait":
+                        duration = float(step.get("duration", 1))
+                        await asyncio.sleep(duration)
+                        result["status"] = "ok"
+                        result["duration"] = duration
+
+                    elif step_type == "detect":
+                        template = step.get("template", "")
+                        threshold = float(step.get("threshold", 0.8))
+                        click_after = bool(step.get("click", False))
+                        retry_interval = float(step.get("retry_interval", 0))
+                        max_retries = int(step.get("max_retries", 1))
+
+                        match_found = False
+                        for retry in range(max(max_retries, 1)):
+                            if retry > 0:
+                                await asyncio.sleep(retry_interval)
+                            snapshot = await self.take_snapshot()
+                            if snapshot is None:
+                                continue
+                            match_result = await self.match_template(template, snapshot, threshold)
+                            if match_result.get("found"):
+                                match_found = True
+                                break
+
+                        if match_found:
+                            center = match_result["center"]
+                            snap_w = match_result.get("snapshot_width", SCREEN_W)
+                            snap_h = match_result.get("snapshot_height", SCREEN_H)
+                            click_x = int(center[0] * SCREEN_W / max(snap_w, 1))
+                            click_y = int(center[1] * SCREEN_H / max(snap_h, 1))
+                            self._logger.info(
+                                "Detect match (retry=%d): center=%s click=(%d,%d) conf=%.4f",
+                                retry, center, click_x, click_y,
+                                match_result.get("confidence", 0),
+                            )
+                            result["status"] = "ok"
+                            result["match"] = match_result
+                            if click_after:
+                                self.mouse_click(click_x, click_y)
+                                result["clicked"] = True
+                            if step.get("stop_on_found", False):
+                                result["stopped_on_success"] = True
+                                _early_stop = True
+                                results.append(result)
+                                break
+                        else:
+                            result["status"] = "error"
+                            result["error"] = f"Template '{template}' not found (retried {max_retries}x)"
+
+                    elif step_type == "click":
+                        x = int(step.get("x", 0))
+                        y = int(step.get("y", 0))
+                        button = step.get("button", "left")
+                    # First move to position
+                        self.mouse_move(x, y)
+                        time.sleep(0.1)
+                        self.mouse_click(x, y, button)
+                        result["status"] = "ok"
+                        result["position"] = (x, y)
+
+                    elif step_type == "move":
+                        x = int(step.get("x", 0))
+                        y = int(step.get("y", 0))
+                        self.mouse_move(x, y)
+                        result["status"] = "ok"
+                        result["position"] = (x, y)
+
+                    elif step_type == "key":
+                        key = step.get("key", "")
+                        if len(key) == 1 and key.isupper():
+                            # Single uppercase letter needs Shift + key
+                            self.keyboard_shortcut(["ShiftLeft", f"Key{key.upper()}"])
+                        else:
+                            self.keyboard_press_key(key)
+                        result["status"] = "ok"
+                        result["key"] = key
+
+                    elif step_type == "keys":
+                        keys = step.get("keys", [])
+                        self.keyboard_shortcut(keys)
+                        result["status"] = "ok"
+                        result["keys"] = keys
+
+                    elif step_type == "type":
+                        text = step.get("text", "")
+                        delay = float(step.get("delay", 0.05))
+                        for char in text:
+                        # Map character to key name
+                            if char.isalpha():
+                                key_name = f"Key{char.upper()}"
+                                if char.isupper():
+                                    self.keyboard_shortcut(["ShiftLeft", key_name])
+                                else:
+                                    self.keyboard_press_key(key_name)
+                            elif char.isdigit():
+                                self.keyboard_press_key(f"Digit{char}")
+                            elif char == ' ':
+                                self.keyboard_press_key("Space")
+                            elif char == '\n':
+                                self.keyboard_press_key("Enter")
+                            elif char == '\t':
+                                self.keyboard_press_key("Tab")
+                            elif char in self._CHAR_MAP:
+                                key_name, need_shift = self._CHAR_MAP[char]
+                                if need_shift:
+                                    self.keyboard_shortcut(["ShiftLeft", key_name])
+                                else:
+                                    self.keyboard_press_key(key_name)
+                            else:
+                                continue
+                            time.sleep(delay)
+                        result["status"] = "ok"
+                        result["text"] = text
+
+                    elif step_type == "ocr":
+                        snapshot = await self.take_snapshot()
+                        if snapshot is None:
+                            result["status"] = "error"
+                            result["error"] = "No snapshot"
+                            results.append(result)
+                            if not step.get("allow_fail", False):
+                                break
+
+                        left = int(step.get("left", 0))
+                        top = int(step.get("top", 0))
+                        right = int(step.get("right", 0))
+                        bottom = int(step.get("bottom", 0))
+                        prompt = step.get("prompt", None)
+
+                        ocr_result = await self.ocr_region(
+                            snapshot, left, top, right, bottom, prompt
+                        )
+                        result["status"] = "ok" if ocr_result["success"] else "error"
+                        result["ocr"] = ocr_result
+                        if ocr_result.get("error"):
+                            result["error"] = ocr_result["error"]
+
+                    elif step_type == "assert_ocr":
+                        snapshot = await self.take_snapshot()
+                        if snapshot is None:
+                            result["status"] = "error"
+                            result["error"] = "No snapshot"
+                            results.append(result)
+                            if not step.get("allow_fail", False):
+                                break
+
+                        left = int(step.get("left", 0))
+                        top = int(step.get("top", 0))
+                        right = int(step.get("right", 0))
+                        bottom = int(step.get("bottom", 0))
+                        expected = step.get("expected", "")
+                        prompt = step.get("prompt", None)
+
+                        ocr_result = await self.ocr_region(
+                            snapshot, left, top, right, bottom, prompt
+                        )
+                        if ocr_result["success"]:
+                            actual = ocr_result["text"]
+                            # Support multiple expected strings (list) or single string
+                            expected_list = expected if isinstance(expected, list) else [expected]
+                            matched_all = True
+                            missing = []
+                            for e in expected_list:
+                                if e and e not in actual:
+                                    matched_all = False
+                                    missing.append(e)
+                            matched = matched_all
+                            result["status"] = "ok" if matched else "fail"
+                            result["expected"] = expected
+                            result["actual"] = actual
+                            if step.get("stop_on_match", False):
+                                result["stopped_on_success"] = True
+                                _early_stop = True
+                                results.append(result)
+                                break
+                            if not matched:
+                                result["error"] = f"Expected strings not found: {missing}"
+                                results.append(result)
+                                break
+                        else:
+                            result["status"] = "error"
+                            result["error"] = ocr_result.get("error", "OCR failed")
+                            results.append(result)
+                            if not step.get("allow_fail", False):
+                                break
+
+                    elif step_type == "snapshot":
+                        snapshot = await self.take_snapshot()
+                        if snapshot:
+                            timestamp = time.strftime("%Y%m%d_%H%M%S")
+                            fpath = f"/tmp/automation_snapshot_{timestamp}.jpg"
+                            with open(fpath, "wb") as f:
+                                f.write(snapshot)
+                            result["status"] = "ok"
+                            result["snapshot_path"] = fpath
+                        else:
+                            result["status"] = "error"
+                            result["error"] = "No snapshot"
+
+                    else:
+                        result["status"] = "error"
+                        result["error"] = f"Unknown step type: {step_type}"
+                        results.append(result)
+                        if not step.get("allow_fail", False):
+                            break
+
+                except SequenceStoppedError:
+                    _stopped = True
+                    result["status"] = "stopped"
+                    result["error"] = "Sequence stopped by user"
+                    results.append(result)
+                    break
+
+                except Exception as ex:
+                    result["status"] = "error"
+                    result["error"] = str(ex)
+                    results.append(result)
+                    if not step.get("allow_fail", False):
+                        break
+                    continue
+
+                prev_ok = result.get("status") in ("ok", "skipped", "fail")
+                if not results or results[-1].get("step") != step_index:
+                    results.append(result)
+
+            if _early_stop or _stopped:
+                break
+
+        success = all(r.get("status") in ("ok", "fail") for r in results)
+        return {
+            "success": success,
+            "sequence_name": name,
+            "total_steps": len(steps) * repeat,
+            "completed_steps": len(results),
+            "results": results,
+        }
