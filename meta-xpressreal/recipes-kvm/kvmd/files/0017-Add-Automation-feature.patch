+# ========================================================================== #
+#                                                                            #
+#    KVMD - Test Automation API                                              #
+#                                                                            #
+#    HTTP API endpoints for the test automation system.                      #
+#    Provides template matching, OCR, HID control, and sequence management.  #
+#                                                                            #
+# ========================================================================== #
+
+
+import json
+import base64
+import os
+
+from typing import Any
+
+from aiohttp.web import Request
+from aiohttp.web import Response
+
+from ....htserver import exposed_http
+from ....htserver import make_json_response
+from ....htserver import UnavailableError
+
+from ....validators.basic import valid_bool
+from ....validators.basic import valid_number
+from ....validators.basic import valid_int_f0
+
+from ..automation_engine import AutomationEngine
+from ..automation_engine import TemplateNotFoundError
+from ..automation_engine import SequenceNotFoundError
+
+from ....logging import get_logger
+
+
+# =====
+class AutomationApi:
+    """
+    API endpoints for test automation.
+
+    All endpoints are under the /automation prefix.
+    """
+
+    def __init__(self, engine: AutomationEngine) -> None:
+        self._engine = engine
+
+    # ======================================================================
+    # Template Management
+    # ======================================================================
+
+    @exposed_http("GET", "/automation/templates")
+    async def __list_templates_handler(self, _: Request) -> Response:
+        """List all saved template images."""
+        templates = self._engine.list_templates()
+        return make_json_response({"templates": templates})
+
+    @exposed_http("POST", "/automation/templates/save")
+    async def __save_template_handler(self, req: Request) -> Response:
+        """
+        Save a template image from a snapshot region.
+
+        POST body (JSON):
+        {
+            "name": "template_name",
+            "snapshot": "<optional base64 JPEG data - if omitted, takes fresh snapshot>",
+            "left": 100, "top": 200,
+            "right": 400, "bottom": 350
+        }
+        """
+        try:
+            body = await req.json()
+        except Exception:
+            return make_json_response({"error": "Invalid JSON body"}, status=400)
+
+        name = body.get("name", "unnamed")
+        snapshot_b64 = body.get("snapshot", None)
+        left = int(body.get("left", 0))
+        top = int(body.get("top", 0))
+        right = int(body.get("right", 0))
+        bottom = int(body.get("bottom", 0))
+
+        # If no snapshot provided, take one from the tee file
+        if not snapshot_b64:
+            snapshot_jpg = await self._engine.take_snapshot()
+            if snapshot_jpg is None:
+                return make_json_response({"error": "No snapshot available"}, status=500)
+        else:
+            try:
+                snapshot_jpg = base64.b64decode(snapshot_b64)
+            except Exception:
+                return make_json_response({"error": "Invalid base64 data"}, status=400)
+
+        try:
+            path = self._engine.save_template_from_snapshot(
+                name, snapshot_jpg, left, top, right, bottom
+            )
+            return make_json_response({"saved": True, "path": path, "name": name})
+        except Exception as ex:
+            return make_json_response({"error": str(ex)}, status=500)
+
+    @exposed_http("DELETE", "/automation/templates/{name}")
+    async def __delete_template_handler(self, req: Request) -> Response:
+        """Delete a saved template."""
+        name = req.match_info.get("name", "")
+        if not name:
+            return make_json_response({"error": "No template name"}, status=400)
+
+        ok = self._engine.delete_template(name)
+        return make_json_response({"deleted": ok})
+
+    # ======================================================================
+    # Template Matching
+    # ======================================================================
+
+    @exposed_http("POST", "/automation/match")
+    async def __match_template_handler(self, req: Request) -> Response:
+        """
+        Run template matching.
+
+        POST body (JSON):
+        {
+            "template": "template_name.jpg",
+            "snapshot": "<optional base64 JPEG - if omitted, takes fresh snapshot>",
+            "threshold": 0.8
+        }
+        """
+        try:
+            body = await req.json()
+        except Exception:
+            return make_json_response({"error": "Invalid JSON body"}, status=400)
+
+        template_name = body.get("template", "")
+        snapshot_b64 = body.get("snapshot", None)
+        threshold = float(body.get("threshold", 0.8))
+
+        snapshot_jpg = None
+        if snapshot_b64:
+            try:
+                snapshot_jpg = base64.b64decode(snapshot_b64)
+            except Exception:
+                return make_json_response({"error": "Invalid base64"}, status=400)
+
+        result = await self._engine.match_template(template_name, snapshot_jpg, threshold)
+        return make_json_response(result)
+
+    # ======================================================================
+    # Snapshot
+    # ======================================================================
+
+    @exposed_http("POST", "/automation/snapshot")
+    async def __take_snapshot_handler(self, _: Request) -> Response:
+        """Take a snapshot and return it as base64 JPEG."""
+        data = await self._engine.take_snapshot()
+        if data is None:
+            raise UnavailableError()
+
+        b64 = base64.b64encode(data).decode("ascii")
+        return make_json_response({"snapshot": b64, "size": len(data)})
+
+    # ======================================================================
+    # OCR
+    # ======================================================================
+
+    @exposed_http("POST", "/automation/ocr")
+    async def __ocr_handler(self, req: Request) -> Response:
+        """
+        Run OCR on a snapshot region using Gemini.
+
+        POST body (JSON):
+        {
+            "snapshot": "<base64 JPEG data>",
+            "left": 100, "top": 200,
+            "right": 400, "bottom": 350,
+            "prompt": "optional custom prompt"
+        }
+        """
+        try:
+            body = await req.json()
+        except Exception:
+            return make_json_response({"error": "Invalid JSON body"}, status=400)
+
+        snapshot_b64 = body.get("snapshot", "")
+        left = int(body.get("left", 0))
+        top = int(body.get("top", 0))
+        right = int(body.get("right", 0))
+        bottom = int(body.get("bottom", 0))
+
+        try:
+            snapshot_jpg = base64.b64decode(snapshot_b64)
+        except Exception:
+            return make_json_response({"error": "Invalid base64"}, status=400)
+
+        prompt = body.get("prompt", None)
+        result = await self._engine.ocr_region(
+            snapshot_jpg, left, top, right, bottom, prompt
+        )
+        return make_json_response(result)
+
+    # ======================================================================
+    # HID Actions
+    # ======================================================================
+
+    @exposed_http("POST", "/automation/action/mouse/move")
+    async def __mouse_move_handler(self, req: Request) -> Response:
+        """Move mouse to absolute coordinates."""
+        try:
+            body = await req.json()
+        except Exception:
+            return make_json_response({"error": "Invalid JSON body"}, status=400)
+
+        x = int(body.get("x", 0))
+        y = int(body.get("y", 0))
+        ok = self._engine.mouse_move(x, y)
+        return make_json_response({"ok": ok})
+
+    @exposed_http("POST", "/automation/action/mouse/click")
+    async def __mouse_click_handler(self, req: Request) -> Response:
+        """Click mouse at coordinates."""
+        try:
+            body = await req.json()
+        except Exception:
+            return make_json_response({"error": "Invalid JSON body"}, status=400)
+
+        x = int(body.get("x", 0))
+        y = int(body.get("y", 0))
+        button = body.get("button", "left")
+        ok = self._engine.mouse_click(x, y, button)
+        return make_json_response({"ok": ok})
+
+    @exposed_http("POST", "/automation/action/key")
+    async def __key_handler(self, req: Request) -> Response:
+        """Press a single key."""
+        try:
+            body = await req.json()
+        except Exception:
+            return make_json_response({"error": "Invalid JSON body"}, status=400)
+
+        key = body.get("key", "")
+        ok = self._engine.keyboard_press_key(key)
+        return make_json_response({"ok": ok})
+
+    @exposed_http("POST", "/automation/action/shortcut")
+    async def __shortcut_handler(self, req: Request) -> Response:
+        """Send a keyboard shortcut (list of keys)."""
+        try:
+            body = await req.json()
+        except Exception:
+            return make_json_response({"error": "Invalid JSON body"}, status=400)
+
+        keys = body.get("keys", [])
+        ok = self._engine.keyboard_shortcut(keys)
+        return make_json_response({"ok": ok})
+
+    # ======================================================================
+    # Sequence Management
+    # ======================================================================
+
+    @exposed_http("GET", "/automation/sequences")
+    async def __list_sequences_handler(self, _: Request) -> Response:
+        """List all saved test sequences."""
+        sequences = self._engine.list_sequences()
+        return make_json_response({"sequences": sequences})
+
+    @exposed_http("POST", "/automation/sequences/save")
+    async def __save_sequence_handler(self, req: Request) -> Response:
+        """Save a test sequence.
+
+        POST body (JSON):
+        {
+            "name": "My Test",
+            "steps": [ ... ]
+        }
+        """
+        try:
+            body = await req.json()
+        except Exception:
+            return make_json_response({"error": "Invalid JSON body"}, status=400)
+
+        name = body.get("name", "unnamed")
+        steps = body.get("steps", [])
+
+        if not steps:
+            return make_json_response({"error": "No steps defined"}, status=400)
+
+        path = self._engine._save_sequence(name, steps)
+        return make_json_response({"saved": True, "path": path, "name": name, "step_count": len(steps)})
+
+    @exposed_http("POST", "/automation/sequences/run")
+    async def __run_sequence_handler(self, req: Request) -> Response:
+        """Run a saved test sequence.
+
+        POST body (JSON):
+        {
+            "name": "My Test"
+        }
+        """
+        try:
+            body = await req.json()
+        except Exception:
+            return make_json_response({"error": "Invalid JSON body"}, status=400)
+
+        name = body.get("name", "")
+        repeat = int(body.get("repeat", 1))
+        if not name:
+            return make_json_response({"error": "No sequence name"}, status=400)
+
+        result = await self._engine.run_sequence(name, repeat=repeat)
+        return make_json_response(result)
+
+    @exposed_http("POST", "/automation/sequence/stop")
+    async def __stop_sequence_handler(self, _: Request) -> Response:
+        """Stop the currently running sequence."""
+        self._engine.stop_sequence()
+        return make_json_response({"ok": True})
+
+    @exposed_http("GET", "/automation/sequences/{name}")
+    async def __get_sequence_handler(self, req: Request) -> Response:
+        """Get a saved sequence by filename (with steps)."""
+        name = req.match_info.get("name", "")
+        if not name:
+            return make_json_response({"error": "No sequence name"}, status=400)
+        try:
+            sequence = self._engine.get_sequence(name)
+            return make_json_response(sequence)
+        except SequenceNotFoundError as ex:
+            return make_json_response({"error": str(ex)}, status=404)
+
+    @exposed_http("DELETE", "/automation/sequences/{name}")
+    async def __delete_sequence_handler(self, req: Request) -> Response:
+        """Delete a saved sequence."""
+        name = req.match_info.get("name", "")
+        ok = self._engine.delete_sequence(name)
+        return make_json_response({"deleted": ok})
+
+    # ======================================================================
+    # Schedule (autonomous batch execution on dev board)
+    # ======================================================================
+
+    @exposed_http("POST", "/automation/schedule")
+    async def __schedule_handler(self, req: Request) -> Response:
+        """
+        Schedule a batch run to execute autonomously on the dev board.
+
+        POST body (JSON):
+        {
+            "run_at": 1700000000000,   # Unix timestamp in ms (dev board time)
+            "sequences": ["seq1", "seq2"]
+        }
+        """
+        try:
+            body = await req.json()
+        except Exception:
+            return make_json_response({"error": "Invalid JSON body"}, status=400)
+
+        run_at = int(body.get("run_at", 0))
+        sequences = body.get("sequences", [])
+
+        if not run_at:
+            return make_json_response({"error": "No run_at timestamp"}, status=400)
+        if not sequences:
+            return make_json_response({"error": "No sequences"}, status=400)
+
+        import time
+        now_ms = int(time.time() * 1000)
+        if run_at <= now_ms:
+            return make_json_response({"error": "run_at must be in the future"}, status=400)
+
+        result = await self._engine.schedule_batch(run_at, sequences)
+        return make_json_response(result)
+
+    @exposed_http("GET", "/automation/schedule")
+    async def __schedule_status_handler(self, _: Request) -> Response:
+        """Get the current schedule status."""
+        status = self._engine.get_schedule_status()
+        return make_json_response(status)
+
+    @exposed_http("POST", "/automation/schedule/cancel")
+    async def __schedule_cancel_handler(self, _: Request) -> Response:
+        """Cancel the pending schedule."""
+        result = self._engine.cancel_schedule()
+        return make_json_response(result)
+
+    # ======================================================================
+    # Gemini Key Management
+    # ======================================================================
+
+    @exposed_http("GET", "/automation/gemini/status")
+    async def __gemini_status_handler(self, _: Request) -> Response:
+        """Get the current Gemini API key status (masked for security)."""
+        status = self._engine.get_gemini_status()
+        return make_json_response(status)
+
+    @exposed_http("GET", "/automation/time")
+    async def __time_handler(self, _: Request) -> Response:
+        """Get the current server (dev board) time as Unix timestamp in milliseconds."""
+        import time
+        return make_json_response({"timestamp": int(time.time() * 1000)})
+
+    @exposed_http("POST", "/automation/gemini/reload")
+    async def __gemini_reload_handler(self, _: Request) -> Response:
+        """Reload API keys from the key file without restarting the server."""
+        result = self._engine.reload_api_keys()
+        return make_json_response(result)
