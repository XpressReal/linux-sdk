+/*****************************************************************************
+#                                                                            #
+#    KVMD - Test Automation CSS                                              #
+#                                                                            #
+#    Styles for the test automation window.                                  #
+#    Uses PiKVM standard CSS variables (--cs-*) for theming.                 #
+#                                                                            #
+*****************************************************************************/
+
+
+#automation-window {
+    min-width: 800px;
+    min-height: 500px;
+    width: 900px;
+    height: 650px;
+    background: var(--cs-window-default-bg, #1e1f22);
+    color: var(--cs-page-default-fg, #dcddde);
+}
+
+#automation-window .automation-body {
+    display: flex;
+    flex-direction: column;
+    height: calc(100% - 36px);
+    padding: 10px;
+    gap: 8px;
+    overflow: hidden;
+}
+
+.automation-main {
+    display: flex;
+    flex: 1;
+    gap: 10px;
+    overflow: hidden;
+}
+
+.automation-panel {
+    display: flex;
+    flex-direction: column;
+    gap: 6px;
+}
+
+.automation-panel-left {
+    width: 280px;
+    min-width: 200px;
+    border-right: 1px solid var(--cs-control-disabled-bg, #36393f);
+    padding-right: 10px;
+}
+
+.automation-panel-right {
+    flex: 1;
+    overflow: hidden;
+}
+
+/* Panel headers */
+.automation-panel h3 {
+    margin: 0 0 6px 0;
+    font-size: 13px;
+    color: var(--cs-page-default-fg, #dcddde);
+    text-transform: uppercase;
+    letter-spacing: 0.5px;
+    border-bottom: 1px solid var(--cs-control-disabled-bg, #36393f);
+    padding-bottom: 4px;
+}
+
+/* Template list */
+#automation-template-list {
+    flex: 1;
+    overflow-y: auto;
+    list-style: none;
+    padding: 0;
+    margin: 0;
+}
+
+#automation-template-list li {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    padding: 6px 8px;
+    margin: 2px 0;
+    border-radius: 4px;
+    cursor: pointer;
+    font-size: 12px;
+    color: var(--cs-page-default-fg, #dcddde);
+    background: var(--cs-control-default-bg, #2b2d30);
+    border: 1px solid transparent;
+}
+
+#automation-template-list li:hover {
+    background: var(--cs-control-hovered-bg, #393c41);
+    border-color: var(--cs-control-intensive-fg, #5b90bb);
+}
+
+#automation-template-list li.selected {
+    background: var(--cs-control-hovered-bg, #393c41);
+    border-color: var(--cs-control-intensive-fg, #5b90bb);
+    color: var(--cs-page-default-fg, #dcddde);
+    font-weight: bold;
+}
+
+#automation-template-list li .template-name {
+    flex: 1;
+    overflow: hidden;
+    text-overflow: ellipsis;
+    white-space: nowrap;
+    color: inherit;
+}
+
+#automation-template-list li .template-delete-btn {
+    cursor: pointer;
+    opacity: 0.6;
+    padding: 0 6px;
+    color: #dcddde;
+    font-size: 14px;
+}
+
+#automation-template-list li .template-delete-btn:hover {
+    opacity: 1;
+    color: #ff6b6b;
+}
+
+/* Template buttons */
+.automation-template-buttons {
+    display: flex;
+    gap: 4px;
+}
+
+.automation-template-buttons button {
+    flex: 1;
+    padding: 6px 8px;
+    font-size: 11px;
+    font-weight: 600;
+    color: #e8e8eb;
+    background: #3a3d45;
+    border: 1px solid #555860;
+    border-radius: 3px;
+    cursor: pointer;
+    transition: background 0.15s, border-color 0.15s;
+}
+
+.automation-template-buttons button:hover {
+    background: #4a4d55;
+    border-color: #7a7d88;
+}
+
+.automation-template-buttons button:active {
+    background: #2a2d35;
+}
+
+/* Steps editor */
+#automation-steps-container {
+    flex: 1;
+    overflow-y: auto;
+    margin: 4px 0;
+}
+
+.automation-step {
+    display: flex;
+    align-items: flex-start;
+    gap: 8px;
+    padding: 8px 10px;
+    margin: 4px 0;
+    background: var(--cs-control-default-bg, #2b2d30);
+    border: 1px solid var(--cs-control-disabled-bg, #36393f);
+    border-radius: 4px;
+    font-size: 12px;
+    color: var(--cs-page-default-fg, #dcddde);
+}
+
+.automation-step:hover {
+    border-color: var(--cs-control-intensive-fg, #5b90bb);
+}
+
+.automation-step .step-number {
+    width: 24px;
+    height: 24px;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    background: var(--cs-control-intensive-fg, #5b90bb);
+    color: #ffffff;
+    border-radius: 50%;
+    font-weight: bold;
+    font-size: 11px;
+    flex-shrink: 0;
+}
+
+.automation-step .step-content {
+    flex: 1;
+    min-width: 0;
+}
+
+.automation-step .step-type {
+    font-weight: bold;
+    color: var(--cs-page-default-fg, #dcddde);
+    margin-bottom: 2px;
+    font-size: 13px;
+}
+
+.automation-step .step-desc {
+    color: var(--cs-control-disabled-fg, #8a8e97);
+    font-size: 11px;
+}
+
+.automation-step .step-actions {
+    display: flex;
+    gap: 4px;
+    flex-shrink: 0;
+}
+
+.automation-step .step-actions button {
+    cursor: pointer;
+    opacity: 0.6;
+    background: none;
+    border: none;
+    color: var(--cs-page-default-fg, #dcddde);
+    font-size: 14px;
+    padding: 2px 6px;
+    border-radius: 3px;
+}
+
+.automation-step .step-actions button:hover {
+    opacity: 1;
+    background: var(--cs-control-hovered-bg, #393c41);
+}
+
+/* Add step toolbar */
+.automation-add-step-toolbar {
+    display: flex;
+    flex-wrap: wrap;
+    gap: 4px;
+    padding: 6px 0;
+}
+
+.automation-add-step-toolbar button {
+    padding: 6px 14px;
+    font-size: 11px;
+    font-weight: 600;
+    white-space: nowrap;
+    color: #e8e8eb;
+    background: #3a3d45;
+    border: 1px solid #555860;
+    border-radius: 3px;
+    cursor: pointer;
+    transition: background 0.15s, border-color 0.15s;
+}
+
+.automation-add-step-toolbar button:hover {
+    background: #4a4d55;
+    border-color: #7a7d88;
+}
+
+.automation-add-step-toolbar button:active {
+    background: #2a2d35;
+}
+
+/* Sequence controls */
+.automation-sequence-controls {
+    display: flex;
+    gap: 6px;
+    align-items: center;
+    padding: 8px 0;
+    border-top: 1px solid var(--cs-control-disabled-bg, #36393f);
+}
+
+#automation-seq-name-input {
+    flex: 1;
+    padding: 6px 10px;
+    font-size: 13px;
+    font-weight: 600;
+    background: #3a3d45;
+    border: 1px solid #555860;
+    color: #f0f0f5;
+    border-radius: 3px;
+    min-width: 0;
+    transition: border-color 0.15s;
+}
+
+#automation-seq-name-input:focus {
+    border-color: #7a9dcc;
+    outline: none;
+}
+
+#automation-sequence-select {
+    padding: 6px 10px;
+    font-size: 12px;
+    font-weight: 500;
+    background: #3a3d45;
+    border: 1px solid #555860;
+    color: #f0f0f5;
+    border-radius: 3px;
+    cursor: pointer;
+    max-width: 240px;
+    -webkit-appearance: none;
+    -moz-appearance: none;
+    appearance: none;
+    background-image: url("data:image/svg+xml;charset=UTF-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='10' height='6'%3E%3Cpath d='M0 0l5 6 5-6z' fill='%23ccc'/%3E%3C/svg%3E");
+    background-repeat: no-repeat;
+    background-position: right 8px center;
+    padding-right: 26px;
+    transition: border-color 0.15s;
+}
+
+#automation-sequence-select:focus {
+    border-color: #7a9dcc;
+    outline: none;
+}
+
+.automation-sequence-controls button {
+    padding: 6px 14px;
+    font-size: 11px;
+    font-weight: 600;
+    color: #e8e8eb;
+    background: #3a3d45;
+    border: 1px solid #555860;
+    border-radius: 3px;
+    cursor: pointer;
+    transition: background 0.15s, border-color 0.15s;
+}
+
+.automation-sequence-controls button:hover {
+    background: #4a4d55;
+    border-color: #7a7d88;
+}
+
+.automation-sequence-controls button:active {
+    background: #2a2d35;
+}
+
+#automation-run-btn {
+    background: #2d8a4e;
+    color: #ffffff;
+    border: 1px solid #36a15e;
+    border-radius: 3px;
+    padding: 6px 18px;
+    font-weight: bold;
+    cursor: pointer;
+}
+
+#automation-run-btn:hover {
+    background: #36a15e;
+}
+
+#automation-run-btn:disabled {
+    background: #555;
+    color: #aaa;
+    border-color: #555;
+    cursor: not-allowed;
+}
+
+/* Results */
+#automation-results {
+    max-height: 100px;
+    overflow-y: auto;
+    border-top: 1px solid var(--cs-control-disabled-bg, #36393f);
+    padding-top: 6px;
+    font-size: 11px;
+    display: none;
+    color: var(--cs-page-default-fg, #dcddde);
+}
+
+/* Scheduled auto-run */
+.automation-schedule-box {
+    display: flex;
+    gap: 4px;
+    align-items: center;
+    margin-left: auto;
+}
+.automation-schedule-box input[type="datetime-local"] {
+    padding: 4px 6px;
+    font-size: 11px;
+    background: #3a3d45;
+    border: 1px solid #555860;
+    color: #e8e8eb;
+    border-radius: 3px;
+    max-width: 170px;
+}
+.automation-schedule-box button {
+    padding: 4px 10px;
+    font-size: 11px;
+    font-weight: 600;
+    color: #e8e8eb;
+    background: #555860;
+    border: 1px solid #6a6d78;
+    border-radius: 3px;
+    cursor: pointer;
+    transition: background 0.15s;
+}
+.automation-schedule-box button:hover {
+    background: #6a6d88;
+}
+.automation-schedule-box .schedule-countdown {
+    font-size: 11px;
+    color: #cca300;
+    min-width: 60px;
+    text-align: right;
+}
+
+#automation-results.visible {
+    display: block;
+}
+
+.automation-result-item {
+    display: flex;
+    gap: 8px;
+    padding: 4px 4px;
+    align-items: center;
+}
+
+.automation-result-item .result-status {
+    width: 10px;
+    height: 10px;
+    border-radius: 50%;
+    flex-shrink: 0;
+}
+
+.result-status.ok {
+    background: #2d8a4e;
+}
+
+.result-status.error {
+    background: #cc3333;
+}
+
+.result-status.fail {
+    background: #cc8800;
+}
+
+.result-status.running {
+    background: #cca300;
+    animation: pulse 0.5s infinite alternate;
+}
+
+.automation-result-item .result-msg {
+    flex: 1;
+    overflow: hidden;
+    text-overflow: ellipsis;
+    white-space: nowrap;
+}
+
+@keyframes pulse {
+    from { opacity: 0.4; }
+    to { opacity: 1; }
+}
+
+/* Selection overlay - direct DOM manipulation */
+#automation-select-window {
+    cursor: crosshair;
+    position: fixed;
+    width: 100%;
+    height: 100%;
+    top: 0;
+    left: 0;
+    z-index: 1000000;
+    border: none !important;
+    border-radius: 0 !important;
+    padding: 0 !important;
+    margin: 0 !important;
+    background: radial-gradient(transparent 15%, black);
+    display: none;
+    outline: none;
+    overflow: hidden;
+    box-sizing: border-box;
+    pointer-events: auto;
+    touch-action: none;
+}
+
+#automation-select-selection {
+    position: absolute;
+    border: 2px solid #00aaff;
+    background: rgba(0, 170, 255, 0.15);
+    pointer-events: none;
+}
+
+/* Step parameter editor inline */
+.automation-step-params {
+    display: flex;
+    flex-wrap: wrap;
+    gap: 6px;
+    margin-top: 4px;
+}
+
+.automation-step-params label {
+    font-size: 10px;
+    color: var(--cs-control-disabled-fg, #8a8e97);
+    display: flex;
+    align-items: center;
+    gap: 3px;
+}
+
+.automation-step-params input {
+    padding: 3px 5px;
+    font-size: 11px;
+    background-color: #1e1f22;
+    border: 1px solid var(--cs-control-disabled-bg, #36393f);
+    color: var(--cs-page-default-fg, #dcddde);
+    border-radius: 3px;
+}
+
+.automation-step-params select {
+    padding: 4px 6px;
+    font-size: 11px;
+    min-height: 26px;
+    background-color: #1e1f22;
+    border: 1px solid var(--cs-control-disabled-bg, #36393f);
+    color: var(--cs-page-default-fg, #dcddde);
+    border-radius: 3px;
+    max-width: 110px;
+    cursor: pointer;
+}
+
+.automation-step-params input:focus,
+.automation-step-params select:focus {
+    border-color: var(--cs-control-intensive-fg, #5b90bb);
+    outline: none;
+}
+
+.automation-step-params input[type="number"] {
+    max-width: 60px;
+}
+
+/* Empty state */
+.automation-empty {
+    color: var(--cs-control-disabled-fg, #8a8e97);
+    font-size: 12px;
+    text-align: center;
+    padding: 30px 20px;
+    font-style: italic;
+}
+
+/* Loading indicator */
+.automation-loading {
+    display: inline-block;
+    width: 12px;
+    height: 12px;
+    border: 2px solid var(--cs-control-disabled-fg, #555);
+    border-top-color: var(--cs-page-default-fg, #dcddde);
+    border-radius: 50%;
+    animation: spin 0.8s linear infinite;
+}
+
+@keyframes spin {
+    to { transform: rotate(360deg); }
+}
diff --git a/web/share/js/kvm/automation.js b/web/share/js/kvm/automation.js
new file mode 100644
index 00000000..a3c3431f
--- /dev/null
+++ b/web/share/js/kvm/automation.js
@@ -0,0 +1,1282 @@
+/*****************************************************************************
+#                                                                            #
+#    KVMD - Test Automation UI Module                                        #
+#                                                                            #
+#    Provides a visual interface for creating and running automated          #
+#    test sequences on the KVM target using template matching, OCR,          #
+#    mouse and keyboard control.                                             #
+#                                                                            #
+*****************************************************************************/
+
+
+"use strict";
+
+
+import {tools, $} from "../tools.js";
+import {wm} from "../wm.js";
+
+
+// =============================================================================
+
+export function Automation(__getGeometry) {
+    var self = this;
+
+    /************************************************************************/
+
+    // State
+    var __steps = [];
+    var __templates = [];
+    var __sequences = [];
+    var __isRunning = false;
+    var __activeTemplate = null;
+    var __sel = null;
+    var __selMode = null;
+    var __selCallback = null;
+    var __selStartPos = null;
+    var __selEndPos = null;
+
+    // Config storage keys
+    var __STORE_KEY = "automation.steps";
+    var __LAST_SEQ = "automation.last_sequence";
+
+    /************************************************************************/
+    // Initialization
+
+    var __init__ = function() {
+        // Enable the sidebar dropdown (remove feature-disabled class)
+        tools.feature.setEnabled($("automation-dropdown"), true);
+        _setupSidebarButton();
+        _loadTemplates();
+        _loadSequences();
+        _restoreSteps();
+    };
+
+    var _setupSidebarButton = function() {
+        tools.el.setOnClick($("automation-menu-button"), function() {
+            wm.showWindow($("automation-window"));
+        });
+    };
+
+    /************************************************************************/
+    // HTTP helpers (since tools.js only has httpGet and httpPost with query params)
+
+    // KVMD's make_json_response wraps all results in {"ok":true, "result": data}
+    var _unwrapJson = function(http) {
+        var data = JSON.parse(http.responseText);
+        if (data && data.ok && data.result !== undefined) {
+            return data.result;
+        }
+        return data;
+    };
+
+    var _httpPostJson = function(url, data, callback) {
+        var xhr = new XMLHttpRequest();
+        xhr.open("POST", url, true);
+        xhr.setRequestHeader("Content-Type", "application/json");
+        xhr.onreadystatechange = function() {
+            if (xhr.readyState === 4) {
+                callback(xhr);
+            }
+        };
+        xhr.timeout = 60000;
+        xhr.send(JSON.stringify(data));
+    };
+
+    var _httpDelete = function(url, callback) {
+        var xhr = new XMLHttpRequest();
+        xhr.open("DELETE", url, true);
+        xhr.onreadystatechange = function() {
+            if (xhr.readyState === 4) {
+                callback(xhr);
+            }
+        };
+        xhr.timeout = 15000;
+        xhr.send();
+    };
+
+    /************************************************************************/
+    // Template panel rendering
+
+    var _renderTemplatePanel = function() {
+        var list = $("automation-template-list");
+        if (!list) return;
+
+        list.innerHTML = "";
+        if (__templates.length === 0) {
+            list.innerHTML = '<li class="automation-empty">No templates saved yet.<br>Use "Save from stream" to capture one.</li>';
+            _populateTemplateSelects();
+            return;
+        }
+        for (var t of __templates) {
+            var li = document.createElement("li");
+            li.className = (__activeTemplate === t.name ? "selected" : "");
+            li.innerHTML = '<span class="template-name">' + _esc(t.name) + '</span>'
+                + '<span class="template-delete-btn" title="Delete">&times;</span>';
+            li.querySelector(".template-name").onclick = (function(name) {
+                return function() { _selectTemplate(name); };
+            })(t.name);
+            li.querySelector(".template-delete-btn").onclick = (function(name, ev) {
+                ev.stopPropagation();
+                _deleteTemplate(name);
+            }).bind(null, t.name);
+            list.appendChild(li);
+        }
+        _populateTemplateSelects();
+    };
+
+    /************************************************************************/
+    // Steps panel rendering
+
+    var _renderStepsPanel = function() {
+        var container = $("automation-steps-container");
+        if (!container) return;
+
+        container.innerHTML = "";
+        if (__steps.length === 0) {
+            container.innerHTML = '<div class="automation-empty">No steps yet. Click a button below to add one.</div>';
+            return;
+        }
+        for (var i = 0; i < __steps.length; i++) {
+            var step = __steps[i];
+            var div = document.createElement("div");
+            div.className = "automation-step";
+            div.innerHTML = _stepToHtml(i, step);
+            // Bind actions (use closures to capture index)
+            _bindStepActions(div, i);
+            container.appendChild(div);
+        }
+    };
+
+    var _bindStepActions = function(div, idx) {
+        var upBtn = div.querySelector(".step-move-up");
+        var downBtn = div.querySelector(".step-move-down");
+        var delBtn = div.querySelector(".step-delete");
+
+        if (upBtn) upBtn.onclick = function() { _moveStep(idx, -1); };
+        if (downBtn) downBtn.onclick = function() { _moveStep(idx, 1); };
+        if (delBtn) delBtn.onclick = function() { _removeStep(idx); };
+
+        // Bind param changes
+        var inputs = div.querySelectorAll("[data-param]");
+        for (var inp of inputs) {
+            inp.onchange = (function(index, el) {
+                return function() {
+                    var val = el.value;
+                    if (el.type === "number") val = parseFloat(el.value);
+                    if (el.type === "checkbox") val = el.checked;
+                    _updateStepParam(index, el.dataset.param, val);
+                };
+            })(idx, inp);
+        }
+    };
+
+    var _stepToHtml = function(index, step) {
+        var type = step.type || "unknown";
+        var label = _stepLabel(type);
+        var desc = _stepDescription(step);
+
+        return '<div class="step-number">' + (index + 1) + '</div>'
+            + '<div class="step-content">'
+            + '  <div class="step-type">' + _esc(label) + '</div>'
+            + '  <div class="step-desc">' + _esc(desc) + '</div>'
+            + _stepParamsHtml(index, step)
+            + '</div>'
+            + '<div class="step-actions">'
+            + '  <button class="step-move-up" title="Move up">&#9650;</button>'
+            + '  <button class="step-move-down" title="Move down">&#9660;</button>'
+            + '  <button class="step-delete" title="Delete step">&times;</button>'
+            + '</div>';
+    };
+
+    var _stepLabel = function(type) {
+        var labels = {
+            "detect":     "Detect Object",
+            "click":      "Mouse Click",
+            "move":       "Mouse Move",
+            "key":        "Press Key",
+            "keys":       "Keyboard Shortcut",
+            "type":       "Type Text",
+            "ocr":        "OCR Read",
+            "assert_ocr": "Assert OCR",
+            "wait":       "Wait",
+            "snapshot":   "Take Snapshot",
+        };
+        return labels[type] || type;
+    };
+
+    var _stepDescription = function(step) {
+        var extra = "";
+        if (step.allow_fail) extra += " [Allow fail]";
+        if (step.only_if_prev_ok) extra += " [If prev OK]";
+        switch (step.type) {
+            case "detect":     return "Template: " + (step.template || "?") + " | Click: " + (step.click ? "Yes" : "No") + " | Retry " + (step.retry_interval || 1) + "s x " + (step.max_retries || 1) + extra;
+            case "click":      return "(" + (step.x || 0) + ", " + (step.y || 0) + ")";
+            case "move":       return "(" + (step.x || 0) + ", " + (step.y || 0) + ")";
+            case "key":        return "Key: " + (step.key || "?");
+            case "keys":       return "Keys: " + ((step.keys || []).join(" + ") || "?");
+            case "type":       return "Text: \"" + (step.text || "") + "\"";
+            case "ocr":        return "Region: (" + (step.left || 0) + ", " + (step.top || 0) + ")";
+            case "assert_ocr":
+                var ex = step.expected || [];
+                if (!Array.isArray(ex)) ex = [ex];
+                return "Expect: \"" + ex.join('", "') + "\" in region";
+            case "wait":       return (step.duration || 1) + " sec";
+            case "snapshot":   return "Save screenshot";
+            default:           return "";
+        }
+    };
+
+    var _stepParamsHtml = function(index, step) {
+        var html = "";
+        switch (step.type) {
+            case "detect":
+                html += '<div class="automation-step-params">';
+                html += '<label>Template: <select data-param="template" class="param-template-select"></select></label>';
+                html += '<label>Threshold: <input type="number" data-param="threshold" value="' + (step.threshold || 0.8) + '" min="0" max="1" step="0.05"></label>';
+                html += '<label>Click: <input type="checkbox" data-param="click" ' + (step.click ? "checked" : "") + '></label>';
+                html += '<label>Retry: <input type="number" data-param="retry_interval" value="' + (step.retry_interval || 1) + '" min="0.1" step="0.5" style="max-width:50px">s</label>';
+                html += '<label>x <input type="number" data-param="max_retries" value="' + (step.max_retries || 1) + '" min="1" max="999" style="max-width:50px"></label>';
+                html += '<label>Stop: <input type="checkbox" data-param="stop_on_found" ' + (step.stop_on_found ? "checked" : "") + '></label>';
+                html += '</div>';
+                break;
+            case "click":
+            case "move":
+                html += '<div class="automation-step-params">';
+                html += '<label>X: <input type="number" data-param="x" value="' + (step.x || 0) + '"></label>';
+                html += '<label>Y: <input type="number" data-param="y" value="' + (step.y || 0) + '"></label>';
+                html += '</div>';
+                break;
+            case "key":
+                html += '<div class="automation-step-params">';
+                html += '<label>Key: <input type="text" data-param="key" value="' + _esc(step.key || "Enter") + '" style="max-width:100px"></label>';
+                html += '</div>';
+                break;
+            case "keys":
+                html += '<div class="automation-step-params">';
+                html += '<label>Keys: <input type="text" data-param="keys" value="' + _esc((step.keys || []).join(",")) + '" style="max-width:160px" placeholder="Key1,Key2"></label>';
+                html += '</div>';
+                break;
+            case "type":
+                html += '<div class="automation-step-params">';
+                html += '<label>Text: <input type="text" data-param="text" value="' + _esc(step.text || "") + '" style="max-width:160px"></label>';
+                html += '</div>';
+                break;
+            case "ocr":
+            case "assert_ocr":
+                html += '<div class="automation-step-params">';
+                html += '<label>L: <input type="number" data-param="left" value="' + (step.left || 0) + '"></label>';
+                html += '<label>T: <input type="number" data-param="top" value="' + (step.top || 0) + '"></label>';
+                html += '<label>R: <input type="number" data-param="right" value="' + (step.right || 0) + '"></label>';
+                html += '<label>B: <input type="number" data-param="bottom" value="' + (step.bottom || 0) + '"></label>';
+                if (step.type === "assert_ocr") {
+                    var expectVal = step.expected || [];
+                    if (Array.isArray(expectVal)) expectVal = expectVal.join("\n");
+                    html += '<label>Expect:<br><textarea data-param="expected" rows="3" style="max-width:160px;width:100%">' + _esc(expectVal) + '</textarea></label>';
+                    html += '<label>Stop: <input type="checkbox" data-param="stop_on_match" ' + (step.stop_on_match ? "checked" : "") + '></label>';
+                }
+                html += '</div>';
+                break;
+            case "wait":
+                html += '<div class="automation-step-params">';
+                html += '<label>Sec: <input type="number" data-param="duration" value="' + (step.duration || 1) + '" min="0.1" step="0.5"></label>';
+                html += '</div>';
+                break;
+        }
+        // Common flags for all steps
+        html += '<div class="automation-step-params" style="border-top:1px solid var(--cs-control-disabled-bg,#36393f);padding-top:4px;margin-top:4px">';
+        html += '<label><input type="checkbox" data-param="allow_fail" ' + (step.allow_fail ? "checked" : "") + '> Allow fail</label>';
+        html += '<label><input type="checkbox" data-param="only_if_prev_ok" ' + (step.only_if_prev_ok ? "checked" : "") + '> Only if prev OK</label>';
+        html += '</div>';
+        return html;
+    };
+
+    /************************************************************************/
+    // Step management
+
+    var _addStep = function(type) {
+        var step = {type: type};
+        switch (type) {
+            case "detect":     step.template = __activeTemplate || ""; step.threshold = 0.8; step.click = false; step.retry_interval = 1; step.max_retries = 1; break;
+            case "click":      step.x = 960; step.y = 540; break;
+            case "move":       step.x = 960; step.y = 540; break;
+            case "key":        step.key = "Enter"; break;
+            case "keys":       step.keys = ["ControlLeft", "AltLeft", "Delete"]; break;
+            case "type":       step.text = ""; step.delay = 0.05; break;
+            case "ocr":        step.left = 0; step.top = 0; step.right = 100; step.bottom = 50; break;
+            case "assert_ocr": step.left = 0; step.top = 0; step.right = 100; step.bottom = 50; step.expected = []; break;
+            case "wait":       step.duration = 1; break;
+            case "snapshot":   break;
+        }
+        __steps.push(step);
+        _renderStepsPanel();
+        _populateTemplateSelects();
+        _saveSteps();
+    };
+
+    var _removeStep = function(index) {
+        __steps.splice(index, 1);
+        _renderStepsPanel();
+        _populateTemplateSelects();
+        _saveSteps();
+    };
+
+    var _moveStep = function(index, direction) {
+        var newIndex = index + direction;
+        if (newIndex < 0 || newIndex >= __steps.length) return;
+        var tmp = __steps[index];
+        __steps[index] = __steps[newIndex];
+        __steps[newIndex] = tmp;
+        _renderStepsPanel();
+        _populateTemplateSelects();
+        _saveSteps();
+    };
+
+    var _updateStepParam = function(index, param, value) {
+        if (!__steps[index]) return;
+        if (param === "keys") {
+            value = value.split(",").map(function(s) { return s.trim(); }).filter(function(s) { return s; });
+        }
+        if (param === "expected") {
+            value = value.split("\n").map(function(s) { return s.trim(); }).filter(function(s) { return s; });
+        }
+        __steps[index][param] = value;
+        _saveSteps();
+        _renderStepsPanel();
+        _populateTemplateSelects();
+    };
+
+    var _saveSteps = function() {
+        tools.storage.set(__STORE_KEY, JSON.stringify(__steps));
+    };
+
+    var _restoreSteps = function() {
+        try {
+            var saved = tools.storage.get(__STORE_KEY, "[]");
+            __steps = JSON.parse(saved);
+            if (!Array.isArray(__steps)) __steps = [];
+        } catch (e) {
+            __steps = [];
+        }
+        _renderStepsPanel();
+        _populateTemplateSelects();
+    };
+
+    /************************************************************************/
+    // Template management
+
+    var _loadTemplates = function() {
+        tools.httpGet("/api/automation/templates", null, function(http) {
+            if (http.status === 200) {
+                try { var resp = _unwrapJson(http); __templates = resp.templates || []; }
+                catch (e) { __templates = []; }
+            } else { __templates = []; }
+            _renderTemplatePanel();
+        });
+    };
+
+    var _selectTemplate = function(name) {
+        __activeTemplate = (__activeTemplate === name ? null : name);
+        _renderTemplatePanel();
+        // Update any detect steps that reference this template
+        for (var i = 0; i < __steps.length; i++) {
+            if (__steps[i].type === "detect") {
+                __steps[i].template = __activeTemplate || __steps[i].template;
+            }
+        }
+    };
+
+    var _deleteTemplate = function(name) {
+        if (!confirm('Delete template "' + name + '"?')) return;
+        var encoded = encodeURIComponent(name);
+        _httpDelete("/api/automation/templates/" + encoded, function(http) {
+            if (http.status === 200) {
+                if (__activeTemplate === name) __activeTemplate = null;
+                _loadTemplates();
+            }
+        });
+    };
+
+    var _showOverlay = function() {
+        var el = $("automation-select-window");
+        if (el) {
+            el.style.display = "block";
+            el.style.visibility = "visible";
+        }
+    };
+
+    var _hideOverlay = function() {
+        var el = $("automation-select-window");
+        if (el) {
+            el.style.display = "none";
+            el.style.visibility = "hidden";
+        }
+    };
+
+    var _startTemplateSelection = function() {
+        __selMode = "template";
+        __sel = null;
+        // Close automation window first so the stream is visible
+        wm.closeWindow($("automation-window"));
+        // Ensure stream window is visible
+        wm.showWindow($("stream-window"));
+        _showOverlay();
+    };
+
+    /************************************************************************/
+    // Stream selection UI
+
+    var _selStart = function(ev) {
+        if (__selStartPos === null) {
+            tools.hidden.setVisible($("automation-select-selection"), false);
+            __selStartPos = _selGetGlobalPos(ev);
+            __selEndPos = null;
+        }
+    };
+
+    var _selChange = function(ev) {
+        if (__selStartPos !== null) {
+            __selEndPos = _selGetGlobalPos(ev);
+            var width = Math.abs(__selStartPos.x - __selEndPos.x);
+            var height = Math.abs(__selStartPos.y - __selEndPos.y);
+            var el = $("automation-select-selection");
+            el.style.left = Math.min(__selStartPos.x, __selEndPos.x) + "px";
+            el.style.top = Math.min(__selStartPos.y, __selEndPos.y) + "px";
+            el.style.width = width + "px";
+            el.style.height = height + "px";
+            tools.hidden.setVisible(el, (width > 1 || height > 1));
+        }
+    };
+
+    var _selEnd = function(ev) {
+        _selChange(ev);
+        var el = $("automation-select-selection");
+        var ok = (el.offsetWidth > 1 && el.offsetHeight > 1 && __selStartPos !== null && __selEndPos !== null);
+        tools.hidden.setVisible(el, ok);
+        if (ok) {
+            var rect = $("stream-box").getBoundingClientRect();
+            var relLeft = Math.min(__selStartPos.x, __selEndPos.x) - rect.left;
+            var relRight = Math.max(__selStartPos.x, __selEndPos.x) - rect.left;
+            var offset = _selGetNavbarOffset();
+            var relTop = Math.min(__selStartPos.y, __selEndPos.y) - rect.top + offset;
+            var relBottom = Math.max(__selStartPos.y, __selEndPos.y) - rect.top + offset;
+            var geo = __getGeometry();
+            __sel = {
+                "left":   Math.round(tools.remap(relLeft - geo.x, 0, geo.width, 0, geo.real_width)),
+                "right":  Math.round(tools.remap(relRight - geo.x, 0, geo.width, 0, geo.real_width)),
+                "top":    Math.round(tools.remap(relTop - geo.y, 0, geo.height, 0, geo.real_height)),
+                "bottom": Math.round(tools.remap(relBottom - geo.y, 0, geo.height, 0, geo.real_height)),
+            };
+        } else { __sel = null; }
+        __selStartPos = null;
+        __selEndPos = null;
+    };
+
+    var _selGetGlobalPos = function(ev) {
+        var rect = $("stream-box").getBoundingClientRect();
+        var geo = __getGeometry();
+        var offset = _selGetNavbarOffset();
+        return {
+            "x": Math.min(Math.max(ev.clientX, rect.left + geo.x), rect.right - geo.x),
+            "y": Math.min(Math.max(ev.clientY - offset, rect.top + geo.y - offset), rect.bottom - geo.y - offset),
+        };
+    };
+
+    var _selGetNavbarOffset = function() {
+        return tools.browser.is_firefox ? wm.getViewGeometry().top : 0;
+    };
+
+    var _selConfirm = function() {
+        if (!__sel) return;
+        var savedSel = __sel;  // Save coordinates before async call
+        if (__selMode === "template") {
+            _saveTemplateFromSelection(savedSel);
+        } else if (__selMode === "ocr" || __selMode === "assert_ocr") {
+            var step = {
+                type: __selMode,
+                left: savedSel.left, top: savedSel.top,
+                right: savedSel.right, bottom: savedSel.bottom,
+            };
+            if (__selMode === "assert_ocr") step.expected = [];
+            __steps.push(step);
+            _renderStepsPanel();
+            _saveSteps();
+        }
+        _selCleanup();
+    };
+
+    var _selCancel = function() {
+        _selCleanup();
+    };
+
+    var _selCleanup = function() {
+        __sel = null;
+        __selMode = null;
+        __selCallback = null;
+        __selStartPos = null;
+        __selEndPos = null;
+        // Remove click tip if present
+        var tip = document.getElementById("automation-click-tip");
+        if (tip) tip.remove();
+        _hideOverlay();
+        tools.hidden.setVisible($("automation-select-selection"), false);
+        // Re-open automation window
+        wm.showWindow($("automation-window"));
+    };
+
+    var _saveTemplateFromSelection = function(sel) {
+        // sel: {left, top, right, bottom} - saved before _selCleanup nulls __sel
+        if (!sel) { wm.error("No selection area"); return; }
+        // Backend will take its own snapshot from the tee file
+        var name = prompt("Template name:", "template_" + (__templates.length + 1));
+        if (!name) return;
+
+        _httpPostJson("/api/automation/templates/save", {
+            name: name,
+            left: sel.left, top: sel.top,
+            right: sel.right, bottom: sel.bottom,
+        }, function(http2) {
+            if (http2.status === 200) {
+                __activeTemplate = name;
+                _loadTemplates();
+                _notify("Template saved: " + name);
+            } else {
+                var errMsg = "Failed to save template";
+                try { var eresp = _unwrapJson(http2); if (eresp.error) errMsg += ": " + eresp.error; } catch(e){}
+                wm.error(errMsg);
+            }
+        });
+    };
+
+    /************************************************************************/
+    // OCR region selection
+
+    var _startOcrSelection = function(type) {
