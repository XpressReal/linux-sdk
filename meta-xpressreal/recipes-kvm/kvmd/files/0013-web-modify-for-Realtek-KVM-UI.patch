+	var __setMassStorageParams = function(ipAddress) {
+		return new Promise((resolve, reject) => {
+			const url = `${ROOT_PREFIX}api/msd/set_params?image=/dev/sda::${ipAddress}`;
+			const xhr = new XMLHttpRequest();
+			
+			xhr.open("POST", url, true);
+			
+			xhr.onreadystatechange = function() {
+				if (xhr.readyState === 4) {  // request success
+					if (xhr.status === 200) {
+						resolve(xhr.responseText);   // success → resolve
+					} else {
+						reject(new Error(`Can't configure Mass Storage (status: ${xhr.status})`));
+					}
+				}
+			};
+			
+			xhr.onerror = () => reject(new Error("Network error"));
+			xhr.send();
+		});
+	}
