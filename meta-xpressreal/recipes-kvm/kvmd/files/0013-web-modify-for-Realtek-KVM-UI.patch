+							wm.error("Can't switch Mass Storage", http.responseText);
+						}
+						else {
+							$("msd-switch").checked = true;
+						}
+					});
+				}
+			});
+		} else {
+			//unmount MSD
+			tools.httpPost("api/msd/set_connected", {"connected": false}, function(http) {
+				if (http.status !== 200) {
+					wm.error("Can't switch Mass Storage", http.responseText);
+				} else {
+					$("msd-switch").checked = false;
+				}
+			});
+		}
+	
+	}
