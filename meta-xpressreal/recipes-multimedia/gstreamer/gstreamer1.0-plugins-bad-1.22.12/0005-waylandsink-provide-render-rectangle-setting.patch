From 096be71055fa0a2b2281b34bdc4143e239101a8a Mon Sep 17 00:00:00 2001
From: yaozenhu <yaozenhu@realtek.com>
Date: Wed, 15 Jul 2026 21:00:06 -0400
Subject: [PATCH] waylandsink: provide render-rectangle setting

Source: Realtek
License: LGPL-2.1-or-later
Upstream-Status: Inappropriate [rtk specific]
---
 ext/wayland/gstwaylandsink.c       | 28 ++++++++++++++++++++++++++--
 ext/wayland/gstwaylandsink.h       |  4 ++++
 gst-libs/gst/wayland/gstwlwindow.c | 10 +++++++++-
 gst-libs/gst/wayland/gstwlwindow.h |  2 ++
 gst-libs/gst/wayland/wayland.h     |  1 +
 5 files changed, 42 insertions(+), 3 deletions(-)

diff --git a/ext/wayland/gstwaylandsink.c b/ext/wayland/gstwaylandsink.c
index 2f116bf..be8eacf 100644
--- a/ext/wayland/gstwaylandsink.c
+++ b/ext/wayland/gstwaylandsink.c
@@ -193,6 +193,9 @@ gst_wayland_sink_init (GstWaylandSink * self)
 {
   g_mutex_init (&self->display_lock);
   g_mutex_init (&self->render_lock);
+
+  self->x = self->y = self->w = self->h = 0;
+  self->set_rect = FALSE;
 }
 
 static void
@@ -294,7 +297,8 @@ gst_wayland_sink_set_property (GObject * object,
           FALSE);
       break;
     default:
-      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, prop_id, pspec);
+      if (!gst_video_overlay_set_property (object, PROP_LAST, prop_id, value))
+          G_OBJECT_WARN_INVALID_PROPERTY_ID (object, prop_id, pspec);
       break;
   }
 }
@@ -615,7 +619,7 @@ gst_wayland_sink_set_caps (GstBaseSink * bsink, GstCaps * caps)
   if (!gst_video_info_from_caps (&self->video_info, caps))
     goto invalid_format;
 
-  format = GST_VIDEO_INFO_FORMAT (&self->video_info);
+  format = self->format = GST_VIDEO_INFO_FORMAT (&self->video_info);
   self->video_info_changed = TRUE;
 
   /* create a new pool for the new caps */
@@ -762,6 +766,20 @@ gst_wayland_sink_show_frame (GstVideoSink * vsink, GstBuffer * buffer)
       /* if we were not provided a window, create one ourselves */
       self->window = gst_wl_window_new_toplevel (self->display,
           &self->video_info, self->fullscreen, &self->render_lock);
+
+      if (self->format == GST_VIDEO_FORMAT_BGRA) {
+        self->window->rtk_surface = WL_RTK_SUBTITLE_SURFACE;
+      } else if (self->format == GST_VIDEO_FORMAT_NV12) {
+        self->window->rtk_surface = WL_RTK_VIDEO_SURFACE;
+      } else {
+        self->window->rtk_surface = WL_NOT_RTK_SURFACE;
+      }
+
+      if (self->set_rect == TRUE) {
+        self->window->set_rect = TRUE;
+        gst_wl_window_set_render_rectangle (self->window, self->x, self->y, self->w, self->h);
+      }
+
       g_signal_connect_object (self->window, "closed",
           G_CALLBACK (on_window_closed), self, 0);
       gst_wl_window_set_rotate_method (self->window,
@@ -1034,6 +1052,12 @@ gst_wayland_sink_set_render_rectangle (GstVideoOverlay * overlay,
 
   g_return_if_fail (self != NULL);
 
+  self->x = x;
+  self->y = y;
+  self->w = w;
+  self->h = h;
+  self->set_rect = TRUE;
+
   g_mutex_lock (&self->render_lock);
   if (!self->window) {
     g_mutex_unlock (&self->render_lock);
diff --git a/ext/wayland/gstwaylandsink.h b/ext/wayland/gstwaylandsink.h
index 3243d8c..be319ec 100644
--- a/ext/wayland/gstwaylandsink.h
+++ b/ext/wayland/gstwaylandsink.h
@@ -68,6 +68,10 @@ struct _GstWaylandSink
   GstVideoOrientationMethod current_rotate_method;
 
   struct wl_callback *callback;
+
+  gint x, y, w, h;
+  GstVideoFormat format;
+  gboolean set_rect;
 };
 
 struct _GstWaylandSinkClass
diff --git a/gst-libs/gst/wayland/gstwlwindow.c b/gst-libs/gst/wayland/gstwlwindow.c
index 0023d4e..f939c97 100644
--- a/gst-libs/gst/wayland/gstwlwindow.c
+++ b/gst-libs/gst/wayland/gstwlwindow.c
@@ -124,7 +124,8 @@ handle_xdg_toplevel_configure (void *data, struct xdg_toplevel *xdg_toplevel,
   if (width <= 0 || height <= 0)
     return;
 
-  gst_wl_window_set_render_rectangle (self, 0, 0, width, height);
+  if (self->set_rect == FALSE)
+    gst_wl_window_set_render_rectangle (self, 0, 0, width, height);
 }
 
 static const struct xdg_toplevel_listener xdg_toplevel_listener = {
@@ -170,6 +171,9 @@ gst_wl_window_init (GstWlWindow * self)
   GstWlWindowPrivate *priv = gst_wl_window_get_instance_private (self);
 
   priv->configured = TRUE;
+  self->rtk_surface = WL_NOT_RTK_SURFACE;
+  self->set_rect = FALSE;
+
   g_cond_init (&priv->configure_cond);
   g_mutex_init (&priv->configure_mutex);
 }
@@ -460,6 +464,10 @@ gst_wl_window_resize_video_surface (GstWlWindow * self, gboolean commit)
     gst_video_center_rect (&src, &dst, &res, FALSE);
   }
 
+  wl_surface_set_position(priv->area_surface, priv->render_rectangle.x, priv->render_rectangle.y);
+  wl_surface_set_rtk_surface(priv->area_surface, WL_RTK_TOPLEVEL_SURFACE);
+  wl_surface_set_rtk_surface(priv->video_surface, self->rtk_surface);
+
   wl_subsurface_set_position (priv->video_subsurface, res.x, res.y);
   wl_surface_set_buffer_transform (priv->video_surface_wrapper,
       priv->buffer_transform);
diff --git a/gst-libs/gst/wayland/gstwlwindow.h b/gst-libs/gst/wayland/gstwlwindow.h
index 06c4001..6e00f1c 100644
--- a/gst-libs/gst/wayland/gstwlwindow.h
+++ b/gst-libs/gst/wayland/gstwlwindow.h
@@ -31,6 +31,8 @@ G_DECLARE_FINAL_TYPE (GstWlWindow, gst_wl_window, GST, WL_WINDOW, GObject);
 struct _GstWlWindow
 {
   GObject parent_instance;
+  enum wl_rtk_surface rtk_surface;
+  gboolean set_rect;
 };
 
 GST_WL_API
diff --git a/gst-libs/gst/wayland/wayland.h b/gst-libs/gst/wayland/wayland.h
index 7a45845..73971a4 100644
--- a/gst-libs/gst/wayland/wayland.h
+++ b/gst-libs/gst/wayland/wayland.h
@@ -26,6 +26,7 @@
 #endif
 
 #include <wayland-client.h>
+#include <wayland-util.h>
 
 #include <gst/wayland/wayland-prelude.h>
 #include <gst/wayland/gstwl_fwd.h>
-- 
2.34.1

