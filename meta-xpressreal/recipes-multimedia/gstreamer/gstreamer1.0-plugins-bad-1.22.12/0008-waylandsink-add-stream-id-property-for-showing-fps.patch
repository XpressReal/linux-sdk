From 4dfcc13c3fc274e0c41b993ea155104aaa99e375 Mon Sep 17 00:00:00 2001
From: yaozenhu <yaozenhu@realtek.com>
Date: Wed, 15 Jul 2026 21:59:55 -0400
Subject: [PATCH] waylandsink: add stream-id property for showing fps

Source: Realtek
License: LGPL-2.1-or-later
Upstream-Status: Inappropriate [rtk specific]
---
 ext/wayland/gstwaylandsink.c | 40 +++++++++++++++++++++++++++++++++++-
 ext/wayland/gstwaylandsink.h |  5 +++++
 2 files changed, 44 insertions(+), 1 deletion(-)

diff --git a/ext/wayland/gstwaylandsink.c b/ext/wayland/gstwaylandsink.c
index d98d21f..216b4a4 100644
--- a/ext/wayland/gstwaylandsink.c
+++ b/ext/wayland/gstwaylandsink.c
@@ -46,7 +46,7 @@
 #include <gst/allocators/allocators.h>
 
 #include <gst/video/videooverlay.h>
-
+#include <stdio.h>
 #define DEFAULT_PROP_SILENT FALSE
 
 /* signals */
@@ -65,6 +65,7 @@ enum
   PROP_ROTATE_METHOD,
   PROP_CLEAR,
   PROP_SILENT,
+  PROP_STREAM_ID,
   PROP_LAST
 };
 
@@ -192,6 +193,12 @@ gst_wayland_sink_class_init (GstWaylandSinkClass * klass)
           "Silent rendering of subtitles", FALSE,
           G_PARAM_READWRITE | G_PARAM_STATIC_STRINGS));
 
+  g_object_class_install_property (gobject_class, PROP_STREAM_ID,
+      g_param_spec_uint ("stream-id", "Stream ID",
+          "Stream ID for identifying this instance (0-64 for multi-stream)",
+          0, 64, 0,
+          G_PARAM_READWRITE | G_PARAM_STATIC_STRINGS));
+
  /**
   * waylandsink:render-rectangle:
   *
@@ -212,6 +219,11 @@ gst_wayland_sink_init (GstWaylandSink * self)
   self->x = self->y = self->w = self->h = 0;
   self->set_rect = FALSE;
   self->silent = DEFAULT_PROP_SILENT;
+
+  self->stream_id = 0;
+  self->fps_last_time = GST_CLOCK_TIME_NONE;
+  self->fps_frame_count = 0;
+
   self->need_clear = FALSE;
 }
 
@@ -289,6 +301,11 @@ gst_wayland_sink_get_property (GObject * object,
     case PROP_CLEAR:
     case PROP_SILENT:
       break;
+    case PROP_STREAM_ID:
+      GST_OBJECT_LOCK (self);
+      g_value_set_uint (value, self->stream_id);
+      GST_OBJECT_UNLOCK (self);
+      break;
     default:
       G_OBJECT_WARN_INVALID_PROPERTY_ID (object, prop_id, pspec);
       break;
@@ -389,6 +406,9 @@ gst_wayland_sink_set_property (GObject * object,
     case PROP_SILENT:
       self->silent = g_value_get_boolean (value);
       break;
+    case PROP_STREAM_ID:
+      self->stream_id = g_value_get_uint (value);
+      break;
     default:
       if (!gst_video_overlay_set_property (object, PROP_LAST, prop_id, value))
           G_OBJECT_WARN_INVALID_PROPERTY_ID (object, prop_id, pspec);
@@ -856,6 +876,24 @@ gst_wayland_sink_show_frame (GstVideoSink * vsink, GstBuffer * buffer)
 
   g_mutex_lock (&self->render_lock);
 
+  /* FPS calculation */
+  if (self->stream_id >= 1) {
+    if (G_UNLIKELY (self->fps_last_time == GST_CLOCK_TIME_NONE)) {
+      self->fps_last_time = g_get_monotonic_time () * GST_USECOND;
+      self->fps_frame_count = 0;
+    }
+    self->fps_frame_count++;
+    GstClockTime now = g_get_monotonic_time () * GST_USECOND;
+    GstClockTimeDiff diff = GST_CLOCK_DIFF (self->fps_last_time, now);
+    if (diff >= 5 * GST_SECOND) {
+      gdouble fps = (gdouble) self->fps_frame_count * GST_SECOND / diff;
+      printf("[waylandsink-%u] Average FPS: %.2f (frames: %u, interval: %" G_GINT64_FORMAT " ms)\n",
+          self->stream_id, fps, self->fps_frame_count, diff / GST_MSECOND);
+      self->fps_last_time = now;
+      self->fps_frame_count = 0;
+    }
+  }
+
   if (self->silent == TRUE) {
     gst_buffer_replace (&self->last_buffer, buffer);
     g_mutex_unlock (&self->render_lock);
diff --git a/ext/wayland/gstwaylandsink.h b/ext/wayland/gstwaylandsink.h
index a5d66a7..99364ea 100644
--- a/ext/wayland/gstwaylandsink.h
+++ b/ext/wayland/gstwaylandsink.h
@@ -74,6 +74,11 @@ struct _GstWaylandSink
   gboolean set_rect;
   gboolean silent;
   gboolean need_clear;
+
+  /* FPS stats */
+  guint stream_id;
+  GstClockTime fps_last_time;
+  guint fps_frame_count;
 };
 
 struct _GstWaylandSinkClass
-- 
2.34.1

