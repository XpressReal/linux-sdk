+struct drm_overlay_fb_release {
+	struct weston_buffer_reference buffer_ref;
+	struct weston_buffer_release_reference release_ref;
+	struct wl_event_source *fence_source;
+	int fence_fd;
+	struct drm_fb *fb;
+};
+
+static void *
+drm_overlay_fence_thread(void *data)
+{
+	struct drm_overlay_fb_release *pending = data;
+	struct pollfd pfd = {
+		.fd = pending->fence_fd,
+		.events = POLLIN,
+	};
+	poll(&pfd, 1, -1);
+
+	close(pending->fence_fd);
+
+	drm_fb_unref_by_fence(pending->fb);
+	free(pending);
+	return NULL;
+}
+
+static int
+drm_overlay_release_fence_cb(int fd, uint32_t mask, void *data)
+{
+	struct drm_overlay_fb_release *pending = data;
+
+	wl_event_source_remove(pending->fence_source);
+	close(fd);
+	weston_buffer_reference(&pending->buffer_ref, NULL,
+	                        BUFFER_WILL_NOT_BE_ACCESSED);
+	weston_buffer_release_reference(&pending->release_ref, NULL);
+	free(pending);
+
+	return 0;
+}
+
+
+static void
+drm_overlay_queue_release(struct drm_plane_state *cur)
+{
+	struct drm_overlay_fb_release *pending;
+	pthread_t thread;
+	struct wl_event_loop *loop;
+	struct drm_backend *b = cur->plane->device->backend;
+
+	pending = zalloc(sizeof(*pending));
+	if (!pending)
+		goto fallback;
+
+	pending->fb = cur->fb;
+	pending->fence_fd = cur->out_fence_fd;
+	cur->out_fence_fd = -1;
+
+	if (cur->plane->type == WDRM_PLANE_TYPE_PRIMARY) {
+		pending->fb->release_by_fence = true;
+		drm_fb_ref_by_fence(pending->fb);
+
+		if (pthread_create(&thread, NULL, drm_overlay_fence_thread, pending) != 0)
+			goto fallback_pending;
+
+		pthread_detach(thread);
+	} else {
+		weston_buffer_reference(&pending->buffer_ref,
+					cur->fb_ref.buffer.buffer,
+					cur->fb_ref.buffer.buffer ?
+						cur->fb_ref.buffer.type :
+						BUFFER_WILL_NOT_BE_ACCESSED);
+		weston_buffer_release_move(&pending->release_ref, &cur->fb_ref.release);
+
+		/* Clear state refs now; the end of drm_plane_state_free will no-op */
+		weston_buffer_reference(&cur->fb_ref.buffer, NULL,
+					BUFFER_WILL_NOT_BE_ACCESSED);
+
+		loop = wl_display_get_event_loop(b->compositor->wl_display);
+		pending->fence_source =
+						wl_event_loop_add_fd(loop, pending->fence_fd,
+							WL_EVENT_READABLE,
+							drm_overlay_release_fence_cb, pending);
+		if (!pending->fence_source)
+			goto fallback_pending;
+	}
+	return;
+
+fallback_pending:
+	close(pending->fence_fd);
+	if (pending->fb->release_by_fence == false) {
+		weston_buffer_reference(&pending->buffer_ref, NULL,
+				BUFFER_WILL_NOT_BE_ACCESSED);
+		weston_buffer_release_reference(&pending->release_ref, NULL);
+	} else {
+		drm_fb_unref_by_fence(pending->fb);
+	}
+	free(pending);
+	return;
+
+fallback:
+	close(cur->out_fence_fd);
+	cur->out_fence_fd = -1;
+}
+
 /**
  * Helper function used only by drm_pending_state_apply, with the same
  * guarantees and constraints as that function.
@@ -1566,9 +1683,37 @@ drm_pending_state_apply_atomic(struct drm_pending_state *pending_state,
 	}
 
 	wl_list_for_each_safe(output_state, tmp, &pending_state->output_list,
-			      link)
+			      link) {
+		struct drm_plane_state *plane_state;
+		struct drm_plane *plane;
+		struct drm_output *assign_output = output_state->output;
+
 		drm_output_assign_state(output_state, mode);
 
+		if (mode != DRM_STATE_APPLY_ASYNC || assign_output->virtual)
+			continue;
+
+		wl_list_for_each(plane_state, &output_state->plane_list, link) {
+			plane = plane_state->plane;
+			if (plane->type != WDRM_PLANE_TYPE_OVERLAY &&
+				plane->type != WDRM_PLANE_TYPE_PRIMARY) {
+				continue;
+			}
+
+			if (plane_state->out_fence_fd < 0) {
+				continue;
+			}
+
+			if (plane->type == WDRM_PLANE_TYPE_OVERLAY && !plane_state->fb_ref.buffer.buffer &&
+				!plane_state->fb_ref.release.buffer_release) {
+				close(plane_state->out_fence_fd);
+				continue;
+			}
+
+			drm_overlay_queue_release(plane_state);
+		}
+	}
+
 	device->state_invalid = false;
 
 	assert(wl_list_empty(&pending_state->output_list));
