diff --git a/libweston/backend-drm/drm-gbm.c b/libweston/backend-drm/drm-gbm.c
index d532937..4285831 100644
--- a/libweston/backend-drm/drm-gbm.c
+++ b/libweston/backend-drm/drm-gbm.c
@@ -330,9 +330,6 @@ drm_output_fini_egl(struct drm_output *output)
 	struct drm_backend *b = output->backend;
 	const struct weston_renderer *renderer = b->compositor->renderer;
 
-	if (output->scanout_plane->prev_bo != NULL)
-		gbm_surface_release_buffer(output->gbm_surface, output->scanout_plane->prev_bo);
-
 	/* Destroying the GBM surface will destroy all our GBM buffers,
 	 * regardless of refcount. Ensure we destroy them here. */
 	if (!b->compositor->shutting_down &&
@@ -352,9 +349,25 @@ drm_output_render_gl(struct drm_output_state *state, pixman_region32_t *damage)
 {
 	struct drm_output *output = state->output;
 	struct drm_device *device = output->device;
+	struct drm_plane *scanout_plane = output->scanout_plane;
 	struct gbm_bo *bo;
 	struct drm_fb *ret;
+	struct timespec abs_timeout;
+
+	pthread_mutex_lock(&scanout_plane->gbm_lock_mutex);
+	while (scanout_plane->gbm_locked_count >= 3) {
+		clock_gettime(CLOCK_REALTIME, &abs_timeout);
+		abs_timeout.tv_nsec += 16 * 1000000L;
+		if (abs_timeout.tv_nsec >= 1000000000L) {
+			abs_timeout.tv_nsec -= 1000000000L;
+			abs_timeout.tv_sec++;
+		}
 
+		pthread_cond_timedwait(&scanout_plane->gbm_lock_cond,
+					   &scanout_plane->gbm_lock_mutex,
+					   &abs_timeout);
+	}
+	pthread_mutex_unlock(&scanout_plane->gbm_lock_mutex);
 
 	if (output->base.compositor->has_video_overlay == true) {
 		output->base.compositor->renderer->repaint_output(&output->base,
@@ -371,6 +384,10 @@ drm_output_render_gl(struct drm_output_state *state, pixman_region32_t *damage)
 		return NULL;
 	}
 
+	pthread_mutex_lock(&scanout_plane->gbm_lock_mutex);
+	scanout_plane->gbm_locked_count++;
+	pthread_mutex_unlock(&scanout_plane->gbm_lock_mutex);
+
 	/* The renderer always produces an opaque image. */
 	if (output->format->format == DRM_FORMAT_ARGB8888)
 		ret = drm_fb_get_from_bo(bo, device, false, BUFFER_GBM_SURFACE);
@@ -383,6 +400,7 @@ drm_output_render_gl(struct drm_output_state *state, pixman_region32_t *damage)
 		return NULL;
 	}
 	ret->gbm_surface = output->gbm_surface;
+	ret->scanout_plane = scanout_plane;
 
 	return ret;
 }
