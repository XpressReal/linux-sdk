+void
+drm_fb_unref_by_fence(struct drm_fb *fb)
+{
+	if (!fb)
+		return;
+
+	if (--fb->fence_refcnt > 0)
+		return;
+
+	switch (fb->type) {
+	case BUFFER_GBM_SURFACE:
+	{
+		if (fb->scanout_plane) {
+			pthread_mutex_lock(&fb->scanout_plane->gbm_lock_mutex);
+			gbm_surface_release_buffer(fb->gbm_surface, fb->bo);
+			fb->scanout_plane->gbm_locked_count--;
+			pthread_cond_broadcast(&fb->scanout_plane->gbm_lock_cond);
+			pthread_mutex_unlock(&fb->scanout_plane->gbm_lock_mutex);
+		} else {
+			gbm_surface_release_buffer(fb->gbm_surface, fb->bo);
+		}
+		break;
+	}
+	default:
+		break;
+	}
+}
