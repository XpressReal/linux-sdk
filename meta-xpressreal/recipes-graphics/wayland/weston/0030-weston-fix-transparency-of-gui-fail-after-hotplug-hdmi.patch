From 5fe501668be9986fbbc4de5eb4d8b157f7367f52 Mon Sep 17 00:00:00 2001
From: yaozenhu <yaozenhu@realtek.com>
Date: Tue, 14 Apr 2026 05:31:59 -0400
Subject: [PATCH] weston: fix bug that the transparency function of rtk gui

Upstream-Status: Inappropriate [rtk specific]
License: MIT
Source: Realtek
---
 libweston/renderer-gl/gl-renderer.c | 13 +++++++++++--
 1 file changed, 11 insertions(+), 2 deletions(-)

diff --git a/libweston/renderer-gl/gl-renderer.c b/libweston/renderer-gl/gl-renderer.c
index ca676ea..ad404af 100644
--- a/libweston/renderer-gl/gl-renderer.c
+++ b/libweston/renderer-gl/gl-renderer.c
@@ -2406,8 +2406,17 @@ gl_renderer_attach_shm(struct weston_surface *es, struct weston_buffer *buffer)
 		assert(pixel_format_get_plane_count(buffer->pixel_format) == 1);
 		num_planes = 1;
 
-		if (pixel_format_is_opaque(buffer->pixel_format))
-			shader_variant = SHADER_VARIANT_RGBX;
+		if (pixel_format_is_opaque(buffer->pixel_format)) {
+			char desc[512] = {0};
+			if (!es->get_label ||
+				es->get_label(es, desc, sizeof(desc)) < 0) {
+				strcpy(desc, "[no description available]");
+			}
+			if (strstr(desc, "rtk") != NULL && strstr(desc, "rtk_video") == NULL) {
+				shader_variant = SHADER_VARIANT_RGBA;
+			} else
+				shader_variant = SHADER_VARIANT_RGBX;
+		}
 		else
 			shader_variant = SHADER_VARIANT_RGBA;
 
-- 
2.34.1

