From 50ea29bbf6f0474b9dbc2edbe2f726f455009759 Mon Sep 17 00:00:00 2001
From: yaozenhu <yaozenhu@realtek.com>
Date: Tue, 14 Apr 2026 03:28:42 -0400
Subject: [PATCH] to enable or disable UI hole punch

Upstream-Status: Inappropriate [rtk specific]
License: MIT
Source: Realtek
---
 compositor/main.c             |  1 +
 desktop-shell/shell.c         | 11 ++++++++++-
 desktop-shell/shell.h         |  1 +
 include/libweston/libweston.h |  6 ++++++
 libweston/compositor.c        | 22 ++++++++++++++++++++++
 5 files changed, 40 insertions(+), 1 deletion(-)

diff --git a/compositor/main.c b/compositor/main.c
index 8550a5f..6a6e0d4 100644
--- a/compositor/main.c
+++ b/compositor/main.c
@@ -3082,6 +3082,7 @@ load_drm_backend(struct weston_compositor *c, int *argc, char **argv,
 	weston_config_section_get_bool(section, "full-damage", &c->full_damage, false);
 	weston_config_section_get_bool(section, "transparent-fade-layer", &c->transparent_fade_layer, false);
 	weston_config_section_get_bool(section, "gbm-afbc", &c->gbm_afbc, false);
+	weston_config_section_get_bool(section, "ui-hole-punch", &c->ui_hole_punch, true);
 
 	if (without_input)
 		c->require_input = !without_input;
diff --git a/desktop-shell/shell.c b/desktop-shell/shell.c
index 184595d..b3fffcd 100644
--- a/desktop-shell/shell.c
+++ b/desktop-shell/shell.c
@@ -1679,7 +1679,12 @@ shell_surface_update_layer(struct shell_surface *shsurf)
 	new_layer_link = shell_surface_calculate_layer_link(shsurf);
 	assert(new_layer_link);
 
-	weston_view_move_to_layer(shsurf->view, new_layer_link);
+	if ((shsurf->shell->compositor->ui_hole_punch == false && shsurf->view->surface->rtk_surface != WL_NOT_RTK_SURFACE) || shsurf->view->surface->rtk_layer > 0) {
+		weston_view_move_to_layer(shsurf->view, &shsurf->shell->rtk_layer.view_list);
+	} else {
+		weston_view_move_to_layer(shsurf->view, new_layer_link);
+	}
+
 	shell_surface_update_child_surface_layers(shsurf);
 }
 
@@ -4921,6 +4926,7 @@ wet_shell_init(struct weston_compositor *ec,
 	weston_layer_init(&shell->background_layer, ec);
 	weston_layer_init(&shell->lock_layer, ec);
 	weston_layer_init(&shell->input_panel_layer, ec);
+	weston_layer_init(&shell->rtk_layer, ec);
 
 	weston_layer_set_position(&shell->fullscreen_layer,
 				  WESTON_LAYER_POSITION_FULLSCREEN);
@@ -4928,6 +4934,9 @@ wet_shell_init(struct weston_compositor *ec,
 				  WESTON_LAYER_POSITION_UI);
 	weston_layer_set_position(&shell->background_layer,
 				  WESTON_LAYER_POSITION_BACKGROUND);
+	weston_layer_set_position(&shell->rtk_layer,
+				  WESTON_LAYER_POSITION_RTK);
+
 
 	wl_list_init(&shell->seat_list);
 	wl_list_init(&shell->shsurf_list);
diff --git a/desktop-shell/shell.h b/desktop-shell/shell.h
index debb365..489053f 100644
--- a/desktop-shell/shell.h
+++ b/desktop-shell/shell.h
@@ -96,6 +96,7 @@ struct desktop_shell {
 	struct weston_layer background_layer;
 	struct weston_layer lock_layer;
 	struct weston_layer input_panel_layer;
+	struct weston_layer rtk_layer;
 
 	struct wl_listener pointer_focus_listener;
 	struct weston_surface *grab_surface;
diff --git a/include/libweston/libweston.h b/include/libweston/libweston.h
index bea2ba9..ca84f5a 100644
--- a/include/libweston/libweston.h
+++ b/include/libweston/libweston.h
@@ -1246,6 +1246,9 @@ enum weston_layer_position {
 	 */
 	WESTON_LAYER_POSITION_BACKGROUND = 0x00000002,
 
+	/* rtk specific layer */
+	WESTON_LAYER_POSITION_RTK        = 0x20000000,
+
 	/* For "desktop widgets" and applications like conky. */
 	WESTON_LAYER_POSITION_BOTTOM_UI  = 0x30000000,
 
@@ -1526,6 +1529,7 @@ struct weston_compositor {
 	bool gbm_afbc;
 	bool found_drm_fd;
 	bool full_damage;
+	bool ui_hole_punch;
 };
 
 struct weston_solid_buffer_values {
@@ -1961,6 +1965,8 @@ struct weston_surface {
 	int x;
 	int y;
 	enum wl_rtk_surface rtk_surface;
+	int rtk_layer;
+	int rtk_layer_order;
 };
 
 struct weston_subsurface {
diff --git a/libweston/compositor.c b/libweston/compositor.c
index f3d719e..6139a69 100644
--- a/libweston/compositor.c
+++ b/libweston/compositor.c
@@ -871,6 +871,8 @@ weston_surface_create(struct weston_compositor *compositor)
 	surface->x = 0;
 	surface->y = 0;
 	surface->rtk_surface = WL_NOT_RTK_SURFACE;
+	surface->rtk_layer = 0;
+	surface->rtk_layer_order = -1;
 	return surface;
 }
 
@@ -4756,6 +4758,24 @@ surface_set_rtk_surface(struct wl_client *client,
 	surface->rtk_surface = (enum wl_rtk_surface)rtk_surface;
 }
 
+static void
+surface_set_rtk_layer(struct wl_client *client,
+	       struct wl_resource *resource,
+	       int32_t rtk_layer)
+{
+	struct weston_surface *surface = wl_resource_get_user_data(resource);
+	surface->rtk_layer = rtk_layer;
+}
+
+static void
+surface_set_rtk_layer_order(struct wl_client *client,
+	       struct wl_resource *resource,
+	       int32_t rtk_layer_order)
+{
+	struct weston_surface *surface = wl_resource_get_user_data(resource);
+	surface->rtk_layer_order = rtk_layer_order;
+}
+
 static const struct wl_surface_interface surface_interface = {
 	surface_destroy,
 	surface_attach,
@@ -4770,6 +4790,8 @@ static const struct wl_surface_interface surface_interface = {
 	surface_offset,
 	surface_set_position,
 	surface_set_rtk_surface,
+	surface_set_rtk_layer,
+	surface_set_rtk_layer_order,
 };
 
 static void
-- 
2.34.1

