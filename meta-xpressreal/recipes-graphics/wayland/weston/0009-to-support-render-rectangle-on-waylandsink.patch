From 9221ab467acee46adb984b192af265ae679a2cf1 Mon Sep 17 00:00:00 2001
From: yaozenhu <yaozenhu@realtek.com>
Date: Tue, 14 Apr 2026 01:32:04 -0400
Subject: [PATCH] to support render-rectangle on waylandsink

Upstream-Status: Inappropriate [rtk specific]
License: MIT
Source: Realtek
---
 include/libweston/libweston.h |  4 ++++
 libweston/compositor.c        | 33 +++++++++++++++++++++++++++++++++
 2 files changed, 37 insertions(+)

diff --git a/include/libweston/libweston.h b/include/libweston/libweston.h
index 9365a51..15b64c8 100644
--- a/include/libweston/libweston.h
+++ b/include/libweston/libweston.h
@@ -43,6 +43,7 @@ extern "C" {
 
 #include <libweston/matrix.h>
 #include <libweston/zalloc.h>
+#include <wayland-util.h>
 
 struct weston_log_pacer {
 	/** This must be set to zero before first use */
@@ -1951,6 +1952,9 @@ struct weston_surface {
 	enum weston_surface_protection_mode protection_mode;
 
 	struct weston_tearing_control *tear_control;
+	int x;
+	int y;
+	enum wl_rtk_surface rtk_surface;
 };
 
 struct weston_subsurface {
diff --git a/libweston/compositor.c b/libweston/compositor.c
index 41459eb..e13558d 100644
--- a/libweston/compositor.c
+++ b/libweston/compositor.c
@@ -867,6 +867,9 @@ weston_surface_create(struct weston_compositor *compositor)
 	surface->current_protection = WESTON_HDCP_DISABLE;
 	surface->protection_mode = WESTON_SURFACE_PROTECTION_MODE_RELAXED;
 
+	surface->x = 0;
+	surface->y = 0;
+	surface->rtk_surface = WL_NOT_RTK_SURFACE;
 	return surface;
 }
 
@@ -1860,9 +1863,17 @@ WL_EXPORT void
 weston_view_set_position(struct weston_view *view,
 			 struct weston_coord_global pos)
 {
+	struct weston_surface *surface = view->surface;
+
 	assert(view->surface->committed != subsurface_committed);
 	assert(!view->geometry.parent);
 
+	if (surface != NULL) {
+		if (surface->rtk_surface == WL_RTK_TOPLEVEL_SURFACE) {
+			pos.c = weston_coord(surface->x, surface->y);
+		}
+	}
+
 	if (view->geometry.pos_offset.x == pos.c.x &&
 	    view->geometry.pos_offset.y == pos.c.y)
 		return;
@@ -4721,6 +4732,26 @@ surface_offset(struct wl_client *client,
 	surface->pending.buf_offset = weston_coord_surface(sx, sy, surface);
 }
 
+static void
+surface_set_position(struct wl_client *client,
+	       struct wl_resource *resource,
+	       int32_t x,
+	       int32_t y)
+{
+	struct weston_surface *surface = wl_resource_get_user_data(resource);
+	surface->x = x;
+	surface->y = y;
+}
+
+static void
+surface_set_rtk_surface(struct wl_client *client,
+	       struct wl_resource *resource,
+	       int32_t rtk_surface)
+{
+	struct weston_surface *surface = wl_resource_get_user_data(resource);
+	surface->rtk_surface = (enum wl_rtk_surface)rtk_surface;
+}
+
 static const struct wl_surface_interface surface_interface = {
 	surface_destroy,
 	surface_attach,
@@ -4733,6 +4764,8 @@ static const struct wl_surface_interface surface_interface = {
 	surface_set_buffer_scale,
 	surface_damage_buffer,
 	surface_offset,
+	surface_set_position,
+	surface_set_rtk_surface,
 };
 
 static void
-- 
