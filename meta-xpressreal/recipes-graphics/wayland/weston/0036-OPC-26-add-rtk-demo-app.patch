+enum bottom_button {
+	BUTTON_NONE,
+	BUTTON_LOCAL_PLAYBACK,
+	BUTTON_DPRX,
+	BUTTON_AISR,
+	BUTTON_PAUSE,
+	BUTTON_RESUME,
+	BUTTON_STOP,
+	BUTTON_FILE_BROWSER
+};
+
+static enum bottom_button
+get_bottom_button(int x, int y)
+{
+	struct rectangle allocation;
+	widget_get_allocation(widget, &allocation);
+
+	int width = allocation.width;
+	int button_width = width / 6;
+	int button_height = 60;
+	bottom_button_area_y = allocation.height - button_height;
+
+	if (y < bottom_button_area_y)
+		return BUTTON_NONE;
+
+	if (x < button_width)
+		return BUTTON_LOCAL_PLAYBACK;
+	else if (x < button_width * 2)
+		return BUTTON_DPRX;
+	else if (x < button_width * 3)
+		return BUTTON_AISR;
+	else if (x < button_width * 4)
+		return BUTTON_PAUSE;
+	else if (x < button_width * 5)
+		return BUTTON_RESUME;
+	else
+		return BUTTON_STOP;
+}
