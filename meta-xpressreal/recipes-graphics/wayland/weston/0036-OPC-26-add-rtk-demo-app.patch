+static void
+load_directory(const char *path)
+{
+	DIR *dir;
+	struct dirent *entry;
+	struct stat st;
+	int i;
+
+	/* Free existing file list */
+	for (i = 0; i < file_count; i++) {
+		free(file_list[i]);
+		file_list[i] = NULL;
+	}
+	file_count = 0;
+	selected_file_index = -1;
+	file_scroll_offset = 0;
+
+	/* Update current path */
+	strncpy(current_path, path, MAX_PATH - 1);
+	current_path[MAX_PATH - 1] = '\0';
+
+	dir = opendir(path);
+	if (!dir) {
+		fprintf(stderr, "Cannot open directory: %s\n", path);
+		return;
+	}
+
+	while ((entry = readdir(dir)) != NULL && file_count < MAX_FILES) {
+		/* Skip hidden files */
+		if (entry->d_name[0] == '.')
+			continue;
+
+		/* Build full path for stat check */
+		char full_path[MAX_PATH];
+		snprintf(full_path, MAX_PATH, "%s/%s", path, entry->d_name);
+
+		if (stat(full_path, &st) == 0 && S_ISDIR(st.st_mode)) {
+			/* Put directories first with '/' suffix */
+			file_list[file_count] = malloc(strlen(entry->d_name) + 2);
+			sprintf(file_list[file_count], "%s/", entry->d_name);
+		} else {
+			file_list[file_count] = strdup(entry->d_name);
+		}
+		file_count++;
+	}
+
+	closedir(dir);
+	fprintf(stderr, "Loaded %d files in %s\n", file_count, path);
+}
