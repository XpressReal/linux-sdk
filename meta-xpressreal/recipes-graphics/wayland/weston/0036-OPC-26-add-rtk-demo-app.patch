+static void
+draw_bottom_bar(cairo_t *cr, struct rectangle *alloc)
+{
+	int width = alloc->width;
+	int height = alloc->height;
+	int button_width = width / 6;
+	int button_height = 60;
+	int y = height - button_height;
+	int margin = 5;
+
+	/* Draw background bar */
+	cairo_set_source_rgb(cr, 0.2, 0.2, 0.2);
+	cairo_rectangle(cr, 0, y, width, button_height);
+	cairo_fill(cr);
+
+	/* Draw each button with grey background and white border */
+	cairo_set_line_width(cr, 2);
+
+	/* Button 1: LOCAL PLAYBACK */
+	cairo_set_source_rgb(cr, 0.5, 0.5, 0.5);
+	cairo_rectangle(cr, margin, y + margin, button_width - margin * 2, button_height - margin * 2);
+	cairo_fill(cr);
+	cairo_set_source_rgb(cr, 1, 1, 1);
+	cairo_rectangle(cr, margin, y + margin, button_width - margin * 2, button_height - margin * 2);
+	cairo_stroke(cr);
+
+	/* Button 2: dprx */
+	cairo_set_source_rgb(cr, 0.5, 0.5, 0.5);
+	cairo_rectangle(cr, button_width + margin, y + margin, button_width - margin * 2, button_height - margin * 2);
+	cairo_fill(cr);
+	cairo_set_source_rgb(cr, 1, 1, 1);
+	cairo_rectangle(cr, button_width + margin, y + margin, button_width - margin * 2, button_height - margin * 2);
+	cairo_stroke(cr);
+
+	/* Button 3: AISR */
+	cairo_set_source_rgb(cr, 0.5, 0.5, 0.5);
+	cairo_rectangle(cr, button_width * 2 + margin, y + margin, button_width - margin * 2, button_height - margin * 2);
+	cairo_fill(cr);
+	cairo_set_source_rgb(cr, 1, 1, 1);
+	cairo_rectangle(cr, button_width * 2 + margin, y + margin, button_width - margin * 2, button_height - margin * 2);
+	cairo_stroke(cr);
+
+	/* Button 4: PAUSE */
+	cairo_set_source_rgb(cr, 0.5, 0.5, 0.5);
+	cairo_rectangle(cr, button_width * 3 + margin, y + margin, button_width - margin * 2, button_height - margin * 2);
+	cairo_fill(cr);
+	cairo_set_source_rgb(cr, 1, 1, 1);
+	cairo_rectangle(cr, button_width * 3 + margin, y + margin, button_width - margin * 2, button_height - margin * 2);
+	cairo_stroke(cr);
+
+	/* Button 5: RESUME */
+	cairo_set_source_rgb(cr, 0.5, 0.5, 0.5);
+	cairo_rectangle(cr, button_width * 4 + margin, y + margin, button_width - margin * 2, button_height - margin * 2);
+	cairo_fill(cr);
+	cairo_set_source_rgb(cr, 1, 1, 1);
+	cairo_rectangle(cr, button_width * 4 + margin, y + margin, button_width - margin * 2, button_height - margin * 2);
+	cairo_stroke(cr);
+
+	/* Button 6: STOP */
+	cairo_set_source_rgb(cr, 0.5, 0.5, 0.5);
+	cairo_rectangle(cr, button_width * 5 + margin, y + margin, button_width - margin * 2, button_height - margin * 2);
+	cairo_fill(cr);
+	cairo_set_source_rgb(cr, 1, 1, 1);
+	cairo_rectangle(cr, button_width * 5 + margin, y + margin, button_width - margin * 2, button_height - margin * 2);
+	cairo_stroke(cr);
+
+	/* Draw button text */
+	cairo_set_source_rgb(cr, 1, 1, 1);
+	cairo_select_font_face(cr, "sans-serif", CAIRO_FONT_SLANT_NORMAL, CAIRO_FONT_WEIGHT_BOLD);
