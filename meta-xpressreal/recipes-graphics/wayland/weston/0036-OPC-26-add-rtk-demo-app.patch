+static void
+draw_file_browser(cairo_t *cr, struct rectangle *alloc)
+{
+	int width = alloc->width;
+	int height = alloc->height;
+	int item_height = 40;
+	int bottom_bar_height = 60;
+	int visible_files = (height - 80 - bottom_bar_height) / item_height;
+	int i;
+
+	/* Draw background - semi-transparent */
+	cairo_set_source_rgba(cr, 0, 0, 0, 0.5);
+	cairo_rectangle(cr, 0, 0, width, height);
+	cairo_fill(cr);
+
+	/* Draw border */
+	cairo_set_source_rgb(cr, 0.5, 0.5, 0.5);
+	cairo_set_line_width(cr, 4);
+	cairo_rectangle(cr, 20, 20, width - 40, height - 40);
+	cairo_stroke(cr);
+
+	/* Draw title */
+	cairo_set_source_rgb(cr, 1, 1, 1);
+	cairo_select_font_face(cr, "sans-serif", CAIRO_FONT_SLANT_NORMAL, CAIRO_FONT_WEIGHT_BOLD);
+	cairo_set_font_size(cr, 24);
+	cairo_move_to(cr, 80, 50);
+	cairo_show_text(cr, "Select File (tap dir to enter, tap file to select)");
+
+	/* Draw back button */
+	cairo_set_source_rgb(cr, 0.2, 0.4, 0.8);
+	cairo_rectangle(cr, 20, 10, 40, 30);
+	cairo_fill(cr);
+	cairo_set_source_rgb(cr, 1, 1, 1);
+	cairo_set_font_size(cr, 18);
+	cairo_move_to(cr, 25, 32);
+	cairo_show_text(cr, "<");
+
+	/* Draw current path */
+	cairo_set_source_rgb(cr, 0.8, 0.8, 0.8);
+	cairo_set_font_size(cr, 16);
+	cairo_move_to(cr, 70, 32);
+	cairo_show_text(cr, current_path);
+
+	/* Draw close button area */
+	cairo_set_source_rgb(cr, 0.8, 0.2, 0.2);
+	cairo_rectangle(cr, width - 80, 10, 60, 30);
+	cairo_fill(cr);
+	cairo_set_source_rgb(cr, 1, 1, 1);
+	cairo_set_font_size(cr, 18);
+	cairo_move_to(cr, width - 70, 32);
+	cairo_show_text(cr, "CLOSE");
+
+	/* Draw file list */
+	cairo_set_font_size(cr, 20);
+	for (i = 0; i < visible_files && (file_scroll_offset + i) < file_count; i++) {
+		int file_idx = file_scroll_offset + i;
+		int file_y = 80 + i * item_height;
+
+		/* Highlight selected file */
+		if (file_idx == selected_file_index) {
+			cairo_set_source_rgb(cr, 0.2, 0.4, 0.8);
+			cairo_rectangle(cr, 30, file_y, width - 60, item_height);
+			cairo_fill(cr);
+		}
+
+		cairo_set_source_rgb(cr, 1, 1, 1);
+		cairo_move_to(cr, 40, file_y + 26);
+		cairo_show_text(cr, file_list[file_idx]);
+
+		/* Draw divider */
+		cairo_set_source_rgb(cr, 0.3, 0.3, 0.3);
+		cairo_move_to(cr, 30, file_y + item_height);
+		cairo_line_to(cr, width - 30, file_y + item_height);
+		cairo_stroke(cr);
+	}
+
+	/* Draw scroll indicator */
+	if (file_count > visible_files) {
+		int scrollbar_height = (height - 80 - bottom_bar_height) * visible_files / file_count;
+		int scrollbar_y = 80 + (height - 80 - bottom_bar_height) * file_scroll_offset / file_count;
+
+		cairo_set_source_rgb(cr, 0.5, 0.5, 0.5);
+		cairo_rectangle(cr, width - 25, 80, 5, height - 80 - bottom_bar_height);
+		cairo_fill(cr);
+
+		cairo_set_source_rgb(cr, 0.8, 0.8, 0.8);
+		cairo_rectangle(cr, width - 25, scrollbar_y, 5, scrollbar_height);
+		cairo_fill(cr);
+	}
+}
+
+static void
+handle_file_browser_click(int x, int y, struct rectangle *alloc)
+{
+	int width = alloc->width;
+	int height = alloc->height;
+	int item_height = 40;
+	int bottom_bar_height = 60;
+	int visible_files = (height - 80 - bottom_bar_height) / item_height;
+
+	/* Check close button */
+	if (x > width - 80 && x < width - 20 && y > 10 && y < 40) {
+		file_browser_visible = false;
+		return;
+	}
+
+	/* Check go back button (left side) */
+	if (x > 20 && x < 60 && y > 10 && y < 40) {
+		/* Go back to parent directory */
+		char *last_slash = strrchr(current_path, '/');
+		if (last_slash && last_slash != current_path) {
+			*last_slash = '\0';
+		} else if (strcmp(current_path, ".") != 0) {
+			strcpy(current_path, ".");
+		}
+		load_directory(current_path);
+		widget_schedule_redraw(widget);
+		return;
+	}
+
+	/* Check file list */
+	if (y >= 80 && y < 80 + visible_files * item_height) {
+		int index = (y - 80) / item_height;
+		int actual_index = file_scroll_offset + index;
+		if (actual_index >= 0 && actual_index < file_count && index < visible_files) {
+			selected_file_index = actual_index;
+			char *filename = file_list[selected_file_index];
+			fprintf(stderr, "Selected: %s\n", filename);
+
+			/* Check if it's a directory (ends with '/') */
+			size_t len = strlen(filename);
+			if (len > 0 && filename[len - 1] == '/') {
+				/* It's a directory - navigate into it */
+				char new_path[MAX_PATH];
+				if (strcmp(current_path, ".") == 0) {
+					snprintf(new_path, MAX_PATH, "%s", filename);
+				} else {
+					snprintf(new_path, MAX_PATH, "%s/%s", current_path, filename);
+				}
+				/* Remove trailing '/' */
+				new_path[strlen(new_path) - 1] = '\0';
+				load_directory(new_path);
+				fprintf(stderr, "Navigating to: %s\n", new_path);
+			} else {
+				/* It's a file - save file path and close browser */
+				if (strcmp(current_path, ".") == 0) {
+					snprintf(selected_file, MAX_PATH, "%s", filename);
+				} else {
+					snprintf(selected_file, MAX_PATH, "%s/%s", current_path, filename);
+				}
+				system("amixer sset \"DPRX Audio En\" off");
+				fprintf(stderr, "File selected: %s\n", selected_file);
+				system("rtk_media_player_ctrl -c stop");
+				char buf[512] = {0};
+				sprintf(buf, "rtk_media_player_ctrl -c start -s %s", selected_file);
+				printf("cmd:%s\n", buf);
+				system(buf);
+				file_browser_visible = false;
+			}
+		}
+	}
+}
+
+#define WL_TABLET_AXIS_MAX 65535
+
+static void
+redraw_handler(struct widget *widget, void *data)
+{
+	cairo_surface_t *surface;
+	cairo_t *window_cr, *drawing_cr;
+	struct rectangle allocation;
+
+	widget_get_allocation(widget, &allocation);
+
+	surface = window_get_surface(window);
+
+	/* Setup the background */
+	window_cr = cairo_create(surface);
+	cairo_set_operator(window_cr, CAIRO_OPERATOR_SOURCE);
+	cairo_rectangle(window_cr,
+			allocation.x,
+			allocation.y,
+			allocation.width,
+			allocation.height);
+	cairo_set_source_rgba(window_cr, 0, 0, 0, 0);
+	cairo_fill(window_cr);
+
+	/* Update the drawing buffer */
+	if (tablet_is_down) {
+		if (old_x != -1 && old_y != -1) {
+			drawing_cr = cairo_create(draw_buffer);
+			if (tool_type == ZWP_TABLET_TOOL_V2_TYPE_PEN) {
+				cairo_set_source_rgb(drawing_cr, 1, 1, 1);
+				cairo_set_line_width(drawing_cr,
+						     current_pressure /
+						     WL_TABLET_AXIS_MAX * 7 + 1);
+			} else if (tool_type == ZWP_TABLET_TOOL_V2_TYPE_ERASER) {
+				cairo_set_operator(drawing_cr, CAIRO_OPERATOR_CLEAR);
+				cairo_set_source_rgb(drawing_cr, 0, 0, 0);
+				cairo_set_line_width(drawing_cr,
+						     current_pressure /
+						     WL_TABLET_AXIS_MAX * 30 + 10);
+			}
+
+			cairo_set_line_cap(drawing_cr, CAIRO_LINE_CAP_ROUND);
+
+			cairo_translate(drawing_cr,
+					-allocation.x,
+					-allocation.y);
+			cairo_move_to(drawing_cr, old_x, old_y);
+			cairo_line_to(drawing_cr, current_x, current_y);
+			cairo_stroke(drawing_cr);
+
+			cairo_destroy(drawing_cr);
+		}
+
+		old_x = current_x;
+		old_y = current_y;
+	}
+
+	/* Squash the drawing buffer onto the window's buffer */
+	cairo_set_source_surface(window_cr,
+				 draw_buffer,
+				 allocation.x,
+				 allocation.y);
+	cairo_set_operator(window_cr, CAIRO_OPERATOR_ADD);
+	cairo_rectangle(window_cr,
+			allocation.x,
+			allocation.y,
+			allocation.width,
+			allocation.height);
+	cairo_clip(window_cr);
+	cairo_paint(window_cr);
+
+	cairo_destroy(window_cr);
+
+	/* Draw bottom bar */
+	window_cr = cairo_create(surface);
+	draw_bottom_bar(window_cr, &allocation);
+	cairo_destroy(window_cr);
+
+	/* Draw file browser if visible */
+	if (file_browser_visible) {
+		window_cr = cairo_create(surface);
+		draw_file_browser(window_cr, &allocation);
+		cairo_destroy(window_cr);
+	}
+
+	cairo_surface_destroy(surface);
+}
+
+static void
+resize_handler(struct widget *widget,
+	       int32_t width, int32_t height,
+	       void *data)
+{
+	cairo_surface_t *tmp_buffer;
+	cairo_t *cr;
+
+	tmp_buffer = draw_buffer;
+	draw_buffer = cairo_image_surface_create(CAIRO_FORMAT_ARGB32,
+						 width, height);
+	cr = cairo_create(draw_buffer);
+	cairo_set_source_rgba(cr, 0, 0, 0, 0);
+	cairo_rectangle(cr, 0, 0, width, height);
+	cairo_fill(cr);
+
+	if (tmp_buffer) {
+		cairo_set_source_surface(cr, tmp_buffer, 0, 0);
+		cairo_rectangle(cr, 0, 0, width, height);
+		cairo_clip(cr);
+		cairo_paint(cr);
+	}
+
+	cairo_destroy(cr);
+
+	cairo_surface_destroy(tmp_buffer);
+}
