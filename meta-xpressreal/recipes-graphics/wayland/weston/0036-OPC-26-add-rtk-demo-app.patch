+static void
+proximity_in_handler(struct widget *widget, struct tablet_tool *tool,
+		     struct tablet *tablet, void *data)
+{
+	tool_type = tablet_tool_get_type(tool);
+}
+
+static void
+pressure_handler(struct widget *widget, struct tablet_tool *tool,
+		 uint32_t pressure, void *data)
+{
+	current_pressure = pressure;
+}
+
+static int
+tablet_motion_handler(struct widget *widget, struct tablet_tool *tool,
+		      float x, float y, void *data)
+{
+	int cursor;
+
+	current_x = x;
+	current_y = y;
+
+	if (tablet_is_down) {
+		widget_schedule_redraw(widget);
+		cursor = CURSOR_HAND1;
+	} else {
+		cursor = CURSOR_LEFT_PTR;
+	}
+
+	return cursor;
+}
+
+static void
+tablet_down_handler(struct widget *widget, struct tablet_tool *tool, void *data)
+{
+	tablet_is_down = true;
+}
+
+static void
+tablet_up_handler(struct widget *widget, struct tablet_tool *tool, void *data)
+{
+	tablet_is_down = false;
+	old_x = -1;
+	old_y = -1;
+}
+
+static void
+axis_handler(struct widget *widget, struct input *input, uint32_t time,
+	     uint32_t axis, wl_fixed_t value, void *data)
+{
+	if (!file_browser_visible)
+		return;
+
+	if (axis != WL_POINTER_AXIS_VERTICAL_SCROLL)
+		return;
+
+	/* Get cursor position to check if in file browser area */
+	int32_t x, y;
+	input_get_position(input, &x, &y);
+
+	struct rectangle allocation;
+	widget_get_allocation(widget, &allocation);
+
+	/* Only scroll if in file browser area */
+	if (y < allocation.height - 60 && x > 20 && x < allocation.width - 20) {
+		int delta = wl_fixed_to_int(value);
+		int visible_files = (allocation.height - 80 - 60) / 40;
+		int max_scroll = file_count - visible_files;
+		if (max_scroll < 0) max_scroll = 0;
+
+		file_scroll_offset += delta > 0 ? 1 : -1;
+		if (file_scroll_offset < 0) file_scroll_offset = 0;
+		if (file_scroll_offset > max_scroll) file_scroll_offset = max_scroll;
+
+		widget_schedule_redraw(widget);
+	}
+}
+
+static void
+button_handler(struct widget *widget,
+	       struct input *input, uint32_t time,
+	       uint32_t button,
+	       enum wl_pointer_button_state state, void *data)
+{
+	int32_t x, y;
+	struct rectangle allocation;
+
+	input_get_position(input, &x, &y);
+	fprintf(stderr, "button_handler: button=%u state=%d x=%d y=%d\n", button, state, x, y);
+
+	if (button == BTN_LEFT && state == WL_POINTER_BUTTON_STATE_PRESSED) {
+		widget_get_allocation(widget, &allocation);
+
+		/* Handle file browser click */
+		if (file_browser_visible) {
+			handle_file_browser_click(x, y, &allocation);
+			widget_schedule_redraw(widget);
+			return;
+		}
+
+		enum bottom_button btn = get_bottom_button(x, y);
+		fprintf(stderr, "button click: btn=%d\n", btn);
+
+		switch (btn) {
+		case BUTTON_LOCAL_PLAYBACK:
+			/* Open file selection UI */
+			load_directory(".");
+			file_browser_visible = true;
+			widget_schedule_redraw(widget);
+			fprintf(stderr, "LOCAL PLAYBACK clicked - file browser opened\n");
+			break;
+		case BUTTON_DPRX:
+			/* dprx - empty function */
+			system("amixer sset \"DPRX Audio En\" on");
+			system("rtk_media_player_ctrl -c stop");
+			system("rtk_media_player_ctrl -c start -s rtk_dprx");
+			fprintf(stderr, "dprx clicked\n");
+			break;
+		case BUTTON_AISR:
+			aiser_enabled = !aiser_enabled;
+			widget_schedule_redraw(widget);
+			if (aiser_enabled) {
+				fprintf(stderr, "disable AISR\n");
+				system("kms_ipc -F -a 0");
+			} else {
+				fprintf(stderr, "enable AISR\n");
+				system("kms_ipc -F -a 1");
+			}
+			break;
+		case BUTTON_PAUSE:
+			system("rtk_media_player_ctrl -c pause");
+			fprintf(stderr, "PAUSE clicked\n");
+			break;
+		case BUTTON_RESUME:
+			system("rtk_media_player_ctrl -c resume");
+			fprintf(stderr, "RESUME clicked\n");
+			break;
+		case BUTTON_STOP:
+			system("rtk_media_player_ctrl -c stop");
+			fprintf(stderr, "STOP clicked\n");
+			break;
+		case BUTTON_FILE_BROWSER:
+		case BUTTON_NONE:
+			break;
+		}
+	}
+}
+
+static void
+init_globals(void)
+{
+	window = window_create(display);
+	widget = window_frame_create(window, NULL);
+	window_set_title(window, "Wayland Tablet Demo");
+	window_set_maximized(window, 1);
+	old_x = -1;
+	old_y = -1;
+
+	widget_set_tablet_tool_axis_handlers(widget,
+					     tablet_motion_handler,
+					     pressure_handler,
+					     NULL, NULL,
+					     NULL, NULL, NULL);
+	widget_set_tablet_tool_down_handler(widget, tablet_down_handler);
+	widget_set_tablet_tool_up_handler(widget, tablet_up_handler);
+	widget_set_tablet_tool_proximity_handlers(widget,
+						  proximity_in_handler,
+						  NULL);
+	widget_set_redraw_handler(widget, redraw_handler);
+	widget_set_resize_handler(widget, resize_handler);
+	widget_set_button_handler(widget, button_handler);
+	widget_set_axis_handler(widget, axis_handler);
+}
+
+static void
+cleanup(void)
+{
+	/* Kill rtk_media_player daemon */
+	if (rtk_media_player_pid > 0) {
+		fprintf(stderr, "Killing rtk_media_player (pid=%d)\n", rtk_media_player_pid);
+		kill(rtk_media_player_pid, SIGTERM);
+		usleep(100000);
+		/* Force kill if still alive */
+		kill(rtk_media_player_pid, SIGKILL);
+	}
+
+	widget_destroy(widget);
+	window_destroy(window);
+}
+
+static void
+start_rtk_media_player_daemon(void)
+{
+	pid_t pid = fork();
+	if (pid < 0) {
+		fprintf(stderr, "fork failed: %m\n");
+		return;
+	}
+	if (pid > 0) {
+		/* Parent process - save PID and continue */
+		rtk_media_player_pid = pid;
+		usleep(100000);
+		return;
+	}
+	if (pid == 0) {
+
+	/* Child process - become daemon */
+	if (setsid() < 0) {
+		_exit(1);
+	}
+
+	/* Close stdin, stdout, stderr */
+	close(STDIN_FILENO);
+	close(STDOUT_FILENO);
+	close(STDERR_FILENO);
+
+	/* Redirect to /dev/null */
+	open("/dev/null", O_RDONLY);
+	open("/dev/null", O_WRONLY);
+	open("/dev/null", O_WRONLY);
+
+	/* Execute rtk_media_player */
+	execlp("rtk_media_player", "rtk_media_player", NULL);
+	_exit(1);
+	}
+}
+
+static void
+signal_handler(int signum)
+{
+	/* Kill rtk_media_player on signal */
+	if (rtk_media_player_pid > 0) {
+		kill(rtk_media_player_pid, SIGTERM);
+	}
+	exit(1);
+}
+
+int
+main(int argc, char *argv[])
+{
+	/* Register signal handlers */
+	struct sigaction sa;
+	sa.sa_handler = signal_handler;
+	sigemptyset(&sa.sa_mask);
+	sa.sa_flags = 0;
+	sigaction(SIGINT, &sa, NULL);
+	sigaction(SIGTERM, &sa, NULL);
+
+	system("kms_ipc -F -a 1");
+	start_rtk_media_player_daemon();
+
+	display = display_create(&argc, argv);
+	if (display == NULL) {
+		fprintf(stderr, "failed to create display: %m\n");
+		return -1;
+	}
+
+	init_globals();
+
+	display_run(display);
+
+	cleanup();
+
+	display_destroy(display);
+
+	return 0;
+}
