+static int
+kms_ipc_crtc_set_tv_mode(struct drm_output *output,
+			 struct kms_ipc_message *msg)
+{
+	struct drm_device *device = output->device;
+	struct drm_mode *current_mode = to_drm_mode(output->base.current_mode);
+	struct drm_mode *tv_current = NULL;
+	struct drm_crtc *crtc = output->crtc;
+	struct drm_plane *plane = NULL;
+	drmModeModeInfo dummy_mode;
+	float w_ratio = 1;
+	float h_ratio = 1;
+	int ret = 0;
+	int crtc_id = msg->cmd_value;
+	drmModeAtomicReq *req = NULL;
+
+	if (crtc_id != crtc->crtc_id) {
+		weston_log("%s:wrong crtc_id:%d\n", __func__, crtc_id);
+		return -1;
+	}
+
+	tv_current = drm_output_choose_initial_mode(device, output,
+					WESTON_DRM_BACKEND_OUTPUT_PREFERRED,
+					msg->cmd_str, &dummy_mode);
+	output->base.tv_current_mode = &tv_current->base;
+	ret = drm_mode_ensure_blob(device, tv_current);
+	if (ret != 0) {
+		weston_log("%s:drm_mode_ensure_blob error\n", __func__);
+		return -1;
+	}
+
+	w_ratio = (float)tv_current->base.width /
+		  (float)current_mode->base.width;
+	h_ratio = (float)tv_current->base.height /
+		  (float)current_mode->base.height;
+
+	pthread_mutex_lock(&output->kms_ipc_atomic_mutex);
+	req = drmModeAtomicAlloc();
+
+	ret |= crtc_add_prop(req, crtc, WDRM_CRTC_MODE_ID,
+			     tv_current->blob_id);
+
+	plane = output->scanout_plane;
+	ret |= plane_add_prop(req, plane, WDRM_PLANE_CRTC_X,
+			      plane->dest_x * w_ratio);
+	ret |= plane_add_prop(req, plane, WDRM_PLANE_CRTC_Y,
+			      plane->dest_y * h_ratio);
+	ret |= plane_add_prop(req, plane, WDRM_PLANE_CRTC_W,
+			      plane->dest_w * w_ratio);
+	ret |= plane_add_prop(req, plane, WDRM_PLANE_CRTC_H,
+			      plane->dest_h * h_ratio);
+
+	if (ret != 0) {
+		weston_log("%s:add property fail\n", __func__);
+		goto finish;
+	}
+
+	drmModeAtomicCommit(device->drm.fd, req,
+			    DRM_MODE_ATOMIC_ALLOW_MODESET, device);
+finish:
+	pthread_mutex_unlock(&output->kms_ipc_atomic_mutex);
+	drmModeAtomicFree(req);
+	return ret;
+}
+
+static int
+kms_ipc_crtc_set_dpms_mode(struct drm_output *output,
+			   struct kms_ipc_message *msg)
+{
+	struct drm_device *device = output->device;
+	struct drm_mode *current_mode = to_drm_mode(output->base.current_mode);
+	struct drm_mode *tv_current = NULL;
+	float w_ratio = 1;
+	float h_ratio = 1;
+	int ret = 0;
+	struct drm_plane *plane = NULL;
+	drmModeAtomicReq *req = NULL;
+
+	if (output->base.tv_current_mode != NULL) {
+		tv_current = to_drm_mode(output->base.tv_current_mode);
+		w_ratio = (float)tv_current->base.width /
+			  (float)current_mode->base.width;
+		h_ratio = (float)tv_current->base.height /
+			  (float)current_mode->base.height;
+	}
+
+	plane = output->scanout_plane;
+	if (strcmp(msg->cmd_str, "disable") == 0) {
+		output->is_disabled = true;
+		w_ratio = 0;
+		h_ratio = 0;
+	} else {
+		output->is_disabled = false;
+	}
+
+	pthread_mutex_lock(&output->kms_ipc_atomic_mutex);
+	req = drmModeAtomicAlloc();
+	ret |= plane_add_prop(req, plane, WDRM_PLANE_CRTC_X,
+			      plane->dest_x * w_ratio);
+	ret |= plane_add_prop(req, plane, WDRM_PLANE_CRTC_Y,
+			      plane->dest_y * h_ratio);
+	ret |= plane_add_prop(req, plane, WDRM_PLANE_CRTC_W,
+			      plane->dest_w * w_ratio);
+	ret |= plane_add_prop(req, plane, WDRM_PLANE_CRTC_H,
+			      plane->dest_h * h_ratio);
+
+	if (ret != 0) {
+		weston_log("%s:add property fail\n", __func__);
+		goto finish;
+	}
+
+	drmModeAtomicCommit(device->drm.fd, req,
+			    DRM_MODE_ATOMIC_ALLOW_MODESET, device);
+finish:
+	pthread_mutex_unlock(&output->kms_ipc_atomic_mutex);
+	drmModeAtomicFree(req);
+	return ret;
+}
+
+static int
+kms_ipc_crtc_active_reset(struct drm_output *output,
+			  struct kms_ipc_message *msg)
+{
+	struct drm_device *device = output->device;
+	struct drm_crtc *crtc = output->crtc;
+	int ret = 0;
+	int crtc_id = msg->cmd_value;
+	drmModeAtomicReq *req = NULL;
+
+	if (crtc_id != crtc->crtc_id) {
+		weston_log("%s:wrong crtc_id:%d\n", __func__, crtc_id);
+		return -1;
+	}
+
+	pthread_mutex_lock(&output->kms_ipc_atomic_mutex);
+	req = drmModeAtomicAlloc();
+	ret |= crtc_add_prop(req, crtc, WDRM_CRTC_ACTIVE, 0);
+	if (ret != 0) {
+		weston_log("%s:active 0 fail\n", __func__);
+		goto finish;
+	}
+
+	drmModeAtomicCommit(device->drm.fd, req,
+			    DRM_MODE_ATOMIC_ALLOW_MODESET, device);
+	drmModeAtomicFree(req);
+
+	req = drmModeAtomicAlloc();
+	ret |= crtc_add_prop(req, crtc, WDRM_CRTC_ACTIVE, 1);
+	if (ret != 0) {
+		weston_log("%s:active 1 fail\n", __func__);
+		goto finish;
+	}
+
+	drmModeAtomicCommit(device->drm.fd, req,
+			    DRM_MODE_ATOMIC_ALLOW_MODESET, device);
+finish:
+	pthread_mutex_unlock(&output->kms_ipc_atomic_mutex);
+	drmModeAtomicFree(req);
+	return ret;
+}
+
+static void
+kms_ipc_crtc_control(struct drm_output *output, struct kms_ipc_message *msg)
+{
+	switch (msg->sub_cmd) {
+	case CRTC_TV_MODE:
+		kms_ipc_crtc_set_tv_mode(output, msg);
+		break;
+	case CRTC_DPMS_MODE:
+		kms_ipc_crtc_set_dpms_mode(output, msg);
+		break;
+	case CRTC_ACTIVE_RESET:
+		kms_ipc_crtc_active_reset(output, msg);
+		break;
+	default:
+		weston_log("IPC_CRTC: unknown sub_cmd %d\n", msg->sub_cmd);
+		break;
+	}
+}
+
+/**
+ * Route an IPC_CONN message — store the message and trigger the
+ * timer callback so drm_device_ipc_connector_active runs in the
+ * main event-loop thread.
+ */
+static void
+ipc_conn_route(struct drm_device *device, struct kms_ipc_message *msg)
+{
+	switch (msg->sub_cmd) {
+	case CONN_ACTIVE:
+		pthread_mutex_lock(&device->kms_ipc_mutex);
+		device->kms_ipc_msg = *msg;
+		pthread_mutex_unlock(&device->kms_ipc_mutex);
+
+		if (device->kms_ipc_timer)
+			wl_event_source_timer_update(device->kms_ipc_timer, 5);
+		break;
+
+	default:
+		weston_log("IPC_CONN: unknown sub_cmd %d\n", msg->sub_cmd);
+		break;
+	}
+}
+
+/**
+ * Route an IPC_CRTC message to the correct drm_output by crtc_id.
+ * Walk drm_device->crtc_list → drm_crtc → crtc->output.
+ */
+static void
+ipc_crtc_route(struct drm_device *device, struct kms_ipc_message *msg)
+{
+	struct drm_crtc *crtc;
+	struct drm_output *output;
+
+	wl_list_for_each(crtc, &device->crtc_list, link) {
+		if (crtc->crtc_id == msg->cmd_value) {
+			output = crtc->output;
+			if (output) {
+				kms_ipc_crtc_control(output, msg);
+			} else {
+				weston_log("IPC_CRTC: crtc %d has no output\n",
+					   msg->cmd_value);
+			}
+			return;
+		}
+	}
+
+	weston_log("IPC_CRTC: no crtc found for id %d\n", msg->cmd_value);
+}
+
+/* ================================================================
+ *  Unified IPC thread — single socket, single pthread
+ * ================================================================ */
+
+void *
+kms_ipc_process(void *data)
+{
+	struct drm_device *device = (struct drm_device *)data;
+	struct sockaddr_un addr;
+	struct sockaddr_un clientaddr;
+	socklen_t addrlen = sizeof(clientaddr);
+	int ret = -1;
+
+	unlink(DRM_IPC_SOCKET_PATH);
+	device->kms_ipc_socket = socket(AF_UNIX, SOCK_DGRAM, 0);
+	if (device->kms_ipc_socket < 0) {
+		weston_log("open socket fail\n");
+		goto finish;
+	}
+
+	memset(&addr, 0, sizeof(addr));
+	addr.sun_family = AF_UNIX;
+	strcpy(addr.sun_path, DRM_IPC_SOCKET_PATH);
+
+	if (bind(device->kms_ipc_socket,
+		 (struct sockaddr *)&addr, sizeof(addr)) < 0) {
+		weston_log("bind socket fail\n");
+		goto finish;
+	}
+
+	while (device->kms_ipc_run) {
+		struct kms_ipc_message msg = { 0 };
+
+		ret = recvfrom(device->kms_ipc_socket, &msg,
+			       sizeof(struct kms_ipc_message), 0,
+			       (struct sockaddr *)&clientaddr, &addrlen);
+		if (ret < 0) {
+			weston_log("recvfrom ret:%d\n", ret);
+			continue;
+		}
+
+		switch (msg.type) {
+		case IPC_CONN:
+			ipc_conn_route(device, &msg);
+			break;
+
+		case IPC_CRTC:
+			ipc_crtc_route(device, &msg);
+			break;
+
+		default:
+			weston_log("unknown ipc type %d\n", msg.type);
+			break;
+		}
+	}
+
+finish:
+	if (device->kms_ipc_socket >= 0) {
+		shutdown(device->kms_ipc_socket, SHUT_RDWR);
+		device->kms_ipc_socket = -1;
+	}
+
+	pthread_exit(NULL);
+}
