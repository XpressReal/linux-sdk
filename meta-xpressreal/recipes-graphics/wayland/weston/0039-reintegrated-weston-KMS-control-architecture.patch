+#ifndef WESTON_KMS_IPC_H
+#define WESTON_KMS_IPC_H
+
+#include <stdint.h>
+#include <xf86drmMode.h>
+
+struct drm_crtc;
+struct drm_connector;
+struct drm_plane;
+struct drm_output;
+struct drm_device;
+
+/*
+ * Unified IPC message (drm_ipc_message) sent over a single socket.
+ *   IPC_CONN  → connector active/inactive (routes by connector_id)
+ *   IPC_CRTC  → crtc-level control (routes by crtc_id → drm_output)
+ */
+
+enum drm_ipc_type {
+	IPC_CONN  = 0,
+	IPC_CRTC  = 1,
+	IPC_COUNT,
+};
+
+enum drm_ipc_sub_cmd {
+	/* IPC_CONN sub-commands */
+	CONN_ACTIVE = 0,
+
+	/* IPC_CRTC sub-commands */
+	CRTC_TV_MODE      = 100,
+	CRTC_DPMS_MODE    = 101,
+	CRTC_ACTIVE_RESET = 102,
+
+	UNKNOWN_CMD_TYPE  = 300,
+};
+
+struct kms_ipc_message {
+	enum drm_ipc_type type;
+	enum drm_ipc_sub_cmd sub_cmd;
+	char cmd_str[128];
+	int  cmd_value;  /* connector_id (IPC_CONN) or crtc_id (IPC_CRTC) */
+};
+
+/* ── Single unified socket path ── */
+#define DRM_IPC_SOCKET_PATH "/tmp/drm_device.sock"
+
+/* ── Unified thread entry point ── */
+
+void *
+kms_ipc_process(void *data);  /* data = struct drm_device * */
+
+/*
+ * kms_ipc_process:
+ *   1. Binds a single UNIX DGRAM socket at DRM_IPC_SOCKET_PATH
+ *   2. IPC_CONN  → timer → drm_device_ipc_connector_active
+ *   3. IPC_CRTC  → find drm_output by crtc_id (crtc_list → crtc->output)
+ *                  → kms_ipc_crtc_control(output, &msg)
+ */
+
+/* ── Timer callback for conn_active (declared here, used by drm.c) ── */
+
+int
+kms_ipc_connector_active(void *data);
+
+#endif /* WESTON_DRM_IPC_H */
