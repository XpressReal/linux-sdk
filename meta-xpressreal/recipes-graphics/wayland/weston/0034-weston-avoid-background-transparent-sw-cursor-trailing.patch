From 38a9bb6e45c92f3ccc9139585807acbfc144ed04 Mon Sep 17 00:00:00 2001
From: yaozenhu <yaozenhu@realtek.com>
Date: Tue, 14 Apr 2026 05:54:11 -0400
Subject: [PATCH] weston avoid background transparent sw cursor trailing

Upstream-Status: Inappropriate [rtk specific]
License: MIT
Source: Realtek
---
 compositor/main.c             | 10 ++++++++++
 include/libweston/libweston.h |  2 ++
 libweston/compositor.c        |  8 +++++++-
 3 files changed, 19 insertions(+), 1 deletion(-)

diff --git a/compositor/main.c b/compositor/main.c
index ed35dba..c5e5ab8 100644
--- a/compositor/main.c
+++ b/compositor/main.c
@@ -3039,6 +3039,7 @@ load_drm_backend(struct weston_compositor *c, int *argc, char **argv,
 	struct wet_backend *wb;
 	bool without_input = false;
 	bool force_pixman = false;
+	uint32_t bg_color;
 
 	wet->drm_use_current_mode = false;
 
@@ -3084,6 +3085,15 @@ load_drm_backend(struct weston_compositor *c, int *argc, char **argv,
 	weston_config_section_get_bool(section, "transparent-fade-layer", &c->transparent_fade_layer, false);
 	weston_config_section_get_bool(section, "gbm-afbc", &c->gbm_afbc, false);
 	weston_config_section_get_bool(section, "ui-hole-punch", &c->ui_hole_punch, true);
+	weston_config_section_get_bool(section, "sw-cursor", &c->use_sw_cursor, true);
+
+	section = weston_config_get_section(wc, "shell", NULL, NULL);
+	weston_config_section_get_color(section, "background-color",&bg_color,0xff000000);
+
+	if(bg_color == 0x00ff0000 || bg_color == 0x0000ff00 || bg_color == 0x000000ff)
+		c->bg_transparent = true;
+	else
+		c->bg_transparent = false;
 
 	if (without_input)
 		c->require_input = !without_input;
diff --git a/include/libweston/libweston.h b/include/libweston/libweston.h
index 60f1f12..f03c305 100644
--- a/include/libweston/libweston.h
+++ b/include/libweston/libweston.h
@@ -1531,6 +1531,8 @@ struct weston_compositor {
 	bool full_damage;
 	bool ui_hole_punch;
 	bool default_max_mode;
+	bool use_sw_cursor;
+	bool bg_transparent;
 };
 
 struct weston_solid_buffer_values {
diff --git a/libweston/compositor.c b/libweston/compositor.c
index 6139a69..6ece48b 100644
--- a/libweston/compositor.c
+++ b/libweston/compositor.c
@@ -3440,8 +3440,14 @@ weston_output_repaint(struct weston_output *output)
 	TL_POINT(ec, "core_repaint_begin", TLP_OUTPUT(output), TLP_END);
 
 	/* Rebuild the surface list and update surface transforms up front. */
-	if (ec->view_list_needs_rebuild)
+	if (ec->view_list_needs_rebuild) {
+		if (ec->use_sw_cursor && ec->bg_transparent) {
+			// background transparent always repaint full to avoid sw_cursor trailing
+			weston_output_damage(output);
+		}
+
 		weston_compositor_build_view_list(ec);
+	}
 
 	wl_list_for_each(pnode, &output->paint_node_z_order_list,
 			 z_order_link) {
-- 
2.34.1

